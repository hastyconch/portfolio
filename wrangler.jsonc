{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project (Git-connected): `main` → https://nakuliyer.pages.dev,
  // every other branch → a preview URL. Static only: no Functions, no bindings.
  "name": "nakuliyer",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-01",
}
