{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-only Worker: Cloudflare serves ./dist directly, no Worker script.
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
  // Branch previews via Workers Builds (`npx wrangler preview`); settings inherit from the top level.
  "previews": {},
}
