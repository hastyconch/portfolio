{
  "include": ["src/system", "src/pages"],
  "exclude": ["node_modules", "dist", ".astro", "demos"],
  "tokens": ["src/system/tokens.css", "src/system/liner.css"],
  "budgets": {
    "fontSize": 10,
    "lineHeight": 8,
    "letterSpacing": 6,
    "radius": 6,
    "shadow": 6,
    "duration": 8,
    "easing": 4,
    "transitionAll": 0,
    "infiniteUnguarded": 0,
    "hoverWithoutFocus": 0,
    "pressWithoutActive": 0,
    "pills": 6,
    "bigBlur": 0
  }
}
