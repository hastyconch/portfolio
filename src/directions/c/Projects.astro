---
// Projects as a board grouped by category. Columns sit side by side on desktop and swipe
// horizontally on phones.
import type { SiteContent } from '../../lib/content';
import SectionHead from './SectionHead.astro';
import ProjectCard from './ProjectCard.astro';
import { categoryLabel } from './util';

interface Props {
  content: SiteContent;
}
const { projects } = Astro.props.content;
const num = new Map(projects.map((p, i) => [p.id, i + 1]));
const order = ['app', 'game', 'tool'] as const;
const columns = order
  .map((cat) => ({ cat, items: projects.filter((p) => p.data.category === cat) }))
  .filter((c) => c.items.length > 0);
const roadmap = projects.reduce((n, p) => n + p.data.planned.length, 0);
---

<section id="projects" class="dc-section" aria-labelledby="projects-h">
  <div class="dc-wrap">
    <SectionHead
      index="03"
      kicker="Projects"
      title="Things I've built"
      id="projects-h"
      count={`${projects.length} products · ${roadmap} roadmap items`}
    />
  </div>
  <div class="board-wrap">
    <div class="board">
      {columns.map((c) => (
        <section class="col" aria-labelledby={`col-${c.cat}`}>
          <h3 class="col__head" id={`col-${c.cat}`}>
            <span class={`col__glyph col__glyph--${c.cat}`} aria-hidden="true" />
            {categoryLabel[c.cat]}
            <span class="col__n">{c.items.length}</span>
          </h3>
          <ul class="col__list" role="list">
            {c.items.map((p) => (
              <li>
                <ProjectCard project={p} n={num.get(p.id) ?? 0} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
  <p class="dc-wrap swipe-hint" aria-hidden="true">
    Swipe for {columns.length} columns →
  </p>
</section>

<style>
  .board-wrap {
    width: 100%;
    max-width: 1152px;
    margin: 0 auto;
  }
  .board {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84%;
    gap: 12px;
    padding: 2px var(--gutter) 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .board::-webkit-scrollbar {
    display: none;
  }
  .col {
    scroll-snap-align: start;
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 10px;
    border-radius: 14px;
    background: var(--sunken);
    border: 1px solid var(--line);
  }
  .col__head {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 4px 6px 2px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
  }
  .col__n {
    margin-left: auto;
    min-width: 22px;
    padding: 0 6px;
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    line-height: 20px;
    text-align: center;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .col__glyph {
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--muted);
  }
  .col__glyph--app {
    border-radius: 3px;
  }
  .col__glyph--game {
    border-radius: 50%;
  }
  .col__glyph--tool {
    transform: rotate(45deg) scale(0.85);
    border-radius: 2px;
  }
  .col__list {
    display: grid;
    gap: 8px;
    padding: 0;
    list-style: none;
  }
  .swipe-hint {
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .board {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      gap: 16px;
      overflow: visible;
      scroll-snap-type: none;
    }
    .swipe-hint {
      display: none;
    }
  }
</style>
