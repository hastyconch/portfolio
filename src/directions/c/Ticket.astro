---
// One professional engagement as a ticket: id, sector, status, summary, spec drawers, skills.
import type { Work } from '../../lib/content';
import Pill from './Pill.astro';
import { ticketId, workStatus } from './util';

interface Props {
  entry: Work;
  n: number;
  featured?: boolean;
}
const { entry, n, featured = false } = Astro.props;
const d = entry.data;
const st = workStatus(d.status);
const hid = `w-${entry.id}`;
---

<article class:list={['ticket card', { 'ticket--featured': featured }]} aria-labelledby={hid}>
  <div class="ticket__main">
    <div class="ticket__top">
      <span class="tid">{ticketId('W', n)}</span>
      <span class="ticket__sector">{d.sector}</span>
      <Pill tone={st.tone} label={st.label} />
    </div>
    <h3 id={hid} class="ticket__title">
      {d.title}
    </h3>
    <p class="ticket__kicker">{d.kicker}</p>
    <p class="ticket__summary">{d.summary}</p>

    <dl class="ticket__meta">
      <div>
        <dt>Role</dt>
        <dd>{d.role}</dd>
      </div>
      <div>
        <dt>Org</dt>
        <dd>{d.years}</dd>
      </div>
    </dl>

    <div class="ticket__drawers">
      <details class="drawer" open={featured}>
        <summary>
          Contributions <span class="drawer__count">{d.contributions.length}</span>
        </summary>
        <div class="drawer__body">
          <ul class="checklist checklist--done">
            {d.contributions.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
      </details>
      {d.outcomes.length > 0 && (
        <details class="drawer" open>
          <summary>
            Outcomes <span class="drawer__count">{d.outcomes.length}</span>
          </summary>
          <div class="drawer__body">
            <ul class="outcomes">
              {d.outcomes.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </div>
        </details>
      )}
    </div>

    <ul class="tags ticket__skills" aria-label="Skills">
      {d.skills.map((s) => (
        <li class="tag">{s}</li>
      ))}
    </ul>
    <slot name="foot" />
  </div>
  <slot />
</article>

<style>
  .ticket {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .ticket > :not(.ticket__main) {
    margin-top: auto;
  }
  .ticket:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lift);
  }
  .ticket__main {
    display: grid;
    align-content: start;
    min-width: 0;
  }
  .ticket__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }
  .ticket__sector {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--muted);
  }
  .ticket__sector::before {
    content: '·';
    margin-right: 10px;
    color: var(--line-strong);
  }
  .ticket__top :global(.pill) {
    margin-left: auto;
  }
  .ticket__title {
    margin-top: 16px;
    font-size: 19px;
    letter-spacing: -0.015em;
  }
  .ticket__kicker {
    margin-top: 4px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
  }
  .ticket__summary {
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }
  .ticket__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin: 16px 0 14px;
    font-size: 13px;
  }
  .ticket__meta div {
    display: flex;
    gap: 8px;
  }
  .ticket__meta dt {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    padding-top: 1px;
  }
  .ticket__meta dd {
    margin: 0;
    font-weight: 500;
  }
  .ticket__drawers {
    border-bottom: 1px solid var(--line);
  }
  .outcomes {
    display: grid;
    gap: 6px;
    padding: 0;
    list-style: none;
  }
  .outcomes li {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ok);
    background: var(--ok-soft);
  }
  .ticket__skills {
    margin-top: 16px;
  }

  .ticket--featured {
    padding: 0;
    gap: 0;
    overflow: hidden;
  }
  .ticket--featured > :not(.ticket__main) {
    margin-top: 0;
  }
  .ticket--featured .ticket__main {
    padding: 24px 20px;
  }
  .ticket--featured .ticket__title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: -0.025em;
  }
  .ticket--featured .ticket__kicker {
    font-size: 17px;
  }
  .ticket--featured .ticket__summary {
    font-size: 15.5px;
    max-width: 52ch;
  }
  /* a ticket that spans the whole board lays its spec out in two columns */
  @container (min-width: 720px) {
    .ticket:not(.ticket--featured) .ticket__main {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: 48px;
    }
    .ticket:not(.ticket--featured) .ticket__main > :not(.ticket__drawers) {
      grid-column: 1;
    }
    .ticket:not(.ticket--featured) .ticket__drawers {
      grid-column: 2;
      grid-row: 1 / 8;
      align-self: start;
      border-top: 0;
    }
  }
  @media (min-width: 1024px) {
    .ticket {
      padding: 24px;
    }
    .ticket--featured {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      padding: 0;
    }
    .ticket--featured .ticket__main {
      display: flex;
      flex-direction: column;
      padding: 40px 40px 36px;
    }
  }
</style>
