---
// One project as a board card; the whole card links to its spec (case study).
import type { Project } from '../../lib/content';
import Pill from './Pill.astro';
import { ticketId, projectStatus, LAB } from './util';

interface Props {
  project: Project;
  n: number;
}
const { project, n } = Astro.props;
const d = project.data;
const st = projectStatus(d.status);
const stackHint = d.stack
  .slice(0, 3)
  .map((s) => s.tech.split(/\s[·(]/)[0].trim())
  .join(' · ');
---

<article class="pc" style={`--acc:${d.accent}`} aria-labelledby={`p-${project.id}`}>
  <div class="pc__top">
    <span class="pc__swatch" aria-hidden="true"></span>
    <span class="tid">{ticketId('P', n)}</span>
    {d.featured && <span class="pc__feat">Featured</span>}
    <Pill tone={st.tone} label={st.label} />
  </div>
  <h4 id={`p-${project.id}`} class="pc__title">
    <a href={`${LAB}${project.id}/`}>{d.title}</a>
  </h4>
  <p class="pc__tagline">{d.tagline}</p>
  <p class="pc__stack">
    <span class="visually-hidden">Stack: </span>
    {stackHint}
  </p>
  <div class="pc__foot">
    <ul class="pc__plat" aria-label="Platforms">
      {d.platforms.map((p) => (
        <li>{p}</li>
      ))}
    </ul>
    {d.planned.length > 0 && (
      <span class="pc__road">
        <span class="pc__road-dot" aria-hidden="true" />
        {d.planned.length} on roadmap
      </span>
    )}
    <span class="pc__go" aria-hidden="true">
      Spec →
    </span>
  </div>
</article>

<style>
  .pc {
    position: relative;
    display: grid;
    align-content: start;
    gap: 6px;
    height: 100%;
    padding: 16px 16px 14px;
    border: 1px solid var(--line);
    border-radius: 11px;
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .pc:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lift);
    transform: translateY(-1px);
  }
  .pc:focus-within {
    border-color: var(--accent);
  }
  .pc__top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }
  .pc__swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--acc);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  .pc__feat {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .pc__feat::before {
    content: '★ ';
    color: var(--progress);
  }
  .pc__top :global(.pill) {
    margin-left: auto;
  }
  .pc__title {
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .pc__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .pc__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .pc__title a:focus-visible {
    outline: none;
  }
  .pc__title a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .pc__tagline {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .pc__stack {
    margin-top: 6px;
    padding: 7px 9px;
    border-radius: 7px;
    font-family: var(--mono);
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--ink-2);
    background: var(--sunken);
  }
  .pc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
  }
  .pc__plat {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 0;
    list-style: none;
  }
  .pc__plat li {
    padding: 1px 7px;
    border: 1px solid var(--line);
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-2);
  }
  .pc__road {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--plan);
  }
  .pc__road-dot {
    width: 6px;
    height: 6px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
  }
  .pc__go {
    margin-left: auto;
    font-weight: 600;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }
  .pc:hover .pc__go,
  .pc:focus-within .pc__go {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .pc__go {
      opacity: 1;
      transform: none;
    }
  }
</style>
