---
// A project written up as a PRD: Problem → Features → Roadmap → Architecture → Engineering
// notes, with an issue-style properties panel beside the document on desktop.
import type { Project } from '../../lib/content';
import Pill from './Pill.astro';
import { ticketId, projectStatus, categoryLabel, LAB } from './util';

interface Props {
  project: Project;
  n: number;
  prev?: Project;
  next?: Project;
}
const { project, n, prev, next } = Astro.props;
const d = project.data;
const st = projectStatus(d.status);
const cat = categoryLabel[d.category].replace(/s$/, '');
const num = (i: number) => String(i + 1);
---

<article class="prd" aria-labelledby="prd-h" style={`--acc:${d.accent}`}>
  <div class="dc-wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol role="list">
        <li>
          <a href={LAB}>Workspace</a>
        </li>
        <li>
          <a href={`${LAB}#projects`}>Projects</a>
        </li>
        <li>
          <span aria-current="page">{d.title}</span>
        </li>
      </ol>
    </nav>

    <header class="prd__head">
      <p class="prd__ids">
        <span class="prd__swatch" aria-hidden="true"></span>
        <span class="tid">{ticketId('P', n)} · Product spec</span>
        <Pill tone={st.tone} label={st.label} />
      </p>
      <h1 id="prd-h">{d.title}</h1>
      <p class="prd__tagline">{d.tagline}</p>
    </header>

    <div class="prd__grid">
      <div class="prd__doc">
        <section id="problem" class="prd__sec" aria-labelledby="problem-h">
          <h2 id="problem-h">
            <span class="prd__n">{num(0)}</span>Problem
          </h2>
          <p class="prd__problem">{d.problem}</p>
        </section>

        <section id="features" class="prd__sec" aria-labelledby="features-h">
          <h2 id="features-h">
            <span class="prd__n">{num(1)}</span>Features
            <span class="prd__count">{d.features.length} shipped</span>
          </h2>
          <ol class="reqs" role="list">
            {d.features.map((f, i) => (
              <li class="req">
                <span class="req__id">{ticketId('F', i + 1)}</span>
                <p class="req__txt">{f}</p>
                <span class="req__st">
                  <Pill tone="ok" label="Shipped" />
                </span>
              </li>
            ))}
          </ol>
        </section>

        <section id="roadmap" class="prd__sec" aria-labelledby="roadmap-h">
          <h2 id="roadmap-h">
            <span class="prd__n">{num(2)}</span>On the roadmap
          </h2>
          {d.planned.length > 0 ? (
            <ol class="reqs reqs--plan" role="list">
              {d.planned.map((p, i) => (
                <li class="req">
                  <span class="req__id">{ticketId('R', i + 1)}</span>
                  <p class="req__txt">{p}</p>
                  <span class="req__st">
                    <Pill tone="plan" label="Planned" />
                  </span>
                </li>
              ))}
            </ol>
          ) : (
            <p class="prd__empty">No roadmap items recorded yet.</p>
          )}
        </section>

        <section id="architecture" class="prd__sec" aria-labelledby="architecture-h">
          <h2 id="architecture-h">
            <span class="prd__n">{num(3)}</span>Architecture
            <span class="prd__count">{d.stack.length} layers</span>
          </h2>
          <table class="arch" role="table">
            <caption class="visually-hidden">Stack for{d.title}: layer, technology and why</caption>
            <thead role="rowgroup">
              <tr role="row">
                <th scope="col" role="columnheader">
                  Layer
                </th>
                <th scope="col" role="columnheader">
                  Tech
                </th>
                <th scope="col" role="columnheader">
                  Why
                </th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {d.stack.map((s) => (
                <tr role="row">
                  <th scope="row" role="rowheader">
                    {s.layer}
                  </th>
                  <td role="cell" class="arch__tech">
                    {s.tech}
                  </td>
                  <td role="cell" class="arch__why">
                    {s.why}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section id="engineering" class="prd__sec" aria-labelledby="engineering-h">
          <h2 id="engineering-h">
            <span class="prd__n">{num(4)}</span>Engineering notes
          </h2>
          <div class="notes">
            {d.engineering.map((e, i) => (
              <div class="enote">
                <span class="enote__n">{ticketId('N', i + 1)}</span>
                <h3 class="enote__t">{e.title}</h3>
                <p class="enote__b">{e.body}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <aside class="prd__side" aria-labelledby="prd-props-h">
        <div class="side">
          <h2 id="prd-props-h" class="side__h">
            Properties
          </h2>
          <dl class="props">
            <dt>Status</dt>
            <dd>
              <Pill tone={st.tone} label={st.label} />
            </dd>
            <dt>Type</dt>
            <dd>{cat}</dd>
            <dt>Year</dt>
            <dd>{d.year}</dd>
            <dt>Platforms</dt>
            <dd>
              <ul class="tags">
                {d.platforms.map((p) => (
                  <li class="tag">{p}</li>
                ))}
              </ul>
            </dd>
            <dt>Scope</dt>
            <dd>
              {d.features.length} features · {d.planned.length} planned
            </dd>
            <dt>Demo</dt>
            <dd>{d.demo === 'none' ? '—' : <Pill tone="progress" label="Demo coming" />}</dd>
          </dl>
          <div class="side__stack">
            <p class="side__label">Stack</p>
            <ul class="tags">
              {d.stack.map((s) => (
                <li class="tag tag--mono">{s.tech.split(/\s[·(]/)[0]}</li>
              ))}
            </ul>
          </div>
        </div>
      </aside>
    </div>

    <nav class="pager" aria-label="More projects">
      {prev ? (
        <a class="pager__a" href={`${LAB}${prev.id}/`}>
          <span class="pager__dir">← Previous spec</span>
          <span class="pager__t">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="pager__a pager__a--next" href={`${LAB}${next.id}/`}>
          <span class="pager__dir">Next spec →</span>
          <span class="pager__t">{next.data.title}</span>
        </a>
      ) : (
        <a class="pager__a pager__a--next" href={`${LAB}#projects`}>
          <span class="pager__dir">Back to board →</span>
          <span class="pager__t">All projects</span>
        </a>
      )}
    </nav>
  </div>
</article>

<style>
  .prd {
    padding: 24px 0 72px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    color: var(--line-strong);
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }

  .prd__head {
    display: grid;
    gap: 12px;
    margin-top: 36px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }
  .prd__ids {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .prd__swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--acc);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  .prd h1 {
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .prd__tagline {
    max-width: 48ch;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .prd__grid {
    display: grid;
    gap: 40px;
  }
  .prd__side {
    order: -1;
    margin-top: 24px;
  }
  .side {
    padding: 16px 18px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .side__h,
  .side__label {
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .side .props {
    grid-template-columns: 84px 1fr;
    row-gap: 12px;
    align-items: center;
  }
  .side__stack {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .tag--mono {
    font-family: var(--mono);
    font-size: 11.5px;
  }

  .prd__sec {
    padding-top: 8px;
    scroll-margin-top: 72px;
  }
  .prd__sec + .prd__sec {
    margin-top: 48px;
  }
  .prd__sec h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin-bottom: 18px;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }
  .prd__n {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-3px);
  }
  .prd__count {
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--muted);
  }
  .prd__problem {
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--acc);
    border-radius: 4px 12px 12px 4px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-2);
    background: var(--surface);
  }
  .prd__empty {
    color: var(--muted);
  }

  .reqs {
    display: grid;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    overflow: hidden;
  }
  .req {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 4px 12px;
    padding: 14px 16px;
  }
  .req + .req {
    border-top: 1px solid var(--line);
  }
  .req__id {
    padding-top: 3px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .req__txt {
    font-size: 15px;
    line-height: 1.6;
  }
  .req__st {
    grid-column: 2;
  }
  /* phones: the section header already says "N shipped"; only roadmap rows keep a pill */
  @media (max-width: 719px) {
    .reqs:not(.reqs--plan) .req__st {
      display: none;
    }
  }
  .reqs--plan {
    border-style: dashed;
    background: var(--surface-2);
  }

  .arch {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 14.5px;
  }
  .arch thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .arch tbody {
    display: grid;
    gap: 8px;
  }
  .arch tr {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .arch th[scope='row'] {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-align: left;
    text-transform: uppercase;
    color: var(--muted);
  }
  .arch__tech {
    font-weight: 600;
  }
  .arch__why {
    line-height: 1.6;
    color: var(--muted);
  }

  .notes {
    display: grid;
    gap: 12px;
  }
  .enote {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .enote__n {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .enote__t {
    font-size: 16px;
  }
  .enote__b {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pager__a {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
  }
  .pager__a:hover {
    border-color: var(--ink);
  }
  .pager__a--next {
    grid-column: 2;
    text-align: right;
  }
  .pager__dir {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .pager__t {
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .req {
      grid-template-columns: 52px minmax(0, 1fr) auto;
      align-items: start;
    }
    .req__st {
      grid-column: 3;
    }
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .enote:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .arch {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--surface);
      overflow: hidden;
    }
    .arch thead {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      display: table-header-group;
    }
    .arch tbody {
      display: table-row-group;
    }
    .arch tr {
      display: table-row;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
    }
    .arch th,
    .arch td {
      padding: 14px 16px;
      vertical-align: top;
      text-align: left;
      border-top: 1px solid var(--line);
    }
    .arch thead th {
      border-top: 0;
      font-family: var(--mono);
      font-size: 11.5px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
      background: var(--surface-2);
    }
    .arch th[scope='row'] {
      width: 128px;
      padding-top: 16px;
    }
    .arch__tech {
      width: 30%;
    }
  }
  @media (min-width: 1024px) {
    .prd {
      padding: 36px 0 96px;
    }
    .prd__head {
      margin-top: 56px;
      padding-bottom: 44px;
    }
    .prd__grid {
      grid-template-columns: minmax(0, 1fr) 288px;
      gap: 56px;
      margin-top: 44px;
    }
    .prd__side {
      order: 0;
      margin-top: 0;
    }
    .side {
      position: sticky;
      top: 24px;
    }
    .prd__sec {
      scroll-margin-top: 24px;
    }
  }
</style>
