---
// Left rail on desktop; on phones a brand bar whose section tabs stay pinned to the top.
// One <nav> serves both layouts. Case-study pages pass `toc` for an "On this page" group.
import type { Profile } from '../../lib/content';
import { initials, LAB } from './util';

interface Item {
  href: string;
  label: string;
  meta?: string;
}
interface Props {
  profile: Profile;
  items: Item[];
  toc?: Item[];
  current?: string;
}
const { profile, items, toc, current } = Astro.props;
---

<header class="rail" data-has-toc={toc ? '' : undefined}>
  <div class="rail__inner">
    <div class="rail__brand">
      <a class="brand" href={LAB}>
        <span class="brand__av" aria-hidden="true">
          {initials(profile.name)}
        </span>
        <span class="brand__txt">
          <strong>{profile.name}</strong>
          <span>{profile.roleLine}</span>
        </span>
      </a>
      <span class="rail__dir">Direction C</span>
    </div>

    <nav class="rail__nav" aria-label="Site">
      <div class="group group--main">
        <p class="group__label" aria-hidden="true">
          Workspace
        </p>
        <ul class="tabs" role="list">
          {items.map((it, i) => (
            <li>
              <a
                class="navlink"
                href={it.href}
                data-spy={it.href.includes('#') && !toc ? '' : undefined}
                aria-current={current === it.href ? 'page' : undefined}
              >
                <span class="navlink__ix" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="navlink__label">{it.label}</span>
                {it.meta && <span class="navlink__meta">{it.meta}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
      {toc && (
        <div class="group group--toc">
          <p class="group__label" aria-hidden="true">
            On this page
          </p>
          <ul class="tabs" role="list">
            <li class="tabs__back">
              <a class="navlink" href={`${LAB}#projects`}>
                <span class="navlink__label">← All projects</span>
              </a>
            </li>
            {toc.map((it, i) => (
              <li>
                <a class="navlink" href={it.href} data-spy>
                  <span class="navlink__ix" aria-hidden="true">
                    {i + 1}.
                  </span>
                  <span class="navlink__label">{it.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </nav>

    <div class="rail__foot">
      <p class="group__label" aria-hidden="true">
        Elsewhere
      </p>
      <ul role="list">
        {profile.links.map((l) => (
          <li>
            <a href={l.href} class:list={[{ 'is-pending': l.href.startsWith('#') }]}>
              {l.label}
              {l.href.startsWith('#') && <span class="visually-hidden"> (link pending)</span>}
            </a>
          </li>
        ))}
      </ul>
      <p class="rail__lab">Lab · Product Spec · noindex</p>
    </div>
  </div>
</header>

<script>
  // Scroll-spy: mark the section currently in view in the rail / tab strip.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a.navlink[data-spy]')];
  const map = new Map<Element, HTMLAnchorElement>();
  for (const a of links) {
    const id = a.hash.slice(1);
    const el = id && document.getElementById(id);
    if (el) map.set(el, a);
  }
  if (map.size && 'IntersectionObserver' in window) {
    const strip = (a: HTMLAnchorElement) => a.closest<HTMLElement>('.tabs');
    const setActive = (a: HTMLAnchorElement) => {
      for (const l of links) l.removeAttribute('aria-current');
      a.setAttribute('aria-current', 'location');
      const s = strip(a);
      if (s && s.scrollWidth > s.clientWidth) {
        const left = a.offsetLeft - (s.clientWidth - a.offsetWidth) / 2;
        s.scrollTo({ left, behavior: 'auto' });
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        const a = hit && map.get(hit.target);
        if (a) setActive(a);
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    map.forEach((_, el) => io.observe(el));
  }
</script>

<style>
  .rail {
    --brand-h: 60px;
    position: sticky;
    top: calc(var(--brand-h) * -1);
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .rail__brand {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: var(--brand-h);
    padding: 0 var(--gutter);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }
  .brand__av {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--accent-ink);
    background: var(--accent);
  }
  .brand__txt {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .brand__txt strong {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand__txt span {
    overflow: hidden;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .rail__dir {
    flex: none;
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }

  .group__label {
    display: none;
  }
  .tabs {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0 var(--gutter) 8px;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
    scroll-padding-inline: var(--gutter);
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .navlink {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .navlink:hover {
    color: var(--ink);
    background: var(--sunken);
  }
  .navlink[aria-current] {
    color: var(--ink);
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow);
  }
  .navlink__ix,
  .navlink__meta {
    display: none;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  /* phones: case-study pages show the document outline in the strip, not the workspace list */
  .rail[data-has-toc] .group--main {
    display: none;
  }
  .rail__foot {
    display: none;
  }

  @media (min-width: 1024px) {
    .rail {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100dvh;
      background: var(--surface-2);
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .rail__inner {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: 20px 14px 18px;
      overflow-y: auto;
    }
    .rail__brand {
      flex-direction: column;
      align-items: stretch;
      height: auto;
      padding: 4px 8px 22px;
      border-bottom: 1px solid var(--line);
    }
    .brand__av {
      width: 36px;
      height: 36px;
      font-size: 13.5px;
    }
    .brand__txt span {
      white-space: normal;
    }
    .rail__dir {
      display: none;
    }
    .rail__nav {
      display: grid;
      gap: 22px;
      padding-top: 22px;
    }
    .group__label {
      display: block;
      margin: 0 0 6px;
      padding: 0 10px;
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .rail[data-has-toc] .group--main {
      display: block;
    }
    .tabs {
      flex-direction: column;
      gap: 1px;
      padding: 0;
      overflow: visible;
    }
    .tabs__back {
      display: none;
    }
    .navlink {
      min-height: 34px;
      padding: 0 10px;
      white-space: normal;
    }
    .navlink__ix,
    .navlink__meta {
      display: inline;
    }
    .navlink__ix {
      width: 20px;
    }
    .navlink__label {
      flex: 1;
    }
    .navlink[aria-current]::before {
      content: '';
      position: absolute;
      left: -14px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      border-radius: 2px;
      background: var(--accent);
    }
    .rail__foot {
      display: block;
      margin-top: auto;
      padding-top: 18px;
      border-top: 1px solid var(--line);
    }
    .rail__foot ul {
      display: grid;
      gap: 1px;
      padding: 0;
      list-style: none;
    }
    .rail__foot a {
      display: flex;
      align-items: center;
      min-height: 30px;
      padding: 0 10px;
      border-radius: 7px;
      font-size: 13.5px;
      color: var(--ink-2);
      text-decoration: none;
    }
    .rail__foot a::after {
      content: '↗';
      margin-left: auto;
      font-size: 12px;
      color: var(--muted);
    }
    .rail__foot a.is-pending::after {
      content: 'pending';
      font-family: var(--mono);
      font-size: 10.5px;
      color: var(--ph);
    }
    .rail__foot a:hover {
      background: var(--sunken);
    }
    .rail__lab {
      margin-top: 14px;
      padding: 0 10px;
      font-family: var(--mono);
      font-size: 10.5px;
      color: var(--muted);
    }
  }

  @media print {
    .rail {
      display: none;
    }
  }
</style>
