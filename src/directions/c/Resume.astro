---
// Résumé as a roadmap: roles are milestones on a vertical track, capabilities a matrix.
// Prints cleanly on its own (nav and other sections are hidden in print).
import type { SiteContent } from '../../lib/content';
import SectionHead from './SectionHead.astro';
import Pill from './Pill.astro';
import { isPlaceholder } from './util';

interface Props {
  content: SiteContent;
}
const { resume } = Astro.props.content;
const ph = (s: string) => ({ 'is-ph': isPlaceholder(s) });
---

<section id="resume" class="dc-section rz" aria-labelledby="resume-h">
  <div class="dc-wrap">
    <SectionHead
      index="05"
      kicker="Résumé"
      title="Career roadmap"
      id="resume-h"
      count={`${resume.experience.length} milestones`}
    >
      <div class="rz__actions">
        <button type="button" class="rz__print no-print" data-print>
          <span aria-hidden="true">⎙</span> Print or save as PDF
        </button>
        {resume.status === 'placeholder' && <Pill tone="ph" label="Some details pending" />}
      </div>
    </SectionHead>

    <div class="rz__grid">
      <div class="rz__main">
        <p class="rz__summary">{resume.summary}</p>

        <ol class="road" role="list">
          {resume.experience.map((x, i) => {
            const now = /present/i.test(x.end);
            const sameYear = x.start === x.end;
            return (
              <li class:list={['ms', { 'ms--now': now }]}>
                <p class="ms__when">
                  <span class:list={ph(x.start)}>{x.start}</span>
                  {!sameYear && (
                    <>
                      <span class="ms__arrow" aria-hidden="true">
                        →
                      </span>
                      <span class="visually-hidden">to</span>
                      <span class:list={ph(x.end)}>{x.end}</span>
                    </>
                  )}
                </p>
                <span class="ms__node" aria-hidden="true" />
                <div class="ms__card">
                  <div class="ms__head">
                    <h3 class="ms__title">{x.title}</h3>
                    {now && <Pill tone="ok" label="Current" />}
                  </div>
                  <p class="ms__org">{x.org}</p>
                  <ul class:list={['ms__bullets', { 'ms__bullets--lead': i === 0 }]}>
                    {x.bullets.map((b) => (
                      <li class:list={ph(b)}>{b}</li>
                    ))}
                  </ul>
                </div>
              </li>
            );
          })}
        </ol>
      </div>

      <aside class="rz__side" aria-label="Capabilities and education">
        <div class="side-card">
          <h3 class="side-h">Capabilities</h3>
          <dl class="caps">
            {resume.capabilities.map((c) => (
              <div class="caps__row">
                <dt>{c.group}</dt>
                <dd>
                  <ul class="tags">
                    {c.items.map((it) => (
                      <li class="tag">{it}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="side-card">
          <h3 class="side-h">Education</h3>
          <ul class="edu" role="list">
            {resume.education.map((e) => (
              <li>
                <strong class:list={ph(e.school)}>{e.school}</strong>
                <span>{e.detail}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-print]')
    .forEach((b) => b.addEventListener('click', () => window.print()));
</script>

<style>
  .rz__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 4px;
  }
  .rz__print {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink);
    background: var(--surface);
    cursor: pointer;
  }
  .rz__print:hover {
    border-color: var(--ink);
  }
  .rz__grid {
    display: grid;
    gap: 32px;
  }
  .rz__summary {
    max-width: 62ch;
    margin-bottom: 32px;
    padding: 16px 18px;
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
    background: var(--surface);
  }

  .road {
    position: relative;
    display: grid;
    gap: 14px;
    padding: 0;
    list-style: none;
  }
  .road::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 5px;
    width: 2px;
    background: repeating-linear-gradient(to bottom, var(--line-strong) 0 4px, transparent 4px 8px);
  }
  .ms {
    position: relative;
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    grid-template-areas:
      'node when'
      '. card';
    column-gap: 16px;
    row-gap: 6px;
  }
  .ms__when {
    grid-area: when;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .ms__arrow {
    color: var(--line-strong);
  }
  .ms__node {
    grid-area: node;
    align-self: center;
    width: 12px;
    height: 12px;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
  }
  .ms--now .ms__node {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .ms__card {
    grid-area: card;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .ms--now .ms__card {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--line));
  }
  .ms__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
  }
  .ms__title {
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .ms__org {
    margin-top: 2px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  .ms__bullets {
    display: grid;
    gap: 7px;
    margin-top: 12px;
    padding-left: 18px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .ms__bullets li::marker {
    color: var(--muted);
  }

  .rz__side {
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .side-card {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .side-h {
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .caps {
    display: grid;
    gap: 16px;
    margin: 0;
  }
  .caps__row {
    display: grid;
    gap: 8px;
  }
  .caps dt {
    font-size: 14px;
    font-weight: 600;
  }
  .caps dd {
    margin: 0;
  }
  .edu {
    display: grid;
    gap: 10px;
    padding: 0;
    list-style: none;
  }
  .edu li {
    display: grid;
    gap: 2px;
    font-size: 14px;
  }
  .edu span {
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .road::before {
      left: 153px;
    }
    .ms {
      grid-template-columns: 134px 12px minmax(0, 1fr);
      grid-template-areas: 'when node card';
      column-gap: 14px;
    }
    .ms__when {
      justify-content: flex-end;
      align-self: start;
      padding-top: 18px;
      text-align: right;
    }
    .ms__node {
      align-self: start;
      margin-top: 21px;
    }
  }
  @media (min-width: 1100px) {
    .rz__grid {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 40px;
    }
    .rz__side {
      position: sticky;
      top: 24px;
      align-self: start;
    }
  }

  @media print {
    :global(body.dc main > :not(#resume)),
    :global(body.dc > footer) {
      display: none !important;
    }
    .rz {
      padding: 0;
      border: 0;
    }
    .ms__card,
    .side-card,
    .rz__summary {
      box-shadow: none;
      break-inside: avoid;
    }
  }
</style>
