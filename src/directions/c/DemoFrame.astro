---
// Chrome around demos: a phone, a desktop window or a diagram sheet. `pending` renders a
// compact "demo coming" preview with skeleton content instead of a live demo.
interface Props {
  kind: 'phone' | 'desktop' | 'diagram' | 'none';
  label: string;
  pending?: boolean;
}
const { kind, label, pending = false } = Astro.props;
---

{!pending && kind === 'phone' && (
  <figure class="df df--phone">
    <div class="df__device">
      <div class="df__status" aria-hidden="true">
        <span>9:41</span>
        <span class="df__island" />
        <span class="df__sig">
          <i />
          <i />
          <i />
        </span>
      </div>
      <div class="df__screen">
        <slot />
      </div>
      <span class="df__home" aria-hidden="true" />
    </div>
    <figcaption class="df__cap">
      <span class="df__live" aria-hidden="true" />
      {label}
    </figcaption>
  </figure>
)}

{!pending && kind !== 'phone' && (
  <figure class={`df df--${kind}`}>
    <div class="df__window">
      <div class="df__bar" aria-hidden="true">
        <i />
        <i />
        <i />
      </div>
      <div class="df__body">
        <slot />
      </div>
    </div>
    <figcaption class="df__cap">{label}</figcaption>
  </figure>
)}

{pending && (
  <div class={`dfm dfm--${kind}`}>
    <div class="dfm__art" aria-hidden="true">
      {kind === 'phone' && (
        <div class="dfm__phone">
          <span class="sk sk--bar" />
          <span class="sk sk--card" />
          <span class="sk sk--line" />
          <span class="sk sk--line sk--short" />
        </div>
      )}
      {kind === 'desktop' && (
        <div class="dfm__win">
          <div class="dfm__winbar">
            <i />
            <i />
            <i />
          </div>
          <div class="dfm__cal">
            {Array.from({ length: 21 }, (_, i) => (
              <span class:list={['sk', { 'sk--fill': [2, 4, 8, 9, 15, 17].includes(i) }]} />
            ))}
          </div>
        </div>
      )}
      {kind === 'diagram' && (
        <svg viewBox="0 0 240 72" class="dfm__svg">
          <rect x="4" y="22" width="52" height="28" rx="6" />
          <rect x="94" y="22" width="52" height="28" rx="6" class="is-accent" />
          <rect x="184" y="6" width="52" height="24" rx="6" />
          <rect x="184" y="42" width="52" height="24" rx="6" />
          <path d="M56 36h34M146 36c18 0 18-18 34-18M146 36c18 0 18 18 34 18" />
        </svg>
      )}
    </div>
    <p class="dfm__label">
      <span class="pill pill--progress">Demo coming</span>
      <span class="dfm__what">{label}</span>
    </p>
  </div>
)}

<style>
  /* ---------- phone ---------- */
  .df {
    display: grid;
    justify-items: center;
    gap: 14px;
    margin: 0;
  }
  .df__device {
    position: relative;
    width: min(100%, 318px);
    padding: 9px;
    border-radius: 48px;
    background: #101114;
    box-shadow:
      0 0 0 1px #2a2c33,
      inset 0 0 0 1px #2a2c33,
      0 30px 60px -24px rgb(16 17 20 / 0.45),
      0 12px 24px -12px rgb(16 17 20 / 0.3);
  }
  .df__status {
    position: absolute;
    top: 9px;
    left: 9px;
    right: 9px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 34px;
    padding: 0 24px 0 30px;
    font-family: var(--sans);
    font-size: 12.5px;
    font-weight: 600;
    color: #fff;
    pointer-events: none;
  }
  .df__island {
    width: 86px;
    height: 24px;
    border-radius: 14px;
    background: #000;
  }
  .df__sig {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 10px;
  }
  .df__sig i {
    width: 3px;
    border-radius: 1px;
    background: #fff;
  }
  .df__sig i:nth-child(1) {
    height: 5px;
  }
  .df__sig i:nth-child(2) {
    height: 7px;
  }
  .df__sig i:nth-child(3) {
    height: 10px;
  }
  .df__screen {
    height: 640px;
    padding: 34px 0 20px;
    border-radius: 39px;
    overflow: hidden;
    background: linear-gradient(#3d2c5e 0 50%, #fff 50% 100%);
    isolation: isolate;
  }
  .df__screen > :global(*) {
    height: 100%;
  }
  .df__home {
    position: absolute;
    left: 50%;
    bottom: 16px;
    width: 120px;
    height: 4px;
    margin-left: -55px;
    border-radius: 4px;
    background: rgb(0 0 0 / 0.35);
    pointer-events: none;
  }
  .df__cap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .df__live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px var(--ok-soft);
  }

  /* ---------- desktop / diagram ---------- */
  .df__window {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lift);
  }
  .df__bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }
  .df__bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .df--diagram .df__body {
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  /* ---------- pending mini previews ---------- */
  .dfm {
    display: grid;
    grid-template-columns: minmax(0, 150px) minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 10px;
    border: 1px dashed var(--line-strong);
    border-radius: 12px;
    background: var(--surface-2);
  }
  .dfm__art {
    position: relative;
    display: grid;
    place-items: end center;
    height: 92px;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--surface-2);
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1.2px);
    background-size: 14px 14px;
  }
  .dfm__phone {
    display: grid;
    align-content: start;
    gap: 7px;
    gap: 6px;
    width: 84px;
    height: 76px;
    padding: 14px 8px 0;
    border: 4px solid var(--ink);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    background: var(--surface);
  }
  .sk {
    display: block;
    border-radius: 4px;
    background: var(--sunken);
  }
  .sk--bar {
    height: 8px;
    width: 60%;
  }
  .sk--card {
    height: 22px;
    border-radius: 7px;
    background: var(--accent-soft);
  }
  .sk--line {
    height: 6px;
  }
  .sk--short {
    width: 70%;
  }
  .dfm__win {
    width: 84%;
    height: 76px;
    border: 1px solid var(--line-strong);
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    background: var(--surface);
  }
  .dfm__winbar {
    display: flex;
    gap: 4px;
    padding: 7px 8px;
    border-bottom: 1px solid var(--line);
  }
  .dfm__winbar i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dfm__cal {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    padding: 8px;
  }
  .dfm__cal {
    gap: 3px;
    padding: 6px;
  }
  .dfm__cal .sk {
    height: 12px;
  }
  .dfm__cal .sk--fill {
    background: var(--accent-soft);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .dfm--diagram .dfm__art {
    place-items: center;
  }
  .dfm__svg {
    width: 88%;
    height: auto;
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }
  .dfm__svg path {
    fill: none;
    stroke: var(--muted);
    stroke-dasharray: 3 3;
  }
  .dfm__svg .is-accent {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }
  .dfm__label {
    display: grid;
    justify-items: start;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink-2);
  }
</style>
