---
// Contact footer (#contact): profile links as a properties table.
import type { Profile } from '../../lib/content';
import Pill from './Pill.astro';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
const year = new Date().getFullYear();
const pretty = (href: string) =>
  href.startsWith('#')
    ? null
    : href
        .replace(/^mailto:/, '')
        .replace(/^https?:\/\/(www\.)?/, '')
        .replace(/\/$/, '');
---

<footer id="contact" class="foot" aria-labelledby="contact-h">
  <div class="dc-wrap">
    <div class="foot__grid">
      <div class="foot__intro">
        <p class="sec-kicker">
          <b>06</b> · Contact
        </p>
        <h2 id="contact-h">{profile.name}</h2>
        <p class="foot__meta">
          {profile.roleLine}
          <br />
          {profile.location}
        </p>
        {profile.status === 'placeholder' && <Pill tone="ph" label="Links pending" />}
      </div>
      <ul class="foot__links" role="list">
        {profile.links.map((l) => {
          const shown = pretty(l.href);
          return (
            <li>
              <a href={l.href} class="foot__link">
                <span class="foot__label">{l.label}</span>
                {shown ? (
                  <span class="foot__href">{shown}</span>
                ) : (
                  <span class="foot__href is-ph">placeholder — link to come</span>
                )}
                <span class="foot__arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
    <div class="foot__base">
      <span>
        © {year} {profile.name}
      </span>
      <span>Design lab · Direction C — Product Spec</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding: 56px 0 28px;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }
  .foot__grid {
    display: grid;
    gap: 32px;
  }
  .foot__intro {
    display: grid;
    gap: 10px;
    align-content: start;
    justify-items: start;
  }
  .foot__intro h2 {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    letter-spacing: -0.025em;
  }
  .foot__meta {
    color: var(--muted);
    font-size: 15px;
  }
  .foot__links {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .foot__link {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .foot__label {
    font-weight: 600;
  }
  .foot__href {
    overflow: hidden;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .foot__href.is-ph {
    color: var(--ph);
  }
  .foot__arrow {
    color: var(--muted);
    transition: transform 0.15s ease;
  }
  .foot__link:hover .foot__label {
    color: var(--accent);
  }
  .foot__link:hover .foot__arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    margin-top: 48px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (min-width: 1024px) {
    .foot {
      padding: 88px 0 32px;
    }
    .foot__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 56px;
    }
    .foot__link {
      grid-template-columns: 140px minmax(0, 1fr) auto;
      min-height: 68px;
    }
  }
</style>
