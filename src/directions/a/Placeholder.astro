---
// Small, tasteful marker for entries with `status: placeholder` (owner copy pending).
interface Props {
  label?: string;
}
const { label = 'Placeholder' } = Astro.props;
---

<span class="ph" title="Placeholder — final copy to come from the owner">
  <span class="dot" aria-hidden="true"></span>
  {label}
</span>

<style>
  .ph {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.65em 0.22em;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 0.6875rem;
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    vertical-align: middle;
    white-space: nowrap;
    color: var(--muted);
  }
  .dot {
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
