---
// Slot: DemoFrame — the chrome around demos: a phone, a desktop window or a diagram plate.
// With `pending`, it renders an empty frame with a "demo in production" note instead of a demo.
interface Props {
  frame: 'phone' | 'desktop' | 'diagram' | 'none';
  pending?: boolean;
  /** Short label shown in desktop title bars / diagram plates. */
  label?: string;
  size?: 'full' | 'small';
}
const { frame, pending = false, label = '', size = 'full' } = Astro.props;
const kind = frame === 'none' ? 'diagram' : frame;
---

<div class:list={['frame', kind, size, { pending }]}>
  {kind === 'phone' && (
    <div class="phone-body">
      <span class="speaker" aria-hidden="true" />
      <div class="screen">
        {pending ? (
          <div class="pending-note">
            <span class="ghost" aria-hidden="true" />
            <span class="ghost short" aria-hidden="true" />
            <span class="ghost block" aria-hidden="true" />
            <span class="note">Interactive demo in production</span>
          </div>
        ) : (
          <slot />
        )}
      </div>
    </div>
  )}
  {kind === 'desktop' && (
    <div class="window">
      <div class="titlebar" aria-hidden="true">
        <span class="lights">
          <i />
          <i />
          <i />
        </span>
        <span class="t">{label}</span>
      </div>
      <div class="pane">
        {pending ? (
          <div class="pending-note">
            <span class="cols" aria-hidden="true">
              {Array.from({ length: 7 }, () => (
                <i />
              ))}
            </span>
            <span class="note">Interactive demo in production</span>
          </div>
        ) : (
          <slot />
        )}
      </div>
    </div>
  )}
  {kind === 'diagram' && (
    <div class="plate">
      <span class="plate-label" aria-hidden="true">
        {label}
      </span>
      {pending ? (
        <div class="pending-note">
          <span class="flow" aria-hidden="true">
            <i />
            <b />
            <i />
            <b />
            <i />
          </span>
          <span class="note">Interactive diagram in production</span>
        </div>
      ) : (
        <slot />
      )}
    </div>
  )}
</div>

<style>
  .frame {
    --frame-ink: var(--ink);
    margin-inline: auto;
  }
  .note {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: var(--muted);
  }

  /* ——— phone ——— */
  .phone {
    width: min(100%, 340px);
  }
  .phone.small {
    width: min(100%, 210px);
  }
  .phone-body {
    position: relative;
    padding: 12px;
    border-radius: 48px;
    background: #0d0c0b;
    box-shadow:
      inset 0 0 0 1.5px #3b3631,
      inset 0 0 0 4px #0d0c0b,
      inset 0 0 0 5px #2a2622,
      0 50px 80px -30px rgb(0 0 0 / 0.55),
      0 18px 30px -18px rgb(0 0 0 / 0.5);
  }
  .small .phone-body {
    padding: 8px;
    border-radius: 32px;
  }
  .speaker {
    position: absolute;
    top: 20px;
    left: 50%;
    z-index: 2;
    width: 84px;
    height: 22px;
    border-radius: 999px;
    background: #0d0c0b;
    transform: translateX(-50%);
  }
  .small .speaker {
    top: 14px;
    width: 52px;
    height: 14px;
  }
  .screen {
    overflow: hidden;
    height: 660px;
    padding-top: 30px;
    border-radius: 37px;
    background: #f6f3fb;
  }
  .screen :global(.sky-app) {
    height: 100%;
    min-height: 0;
  }
  .small .screen {
    height: 380px;
    padding-top: 0;
    border-radius: 25px;
    background: var(--paper);
  }

  /* ——— desktop window ——— */
  .desktop {
    width: 100%;
  }
  .window {
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper);
    box-shadow: 0 30px 50px -34px rgb(0 0 0 / 0.45);
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 30px;
    padding: 0 12px;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .lights {
    display: inline-flex;
    gap: 6px;
  }
  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--muted);
  }
  .t {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .pane {
    min-height: 200px;
  }

  /* ——— diagram plate ——— */
  .diagram {
    width: 100%;
  }
  .plate {
    position: relative;
    padding: 1rem;
    border: 1px solid var(--rule);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -1px -1px;
  }
  .plate-label {
    position: absolute;
    top: 0.6rem;
    left: 0.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  /* ——— pending skeletons ——— */
  .pending-note {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 12px;
    height: 100%;
    padding: 2.5rem 1rem 1.25rem;
  }
  .phone .pending-note {
    padding-inline: 18px;
  }
  .ghost {
    height: 10px;
    border-radius: 6px;
    background: var(--rule);
  }
  .ghost.short {
    width: 60%;
  }
  .ghost.block {
    height: 110px;
    margin-bottom: 0.75rem;
    border-radius: 14px;
    background: repeating-linear-gradient(
      135deg,
      var(--paper-2) 0 8px,
      color-mix(in srgb, var(--rule) 55%, var(--paper-2)) 8px 9px
    );
    border: 1px solid var(--rule);
  }
  .desktop .pending-note {
    min-height: 200px;
    padding: 1rem;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    height: 120px;
  }
  .cols i {
    border-radius: 4px;
    border: 1px solid var(--rule);
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 14px,
      color-mix(in srgb, var(--rule) 70%, transparent) 14px 26px
    );
  }
  .diagram .pending-note {
    min-height: 200px;
    padding: 2rem 0.5rem 0.5rem;
  }
  .flow {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .flow i {
    flex: 0 0 auto;
    width: 46px;
    height: 34px;
    border: 1.5px solid var(--ink-2);
    border-radius: 6px;
    background: var(--paper);
  }
  .flow b {
    flex: 1 1 auto;
    max-width: 48px;
    height: 1.5px;
    background: var(--ink-2);
  }
</style>
