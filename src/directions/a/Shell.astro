---
// Page shell for direction A: shared Base layout + fonts + tokens + masthead nav + footer.
import Base from '../../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import type { Profile } from '../../lib/content';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter';
import './styles.css';

interface Props {
  title: string;
  description?: string;
  profile: Profile;
  /** Prefix for in-page section links: '' on the home page, '/lab/a/' elsewhere. */
  base?: string;
}
const { title, description, profile, base = '' } = Astro.props;
---

<Base title={title} description={description} noindex bodyClass="dir-a">
  <Fragment slot="header">
    <Nav name={profile.name} base={base} />
  </Fragment>
  <slot />
  <Fragment slot="footer">
    <Footer profile={profile} />
  </Fragment>
</Base>
