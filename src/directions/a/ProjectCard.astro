---
// Slot: ProjectCard — `feature` is a tall magazine card with an accent plate;
// `index` is a table-of-contents row. Both link to the case study.
import type { Project } from '../../lib/content';
import Placeholder from './Placeholder.astro';

interface Props {
  project: Project;
  variant?: 'feature' | 'index';
  num?: number;
}
const { project, variant = 'feature', num = 1 } = Astro.props;
const p = project.data;
const href = `/lab/a/${project.id}/`;
const stackHint = p.stack
  .slice(0, 3)
  .map((s) => s.tech)
  .join(' · ');
const cat = { app: 'App', game: 'Game', tool: 'Tool' }[p.category];
const hid = `proj-${project.id}`;
---

{variant === 'feature' ? (
  <article class="feature reveal" style={`--acc: ${p.accent}`} aria-labelledby={hid}>
    <div class="art" aria-hidden="true">
      <span class="art-cat">{cat}</span>
      <span class="art-title">{p.title}</span>
      <span class="art-no">{String(num).padStart(2, '0')}</span>
    </div>
    <div class="text">
      <p class="eyebrow">
        {cat} · {p.year}
        {p.status === 'placeholder' && <Placeholder />}
      </p>
      <h3 id={hid}>
        <a href={href} class="stretch">
          {p.title}
        </a>
      </h3>
      <p class="tagline">{p.tagline}</p>
      <dl class="facts">
        <div>
          <dt>Platforms</dt>
          <dd>{p.platforms.join(' · ')}</dd>
        </div>
        <div>
          <dt>Built with</dt>
          <dd>{stackHint}</dd>
        </div>
      </dl>
      <span class="more" aria-hidden="true">
        Read the case study <span class="arrow">→</span>
      </span>
    </div>
  </article>
) : (
  <article class="row" style={`--acc: ${p.accent}`} aria-labelledby={hid}>
    <span class="row-no" aria-hidden="true">
      {String(num).padStart(2, '0')}
    </span>
    <div class="row-main">
      <h3 id={hid}>
        <a href={href} class="stretch">
          {p.title}
        </a>
      </h3>
      <p class="row-tag">{p.tagline}</p>
    </div>
    <p class="row-meta">
      <span class="swatch" aria-hidden="true" />
      {cat} · {p.year} · {p.platforms.join(', ')}
      <span class="row-stack">{stackHint}</span>
    </p>
    <span class="arrow" aria-hidden="true">
      →
    </span>
  </article>
)}

<style>
  .stretch {
    text-decoration: none;
  }
  .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .stretch:focus-visible {
    outline: none;
  }
  .stretch:focus-visible::after {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  /* ——— feature ——— */
  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .art {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 16 / 10;
    padding: 1.1rem 1.25rem 1.25rem;
    overflow: hidden;
    color: #fff;
    background:
      repeating-linear-gradient(-60deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 14px),
      radial-gradient(circle at 85% 15%, rgb(255 255 255 / 0.18), transparent 45%),
      linear-gradient(160deg, var(--acc), color-mix(in srgb, var(--acc) 55%, #000));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
  }
  .art-cat {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .art-title {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 2rem + 2.2vw, 3.75rem);
    font-style: italic;
    font-weight: 330;
    font-variation-settings: 'opsz' 144;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .art-no {
    position: absolute;
    top: 0.9rem;
    right: 1.1rem;
    font-family: var(--serif);
    font-size: 1rem;
    font-style: italic;
  }
  .text {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 1.1rem;
  }
  .text .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  h3 {
    font-size: var(--step-2);
    font-weight: 420;
    font-variation-settings: 'opsz' 72;
    line-height: 1.1;
  }
  .tagline {
    margin-top: 0.5rem;
    font-family: var(--serif);
    font-size: 1.1875rem;
    font-style: italic;
    font-variation-settings: 'opsz' 24;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .facts {
    display: grid;
    gap: 0.5rem;
    margin: 1.25rem 0 1.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .facts div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.75rem;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    color: var(--ink-2);
  }
  .more {
    margin-top: auto;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform 0.3s ease;
  }
  .feature:hover .art {
    transform: translateY(-4px);
  }
  .feature:hover .arrow,
  .row:hover .arrow {
    transform: translateX(4px);
  }
  .feature:hover h3 a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--accent);
  }

  @media (min-width: 48rem) {
    .art {
      aspect-ratio: 4 / 3.4;
    }
  }

  /* ——— index row ——— */
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    grid-template-areas:
      'no main arrow'
      'no meta arrow';
    gap: 0.35rem 1rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--rule);
  }
  .row-no {
    grid-area: no;
    padding-top: 0.35rem;
    font-family: var(--serif);
    font-size: 1rem;
    font-style: italic;
    color: var(--accent);
  }
  .row-main {
    grid-area: main;
  }
  .row h3 {
    font-size: var(--step-2);
    font-weight: 400;
  }
  .row-tag {
    margin-top: 0.3rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .row-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .row-stack {
    flex-basis: 100%;
  }
  .swatch {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--acc);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.25);
  }
  .row .arrow {
    grid-area: arrow;
    align-self: center;
    font-size: 1.5rem;
  }
  .row:hover h3 a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--accent);
  }
  @media (min-width: 56rem) {
    .row {
      grid-template-columns: 3rem minmax(0, 6fr) minmax(0, 4fr) 2rem;
      grid-template-areas: 'no main meta arrow';
      align-items: baseline;
      gap: 2rem;
      padding: 1.75rem 0;
    }
    .row-meta {
      align-self: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feature:hover .art {
      transform: none;
    }
  }
</style>
