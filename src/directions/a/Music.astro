---
// Slot: Music — story intro, a tracklist with gradient "covers", and per-song lyric sheets
// with annotations (margin notes beside the line on desktop, an inline card on mobile).
// Streaming players are click-to-load only: nothing third-party loads with the page.
import type { Song } from '../../lib/content';
import ChapterHead from './ChapterHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  songs: Song[];
}
const { songs } = Astro.props;
const first = songs[0]?.data;
const years = [...new Set(songs.map((s) => s.data.year))].join('–');
const anyPlaceholder = songs.some((s) => s.data.status === 'placeholder');
const pad = (n: number) => String(n).padStart(2, '0');

function spotifyEmbed(url?: string) {
  if (!url) return undefined;
  try {
    const u = new URL(url);
    if (!u.hostname.endsWith('spotify.com')) return undefined;
    return `https://open.spotify.com/embed${u.pathname}`;
  } catch {
    return undefined;
  }
}
function youtubeEmbed(url?: string) {
  if (!url) return undefined;
  try {
    const u = new URL(url);
    const id = u.hostname.includes('youtu.be') ? u.pathname.slice(1) : u.searchParams.get('v');
    return id ? `https://www.youtube-nocookie.com/embed/${id}` : undefined;
  } catch {
    return undefined;
  }
}
---

<section id="music" class="music" aria-labelledby="music-h">
  <ChapterHead num="03" label="Side project" title="Music" headingId="music-h">
    {first && (
      <p>
        Songs from {years}, {first.credits.charAt(0).toLowerCase() + first.credits.slice(1)} and
        published on streaming services. {anyPlaceholder && <Placeholder />}
      </p>
    )}
  </ChapterHead>

  <div class="wrap">
    <ol class="tracklist" aria-label="Tracklist">
      {songs.map((s, i) => (
        <li>
          <a href={`#song-${s.id}`} class="track">
            <span
              class="cover"
              aria-hidden="true"
              style={`--c1: ${s.data.artColors[0]}; --c2: ${s.data.artColors[1]}`}
            />
            <span class="track-no">{pad(i + 1)}</span>
            <span class="track-title">{s.data.title}</span>
            <span class="track-year">{s.data.year}</span>
          </a>
        </li>
      ))}
    </ol>

    {songs.map((s, i) => {
      const d = s.data;
      const spotify = spotifyEmbed(d.spotify);
      const youtube = youtubeEmbed(d.youtube);
      const hid = `song-${s.id}-h`;
      return (
        <article id={`song-${s.id}`} class="song" aria-labelledby={hid}>
          <div class="song-main">
            <header class="song-head">
              <p class="eyebrow">
                <span class="nowrap">
                  Track {pad(i + 1)} · {d.year}
                </span>
                {d.status === 'placeholder' && <Placeholder />}
              </p>
              <h3 id={hid}>{d.title}</h3>
              <p class="credits">{d.credits}</p>
            </header>
            <div class="song-body">
              <h4 class="eyebrow sub">What it's about</h4>
              <p class="meaning">{d.meaning}</p>

              <h4 class="eyebrow sub">Lyrics</h4>
              <p class="hint">
                <span class="hint-mark" aria-hidden="true">
                  Aa
                </span>
                Highlighted lines carry an annotation — select one to read it.
              </p>
              <div class="sheet" data-annotator>
                {d.lyrics.map((l, j) => {
                  const nid = `note-${s.id}-${j}`;
                  return (
                    <div class:list={['ly', { 'has-section': !!l.section }]}>
                      {l.section && <span class="section">{l.section}</span>}
                      {l.note ? (
                        <button
                          type="button"
                          class="line annotated"
                          aria-expanded="false"
                          aria-controls={nid}
                        >
                          {l.line}
                        </button>
                      ) : (
                        <span class="line">{l.line}</span>
                      )}
                      {l.note && (
                        <div class="note-wrap">
                          <div
                            class="note"
                            id={nid}
                            role="region"
                            aria-label={`Annotation: ${l.line}`}
                            tabindex="-1"
                          >
                            <p class="note-q">“{l.line}”</p>
                            <p class="note-body">{l.note}</p>
                            <button type="button" class="note-close" data-close>
                              Close<span class="visually-hidden"> annotation</span>
                            </button>
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
          <div class="song-side">
            <div
              class="cover big"
              aria-hidden="true"
              style={`--c1: ${d.artColors[0]}; --c2: ${d.artColors[1]}`}
            >
              <span class="disc" />
            </div>
            <div class="listen no-print">
              <h4 class="eyebrow">Listen</h4>
              {[
                { name: 'Spotify', url: d.spotify, embed: spotify, h: 152 },
                { name: 'YouTube', url: d.youtube, embed: youtube, h: 0 },
              ].map((p) => (
                <div class="player" data-embed={p.embed} data-title={`${p.name}: ${d.title}`}>
                  {p.embed ? (
                    <>
                      <button type="button" class="btn" data-load data-h={p.h}>
                        <span class="play" aria-hidden="true" />
                        Load {p.name} player
                      </button>
                      <a class="fallback" href={p.url}>
                        Open on {p.name}
                      </a>
                    </>
                  ) : (
                    <button type="button" class="btn" disabled>
                      <span class="play" aria-hidden="true" />
                      {p.name} — link coming
                    </button>
                  )}
                  <div class="embed-slot" />
                </div>
              ))}
              <p class="privacy">
                Players load only when you ask — no third-party requests before.
              </p>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script>
  // Lyrics annotator: one open note per sheet; focus moves into the note and back on close.
  document.documentElement.classList.add('a-js');
  document.querySelectorAll<HTMLElement>('[data-annotator]').forEach((sheet) => {
    const lines = [...sheet.querySelectorAll<HTMLButtonElement>('button.annotated')];
    const noteFor = (b: HTMLButtonElement) =>
      document.getElementById(b.getAttribute('aria-controls')!)!;
    const close = (b: HTMLButtonElement, restore = false) => {
      b.setAttribute('aria-expanded', 'false');
      noteFor(b).closest('.note-wrap')!.classList.remove('open');
      if (restore) b.focus();
    };
    lines.forEach((b) => {
      const note = noteFor(b);
      b.addEventListener('click', () => {
        const wasOpen = b.getAttribute('aria-expanded') === 'true';
        lines.forEach((o) => o.getAttribute('aria-expanded') === 'true' && close(o));
        if (wasOpen) return;
        b.setAttribute('aria-expanded', 'true');
        note.closest('.note-wrap')!.classList.add('open');
        note.focus({ preventScroll: true });
        if (window.matchMedia('(max-width: 55.99rem)').matches) {
          note.scrollIntoView({ block: 'nearest' });
        }
      });
      note.querySelector('[data-close]')!.addEventListener('click', () => close(b, true));
      note.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          close(b, true);
        }
      });
    });
  });

  // Click-to-load streaming players.
  document.querySelectorAll<HTMLElement>('.player[data-embed]').forEach((player) => {
    const btn = player.querySelector<HTMLButtonElement>('[data-load]');
    btn?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = player.dataset.embed!;
      frame.title = player.dataset.title ?? 'Music player';
      frame.loading = 'lazy';
      frame.allow = 'encrypted-media; picture-in-picture';
      const h = Number(btn.dataset.h);
      frame.style.cssText = `width:100%;border:0;border-radius:12px;${h ? `height:${h}px` : 'aspect-ratio:16/9'}`;
      player.querySelector('.embed-slot')!.replaceChildren(frame);
      btn.remove();
      frame.focus();
    });
  });
</script>

<style>
  .tracklist {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0;
    padding: 0;
  }
  .track {
    display: grid;
    grid-template-columns: 3.5rem 1.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .track:hover .track-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .cover {
    display: block;
    aspect-ratio: 1;
    background:
      radial-gradient(circle at 30% 25%, rgb(255 255 255 / 0.28), transparent 45%),
      repeating-radial-gradient(circle at 50% 50%, rgb(0 0 0 / 0.07) 0 1px, transparent 1px 5px),
      linear-gradient(135deg, var(--c1), var(--c2));
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.08);
  }
  .track-no {
    font-family: var(--serif);
    font-style: italic;
    color: var(--accent);
  }
  .track-title {
    font-family: var(--serif);
    font-size: 1.375rem;
    font-variation-settings: 'opsz' 36;
  }
  .track-year {
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 56rem) {
    .tracklist {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
    .track {
      grid-template-columns: 4.5rem 1.75rem minmax(0, 1fr) auto;
      padding: 0 0 0.9rem;
    }
  }

  .song {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    grid-template-areas:
      'cover head'
      'body body'
      'listen listen';
    gap: 1.75rem 1.25rem;
    margin-top: clamp(4rem, 9vw, 7.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 2px solid var(--rule-strong);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .song-main,
  .song-side {
    display: contents;
  }
  .song-head {
    grid-area: head;
    align-self: end;
  }
  .song-body {
    grid-area: body;
  }
  .song > .song-side > .cover {
    grid-area: cover;
  }
  .listen {
    grid-area: listen;
  }
  .cover.big {
    position: relative;
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.55);
  }
  .disc {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    box-shadow:
      0 0 0 6px rgb(0 0 0 / 0.12),
      inset 0 0 0 2px rgb(0 0 0 / 0.1);
    transform: translate(-50%, -50%);
  }
  .listen {
    display: grid;
    gap: 0.6rem;
  }
  .listen h4 {
    margin: 0;
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.6;
  }
  .listen .btn {
    width: 100%;
    justify-content: flex-start;
    font-size: 0.875rem;
  }
  .listen .btn:disabled {
    cursor: not-allowed;
    border-style: dashed;
    color: var(--muted);
  }
  .listen .btn:disabled:hover {
    background: transparent;
    border-color: currentColor;
  }
  .play {
    width: 0;
    height: 0;
    border-left: 8px solid currentColor;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }
  .fallback {
    font-size: 0.875rem;
  }
  :global(.a-js) .fallback {
    display: none;
  }
  .privacy {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .nowrap {
    white-space: nowrap;
  }
  .song-head .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }
  h3 {
    margin-top: 0.5rem;
    font-size: var(--step-4);
    font-weight: 350;
    font-style: italic;
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.03em;
  }
  .credits {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: var(--muted);
  }
  .sub {
    margin: 2.25rem 0 0.75rem;
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.6;
  }
  .song-body > .sub:first-child {
    margin-top: 0;
  }
  .meaning {
    max-width: var(--measure);
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 350;
    font-variation-settings: 'opsz' 24;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .hint {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .hint-mark {
    padding: 0 0.35em;
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  /* ——— lyric sheet ——— */
  .sheet {
    position: relative;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-variation-settings: 'opsz' 36;
    line-height: 1.5;
  }
  .ly.has-section {
    margin-top: 1.25em;
  }
  .ly.has-section:first-child {
    margin-top: 0;
  }
  .section {
    display: block;
    margin-bottom: 0.2em;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .line {
    display: inline;
    padding: 0.05em 0.15em;
    margin-left: -0.15em;
  }
  button.line {
    font: inherit;
    text-align: left;
    color: inherit;
    border: 0;
    border-radius: 2px;
    cursor: pointer;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    box-shadow: inset 0 -2px 0 color-mix(in srgb, var(--accent) 70%, transparent);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-color 0.2s ease;
    min-height: 24px;
  }
  button.line:hover {
    background: color-mix(in srgb, var(--accent) 26%, transparent);
  }
  button.line[aria-expanded='true'] {
    color: var(--paper);
    background: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .note-wrap {
    margin: 0.6rem 0 0.9rem;
  }
  :global(.a-js) .note-wrap:not(.open) {
    display: none;
  }
  .note {
    position: relative;
    padding: 1rem 1.1rem 0.9rem;
    border-left: 3px solid var(--accent);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.55;
    background: var(--paper-2);
  }
  .note:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .note-q {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .note-body {
    margin-top: 0.4rem;
    color: var(--ink);
  }
  .note-close {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    margin-top: 0.6rem;
    padding: 0 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font: 600 0.8125rem/1 var(--sans);
    color: var(--ink);
    background: var(--paper);
    cursor: pointer;
  }
  .note-close:hover {
    border-color: var(--ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .note-wrap.open .note {
      animation: a-note 0.28s cubic-bezier(0.2, 0.7, 0.1, 1);
    }
    @keyframes a-note {
      from {
        transform: translateY(6px);
      }
    }
  }

  @media (min-width: 56rem) {
    .song {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      grid-template-areas: none;
      gap: 2rem;
    }
    .song-side {
      display: block;
      grid-column: 1;
      grid-row: 1;
    }
    .song-main {
      display: block;
      grid-column: 2;
      grid-row: 1;
    }
    .song-body {
      margin-top: 0.5rem;
    }
    .listen {
      margin-top: 1.75rem;
    }
    .sheet {
      padding-bottom: 4rem;
    }
    .ly {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 2.5rem;
    }
    .ly > .section,
    .ly > .line {
      grid-column: 1;
      justify-self: start;
    }
    .note-wrap {
      grid-column: 2;
      grid-row: 1;
      height: 0;
      margin: 0;
      overflow: visible;
      position: relative;
      z-index: 2;
    }
    .has-section .note-wrap {
      grid-row: 2;
    }
    .note {
      box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.4);
    }
  }
</style>
