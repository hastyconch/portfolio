---
// A squircle app icon. Purely decorative: callers always pair it with a visible text label.
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon: IconName;
  /** Base colour; the light end of the gradient is derived from it unless `from` is given. */
  color: string;
  from?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}
const { icon, color, from, size = 'md', class: cls } = Astro.props;
const glyph = { sm: 14, md: 26, lg: 30, xl: 50 }[size];
const style = `--app-a:${from ?? `color-mix(in oklab, ${color} 62%, white)`};--app-b:${color}`;
---

<span class:list={['app-icon', `app-icon--${size}`, cls]} style={style} aria-hidden="true">
  <Icon name={icon} size={glyph} stroke={1.9} />
</span>
