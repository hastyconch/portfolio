---
// CaseStudyLayout slot: the project opened as a maximised app window on the desktop (a full-
// screen app on phones). Problem, features, roadmap (clearly "On the roadmap"), stack table
// (layer · tech · why) and engineering notes.
import type { Project } from '../../lib/content';
import Icon from './Icon.astro';
import AppIcon from './AppIcon.astro';
import Placeholder from './Placeholder.astro';
import { LAB_BASE, projectIcon } from './apps';

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}
const { project, prev, next } = Astro.props;
const d = project.data;
---

<article class="cs" style={`--accent:${d.accent}`} aria-labelledby="cs-title">
  <div class="cs-bar">
    <div class="win-ctl">
      <a class="win-close" href={`${LAB_BASE}#projects`}>
        <span class="win-close-dot" aria-hidden="true"></span>
        <Icon name="chevron" size={22} stroke={2.2} class="win-back-chev" />
        <span class="win-close-txt">Projects</span>
        <span class="visually-hidden">, close {d.title}</span>
      </a>
      <span class="win-dot win-dot--min" aria-hidden="true"></span>
      <span class="win-dot win-dot--zoom" aria-hidden="true"></span>
    </div>
    <p class="cs-bar-title">
      <AppIcon icon={projectIcon(d.demo)} color={d.accent} size="sm" />
      <span>{d.title}</span>
    </p>
    <span class="win-meta">case study</span>
  </div>

  <header class="cs-hero">
    <AppIcon icon={projectIcon(d.demo)} color={d.accent} size="xl" class="cs-icon" />
    <div class="cs-hero-text">
      <p class="cs-kicker">
        <span class="pcard-cat">{d.category}</span>
        <span>{d.year}</span>
        <span aria-hidden="true">·</span>
        <span>{d.platforms.join(' · ')}</span>
        <Placeholder status={d.status} />
      </p>
      <h1 id="cs-title" class="cs-title">
        {d.title}
      </h1>
      <p class="cs-tagline">{d.tagline}</p>
    </div>
  </header>

  <div class="cs-grid">
    <div class="cs-main">
      <section class="cs-sec" aria-labelledby="cs-problem">
        <h2 id="cs-problem" class="cs-h">
          Why I built it
        </h2>
        <p class="cs-problem">{d.problem}</p>
      </section>

      <section class="cs-sec" aria-labelledby="cs-features">
        <h2 id="cs-features" class="cs-h">
          What it does
        </h2>
        <ul class="ticks ticks--lg">
          {d.features.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </section>
    </div>

    <aside class="cs-side" aria-label="Project info">
      <dl class="cs-info">
        <div>
          <dt>Category</dt>
          <dd>{d.category}</dd>
        </div>
        <div>
          <dt>Year</dt>
          <dd>{d.year}</dd>
        </div>
        <div>
          <dt>Platforms</dt>
          <dd>{d.platforms.join(', ')}</dd>
        </div>
        <div>
          <dt>Layers</dt>
          <dd>{d.stack.length}</dd>
        </div>
      </dl>
      {d.planned.length > 0 && (
        <section class="cs-roadmap" aria-labelledby="cs-roadmap-h">
          <h2 id="cs-roadmap-h" class="cs-roadmap-h">
            <Icon name="flag" size={16} stroke={2.2} /> On the roadmap
          </h2>
          <ul>
            {d.planned.map((p) => (
              <li>
                <span class="roadmap-chip roadmap-chip--sm">Planned</span> {p}
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>

  <section class="cs-sec cs-stack" aria-labelledby="cs-stack-h">
    <h2 id="cs-stack-h" class="cs-h">
      Stack
    </h2>
    <!-- Explicit roles keep table semantics when phones restyle rows as cards. -->
    <table class="cs-table" role="table" aria-labelledby="cs-stack-h">
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">
            Layer
          </th>
          <th scope="col" role="columnheader">
            Tech
          </th>
          <th scope="col" role="columnheader">
            Why
          </th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {d.stack.map((s) => (
          <tr role="row">
            <th scope="row" role="rowheader">
              {s.layer}
            </th>
            <td class="cs-tech" role="cell">
              {s.tech}
            </td>
            <td class="cs-why" role="cell">
              {s.why}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="cs-sec" aria-labelledby="cs-eng-h">
    <h2 id="cs-eng-h" class="cs-h">
      Engineering notes
    </h2>
    <ul class="cs-notes">
      {d.engineering.map((n, i) => (
        <li class="cs-note">
          <span class="cs-note-n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="cs-note-h">{n.title}</h3>
          <p>{n.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <nav class="cs-pager" aria-label="More projects">
    {prev && (
      <a class="cs-page cs-page--prev" href={`${LAB_BASE}${prev.id}/`}>
        <span class="cs-page-k">Previous app</span>
        <span class="cs-page-t">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a class="cs-page cs-page--next" href={`${LAB_BASE}${next.id}/`}>
        <span class="cs-page-k">Next app</span>
        <span class="cs-page-t">{next.data.title}</span>
      </a>
    )}
  </nav>
</article>
