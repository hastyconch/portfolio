---
// Renders one glyph from icons.ts. Always decorative — the accessible name lives on the
// control or label next to it.
import { ICON_PATHS, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 20, stroke = 1.75, class: cls } = Astro.props;
---

<svg
  class:list={['b-icon', cls]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICON_PATHS[name]}
/>
