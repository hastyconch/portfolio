---
// DemoFrame slot: the chrome around a demo — a phone, a mini desktop window or a diagram board.
// With no slotted demo it renders the "demo coming" state (labelled as planned, per art. 7).
import Icon from './Icon.astro';

interface Props {
  frame: 'phone' | 'desktop' | 'diagram' | 'none';
  /** What the demo is, e.g. the engagement title. Used for the caption. */
  label: string;
  coming?: boolean;
}
const { frame, label, coming = false } = Astro.props;
const kind = frame === 'none' ? 'diagram' : frame;
const comingText = {
  phone: 'Interactive phone demo',
  desktop: 'Interactive desktop demo',
  diagram: 'Interactive diagram',
}[kind];
---

<figure class:list={['demo', `demo--${kind}`, { 'demo--coming': coming }]}>
  <div class="demo-device">
    {kind === 'phone' && <span class="demo-speaker" aria-hidden="true" />}
    {kind === 'desktop' && (
      <span class="demo-chrome" aria-hidden="true">
        <i />
        <i />
        <i />
      </span>
    )}
    <div class="demo-screen">
      {coming ? (
        <div class="demo-soon">
          <span class="demo-soon-glyph" aria-hidden="true">
            <Icon name="sparkle" size={22} />
          </span>
          <span class="demo-soon-title">{comingText}</span>
          <span class="roadmap-chip">
            <Icon name="flag" size={13} stroke={2.2} />
            On the roadmap
          </span>
        </div>
      ) : (
        <slot />
      )}
    </div>
  </div>
  <figcaption class="demo-cap">
    {coming ? 'Demo planned' : 'Live demo · mock data'} — {label}
  </figcaption>
</figure>
