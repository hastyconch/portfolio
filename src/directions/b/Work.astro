---
// Work slot: a two-pane "Finder" window — engagements in the sidebar, detail on the right.
// The airline engagement embeds the live phone demo; other demos show a "planned" frame.
import type { Work } from '../../lib/content';
import AirlineDemo from '../../demos/airline/AirlineDemo';
import Window from './Window.astro';
import DemoFrame from './DemoFrame.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  work: Work[];
}
const { work } = Astro.props;
---

<Window id="work" meta={`${work.length} engagements`} bodyLabel="Professional work">
  <div class="work-layout">
    <nav class="work-side" aria-label="Engagements">
      <p class="side-h" aria-hidden="true">
        Engagements
      </p>
      <ol>
        {work.map((e) => (
          <li>
            <a href={`#w-${e.id}`}>
              <span class="side-sector">{e.data.sector}</span>
              <span class="side-title">{e.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="work-list">
      {work.map((e, i) => (
        <article id={`w-${e.id}`} class="job" aria-labelledby={`w-${e.id}-h`}>
          <header class="job-head">
            <p class="job-meta">
              <span class="job-num">{String(i + 1).padStart(2, '0')}</span>
              <span>{e.data.sector}</span>
              <span aria-hidden="true">·</span>
              <span>{e.data.years}</span>
              <span aria-hidden="true">·</span>
              <span>{e.data.role}</span>
              <Placeholder status={e.data.status} />
            </p>
            <h3 id={`w-${e.id}-h`} class="job-title">
              {e.data.title}
            </h3>
            <p class="job-kicker">{e.data.kicker}</p>
          </header>
          <div class:list={['job-grid', { 'job-grid--demo': e.data.demo !== 'none' }]}>
            <div class="job-text">
              <p class="job-summary">{e.data.summary}</p>
              <h4 class="job-sub">What I did</h4>
              <ul class="ticks">
                {e.data.contributions.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
              {e.data.outcomes.length > 0 && (
                <>
                  <h4 class="job-sub">Outcomes</h4>
                  <ul class="ticks">
                    {e.data.outcomes.map((o) => (
                      <li>{o}</li>
                    ))}
                  </ul>
                </>
              )}
              <ul class="tags" aria-label="Skills">
                {e.data.skills.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
            {e.data.demo === 'airline' ? (
              <DemoFrame frame={e.data.demoFrame} label={e.data.title}>
                <AirlineDemo client:visible />
              </DemoFrame>
            ) : e.data.demo !== 'none' ? (
              <DemoFrame frame={e.data.demoFrame} label={e.data.title} coming />
            ) : null}
          </div>
        </article>
      ))}
    </div>
  </div>
</Window>
