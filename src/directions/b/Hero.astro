---
// Hero slot: the desktop itself. On phones it is the lock-screen-style widget at the top of the
// home screen; on desktop it is type set straight onto the wallpaper with pillar widgets.
import type { Profile } from '../../lib/content';
import Icon from './Icon.astro';
import type { IconName } from './icons';
import Placeholder from './Placeholder.astro';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
const pillarIcons: IconName[] = ['chart', 'sparkle', 'code'];
---

<section id="hero" class="hero" aria-labelledby="hero-name" data-bg>
  <div class="hero-main">
    <p class="hero-role">
      <span class="hero-pulse" aria-hidden="true"></span>
      {profile.roleLine}
    </p>
    <h1 id="hero-name" class="hero-name">
      {profile.name}
    </h1>
    <p class="hero-headline">{profile.headline}</p>
    <p class="hero-intro">{profile.intro}</p>
    <div class="hero-actions">
      <a class="btn btn--primary" href="#work" data-open="work">
        <Icon name="work" size={18} />
        Open Work
      </a>
      <a class="btn" href="#projects" data-open="projects">
        <Icon name="projects" size={18} />
        Browse projects
      </a>
    </div>
    <p class="hero-loc">
      <Icon name="pin" size={16} />
      {profile.location}
      <Placeholder status={profile.status} />
    </p>
  </div>
  <ul class="pillars" aria-label="What I do">
    {profile.pillars.map((p, i) => (
      <li class="widget pillar">
        <span class="pillar-glyph">
          <Icon name={pillarIcons[i % pillarIcons.length]} size={18} stroke={2} />
        </span>
        <h2 class="pillar-title">{p.title}</h2>
        <p class="pillar-body">{p.body}</p>
      </li>
    ))}
  </ul>
</section>
