---
// ProjectCard slot: an app tile in the Projects window — icon, name, tagline, category,
// platforms and a hint of the stack. The whole card opens the project's case-study window.
import type { Project } from '../../lib/content';
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import { LAB_BASE, projectIcon } from './apps';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const d = project.data;
const stackHint = d.stack
  .slice(0, 3)
  .map((s) => s.tech.split(' · ')[0].replace(/\s*\(.*\)$/, ''))
  .filter((t, i, all) => all.indexOf(t) === i);
---

<article class:list={['pcard', { 'pcard--featured': d.featured }]} style={`--accent:${d.accent}`}>
  <AppIcon icon={projectIcon(d.demo)} color={d.accent} size="lg" />
  <div class="pcard-body">
    <p class="pcard-meta">
      <span class="pcard-cat">{d.category}</span>
      <span>{d.platforms.join(' · ')}</span>
      <Placeholder status={d.status} />
    </p>
    <h3 class="pcard-title">
      <a class="pcard-link" href={`${LAB_BASE}${project.id}/`}>
        {d.title}
      </a>
    </h3>
    <p class="pcard-tag">{d.tagline}</p>
    <p class="pcard-stack">
      <span class="visually-hidden">Built with </span>
      {stackHint.map((t) => (
        <span>{t}</span>
      ))}
    </p>
  </div>
  <span class="pcard-go" aria-hidden="true">
    <Icon name="arrow" size={18} stroke={2} />
  </span>
</article>
