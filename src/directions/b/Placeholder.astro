---
// Visible marker for content whose status is `placeholder` (owner input pending).
interface Props {
  status: 'ready' | 'placeholder';
  label?: string;
}
const { status, label = 'Placeholder' } = Astro.props;
---

{status === 'placeholder' && (
  <span class="ph-chip" title="Owner copy pending">
    {label}
  </span>
)}
