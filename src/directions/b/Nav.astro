---
// Nav slot (part 1 of 2, see Dock.astro): a menu bar across the top on desktop that becomes a
// slim status bar on phones. Plain links: on the home page they target section ids (opened as
// windows by wm.ts, or by :target without JS); on case-study pages they lead back home.
import Icon from './Icon.astro';
import { APPS, LAB_BASE } from './apps';

interface Props {
  name: string;
  location: string;
  /** '' on the home page, LAB_BASE elsewhere. */
  base?: string;
}
const { name, location, base = '' } = Astro.props;
const dockApps = APPS.filter((a) => a.id !== 'hero');
const href = (id: string) => `${base}#${id}`;
---

<header class="menubar" data-bg>
  <a class="mb-brand" href={base ? LAB_BASE : '#hero'}>
    <span class="mb-logo" aria-hidden="true"></span>
    <span class="mb-name">{name}</span>
    <span class="visually-hidden"> — home</span>
  </a>
  <nav class="mb-nav" aria-label="Main">
    <ul>
      {dockApps.map((a) => (
        <li>
          <a href={href(a.id)} data-app={a.id}>
            {a.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p class="mb-status">
    <span class="mb-loc">
      <Icon name="pin" size={14} stroke={2} />
      {location}
    </span>
    <time class="mb-clock" data-clock></time>
  </p>
</header>
