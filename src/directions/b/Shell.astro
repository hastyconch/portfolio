---
// Page shell for direction B: Base layout + fonts/tokens, menu bar, dock and the window manager.
import Base from '../../layouts/Base.astro';
import Nav from './Nav.astro';
import Dock from './Dock.astro';
import type { Profile } from '../../lib/content';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import './b.css';

interface Props {
  title: string;
  description?: string;
  profile: Profile;
  /** '' on the home page; LAB_BASE on case-study pages. */
  base?: string;
  bodyClass?: string;
}
const { title, description, profile, base = '', bodyClass } = Astro.props;
---

<Base title={title} description={description} noindex bodyClass={`dos ${bodyClass ?? ''}`.trim()}>
  <Fragment slot="head">
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="theme-color" content="#ece7f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f1e" media="(prefers-color-scheme: dark)" />
  </Fragment>
  <Fragment slot="header">
    <div class="wallpaper" aria-hidden="true"></div>
    <Nav name={profile.name} location={profile.location} base={base} />
  </Fragment>
  <slot />
  <Fragment slot="footer">
    <Dock base={base} />
  </Fragment>
</Base>

<script>
  import './wm';
</script>
