---
// Footer/contact slot — the outro and the back-cover fine print.
import type { Profile } from '../../lib/content';
import Placeholder from './Placeholder.astro';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
const external = (href: string) => /^https?:/.test(href);
// Deterministic "barcode" from the name, purely decorative.
const bars = [...`${profile.name}${profile.location}`].map((c) => (c.charCodeAt(0) % 4) + 1);
---

<footer id="contact" class="ft ln-dark" data-np="Outro · Contact" aria-labelledby="contact-h">
  <div class="ln-wrap">
    <p class="ln-eyebrow ft-k">Outro · Contact</p>
    <h2 id="contact-h" class="ft-title">
      Thanks for listening.
    </h2>
    <ul class="ft-links">
      {profile.links.map((l, i) => (
        <li>
          <a href={l.href} rel={external(l.href) ? 'noopener' : undefined}>
            <span class="ft-n ln-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="ft-label">{l.label}</span>
            <span class="ft-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))}
    </ul>
    {profile.status === 'placeholder' && <Placeholder label="Some links to come" />}

    <div class="ft-fine">
      <p>
        <span>℗ {profile.name}</span>
        <span>{profile.location}</span>
        <span>Design lab · direction D, Liner Notes</span>
      </p>
      <span class="ft-barcode" aria-hidden="true">
        {bars.map((w) => (
          <span style={`width:${w}px`} />
        ))}
      </span>
    </div>
  </div>
</footer>

<style>
  .ft {
    padding-block: clamp(4.5rem, 10vw, 8rem) 2.5rem;
    border-top: 1px solid var(--ln-rule);
    background:
      radial-gradient(60% 80% at 100% 0%, rgb(255 122 69 / 0.16), transparent 70%), var(--ln-bg);
    scroll-margin-top: var(--ln-header);
  }
  .ft-k {
    color: var(--ln-accent);
  }
  body.ln .ft-title {
    margin-top: 0.75rem;
    font-size: clamp(2.8rem, 10vw, 8.5rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }
  .ft-links {
    margin: clamp(2rem, 5vw, 3.5rem) 0 1.5rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ln-rule);
  }
  .ft-links a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--ln-rule);
    text-decoration: none;
  }
  .ft-n {
    font-size: 0.8125rem;
    color: var(--ln-ink-3);
  }
  .ft-label {
    font-family: var(--ln-display);
    font-size: clamp(1.5rem, 3.5vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .ft-arrow {
    font-size: 1.4rem;
    color: var(--ln-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ft-arrow {
      transition: transform 0.25s ease;
    }
    .ft-links a:hover .ft-arrow {
      transform: translate(4px, -4px);
    }
  }
  .ft-links a:hover .ft-label {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .ft-fine {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--ln-rule);
    font-size: 0.8125rem;
    color: var(--ln-ink-3);
  }
  .ft-fine p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
  }
  .ft-barcode {
    display: flex;
    gap: 2px;
    height: 34px;
    padding: 4px 6px;
    background: #f4ece1;
    border-radius: 2px;
  }
  .ft-barcode span {
    background: #1a1411;
  }
</style>
