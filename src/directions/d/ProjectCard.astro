---
// ProjectCard slot: a record in the crate. Album art is generated from the project accent;
// the motif changes with category (app · game · tool). Whole card links to the case study.
import type { Project } from '../../lib/content';
import Placeholder from './Placeholder.astro';

interface Props {
  project: Project;
  n: string;
}
const { project, n } = Astro.props;
const d = project.data;
const stackHint = d.stack
  .slice(0, 3)
  .map((s) => s.tech.split(/\s[·(]/)[0].trim())
  .join(' · ');
---

<li class="pc" style={`--art: ${d.accent}`}>
  <div class:list={['pc-art', `pc-art-${d.category}`]} aria-hidden="true">
    <span class="pc-art-disc ln-vinyl"></span>
    <span class="pc-art-n">{n}</span>
    <span class="pc-art-word">{d.title}</span>
  </div>
  <div class="pc-body">
    <p class="pc-k">
      <span class="ln-num">{n}</span>
      <span>{d.category}</span>
      {d.featured && <span class="pc-feat">Featured</span>}
      {d.status === 'placeholder' && <Placeholder />}
    </p>
    <h3 class="pc-title">
      <a class="pc-link" href={`/lab/d/${project.id}/`}>
        {d.title}
      </a>
    </h3>
    <p class="pc-tag">{d.tagline}</p>
    <p class="pc-meta">
      <span>{d.platforms.join(' · ')}</span>
      <span class="ln-num">{d.year}</span>
    </p>
    <p class="pc-stack">
      <span class="visually-hidden">Stack: </span>
      {stackHint}
    </p>
  </div>
</li>

<style>
  .pc {
    position: relative;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--ln-rule);
  }
  .pc:has(.pc-link:focus-visible) {
    outline: 3px solid var(--ln-accent);
    outline-offset: 4px;
    border-radius: 8px;
  }
  .pc-link {
    text-decoration: none;
  }
  .pc-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  body.ln .pc-link:focus-visible {
    outline: none;
  }
  .pc:hover .pc-link {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* Album art */
  .pc-art {
    position: relative;
    aspect-ratio: 1;
    border-radius: 4px;
    overflow: hidden;
    container-type: inline-size;
    color: #fff;
    background:
      var(--ln-grain),
      radial-gradient(
        90% 70% at 20% 10%,
        color-mix(in oklab, var(--art) 55%, #fff) 0,
        transparent 60%
      ),
      linear-gradient(160deg, var(--art), color-mix(in oklab, var(--art) 30%, #000));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.2) inset,
      0 14px 30px -14px rgb(0 0 0 / 0.6);
  }
  .pc-art::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.45;
    mix-blend-mode: soft-light;
  }
  .pc-art-app::before {
    background: repeating-radial-gradient(circle at 100% 100%, #fff 0 1px, transparent 1.5px 9cqi);
  }
  .pc-art-game::before {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.5) 1px, transparent 1px) 0 0 / 12.5cqi 12.5cqi,
      linear-gradient(rgb(255 255 255 / 0.5) 1px, transparent 1px) 0 0 / 12.5cqi 12.5cqi;
  }
  .pc-art-tool::before {
    background: repeating-linear-gradient(
      -45deg,
      rgb(255 255 255 / 0.55) 0 1px,
      transparent 1px 7cqi
    );
  }
  .pc-art-disc {
    position: absolute;
    width: 62%;
    right: -24%;
    bottom: -24%;
    --ln-label: color-mix(in oklab, var(--art) 60%, #fff);
  }
  .pc-art-n {
    position: absolute;
    top: 7cqi;
    left: 8cqi;
    font-family: var(--ln-display);
    font-size: max(0.625rem, 7cqi);
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .pc-art-word {
    position: absolute;
    z-index: 1;
    left: 7cqi;
    right: 30cqi;
    bottom: 9cqi;
    font-family: var(--ln-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 15cqi;
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-wrap: balance;
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.25);
  }

  /* Body */
  .pc-body {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }
  .pc-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-height: 1.4rem;

    gap: 0.3rem 0.6rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .pc-feat {
    padding: 0.1em 0.55em;
    border-radius: 999px;
    background: var(--ln-accent);
    color: var(--ln-accent-ink);
    letter-spacing: 0.08em;
  }
  body.ln .pc-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .pc-tag {
    font-size: 0.9375rem;
    color: var(--ln-ink-2);
    line-height: 1.45;
  }
  .pc-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: var(--ln-ink-3);
  }
  .pc-stack {
    display: none;
    font-size: 0.8125rem;
    color: var(--ln-ink-3);
  }

  /* Desktop: a sleeve in the horizontal rail */
  @media (min-width: 900px) {
    .pc {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      padding: 0;
      border-bottom: 0;
      width: 300px;
      flex: none;
      scroll-snap-align: start;
    }
    .pc-art {
      border-radius: 6px;
    }
    @media (prefers-reduced-motion: no-preference) {
      .pc-art {
        transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
      }
      .pc-art-disc {
        transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.1, 1);
      }
      .pc:hover .pc-art,
      .pc:focus-within .pc-art {
        transform: translateY(-6px);
      }
      .pc:hover .pc-art-disc,
      .pc:focus-within .pc-art-disc {
        transform: translate(-14%, -14%) rotate(40deg);
      }
    }
    body.ln .pc-title {
      font-size: 1.5rem;
    }
    .pc-stack {
      display: block;
      padding-top: 0.6rem;
      margin-top: 0.35rem;
      border-top: 1px solid var(--ln-rule);
    }
  }
</style>
