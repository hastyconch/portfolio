---
// Music slot — Bonus tracks, the showcase of this direction. Songs are a tablist of sleeves;
// each song panel has art, credits, a click-to-load player slot and a Genius-style lyrics
// annotator. Annotated lines are <details>/<summary> (native keyboard + no-JS); the script adds
// focus management (note receives focus, Esc/Close return it) and desktop gutter alignment.
import type { Song } from '../../lib/content';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  songs: Song[];
}
const { songs } = Astro.props;

type Line = Song['data']['lyrics'][number];
function stanzas(lines: Line[]) {
  const out: { section?: string; lines: Line[] }[] = [];
  for (const l of lines) {
    if (l.section || out.length === 0) out.push({ section: l.section, lines: [] });
    out[out.length - 1].lines.push(l);
  }
  return out;
}
function spotifyEmbed(u?: string) {
  const m = u?.match(/open\.spotify\.com\/(track|album|playlist)\/([A-Za-z0-9]+)/);
  return m ? `https://open.spotify.com/embed/${m[1]}/${m[2]}` : undefined;
}
function youtubeEmbed(u?: string) {
  const m = u?.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
  return m ? `https://www.youtube-nocookie.com/embed/${m[1]}` : undefined;
}
const years = [...new Set(songs.map((s) => s.data.year))].sort();
const credits = [...new Set(songs.map((s) => s.data.credits))];
const pad = (n: number) => String(n).padStart(2, '0');
const first = songs[0]?.data.artColors ?? ['#3b1f5e', '#e07a5f'];
const anyPlaceholder = songs.some((s) => s.data.status === 'placeholder');
---

<section
  id="music"
  class="ln-side music ln-dark"
  data-np="Bonus tracks · Music"
  aria-labelledby="music-h"
  style={`--c1: ${first[0]}; --c2: ${first[1]}`}
>
  <div class="mu-glow" aria-hidden="true"></div>
  <div class="ln-wrap mu-wrap">
    <SideHead
      badge="+"
      kicker="Bonus tracks"
      title="Music"
      id="music-h"
      meta={`${songs.length} songs · ${years.join(' – ')}`}
    />

    <div class="mu-story">
      <p class="mu-story-lead">{credits.join(' · ')}</p>
      <ul class="mu-story-facts">
        <li>
          <span class="ln-eyebrow">Since</span> <span class="ln-num">{years[0]}</span>
        </li>
        <li>
          <span class="ln-eyebrow">Songs</span> <span class="ln-num">{songs.length}</span>
        </li>
        <li>
          <span class="ln-eyebrow">Released</span> on streaming
        </li>
        {anyPlaceholder && (
          <li>
            <Placeholder label="Story & lyrics to come" />
          </li>
        )}
      </ul>
    </div>

    <div class="mu-tabs" role="tablist" aria-label="Songs">
      {songs.map((s, i) => (
        <button
          type="button"
          role="tab"
          class="mu-tab"
          id={`mu-tab-${s.id}`}
          aria-controls={`mu-panel-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-c1={s.data.artColors[0]}
          data-c2={s.data.artColors[1]}
          style={`--c1: ${s.data.artColors[0]}; --c2: ${s.data.artColors[1]}`}
        >
          <span class="mu-tab-art" aria-hidden="true">
            <span class="ln-num">{pad(i + 1)}</span>
          </span>
          <span class="mu-tab-text">
            <span class="mu-tab-k">Bonus {i + 1}</span>
            <span class="mu-tab-t">{s.data.title}</span>
            <span class="mu-tab-y ln-num">{s.data.year}</span>
          </span>
        </button>
      ))}
    </div>

    {songs.map((s, i) => {
      const d = s.data;
      const notes = d.lyrics.filter((l) => l.note).length;
      const players = [
        { key: 'spotify', name: 'Spotify', url: d.spotify, embed: spotifyEmbed(d.spotify) },
        { key: 'youtube', name: 'YouTube', url: d.youtube, embed: youtubeEmbed(d.youtube) },
      ];
      let lineNo = 0;
      return (
        <div
          class="mu-panel"
          role="tabpanel"
          id={`mu-panel-${s.id}`}
          aria-labelledby={`mu-tab-${s.id}`}
          hidden={i !== 0}
          style={`--c1: ${d.artColors[0]}; --c2: ${d.artColors[1]}`}
        >
          <div class="mu-head">
            <div class="mu-art-wrap" aria-hidden="true">
              <span class="mu-vinyl ln-vinyl" />
              <div class="mu-art">
                <span class="mu-art-n ln-num">{pad(i + 1)}</span>
                <span class="mu-art-t">{d.title}</span>
                <span class="mu-art-y ln-num">{d.year}</span>
              </div>
            </div>
            <div class="mu-info">
              <p class="mu-k">
                <span class="ln-eyebrow">
                  Bonus track {i + 1} · {d.year}
                </span>
                {d.status === 'placeholder' && <Placeholder />}
              </p>
              <h3 class="mu-title">{d.title}</h3>
              <p class="mu-credits">{d.credits}</p>
              <div class="mu-about">
                <h4 class="mu-h">About this song</h4>
                <p>{d.meaning}</p>
              </div>
              <ul class="mu-players" aria-label="Listen">
                {players.map((p) => (
                  <li class="mu-player" data-player>
                    {p.url && p.embed ? (
                      <>
                        <button
                          type="button"
                          class="mu-play"
                          data-src={p.embed}
                          data-kind={p.key}
                          data-title={`${d.title} on ${p.name}`}
                        >
                          <span class="mu-play-ico" aria-hidden="true" />
                          <span class="mu-play-text">
                            <strong>Play on {p.name}</strong>
                            <small>Loads the {p.name} player</small>
                          </span>
                        </button>
                        <a class="mu-play-link" href={p.url} rel="noopener">
                          Open on {p.name}
                        </a>
                      </>
                    ) : (
                      <p class="mu-play is-soon">
                        <span class="mu-play-ico" aria-hidden="true" />
                        <span class="mu-play-text">
                          <strong>{p.name}</strong>
                          <small>Link coming — player loads on click</small>
                        </span>
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mu-lyrics">
            <div class="mu-lyr-head">
              <h4 class="mu-h">Lyrics</h4>
              <p class="mu-legend">
                <span class="mu-swatch" aria-hidden="true" />
                {notes} annotated {notes === 1 ? 'line' : 'lines'} — select one to read the note
              </p>
            </div>
            <div class="mu-lyr-grid" data-lyrics>
              <div class="mu-lyr-col">
                {stanzas(d.lyrics).map((st) => (
                  <div class="ly-stanza">
                    {st.section && <p class="ly-sec">[{st.section}]</p>}
                    {st.lines.map((l) => {
                      lineNo += 1;
                      return l.note ? (
                        <details class="ly-d" name={`notes-${s.id}`}>
                          <summary class="ly-s">
                            <span class="ly-hl">{l.line}</span>
                            <span class="visually-hidden"> — annotated line</span>
                          </summary>
                          <div
                            class="ly-note"
                            role="group"
                            tabindex="-1"
                            aria-label={`Annotation: ${l.line}`}
                            id={`note-${s.id}-${lineNo}`}
                          >
                            <p class="ly-note-k">
                              <span class="ly-note-disc" aria-hidden="true" />
                              Liner note
                            </p>
                            <p class="ly-note-q">“{l.line}”</p>
                            <p class="ly-note-t">{l.note}</p>
                            <button type="button" class="ly-close" data-close>
                              Close note <kbd>Esc</kbd>
                            </button>
                          </div>
                        </details>
                      ) : (
                        <p class="ly-line">{l.line}</p>
                      );
                    })}
                  </div>
                ))}
              </div>
              <div class="mu-gutter">
                <p class="mu-gutter-hint">
                  <span class="mu-gutter-ico" aria-hidden="true" />
                  Highlighted lines carry notes from the studio. Select one and its annotation opens
                  here.
                </p>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  const root = document.getElementById('music');
  if (root) {
    // Tabs (automatic activation, roving tabindex)
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      root.style.setProperty('--c1', tab.dataset.c1 ?? '');
      root.style.setProperty('--c2', tab.dataset.c2 ?? '');
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let next = -1;
        if (k === 'ArrowRight' || k === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft' || k === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') next = 0;
        else if (k === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });

    // Lyrics annotator
    const wide = matchMedia('(min-width: 900px)');
    const place = (d: HTMLDetailsElement) => {
      const note = d.querySelector<HTMLElement>('.ly-note');
      const grid = d.closest<HTMLElement>('[data-lyrics]');
      if (!note || !grid) return;
      note.style.removeProperty('--shift');
      if (!wide.matches) return;
      const over = note.getBoundingClientRect().bottom - grid.getBoundingClientRect().bottom;
      if (over > 0) note.style.setProperty('--shift', `${-over}px`);
    };
    root.querySelectorAll<HTMLDetailsElement>('details.ly-d').forEach((d) => {
      const summary = d.querySelector<HTMLElement>('summary');
      const note = d.querySelector<HTMLElement>('.ly-note');
      d.addEventListener('toggle', () => {
        if (!d.open) return;
        place(d);
        note?.focus({ preventScroll: true });
        note?.scrollIntoView({ block: 'nearest' });
      });
      const close = () => {
        d.open = false;
        summary?.focus();
      };
      d.querySelector('[data-close]')?.addEventListener('click', close);
      d.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && d.open) {
          e.preventDefault();
          close();
        }
      });
    });

    // Click-to-load players: nothing third-party loads until the visitor asks.
    root.querySelectorAll<HTMLButtonElement>('.mu-play[data-src]').forEach((b) => {
      b.addEventListener('click', () => {
        const f = document.createElement('iframe');
        f.src = b.dataset.src ?? '';
        f.title = b.dataset.title ?? 'Music player';
        f.className = `mu-frame mu-frame-${b.dataset.kind}`;
        f.allow = 'encrypted-media; picture-in-picture; fullscreen';
        f.loading = 'lazy';
        b.replaceWith(f);
        f.focus();
      });
    });
  }
</script>

<style>
  .music {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: #0a0908;
    border-block: 1px solid #2a2522;
  }
  .mu-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        42% 26% at 16% 40%,
        color-mix(in srgb, var(--c1) 80%, transparent),
        transparent 72%
      ),
      radial-gradient(
        26% 16% at 26% 36%,
        color-mix(in srgb, var(--c2) 22%, transparent),
        transparent 70%
      );
    filter: blur(20px);
    opacity: 0.8;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mu-glow {
      transition: background 0.6s ease;
    }
  }

  /* Story plate */
  .mu-story {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 52rem;
  }
  .mu-story-lead {
    font-family: var(--ln-display);
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    font-weight: 600;
    font-stretch: 88%;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .mu-story-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ln-ink-2);
  }
  .mu-story-facts .ln-eyebrow {
    margin-right: 0.35rem;
  }

  /* Song tabs */
  .mu-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .mu-tab {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 0.5rem;
    border: 1px solid var(--ln-rule);
    border-radius: 10px;
    background: transparent;
    color: var(--ln-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .mu-tab:hover {
    background: var(--ln-hl);
  }
  .mu-tab[aria-selected='true'] {
    border-color: var(--ln-ink);
    background: var(--ln-bg-3);
    box-shadow: inset 0 -3px 0 var(--ln-accent);
  }
  .mu-tab-art {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 1;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    background:
      repeating-linear-gradient(var(--c1) 0 12%, transparent 12% 26%) 0 52% / 100% 22% no-repeat,
      radial-gradient(circle at 64% 40%, var(--c2) 0 25%, transparent 25.4%),
      linear-gradient(
        172deg,
        color-mix(in oklab, var(--c1) 88%, #fff) 0%,
        var(--c1) 42%,
        color-mix(in oklab, var(--c1) 45%, #000) 100%
      );
    color: #fff;
    font-family: var(--ln-display);
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1;
  }
  .mu-tab-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .mu-tab-k {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ln-accent);
  }
  .mu-tab-t {
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.15;
  }
  .mu-tab-y {
    font-size: 0.75rem;
    color: var(--ln-ink-3);
  }

  /* Song head */
  .mu-head {
    display: grid;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .mu-art-wrap {
    position: relative;
    width: min(100%, 340px);
  }
  .mu-vinyl {
    position: absolute;
    top: 5%;
    right: -2%;
    width: 80%;
    --ln-label: var(--c2);
  }
  .mu-art {
    position: relative;
    width: 82%;
    aspect-ratio: 1;
    container-type: inline-size;
    border-radius: 4px;
    overflow: hidden;
    color: #fff;
    background:
      var(--ln-grain),
      repeating-linear-gradient(var(--c1) 0 12%, transparent 12% 26%) 0 52% / 100% 22% no-repeat,
      radial-gradient(circle at 64% 40%, var(--c2) 0 25%, transparent 25.4%),
      radial-gradient(
        circle at 64% 40%,
        color-mix(in srgb, var(--c2) 45%, transparent) 0,
        transparent 48%
      ),
      linear-gradient(
        172deg,
        color-mix(in oklab, var(--c1) 88%, #fff) 0%,
        var(--c1) 42%,
        color-mix(in oklab, var(--c1) 45%, #000) 100%
      );
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.2) inset,
      0 30px 60px -24px rgb(0 0 0 / 0.7);
  }
  .mu-art-n {
    position: absolute;
    top: 7cqi;
    left: 8cqi;
    font-family: var(--ln-display);
    font-weight: 800;
    font-size: 11cqi;
    line-height: 1;
  }
  .mu-art-t {
    position: absolute;
    left: 8cqi;
    right: 8cqi;
    bottom: 13cqi;
    font-family: var(--ln-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 15cqi;
    line-height: 0.88;
    letter-spacing: -0.02em;
  }
  .mu-art-y {
    position: absolute;
    left: 8cqi;
    bottom: 6cqi;
    font-size: 4.5cqi;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mu-panel:not([hidden]) .mu-vinyl {
      animation: mu-out 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    }
  }
  @keyframes mu-out {
    from {
      transform: translateX(-18%) rotate(-60deg);
    }
  }

  .mu-info {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    min-width: 0;
  }
  .mu-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
  }
  .mu-k .ln-eyebrow {
    color: var(--ln-accent);
  }
  body.ln .mu-title {
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .mu-credits {
    font-size: 1.0625rem;
    color: var(--ln-ink-2);
  }
  body.ln .mu-h {
    font-family: var(--ln-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .mu-about {
    display: grid;
    gap: 0.4rem;
    max-width: 36em;
    margin-top: 0.4rem;
    padding: 1.1rem 1.2rem;
    border-left: 3px solid var(--ln-accent);
    background: rgb(255 255 255 / 0.04);
  }
  .mu-about p {
    color: var(--ln-ink-2);
  }

  /* Players */
  .mu-players {
    display: grid;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .mu-player {
    display: grid;
    gap: 0.35rem;
  }
  .mu-play {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    min-height: 60px;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    border: 1px solid var(--ln-rule);
    border-radius: 999px;
    background: var(--ln-bg-2);
    color: var(--ln-ink);
    font: inherit;
    text-align: left;
  }
  button.mu-play {
    cursor: pointer;
  }
  button.mu-play:hover {
    border-color: var(--ln-ink);
  }
  .mu-play.is-soon {
    border-style: dashed;
    background: transparent;
  }
  .mu-play-ico {
    position: relative;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--ln-ink);
  }
  .mu-play-ico::after {
    content: '';
    position: absolute;
    left: 16px;
    top: 13px;
    border-left: 13px solid var(--ln-bg);
    border-block: 8px solid transparent;
  }
  .is-soon .mu-play-ico {
    background: var(--ln-bg-3);
    box-shadow: inset 0 0 0 1px var(--ln-rule);
  }
  .is-soon .mu-play-ico::after {
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    border: 0;
    border-radius: 50%;
    background: var(--ln-ink-3);
    box-shadow:
      -8px 0 0 var(--ln-ink-3),
      8px 0 0 var(--ln-ink-3);
    transform: translate(-50%, -50%);
  }

  .mu-play-text {
    display: grid;
    line-height: 1.25;
  }
  .mu-play-text strong {
    font-weight: 700;
  }
  .mu-play-text small {
    font-size: 0.8125rem;
    color: var(--ln-ink-3);
  }
  .mu-play-link {
    justify-self: start;
    padding: 0.25rem 1rem;
    font-size: 0.875rem;
    color: var(--ln-ink-2);
  }
  .mu-player :global(.mu-frame) {
    width: 100%;
    border: 0;
    border-radius: 12px;
  }
  .mu-player :global(.mu-frame-spotify) {
    height: 152px;
  }
  .mu-player :global(.mu-frame-youtube) {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  /* Lyrics */
  .mu-lyr-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-bottom: 1rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--ln-rule);
  }
  .mu-legend {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--ln-ink-2);
  }
  .mu-swatch {
    width: 1.6rem;
    height: 0.9rem;
    border-radius: 2px;
    background: var(--ln-hl);
    box-shadow: inset 0 -2px 0 var(--ln-accent);
  }
  .mu-lyr-grid {
    position: relative;
  }
  .mu-gutter {
    display: none;
  }
  .ly-stanza {
    margin-bottom: 1.75rem;
  }
  .ly-sec {
    margin-bottom: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ln-ink-3);
  }
  .ly-line,
  .ly-s {
    font-family: var(--ln-display);
    font-size: clamp(1.2rem, 2.3vw, 1.55rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.005em;
    padding-block: 0.12rem;
  }
  .ly-s {
    display: block;
    width: fit-content;
    max-width: 100%;
    list-style: none;
    cursor: pointer;
    border-radius: 3px;
  }
