---
// Work slot — Side A. A tracklist; the track with a live demo plays as a full spread,
// the rest open like liner notes (details/summary: keyboard and no-JS friendly).
import type { Work } from '../../lib/content';
import AirlineDemo from '../../demos/airline/AirlineDemo.tsx';
import DemoFrame from './DemoFrame.astro';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  work: Work[];
}
const { work } = Astro.props;
const labels = [...new Set(work.map((w) => w.data.years))];
const meta = `${work.length} tracks · ${labels.join(' / ')}`;
---

<section
  id="work"
  class="ln-side work"
  data-np="Side A · Professional work"
  aria-labelledby="work-h"
>
  <div class="ln-wrap">
    <SideHead badge="A" kicker="Side A" title="Professional work" id="work-h" meta={meta} />

    <ol class="tl">
      {work.map((w, i) => {
        const d = w.data;
        const n = `A${i + 1}`;
        const ph = d.status === 'placeholder';
        if (d.demo === 'airline') {
          return (
            <li class="feat">
              <div class="feat-text">
                <p class="feat-k">
                  <span class="feat-n ln-num">{n}</span>
                  <span class="ln-eyebrow">
                    {d.sector} · {d.role}
                  </span>
                  {ph && <Placeholder />}
                </p>
                <h3 class="feat-title">{d.title}</h3>
                <p class="feat-kicker">{d.kicker}</p>
                <p class="feat-summary">{d.summary}</p>
                <h4 class="tl-h">What I did</h4>
                <ul class="tl-list">
                  {d.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                {d.outcomes.length > 0 && (
                  <>
                    <h4 class="tl-h">Outcomes</h4>
                    <ul class="tl-list">
                      {d.outcomes.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  </>
                )}
                <p class="tl-personnel">
                  <span class="ln-eyebrow">Personnel</span> {d.skills.join(' · ')}
                </p>
                <p class="tl-label">℗ {d.years}</p>
              </div>
              <div class="feat-demo">
                <DemoFrame frame={d.demoFrame} caption="Playable demo · invented brand, mock data">
                  <AirlineDemo client:visible />
                </DemoFrame>
              </div>
            </li>
          );
        }
        return (
          <li class="tl-row">
            <details class="tl-d">
              <summary class="tl-s">
                <span class="tl-n ln-num">{n}</span>
                <span class="tl-t">
                  <span class="tl-title">{d.title}</span>
                  <span class="tl-kick">{d.kicker}</span>
                </span>
                <span class="tl-meta">
                  <span class="tl-sector">{d.sector}</span>
                  {d.demo !== 'none' && <span class="tl-tag">Demo coming</span>}
                  {ph && <Placeholder />}
                </span>
                <span class="tl-chev" aria-hidden="true" />
              </summary>
              <div class="tl-body">
                <div class="tl-notes">
                  <p class="ln-eyebrow">{d.role}</p>
                  <p class="tl-summary">{d.summary}</p>
                  <h3 class="tl-h">What I did</h3>
                  <ul class="tl-list">
                    {d.contributions.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                  {d.outcomes.length > 0 && (
                    <>
                      <h3 class="tl-h">Outcomes</h3>
                      <ul class="tl-list tl-outcomes">
                        {d.outcomes.map((o) => (
                          <li>{o}</li>
                        ))}
                      </ul>
                    </>
                  )}
                  <p class="tl-personnel">
                    <span class="ln-eyebrow">Personnel</span> {d.skills.join(' · ')}
                  </p>
                  <p class="tl-label">℗ {d.years}</p>
                </div>
                {d.demo !== 'none' && (
                  <div class="tl-demo">
                    <DemoFrame frame={d.demoFrame} coming size="sm" />
                  </div>
                )}
              </div>
            </details>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .tl {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ln-rule);
  }

  /* Feature spread (track with a live demo) */
  .feat {
    display: grid;
    gap: 2.5rem;
    padding: clamp(2rem, 5vw, 3.5rem) 0;
    border-bottom: 1px solid var(--ln-rule);
  }
  .feat-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin-bottom: 1rem;
  }
  .feat-n {
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--ln-accent);
  }
  body.ln .feat-title {
    font-size: clamp(2.1rem, 5vw, 3.75rem);
    font-weight: 800;
    font-stretch: 82%;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .feat-kicker {
    margin-top: 0.9rem;
    font-family: var(--ln-display);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--ln-ink-2);
  }
  .feat-summary {
    margin-top: 1.5rem;
    max-width: 36em;
  }
  .feat-demo {
    min-width: 0;
  }

  /* Track rows */
  .tl-row {
    border-bottom: 1px solid var(--ln-rule);
  }
  .tl-s {
    display: grid;
    grid-template-columns: 2.75rem 1fr 1.75rem;
    align-items: start;
    gap: 0.25rem 0.75rem;
    padding: 1.25rem 0.25rem;
    cursor: pointer;
    list-style: none;
    border-radius: 6px;
  }
  .tl-s::-webkit-details-marker {
    display: none;
  }
  .tl-s:hover .tl-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .tl-n {
    padding-top: 0.3rem;
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ln-ink-3);
  }
  .tl-d[open] .tl-n {
    color: var(--ln-accent);
  }
  .tl-t {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .tl-title {
    font-family: var(--ln-display);
    font-size: clamp(1.3rem, 2.6vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .tl-kick {
    color: var(--ln-ink-2);
    font-size: 0.975rem;
  }
  .tl-meta {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ln-ink-3);
  }
  .tl-sector {
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.6875rem;
  }
  .tl-tag {
    padding: 0.15em 0.6em;
    border-radius: 999px;
    background: var(--ln-hl);
    color: var(--ln-ink);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .tl-chev {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    width: 28px;
    height: 28px;
    margin-top: 0.2rem;
    border: 1px solid var(--ln-rule);
    border-radius: 50%;
    position: relative;
  }
  .tl-chev::before,
  .tl-chev::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .tl-chev::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  .tl-d[open] .tl-chev::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tl-chev::after {
      transition: transform 0.25s ease;
    }
  }

  .tl-body {
    display: grid;
    gap: 2rem;
    padding: 0.25rem 0.25rem 2.25rem 3.5rem;
  }
  .tl-summary {
    margin-top: 0.5rem;
    max-width: 38em;
    font-size: 1.0625rem;
  }
  body.ln .tl-h {
    margin-top: 1.5rem;
    font-family: var(--ln-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ln-accent);
  }
  .tl-list {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    max-width: 40em;
  }
  .tl-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ln-ink-2);
  }
  .tl-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.7rem;
    height: 1px;
    background: var(--ln-ink-3);
  }
  .tl-outcomes li {
    color: var(--ln-ink);
    font-weight: 600;
  }
  .tl-personnel {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
    color: var(--ln-ink-2);
  }
  .tl-personnel .ln-eyebrow {
    margin-right: 0.5rem;
  }
  .tl-label {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--ln-ink-3);
  }
  .tl-demo {
    justify-self: start;
    width: 100%;
    max-width: 280px;
  }

  @media (max-width: 599px) {
    .tl-body {
      padding-left: 0.25rem;
    }
  }
  @media (min-width: 760px) {
    .tl-s {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(11rem, auto) 2rem;
      align-items: center;
      gap: 1.25rem;
      padding: 1.5rem 0.5rem;
    }
    .tl-n {
      padding-top: 0;
    }
    .tl-meta {
      grid-column: 3;
      grid-row: 1;
      justify-content: flex-end;
      margin-top: 0;
    }
    .tl-chev {
      grid-column: 4;
      margin-top: 0;
    }
    .tl-body {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 3rem;
      padding: 0 0.5rem 2.75rem 4.75rem;
    }
    .tl-demo {
      justify-self: end;
    }
  }
  @media (min-width: 1000px) {
    .feat {
      grid-template-columns: minmax(0, 1fr) 400px;
      gap: 5rem;
      align-items: center;
    }
  }
</style>
