---
// Nav slot: a "now playing" bar. Mobile: mini player + menu (details/summary, works without JS).
// Desktop: brand, now-playing readout and side links. The readout follows the section in view.
import type { Profile } from '../../lib/content';

interface Props {
  profile: Profile;
  home: boolean;
  nowPlaying: string;
}
const { profile, home, nowPlaying } = Astro.props;
const base = home ? '' : '/lab/d/';
const links = [
  { href: `${base}#work`, side: 'A', label: 'Work' },
  { href: `${base}#projects`, side: 'B', label: 'Projects' },
  { href: `${base}#music`, side: 'Bonus', label: 'Music' },
  { href: `${base}#resume`, side: 'Notes', label: 'Résumé' },
  { href: `${base}#contact`, side: 'Outro', label: 'Contact' },
];
---

<header class="np">
  <div class="np-bar">
    <a class="np-brand" href={`${base}#hero`}>
      <span class="np-disc" aria-hidden="true"></span>
      <span class="np-name">{profile.name}</span>
    </a>

    <p class="np-now" aria-hidden="true">
      <span class="np-now-k">Now playing</span>
      <span class="np-now-v" data-np-label>
        {nowPlaying}
      </span>
    </p>

    <nav class="np-nav" aria-label="Sections">
      <ul class="np-links">
        {links.map((l) => (
          <li>
            <a href={l.href}>
              <span class="np-side" aria-hidden="true">
                {l.side}
              </span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <details class="np-menu">
        <summary>
          <span class="np-burger" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          Menu
        </summary>
        <ul class="np-menu-list">
          {links.map((l) => (
            <li>
              <a href={l.href}>
                <span class="np-side">{l.side}</span>
                <span class="np-menu-label">{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
  <div class="np-progress" aria-hidden="true">
    <span></span>
  </div>
</header>

<script>
  // Now-playing readout follows the section in view; menu closes after a jump.
  const label = document.querySelector<HTMLElement>('[data-np-label]');
  const sections = [...document.querySelectorAll<HTMLElement>('[data-np]')];
  if (label && sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) label.textContent = (e.target as HTMLElement).dataset.np ?? '';
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
  const menu = document.querySelector<HTMLDetailsElement>('.np-menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menu.open = false;
  });
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .np {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ln-bg) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--ln-rule);
  }
  .np-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: var(--ln-max);
    min-height: var(--ln-header);
    margin-inline: auto;
    padding-inline: var(--ln-gutter);
  }
  .np-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    text-decoration: none;
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    flex: none;
  }
  .np-disc {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    flex: none;
    background:
      radial-gradient(circle, #0b0a09 0 7%, transparent 8%),
      radial-gradient(circle, #ff7a45 0 30%, transparent 31%),
      repeating-radial-gradient(circle, #151312 0 1px, #24211f 1.5px 2.5px), #151312;
    box-shadow: 0 0 0 1px var(--ln-rule);
  }
  @media (prefers-reduced-motion: no-preference) {
    .np-disc {
      animation: np-spin 4s linear infinite;
    }
  }
  @keyframes np-spin {
    to {
      transform: rotate(1turn);
    }
  }
  .np-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .np-now {
    display: grid;
    min-width: 0;
    flex: 1;
    line-height: 1.2;
  }
  .np-now-k {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ln-accent);
  }
  .np-now-v {
    font-family: var(--ln-display);
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .np-links {
    display: none;
  }

  /* Mobile menu */
  .np-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--ln-rule);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
  }
  .np-menu summary::-webkit-details-marker {
    display: none;
  }
  .np-burger {
    display: grid;
    gap: 4px;
    width: 16px;
  }
  .np-burger span {
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .np-menu[open] summary {
    background: var(--ln-ink);
    color: var(--ln-bg);
  }
  .np-menu-list {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin: 0;
    padding: 0.5rem var(--ln-gutter) 1.25rem;
    list-style: none;
    background: var(--ln-bg);
    border-bottom: 1px solid var(--ln-rule);
    box-shadow: 0 24px 40px rgb(0 0 0 / 0.25);
  }
  .np-menu-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--ln-rule);
    text-decoration: none;
  }
  .np-menu-list li:last-child a {
    border-bottom: 0;
  }
  .np-menu-list .np-side {
    width: 3.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .np-menu-label {
    font-family: var(--ln-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-stretch: 85%;
  }

  .np-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
  }
  .np-progress span {
    display: block;
    height: 100%;
    background: var(--ln-accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .np-progress span {
        animation: np-grow linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes np-grow {
    to {
      transform: scaleX(1);
    }
  }

  @media (min-width: 900px) {
    .np-name {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
    .np-now {
      flex: 0 1 auto;
      margin-left: 1.5rem;
      padding-left: 1.5rem;
      border-left: 1px solid var(--ln-rule);
    }
    .np-nav {
      margin-left: auto;
    }
    .np-menu {
      display: none;
    }
    .np-links {
      display: flex;
      gap: 0.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .np-links a {
      display: inline-flex;
      align-items: baseline;
      gap: 0.4rem;
      min-height: 40px;
      padding: 0.55rem 0.8rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9375rem;
    }
    .np-links a:hover {
      background: var(--ln-hl);
    }
    .np-side {
      font-size: 0.625rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ln-ink-3);
    }
  }
</style>
