---
// Page shell for direction D: Base layout + fonts/tokens + Nav + Footer.
import Base from '../../layouts/Base.astro';
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/dm-sans';
import './liner.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { getSiteContent } from '../../lib/content';

interface Props {
  title: string;
  description?: string;
  /** true on the one-page home, so nav links are plain fragments */
  home?: boolean;
  /** initial "now playing" label in the header */
  nowPlaying: string;
}
const { title, description, home = false, nowPlaying } = Astro.props;
const { profile } = await getSiteContent();
---

<Base title={title} description={description} noindex bodyClass="ln">
  <Nav slot="header" profile={profile} home={home} nowPlaying={nowPlaying} />
  <slot />
  <Footer slot="footer" profile={profile} />
</Base>
