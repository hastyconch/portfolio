---
// Work: engagements with a demo get the full layout (story, what I did, the live demo inline
// beside it, after the summary on phones). The rest follow as a compact list, each summary in
// a disclosure. Sector and role sit inline above each title.
import type { Work } from '../lib/content';
import AirlineDemo from '../demos/airline/AirlineDemo.tsx';
import GrocerDemo from '../demos/grocer/GrocerDemo.tsx';
import PipelineDemo from '../demos/pipeline/PipelineDemo.tsx';
import SchedulerDemo from '../demos/scheduler/SchedulerDemo.tsx';
import DemoFrame from './DemoFrame.astro';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  work: Work[];
}
const { work } = Astro.props;
const companies = [...new Set(work.map((w) => w.data.years))];
const lead = `Client engagements at ${companies.join(' and ')}. The ones with a demo come first; each demo is playable, built on an invented brand and mock data.`;
// Demos that are built. Others with a demo show the "coming soon" plate.
const LIVE = new Set(['airline', 'grocer', 'pipeline', 'scheduler']);
// Wide demos (desktop window, diagram) sit full-width under the summary on desktop.
const isWide = (frame: string) => frame === 'desktop' || frame === 'diagram';
const caption = 'Playable. Invented brand, mock data.';
const featured = work.filter((w) => w.data.demo !== 'none');
const others = work.filter((w) => w.data.demo === 'none');
---

<section id="work" class="ln-sec work" aria-labelledby="work-h">
  <div class="ln-wrap">
    <SideHead title="Work" id="work-h" lead={lead} layout="aside" />

    <ol class="wk-list">
      {featured.map((w) => {
        const d = w.data;
        const hid = `work-${w.id}`;
        const live = LIVE.has(d.demo);
        const wide = live && isWide(d.demoFrame);
        return (
          <li class:list={['wk', live && 'wk-live', wide && 'wk-wide']}>
            <article class="reveal" aria-labelledby={hid}>
              <div class="wk-head">
                <p class="wk-meta">
                  <span class="label">{d.sector}</span>
                  <span class="wk-role">
                    <span class="visually-hidden">Role: </span>
                    {d.role}
                  </span>
                  {d.status === 'placeholder' && <Placeholder />}
                </p>
                <h3 id={hid} class="wk-title">
                  {d.title}
                </h3>
                <p class="wk-kicker">{d.kicker}</p>
                <p class="wk-summary">{d.summary}</p>
              </div>

              <div class="wk-demo">
                {d.demo === 'airline' && (
                  <DemoFrame frame={d.demoFrame} caption={caption} tint={['#3d2c5e', '#f6f3fb']}>
                    <AirlineDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'grocer' && (
                  <DemoFrame frame={d.demoFrame} caption={caption} tint={['#134e4a', '#f3f6f4']}>
                    <GrocerDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'pipeline' && (
                  <DemoFrame
                    frame={d.demoFrame}
                    caption="Interactive. Invented project, mock data."
                  >
                    <PipelineDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'scheduler' && (
                  <DemoFrame
                    frame={d.demoFrame}
                    caption="Interactive. Invented unit and staff, mock data."
                  >
                    <SchedulerDemo client:visible />
                  </DemoFrame>
                )}
                {!live && <DemoFrame frame={d.demoFrame} coming size="sm" />}
              </div>

              <div class="wk-details">
                <h4 class="wk-h label">What I did</h4>
                <ul class="wk-ul">
                  {d.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                {d.outcomes.length > 0 && (
                  <>
                    <h4 class="wk-h label">Outcomes</h4>
                    <ul class="wk-ul wk-outcomes">
                      {d.outcomes.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  </>
                )}
              </div>

              <ul class="wk-skills" aria-label={`Skills: ${d.title}`}>
                {d.skills.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </article>
          </li>
        );
      })}
    </ol>

    {others.length > 0 && (
      <section class="wk-more reveal" aria-labelledby="work-more-h">
        <h3 id="work-more-h" class="wk-more-h label">
          More client work
        </h3>
        <ul class="wk-more-list">
          {others.map((w) => {
            const d = w.data;
            return (
              <li class="wk-item">
                <p class="wk-meta">
                  <span class="label">{d.sector}</span>
                  <span class="wk-role">
                    <span class="visually-hidden">Role: </span>
                    {d.role}
                  </span>
                  {d.status === 'placeholder' && <Placeholder />}
                </p>
                <h4 class="wk-item-title">{d.title}</h4>
                <p class="wk-item-kicker">{d.kicker}</p>
                <details class="wk-disc">
                  <summary>
                    Details<span class="visually-hidden">: {d.title}</span>
                  </summary>
                  <div class="wk-disc-body">
                    <p>{d.summary}</p>
                    <ul class="wk-ul">
                      {d.contributions.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</section>

<style>
  .wk-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .wk {
    border-bottom: var(--ln-hairline);
  }
  .wk article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'demo' 'details' 'skills';
    padding-block: var(--space-7);
  }
  .wk-demo,
  .wk-details {
    margin-top: var(--space-5);
  }

  /* Sector (label) and role, one line above the title */
  .wk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-bottom: var(--space-2);
  }
  .wk-role {
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
  }
  .wk-meta :global(.ln-ph) {
    align-self: center;
  }

  /* Story */
  .wk-head {
    grid-area: head;
    max-width: var(--measure);
  }
  body.ln .wk-title {
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .wk-kicker {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }
  .wk-summary {
    margin-top: var(--space-4);
  }
  .wk-details {
    grid-area: details;
    max-width: var(--measure);
  }
  body.ln .wk-h {
    margin: var(--space-5) 0 0;
  }
  body.ln .wk-h:first-child {
    margin-top: 0;
  }
  .wk-ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .wk-ul li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--ln-ink-2);
  }
  .wk-ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: var(--space-3);
    height: 1px;
    background: var(--ln-ink-3);
  }
  .wk-outcomes li {
    color: var(--ln-ink);
    font-weight: 600;
  }

  /* Demo, inline */
  .wk-demo {
    grid-area: demo;
    min-width: 0;
  }
  .wk:not(.wk-live) .wk-demo :global(.df) {
    justify-items: start;
  }

  /* Skills: tags on phones, a quiet list in the side column on wider screens */
  .wk-skills {
    grid-area: skills;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .wk-skills li {
    padding: var(--space-1) var(--space-3);
    border: var(--ln-hairline);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--ln-ink-2);
  }

  /* More client work: a compact list */
  .wk-more {
    padding-top: var(--space-7);
  }
  .wk-more-list {
    display: grid;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .wk-item {
    padding-block: var(--space-5);
    border-bottom: var(--ln-hairline);
  }
  body.ln .wk-item-title {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .wk-item-kicker {
    margin-top: var(--space-1);
    color: var(--ln-ink-2);
  }
  .wk-disc {
    margin-top: var(--space-2);
  }
  .wk-disc summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    border-radius: var(--radius-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ln-accent);
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .wk-disc summary::-webkit-details-marker {
    display: none;
  }
  .wk-disc summary::before {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: -45deg;
    transition: rotate var(--dur-quick) var(--ease-out);
  }
  .wk-disc[open] summary::before {
    rotate: 45deg;
  }
  .wk-disc summary:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }
  .wk-disc summary:active {
    color: var(--ln-ink);
  }
  .wk-disc-body {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    padding-bottom: var(--space-2);
  }
  .wk-disc-body .wk-ul {
    margin-top: 0;
  }

  /* Tablet: skills column + story */
  @media (min-width: 760px) {
    .wk article {
      grid-template-columns: 11rem minmax(0, 1fr);
      grid-template-areas:
        'skills head'
        'skills demo'
        'skills details';
      grid-template-rows: auto auto 1fr;
      column-gap: 2.5rem;
    }
    .wk-demo,
    .wk-details {
      margin-top: var(--space-6);
    }
    .wk-skills {
      align-self: start;
      flex-direction: column;
      gap: var(--space-1);
      margin-top: var(--space-1);
    }
    .wk-skills li {
      padding: 0;
      border: 0;
      font-size: var(--text-sm);
    }
    .wk-more {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: 2.5rem;
      align-items: start;
    }
    .wk-more-h {
      padding-top: var(--space-5);
    }
    .wk-more-list {
      margin-top: 0;
    }
  }

  /* Desktop: skills | story | demo, side by side */
  @media (min-width: 1100px) {
    .wk article {
      grid-template-columns: 11rem minmax(0, 1fr) 360px;
      grid-template-areas:
        'skills head demo'
        'skills details demo';
      grid-template-rows: auto 1fr;
      column-gap: clamp(2.5rem, 4vw, 4rem);
    }
    .wk-demo {
      margin-top: 0;
      align-self: start;
    }
    .wk:not(.wk-live) .wk-demo :global(.df) {
      justify-items: end;
    }
    /* Wide demos (desktop window, diagram): full width under the summary. */
    .wk-wide article {
      grid-template-areas:
        'skills head head'
        'skills demo demo'
        'skills details details';
      grid-template-rows: auto auto 1fr;
    }
    .wk-wide .wk-demo {
      margin-top: var(--space-6);
    }
    .wk-more {
      column-gap: clamp(2.5rem, 4vw, 4rem);
    }
    .wk-more-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }
</style>
