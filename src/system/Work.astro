---
// Work: engagements with a demo get the full layout (story, what I did, the live demo inline
// beside it, after the summary on phones). The rest follow as a compact list, each summary in
// a disclosure. Sector and role sit inline above each title.
// WO-015: on laptops each demo engagement is one pane, one viewport tall below the nav (WO-023
// removed the page snap; the header's stepper moves pane to pane). Skills are badges: a
// deliberate, non-interactive stamp, not a quiet list.
// WO-019: the header's stepper and jump list move between panes and put focus on the pane's
// heading (tabindex -1), so keyboard users land where they went.
// WO-024: on phones (under 760px, scripting on) only the first demo shows inline. The others
// wait behind a "Try the demo" button and hydrate when it reveals them (client:visible never
// fires while they are display: none). Without scripting they all show, as before.
// WO-025: the button is a button (outlined, "Try the demo: {name}", its one line as the
// description), revealing does not jump the page, and the demos add no region landmarks: the
// revealed wrapper is a named group, and only once it has been revealed.
import type { Work } from '../lib/content';
import AirlineDemo from '../demos/airline/AirlineDemo.tsx';
import GrocerDemo from '../demos/grocer/GrocerDemo.tsx';
import PipelineDemo from '../demos/pipeline/PipelineDemo.tsx';
import SchedulerDemo from '../demos/scheduler/SchedulerDemo.tsx';
import DemoFrame from './DemoFrame.astro';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  work: Work[];
}
const { work } = Astro.props;
const companies = [...new Set(work.map((w) => w.data.years))];
const lead = `Client engagements at ${companies.join(' and ')}. The ones with a demo come first; each demo is playable, built on an invented brand and mock data.`;
// Demos that are built. Others with a demo show the "coming soon" plate.
const LIVE = new Set(['airline', 'grocer', 'pipeline', 'scheduler']);
// Wide demos (desktop window, diagram) sit full-width under the summary on desktop.
const isWide = (frame: string) => frame === 'desktop' || frame === 'diagram';
const caption = 'Playable. Invented brand, mock data.';
const featured = work.filter((w) => w.data.demo !== 'none');
// The "Try the demo" button's name and one line, per demo.
const TRY: Record<string, { name: string; line: string }> = {
  airline: { name: 'Airline loyalty app', line: 'Track tier progress, book a reward.' },
  grocer: { name: 'Grocer loyalty app', line: 'Load offers, build a list, earn points.' },
  scheduler: { name: 'Nurse scheduler', line: 'Fill an open shift within the rules.' },
  pipeline: { name: 'AI program pipeline', line: 'Transcript to exec update, step by step.' },
};
const others = work.filter((w) => w.data.demo === 'none');
---

<section id="work" class="ln-sec work" aria-labelledby="work-h">
  <div class="ln-wrap">
    <SideHead title="Work" id="work-h" lead={lead} layout="aside" />

    <ol class="wk-list">
      {featured.map((w, i) => {
        const d = w.data;
        const hid = `work-${w.id}`;
        const live = LIVE.has(d.demo);
        const wide = live && isWide(d.demoFrame);
        const tryIt = live && i > 0 ? TRY[d.demo] : undefined;
        return (
          <li class:list={['wk', live && 'wk-live', wide && 'wk-wide']}>
            <article aria-labelledby={hid} class:list={[tryIt && 'wk-collapse']}>
              <div class="wk-head">
                <p class="wk-meta">
                  <span class="label">{d.sector}</span>
                  <span class="wk-role">
                    <span class="visually-hidden">Role: </span>
                    {d.role}
                  </span>
                  {d.status === 'placeholder' && <Placeholder />}
                </p>
                <h3 id={hid} class="wk-title" tabindex="-1">
                  {d.title}
                </h3>
                <p class="wk-kicker">{d.kicker}</p>
                <p class="wk-summary">{d.summary}</p>
              </div>

              {tryIt && (
                <div class="wk-try">
                  <button
                    type="button"
                    class="wk-try-b"
                    data-wk-try
                    aria-controls={`${hid}-demo`}
                    aria-label={`Try the demo: ${tryIt.name}`}
                    aria-describedby={`${hid}-try-d`}
                  >
                    {/* The name is the visible text with a colon for the ear; the space keeps
                        the visible text two words apart for label-in-name checks. */}
                    <span class="wk-try-k">Try the demo</span>{' '}
                    <span class="wk-try-n">{tryIt.name}</span>
                  </button>
                  <p class="wk-try-d" id={`${hid}-try-d`}>
                    {tryIt.line}
                  </p>
                </div>
              )}
              <div
                class="wk-demo"
                id={tryIt ? `${hid}-demo` : undefined}
                data-wk-label={tryIt ? `${tryIt.name} demo` : undefined}
              >
                {d.demo === 'airline' && (
                  <DemoFrame frame={d.demoFrame} caption={caption} tint={['#3d2c5e', '#f6f3fb']}>
                    <AirlineDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'grocer' && (
                  <DemoFrame frame={d.demoFrame} caption={caption} tint={['#134e4a', '#f3f6f4']}>
                    <GrocerDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'pipeline' && (
                  <DemoFrame
                    frame={d.demoFrame}
                    caption="Interactive. Invented project, mock data."
                  >
                    <PipelineDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'scheduler' && (
                  <DemoFrame
                    frame={d.demoFrame}
                    caption="Interactive. Invented unit and staff, mock data."
                  >
                    <SchedulerDemo client:visible />
                  </DemoFrame>
                )}
                {!live && <DemoFrame frame={d.demoFrame} coming size="sm" />}
              </div>

              <div class="wk-details">
                <h4 class="wk-h label">What I did</h4>
                <ul class="wk-ul">
                  {d.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                {d.outcomes.length > 0 && (
                  <>
                    <h4 class="wk-h label">Outcomes</h4>
                    <ul class="wk-ul wk-outcomes">
                      {d.outcomes.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  </>
                )}
              </div>

              <div class="wk-skills">
                <h4 class="wk-skills-h label" id={`${hid}-skills`}>
                  Skills
                </h4>
                <ul class="wk-badges" aria-labelledby={`${hid}-skills ${hid}`}>
                  {d.skills.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        );
      })}
    </ol>

    {others.length > 0 && (
      <section class="wk-more" aria-labelledby="work-more-h">
        <h3 id="work-more-h" class="wk-more-h label" tabindex="-1">
          More client work
        </h3>
        <ul class="wk-more-list">
          {others.map((w) => {
            const d = w.data;
            return (
              <li class="wk-item">
                <p class="wk-meta">
                  <span class="label">{d.sector}</span>
                  <span class="wk-role">
                    <span class="visually-hidden">Role: </span>
                    {d.role}
                  </span>
                  {d.status === 'placeholder' && <Placeholder />}
                </p>
                <h4 class="wk-item-title">{d.title}</h4>
                <p class="wk-item-kicker">{d.kicker}</p>
                <details class="wk-disc">
                  <summary>
                    Details<span class="visually-hidden">: {d.title}</span>
                  </summary>
                  <div class="wk-disc-body">
                    <p>{d.summary}</p>
                    <ul class="wk-ul">
                      {d.contributions.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</section>

<script>
  // Reveal a collapsed demo (phones): it becomes visible, so client:visible hydrates it now. It
  // becomes a named group and takes focus without scrolling; then the page brings the
  // engagement's head (meta, title, kicker) flush under the header, so the title stays on screen
  // and the demo follows it.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-wk-try]')) {
    btn.addEventListener('click', () => {
      const article = btn.closest('article');
      const demo = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (!article || !demo) return;
      article.setAttribute('data-open', '');
      demo.setAttribute('role', 'group');
      demo.setAttribute('aria-label', demo.dataset.wkLabel ?? '');
      demo.tabIndex = -1;
      demo.focus({ preventScroll: true });
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      article
        .querySelector('.wk-head')
        ?.scrollIntoView({ block: 'start', behavior: still ? 'instant' : 'smooth' });
    });
  }
</script>

<style>
  .wk-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .wk {
    border-bottom: var(--ln-hairline);
    /* A jump or a step to a pane lands its top flush under the header, like a section band
       (liner.css). There is no page-level snap (WO-023). */
    scroll-margin-top: var(--ln-flush);
  }
  .wk article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'demo' 'details' 'skills';
    padding-block: var(--space-7);
  }
  .wk-demo,
  .wk-details {
    margin-top: var(--space-5);
  }

  /* Sector (label) and role, one line above the title */
  .wk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-bottom: var(--space-2);
  }
  .wk-role {
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
  }
  .wk-meta :global(.ln-ph) {
    align-self: center;
  }

  /* Story */
  .wk-head {
    grid-area: head;
    max-width: var(--measure);
    /* "Try the demo" scrolls the head flush under the header (WO-025). */
    scroll-margin-top: var(--ln-flush);
  }
  /* Focus arrives here from the header's stepper; the pane coming into view is the cue. */
  body.ln :is(.wk-title, .wk-more-h):focus {
    outline: none;
  }
  body.ln .wk-title {
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .wk-kicker {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }
  .wk-summary {
    margin-top: var(--space-4);
  }
  .wk-details {
    grid-area: details;
    max-width: var(--measure);
  }
  body.ln .wk-h {
    margin: var(--space-5) 0 0;
  }
  body.ln .wk-h:first-child {
    margin-top: 0;
  }
  .wk-ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .wk-ul li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--ln-ink-2);
  }
  .wk-ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: var(--space-3);
    height: 1px;
    background: var(--ln-ink-3);
  }
  .wk-outcomes li {
    color: var(--ln-ink);
    font-weight: 600;
  }

  /* Demo, inline */
  .wk-demo {
    grid-area: demo;
    min-width: 0;
  }
  .wk:not(.wk-live) .wk-demo :global(.df) {
    justify-items: start;
  }
  /* Focus lands on a revealed demo; keyboard users see where. */
  .wk-demo:focus-visible {
    outline-offset: var(--space-2);
  }

  /* Try the demo (phones): an outlined button in the demo's place, with its one line under it,
     until it is pressed. The accent outline and label set it apart from the neutral skill tags. */
  .wk-try {
    display: none;
    grid-area: demo;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .wk-try-b {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--ln-accent);
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--ln-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      border-color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  .wk-try-b:hover,
  .wk-try-b:focus-visible {
    background: var(--ln-hl-hover);
  }
  .wk-try-b:active {
    background: var(--ln-hl-hover);
    border-color: var(--ln-ink);
    scale: var(--press-scale);
  }
  .wk-try-k {
    font-weight: 700;
    color: var(--ln-accent);
  }
  .wk-try-n {
    font-weight: 600;
  }
  body.ln .wk-try-d {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }
  @media (max-width: 759.98px) and (scripting: enabled) {
    .wk-collapse:not([data-open]) .wk-try {
      display: grid;
    }
    .wk-collapse:not([data-open]) .wk-demo {
      display: none;
    }
  }

  /* Skills: badges, a row on phones and a stack in the side column on wider screens. Quiet: a
     tinted neutral plate and a neutral hairline (no accent edge since WO-025, so the one
     tappable thing, "Try the demo", doesn't read as a tag), set in the UI face at a firmer weight
     than the copy. Not interactive, so no states. */
  .wk-skills {
    grid-area: skills;
    margin-top: var(--space-6);
  }
  body.ln .wk-skills-h {
    margin: 0 0 var(--space-3);
  }
  .wk-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wk-badges li {
    padding: var(--space-1) var(--space-2);
    border: var(--ln-hairline);
    border-radius: var(--radius-1);
    background: var(--ln-badge);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--ln-ink);
  }

  /* More client work: a compact list. Its last rule ends the section: no bottom padding on top of
     the next section's own (WO-025), so the gap before Projects is one section rhythm. */
  .work {
    padding-bottom: 0;
  }
  .wk-more {
    padding-top: var(--space-7);
  }
  .wk-more-list {
    display: grid;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .wk-item {
    padding-block: var(--space-5);
    border-bottom: var(--ln-hairline);
  }
  body.ln .wk-item-title {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .wk-item-kicker {
    margin-top: var(--space-1);
    color: var(--ln-ink-2);
  }
  .wk-disc {
    margin-top: var(--space-2);
  }
  .wk-disc summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    border-radius: var(--radius-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ln-accent);
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .wk-disc summary::-webkit-details-marker {
    display: none;
  }
  .wk-disc summary::before {
    content: '';
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: -45deg;
    transition: rotate var(--dur-quick) var(--ease-out);
  }
  .wk-disc[open] summary::before {
    rotate: 45deg;
  }
  .wk-disc summary:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }
  .wk-disc summary:active {
    color: var(--ln-ink);
  }
  .wk-disc-body {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    padding-bottom: var(--space-2);
  }
  .wk-disc-body .wk-ul {
    margin-top: 0;
  }

  /* Tablet: skills column + story */
  @media (min-width: 760px) {
    .wk article {
      grid-template-columns: 11rem minmax(0, 1fr);
      grid-template-areas:
        'skills head'
        'skills demo'
        'skills details';
      grid-template-rows: auto auto 1fr;
      column-gap: 2.5rem;
    }
    .wk-demo,
    .wk-details {
      margin-top: var(--space-6);
    }
    .wk-skills {
      align-self: start;
      margin-top: var(--space-1);
    }
    .wk-badges {
      flex-direction: column;
    }
    .wk-more {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: 2.5rem;
      align-items: start;
    }
    .wk-more-h {
      padding-top: var(--space-5);
    }
    /* Beside the heading, the last engagement's rule above already tops the list. */
    .wk-more-list {
      margin-top: 0;
      border-top: 0;
    }
  }

  /* Desktop: skills | story | demo, side by side */
  @media (min-width: 1100px) {
    .wk article {
      grid-template-columns: 11rem minmax(0, 1fr) 360px;
      grid-template-areas:
        'skills head demo'
        'skills details demo';
      grid-template-rows: auto 1fr;
      column-gap: clamp(2.5rem, 4vw, 4rem);
    }
    .wk-demo {
      margin-top: 0;
      align-self: start;
    }
    .wk:not(.wk-live) .wk-demo :global(.df) {
      justify-items: end;
    }
    /* Wide demos (desktop window, diagram): full width under the summary. */
    .wk-wide article {
      grid-template-areas:
        'skills head head'
        'skills demo demo'
        'skills details details';
      grid-template-rows: auto auto 1fr;
    }
    .wk-wide .wk-demo {
      margin-top: var(--space-6);
    }
    .wk-more {
      column-gap: clamp(2.5rem, 4vw, 4rem);
    }
    .wk-more-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  /* Laptop panes (WO-015): each demo engagement is one viewport tall below the nav, from
     1280 × 720 up. Phone panes centre the story beside a phone scaled to the pane; wide panes put
     the story and what I did side by side over a full-width demo that takes the rest of the
     pane (its frame scrolls inside if the demo is taller). Shorter windows keep the flowing
     layout above. */
  @media (min-width: 1100px) and (min-height: 600px) {
    .wk-list {
      --wk-pane: calc(100svh - var(--ln-header));
      --wk-pad: clamp(var(--space-4), 4svh, var(--space-6));
    }
    /* The pane is the list item; the engagement sits centred in it. */
    .wk {
      display: grid;
      align-content: center;
      min-height: var(--wk-pane);
    }
    .wk article {
      padding-block: var(--wk-pad);
    }
    /* Device height: the pane less its padding and the caption under the phone. */
    .wk-live:not(.wk-wide) .wk-demo {
      --df-h: calc(var(--wk-pane) - 2 * var(--wk-pad) - var(--space-7));
    }

    .wk-wide {
      height: var(--wk-pane);
      grid-template-rows: minmax(0, 1fr);
      align-content: stretch;
    }
    .wk-wide article {
      min-height: 0;
      padding-block: var(--space-5);
      grid-template-columns: 11rem minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-areas:
        'skills head details'
        'demo demo demo';
      grid-template-rows: auto minmax(0, 1fr);
    }
    .wk-wide .wk-head {
      align-self: start;
    }
    /* What I did, compact: a step smaller, so the demo keeps most of the pane. */
    .wk-wide .wk-details {
      margin-top: 0;
      font-size: var(--text-sm);
      line-height: var(--leading-normal);
    }
    .wk-wide .wk-ul {
      gap: var(--space-1);
    }
    .wk-wide .wk-demo {
      align-self: stretch;
      min-height: 0;
      margin-top: var(--space-5);
    }
  }
</style>
