---
// Work — Side A. Organisation from direction A (owner pick): every engagement is open, with a
// sector / company / role column beside the story. Demo frame from direction D: the live demo
// sits inline beside its engagement (after the summary on phones) so nobody scrolls past
// text to reach it. Styled in the Liner Notes system.
import type { Work } from '../lib/content';
import AirlineDemo from '../demos/airline/AirlineDemo.tsx';
import GrocerDemo from '../demos/grocer/GrocerDemo.tsx';
import PipelineDemo from '../demos/pipeline/PipelineDemo.tsx';
import SchedulerDemo from '../demos/scheduler/SchedulerDemo.tsx';
import DemoFrame from './DemoFrame.astro';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  work: Work[];
}
const { work } = Astro.props;
const companies = [...new Set(work.map((w) => w.data.years))];
const meta = `${work.length} engagements · ${companies.join(' / ')}`;
// Demos that are built. Others with a demo show the "coming soon" plate.
const LIVE = new Set(['airline', 'grocer', 'pipeline', 'scheduler']);
// Wide demos (desktop window, diagram) sit full-width under the summary on desktop.
const isWide = (frame: string) => frame === 'desktop' || frame === 'diagram';
const caption = 'Playable · invented brand, mock data';
---

<section
  id="work"
  class="ln-side work"
  data-np="Side A · Professional work"
  aria-labelledby="work-h"
>
  <div class="ln-wrap">
    <SideHead badge="A" kicker="Side A" title="Professional work" id="work-h" meta={meta} />

    <ol class="wk-list">
      {work.map((w, i) => {
        const d = w.data;
        const hid = `work-${w.id}`;
        const live = LIVE.has(d.demo);
        const hasDemo = d.demo !== 'none';
        const wide = live && isWide(d.demoFrame);
        return (
          <li class:list={['wk', live && 'wk-live', wide && 'wk-wide', !hasDemo && 'wk-nodemo']}>
            <article aria-labelledby={hid}>
              <div class="wk-meta">
                <span class="wk-n ln-num">A{i + 1}</span>
                <dl class="wk-dl">
                  <div>
                    <dt>Sector</dt>
                    <dd>{d.sector}</dd>
                  </div>
                  <div>
                    <dt>Company</dt>
                    <dd>{d.years}</dd>
                  </div>
                  <div>
                    <dt>Role</dt>
                    <dd>{d.role}</dd>
                  </div>
                </dl>
                {d.status === 'placeholder' && <Placeholder />}
              </div>

              <div class="wk-head">
                <h3 id={hid} class="wk-title">
                  {d.title}
                </h3>
                <p class="wk-kicker">{d.kicker}</p>
                <p class="wk-summary">{d.summary}</p>
              </div>

              {hasDemo && (
                <div class="wk-demo">
                  {d.demo === 'airline' && (
                    <DemoFrame frame={d.demoFrame} caption={caption} tint={['#3d2c5e', '#f6f3fb']}>
                      <AirlineDemo client:visible />
                    </DemoFrame>
                  )}
                  {d.demo === 'grocer' && (
                    <DemoFrame frame={d.demoFrame} caption={caption} tint={['#134e4a', '#f3f6f4']}>
                      <GrocerDemo client:visible />
                    </DemoFrame>
                  )}
                  {d.demo === 'pipeline' && (
                    <DemoFrame
                      frame={d.demoFrame}
                      caption="Interactive · invented project, mock data"
                    >
                      <PipelineDemo client:visible />
                    </DemoFrame>
                  )}
                  {d.demo === 'scheduler' && (
                    <DemoFrame
                      frame={d.demoFrame}
                      caption="Interactive · invented unit and staff, mock data"
                    >
                      <SchedulerDemo client:visible />
                    </DemoFrame>
                  )}
                  {!live && <DemoFrame frame={d.demoFrame} coming size="sm" />}
                </div>
              )}

              <div class="wk-details">
                <h4 class="wk-h">What I did</h4>
                <ul class="wk-ul">
                  {d.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                {d.outcomes.length > 0 && (
                  <>
                    <h4 class="wk-h">Outcomes</h4>
                    <ul class="wk-ul wk-outcomes">
                      {d.outcomes.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  </>
                )}
              </div>

              <ul class="wk-skills" aria-label={`Skills — ${d.title}`}>
                {d.skills.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .wk-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ln-rule);
  }
  .wk {
    border-bottom: 1px solid var(--ln-rule);
  }
  .wk article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'meta' 'head' 'demo' 'details' 'skills';
    padding-block: clamp(2.25rem, 5vw, 3.75rem);
  }
  .wk-head,
  .wk-demo,
  .wk-details,
  .wk-skills {
    margin-top: 1.5rem;
  }

  /* ——— Meta column: number, sector / company / role ——— */
  .wk-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .wk-n {
    font-family: var(--ln-display);
    font-weight: 800;
    font-stretch: 80%;
    font-size: 1.125rem;
    color: var(--ln-accent);
  }
  .wk-dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
  }
  .wk-dl dt {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .wk-dl dd {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }

  /* ——— Story ——— */
  .wk-head {
    grid-area: head;
    max-width: 40em;
  }
  body.ln .wk-title {
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    font-weight: 800;
    font-stretch: 82%;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .wk-kicker {
    margin-top: 0.75rem;
    font-family: var(--ln-display);
    font-size: clamp(1.15rem, 1.8vw, 1.375rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ln-ink-2);
  }
  .wk-summary {
    margin-top: 1.25rem;
  }
  .wk-details {
    grid-area: details;
    max-width: 40em;
  }
  body.ln .wk-h {
    margin: 1.5rem 0 0;
    font-family: var(--ln-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ln-accent);
  }
  body.ln .wk-h:first-child {
    margin-top: 0;
  }
  .wk-ul {
    display: grid;
    gap: 0.5rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wk-ul li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ln-ink-2);
  }
  .wk-ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.7rem;
    height: 1px;
    background: var(--ln-ink-3);
  }
  .wk-outcomes li {
    color: var(--ln-ink);
    font-weight: 600;
  }

  /* ——— Demo, inline ——— */
  .wk-demo {
    grid-area: demo;
    min-width: 0;
  }
  .wk:not(.wk-live) .wk-demo :global(.df) {
    justify-items: start;
  }
  .wk:not(.wk-live) .wk-demo :global(.df-device) {
    max-width: 260px;
  }
  .wk:not(.wk-live) .wk-demo :global(.df-phone .df-device) {
    max-width: 150px;
  }

  /* ——— Skills ——— */
  .wk-skills {
    grid-area: skills;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wk-skills li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--ln-rule);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--ln-ink-2);
  }

  /* ——— Tablet: meta column + story ——— */
  @media (min-width: 760px) {
    .wk article {
      grid-template-columns: 11rem minmax(0, 1fr);
      grid-template-areas:
        'meta head'
        'skills demo'
        'skills details';
      grid-template-rows: auto auto 1fr;
      column-gap: 2.5rem;
    }
    .wk-head {
      margin-top: 0;
    }
    .wk-demo,
    .wk-details {
      margin-top: 2rem;
    }
    .wk-nodemo .wk-details {
      grid-row: 2 / 4;
    }
    .wk-skills {
      margin-top: 2rem;
    }
    .wk-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .wk-n {
      font-size: clamp(2.25rem, 4vw, 3rem);
      line-height: 0.85;
    }
    .wk-dl {
      flex-direction: column;
      gap: 0.75rem;
    }
    .wk-dl dt {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ln-ink-3);
    }
    .wk-dl dd {
      margin-top: 0.15rem;
      font-family: var(--ln-display);
      font-size: 1.0625rem;
      font-weight: 600;
      letter-spacing: -0.005em;
      text-transform: none;
      color: var(--ln-ink);
      line-height: 1.2;
    }
    .wk-skills {
      align-self: start;
      flex-direction: column;
      gap: 0.4rem;
    }
    .wk-skills li {
      padding: 0;
      border: 0;
      font-size: 0.9375rem;
    }
    .wk-skills li::before {
      content: '•';
      margin-right: 0.5em;
      color: var(--ln-accent);
    }
  }

  /* ——— Desktop: meta | story | demo, side by side ——— */
  @media (min-width: 1100px) {
    .wk article {
      grid-template-columns: 11rem minmax(0, 1fr) 360px;
      grid-template-areas:
        'meta head demo'
        'skills details demo';
      grid-template-rows: auto 1fr;
      column-gap: clamp(2.5rem, 4vw, 4rem);
    }
    .wk-demo {
      margin-top: 0;
      align-self: start;
    }
    .wk-nodemo .wk-head,
    .wk-nodemo .wk-details {
      grid-column: 2 / 4;
    }
    .wk-nodemo .wk-head {
      grid-row: 1;
    }
    .wk-nodemo .wk-details {
      grid-row: 2;
    }
    .wk:not(.wk-live) .wk-demo :global(.df) {
      justify-items: end;
    }
    /* Wide demos (desktop window, diagram): full width under the summary. */
    .wk-wide article {
      grid-template-areas:
        'meta head head'
        'skills demo demo'
        'skills details details';
      grid-template-rows: auto auto 1fr;
    }
    .wk-wide .wk-demo {
      margin-top: 2rem;
    }
  }
</style>
