---
// Work: every engagement is open, with a sector / company / role column beside the story
// (direction A's organisation, owner pick). The live demo sits inline beside its engagement
// (after the summary on phones) so nobody scrolls past text to reach it.
import type { Work } from '../lib/content';
import AirlineDemo from '../demos/airline/AirlineDemo.tsx';
import GrocerDemo from '../demos/grocer/GrocerDemo.tsx';
import PipelineDemo from '../demos/pipeline/PipelineDemo.tsx';
import SchedulerDemo from '../demos/scheduler/SchedulerDemo.tsx';
import DemoFrame from './DemoFrame.astro';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  work: Work[];
}
const { work } = Astro.props;
const companies = [...new Set(work.map((w) => w.data.years))];
const lead = `Client engagements at ${companies.join(' and ')}. Where one has a demo beside it, the demo is playable, built on an invented brand and mock data.`;
// Demos that are built. Others with a demo show the "coming soon" plate.
const LIVE = new Set(['airline', 'grocer', 'pipeline', 'scheduler']);
// Wide demos (desktop window, diagram) sit full-width under the summary on desktop.
const isWide = (frame: string) => frame === 'desktop' || frame === 'diagram';
const caption = 'Playable. Invented brand, mock data.';
---

<section id="work" class="ln-sec work" aria-labelledby="work-h">
  <div class="ln-wrap">
    <SideHead title="Work" id="work-h" lead={lead} layout="aside" />

    <ol class="wk-list">
      {work.map((w) => {
        const d = w.data;
        const hid = `work-${w.id}`;
        const live = LIVE.has(d.demo);
        const hasDemo = d.demo !== 'none';
        const wide = live && isWide(d.demoFrame);
        return (
          <li class:list={['wk', live && 'wk-live', wide && 'wk-wide', !hasDemo && 'wk-nodemo']}>
            <article class="reveal" aria-labelledby={hid}>
              <div class="wk-meta">
                <dl class="wk-dl">
                  <div>
                    <dt>Sector</dt>
                    <dd>{d.sector}</dd>
                  </div>
                  <div>
                    <dt>Company</dt>
                    <dd>{d.years}</dd>
                  </div>
                  <div>
                    <dt>Role</dt>
                    <dd>{d.role}</dd>
                  </div>
                </dl>
                {d.status === 'placeholder' && <Placeholder />}
              </div>

              <div class="wk-head">
                <h3 id={hid} class="wk-title">
                  {d.title}
                </h3>
                <p class="wk-kicker">{d.kicker}</p>
                <p class="wk-summary">{d.summary}</p>
              </div>

              {hasDemo && (
                <div class="wk-demo">
                  {d.demo === 'airline' && (
                    <DemoFrame frame={d.demoFrame} caption={caption} tint={['#3d2c5e', '#f6f3fb']}>
                      <AirlineDemo client:visible />
                    </DemoFrame>
                  )}
                  {d.demo === 'grocer' && (
                    <DemoFrame frame={d.demoFrame} caption={caption} tint={['#134e4a', '#f3f6f4']}>
                      <GrocerDemo client:visible />
                    </DemoFrame>
                  )}
                  {d.demo === 'pipeline' && (
                    <DemoFrame
                      frame={d.demoFrame}
                      caption="Interactive. Invented project, mock data."
                    >
                      <PipelineDemo client:visible />
                    </DemoFrame>
                  )}
                  {d.demo === 'scheduler' && (
                    <DemoFrame
                      frame={d.demoFrame}
                      caption="Interactive. Invented unit and staff, mock data."
                    >
                      <SchedulerDemo client:visible />
                    </DemoFrame>
                  )}
                  {!live && <DemoFrame frame={d.demoFrame} coming size="sm" />}
                </div>
              )}

              <div class="wk-details">
                <h4 class="wk-h label">What I did</h4>
                <ul class="wk-ul">
                  {d.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                {d.outcomes.length > 0 && (
                  <>
                    <h4 class="wk-h label">Outcomes</h4>
                    <ul class="wk-ul wk-outcomes">
                      {d.outcomes.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  </>
                )}
              </div>

              <ul class="wk-skills" aria-label={`Skills: ${d.title}`}>
                {d.skills.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .wk-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .wk {
    border-bottom: var(--ln-hairline);
  }
  .wk article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'meta' 'head' 'demo' 'details' 'skills';
    padding-block: var(--space-7);
  }
  .wk-head,
  .wk-demo,
  .wk-details,
  .wk-skills {
    margin-top: var(--space-5);
  }

  /* Meta column: sector / company / role */
  .wk-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }
  .wk-dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    width: 100%;
    margin: 0;
  }
  .wk-dl dt {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .wk-dl dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  /* Story */
  .wk-head {
    grid-area: head;
    max-width: var(--measure);
  }
  body.ln .wk-title {
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .wk-kicker {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }
  .wk-summary {
    margin-top: var(--space-4);
  }
  .wk-details {
    grid-area: details;
    max-width: var(--measure);
  }
  body.ln .wk-h {
    margin: var(--space-5) 0 0;
  }
  body.ln .wk-h:first-child {
    margin-top: 0;
  }
  .wk-ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .wk-ul li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--ln-ink-2);
  }
  .wk-ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: var(--space-3);
    height: 1px;
    background: var(--ln-ink-3);
  }
  .wk-outcomes li {
    color: var(--ln-ink);
    font-weight: 600;
  }

  /* Demo, inline */
  .wk-demo {
    grid-area: demo;
    min-width: 0;
  }
  .wk:not(.wk-live) .wk-demo :global(.df) {
    justify-items: start;
  }
  .wk:not(.wk-live) .wk-demo :global(.df-device) {
    max-width: 260px;
  }
  .wk:not(.wk-live) .wk-demo :global(.df-phone .df-device) {
    max-width: 150px;
  }

  /* Skills: tags on phones, a quiet list beside the story on wider screens */
  .wk-skills {
    grid-area: skills;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .wk-skills li {
    padding: var(--space-1) var(--space-3);
    border: var(--ln-hairline);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    color: var(--ln-ink-2);
  }

  /* Tablet: meta column + story */
  @media (min-width: 760px) {
    .wk article {
      grid-template-columns: 11rem minmax(0, 1fr);
      grid-template-areas:
        'meta head'
        'skills demo'
        'skills details';
      grid-template-rows: auto auto 1fr;
      column-gap: 2.5rem;
    }
    .wk-head {
      margin-top: 0;
    }
    .wk-demo,
    .wk-details {
      margin-top: var(--space-6);
    }
    .wk-nodemo .wk-details {
      grid-row: 2 / 4;
    }
    .wk-skills {
      margin-top: var(--space-6);
    }
    .wk-meta {
      flex-direction: column;
      align-items: flex-start;
      padding-top: var(--space-1);
    }
    .wk-dl {
      grid-template-columns: minmax(0, 1fr);
    }
    .wk-dl dd {
      font-size: var(--text-md);
    }
    .wk-skills {
      align-self: start;
      flex-direction: column;
      gap: var(--space-1);
    }
    .wk-skills li {
      padding: 0;
      border: 0;
      font-size: var(--text-sm);
    }
  }

  /* Desktop: meta | story | demo, side by side */
  @media (min-width: 1100px) {
    .wk article {
      grid-template-columns: 11rem minmax(0, 1fr) 360px;
      grid-template-areas:
        'meta head demo'
        'skills details demo';
      grid-template-rows: auto 1fr;
      column-gap: clamp(2.5rem, 4vw, 4rem);
    }
    .wk-demo {
      margin-top: 0;
      align-self: start;
    }
    .wk-nodemo .wk-head,
    .wk-nodemo .wk-details {
      grid-column: 2 / 4;
    }
    .wk-nodemo .wk-head {
      grid-row: 1;
    }
    .wk-nodemo .wk-details {
      grid-row: 2;
    }
    .wk:not(.wk-live) .wk-demo :global(.df) {
      justify-items: end;
    }
    /* Wide demos (desktop window, diagram): full width under the summary. */
    .wk-wide article {
      grid-template-areas:
        'meta head head'
        'skills demo demo'
        'skills details details';
      grid-template-rows: auto auto 1fr;
    }
    .wk-wide .wk-demo {
      margin-top: var(--space-6);
    }
  }
</style>
