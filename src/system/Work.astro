---
// Work: engagements with a demo get the full layout (story, what I did, the live demo inline
// beside it, after the summary on phones). The rest follow as a compact list, each summary in
// a disclosure. Sector and role sit inline above each title.
// WO-015: on laptops each demo engagement is one pane, one viewport tall below the nav (WO-023
// removed the page snap; the header's stepper moves pane to pane). Skills are badges: a
// deliberate, non-interactive stamp, not a quiet list.
// WO-019: the header's stepper and jump list move between panes and put focus on the pane's
// heading (tabindex -1), so keyboard users land where they went.
// WO-024: on phones (under 760px, scripting on) only the first demo shows inline. The others
// wait behind a "Try the demo" button and hydrate when it reveals them (client:visible never
// fires while they are display: none). Without scripting they all show, as before.
// WO-025: the button is a button (outlined, "Try the demo: {name}", its one line as the
// description), revealing does not jump the page, and the demos add no region landmarks: the
// revealed wrapper is a named group, and only once it has been revealed.
// WO-028: on phones every demo waits behind its button, the first one too, so Work is a run of
// stories and Projects comes sooner. The button is filled with the accent and centred ("Try the
// demo: {name} ▸"); the skill tags beside it are plain text in a hairline, with no fill.
// WO-032: Work starts a step sooner after the hero, and the first pane's engagement starts at its
// top, so the work shows on common laptops. On phones the button is a toggle ("Hide demo" while
// open, aria-expanded) and its one line stays as the demo's caption; a hidden demo stays mounted;
// open demos come back after Back (sessionStorage). The demo's own group is the only group. The
// skill tags are plain text separated by middots.
// WO-034: the panes lock in again. On laptops (a fine pointer, 760px and up) one wheel or trackpad
// gesture moves exactly one demo pane, flush under the header, never back to the pane it started
// in, and the page scrolls natively past the last pane and above the first. It is a small module
// script (work-paging.ts), not `scroll-snap-type: y mandatory`: mandatory snapping would need snap
// points over the whole page, can snap back to the starting pane (WO-023's trap) and carries a
// trackpad fling differently in Chromium, Firefox and Safari. The reasons are in the module.
// WO-040: phones (under 760px, scripting on) show each demo engagement short: sector and role,
// the title and the intro line, a still of the app's first screen (tapping it is the same as
// "Try the demo"), then one row with the button and a "Details" toggle. The summary, what I did,
// outcomes and skills wait behind Details. An opened demo lands flush under the header, a second
// "Hide demo" follows it, and a tap inside it before it hydrates is replayed once it has.
// 760px and up is unchanged: no still, no toggle, everything open.
// Spacing: the section's padding is the shared rhythm (.ln-sec in liner.css).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Work } from '../lib/content';
import airlineShot from '../assets/work/airline.webp';
import grocerShot from '../assets/work/grocer.webp';
import pipelineShot from '../assets/work/pipeline.webp';
import schedulerShot from '../assets/work/scheduler.webp';
import AirlineDemo from '../demos/airline/AirlineDemo.tsx';
import GrocerDemo from '../demos/grocer/GrocerDemo.tsx';
import PipelineDemo from '../demos/pipeline/PipelineDemo.tsx';
import SchedulerDemo from '../demos/scheduler/SchedulerDemo.tsx';
import DemoFrame from './DemoFrame.astro';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  work: Work[];
}
const { work } = Astro.props;
const companies = [...new Set(work.map((w) => w.data.years))];
const lead = `Client engagements at ${companies.join(' and ')}. The ones with a demo come first; each demo is playable, built on an invented brand and mock data.`;
// Demos that are built. Others with a demo show the "coming soon" plate.
const LIVE = new Set(['airline', 'grocer', 'pipeline', 'scheduler']);
// Wide demos (desktop window, diagram) sit full-width under the summary on desktop.
const isWide = (frame: string) => frame === 'desktop' || frame === 'diagram';
const caption = 'Playable. Invented brand, mock data.';
const featured = work.filter((w) => w.data.demo !== 'none');
// The "Try the demo" button's name and one line, per demo.
const TRY: Record<string, { name: string; line: string }> = {
  airline: { name: 'Airline loyalty app', line: 'Track tier progress, book a reward.' },
  grocer: { name: 'Grocer loyalty app', line: 'Load offers, build a list, earn points.' },
  scheduler: { name: 'Nurse scheduler', line: 'Fill an open shift within the rules.' },
  pipeline: { name: 'AI program pipeline', line: 'Transcript to exec update, step by step.' },
};
// WO-040: the phone still of each app's first screen, captured from the demo at 375 in the light
// theme and cropped to 343 × 200 (see factory/decisions.md).
const SHOT: Record<string, { src: ImageMetadata; alt: string }> = {
  airline: {
    src: airlineShot,
    alt: 'The airline app home screen: a greeting and a plum member card with Gold status and 48,250 points.',
  },
  grocer: {
    src: grocerShot,
    alt: 'The grocer app home screen: a 4,650 points balance and a bar showing 350 points to $10 off.',
  },
  scheduler: {
    src: schedulerShot,
    alt: 'The scheduler roster: nurses down the side with their hours, days across, and day and night shifts in the cells.',
  },
  pipeline: {
    src: pipelineShot,
    alt: 'The pipeline at step 1 of 5, Meeting transcript in: a stand-up recording with its speakers listed.',
  },
};
const others = work.filter((w) => w.data.demo === 'none');
---

<section id="work" class="ln-sec work" aria-labelledby="work-h">
  <div class="ln-wrap">
    <SideHead title="Work" id="work-h" lead={lead} layout="aside" />

    <ol class="wk-list">
      {featured.map((w) => {
        const d = w.data;
        const hid = `work-${w.id}`;
        const live = LIVE.has(d.demo);
        const wide = live && isWide(d.demoFrame);
        const tryIt = live ? TRY[d.demo] : undefined;
        const shot = tryIt ? SHOT[d.demo] : undefined;
        return (
          <li class:list={['wk', live && 'wk-live', wide && 'wk-wide']}>
            <article aria-labelledby={hid} class:list={[tryIt && 'wk-collapse']}>
              <div class="wk-head">
                <p class="wk-meta">
                  <span class="label">{d.sector}</span>
                  <span class="wk-role">
                    <span class="visually-hidden">Role: </span>
                    {d.role}
                  </span>
                  {d.status === 'placeholder' && <Placeholder />}
                </p>
                <h3 id={hid} class="wk-title" tabindex="-1">
                  {d.title}
                </h3>
                <p class="wk-kicker">{d.kicker}</p>
                <p class="wk-summary" id={`${hid}-sum`}>
                  {d.summary}
                </p>
              </div>

              {shot && (
                <div class="wk-shot" data-wk-shot>
                  <Image
                    src={shot.src}
                    alt={shot.alt}
                    widths={[343, 686, 1029]}
                    sizes="min(384px, calc(100vw - 2rem))"
                    quality={70}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}

              {tryIt && (
                <div class="wk-try">
                  <div class="wk-try-row">
                    <button
                      type="button"
                      class="wk-try-b"
                      data-wk-try
                      data-wk-name={tryIt.name}
                      aria-controls={`${hid}-demo`}
                      aria-expanded="false"
                      aria-label={`Try the demo: ${tryIt.name}`}
                      aria-describedby={`${hid}-try-d`}
                    >
                      Try the demo <span aria-hidden="true">▸</span>
                    </button>
                    <button
                      type="button"
                      class="wk-more-b"
                      data-wk-more
                      aria-expanded="false"
                      aria-controls={`${hid}-sum ${hid}-details ${hid}-skillset`}
                      aria-label={`Details: ${d.title}`}
                    >
                      Details
                    </button>
                  </div>
                  <p class="wk-try-d" id={`${hid}-try-d`}>
                    {tryIt.line}
                  </p>
                </div>
              )}
              <div class="wk-demo" id={tryIt ? `${hid}-demo` : undefined}>
                {d.demo === 'airline' && (
                  <DemoFrame frame={d.demoFrame} caption={caption} tint={['#3d2c5e', '#f6f3fb']}>
                    <AirlineDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'grocer' && (
                  <DemoFrame frame={d.demoFrame} caption={caption} tint={['#134e4a', '#f3f6f4']}>
                    <GrocerDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'pipeline' && (
                  <DemoFrame
                    frame={d.demoFrame}
                    caption="Interactive. Invented project, mock data."
                  >
                    <PipelineDemo client:visible />
                  </DemoFrame>
                )}
                {d.demo === 'scheduler' && (
                  <DemoFrame
                    frame={d.demoFrame}
                    caption="Interactive. Invented unit and staff, mock data."
                  >
                    <SchedulerDemo client:visible />
                  </DemoFrame>
                )}
                {!live && <DemoFrame frame={d.demoFrame} coming size="sm" />}
                {tryIt && (
                  <button
                    type="button"
                    class="wk-try-b wk-hide"
                    data-wk-hide
                    aria-label={`Hide demo: ${tryIt.name}`}
                  >
                    Hide demo
                  </button>
                )}
              </div>

              <div class="wk-details" id={`${hid}-details`}>
                <h4 class="wk-h label">What I did</h4>
                <ul class="wk-ul">
                  {d.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                {d.outcomes.length > 0 && (
                  <>
                    <h4 class="wk-h label">Outcomes</h4>
                    <ul class="wk-ul wk-outcomes">
                      {d.outcomes.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  </>
                )}
              </div>

              <div class="wk-skills" id={`${hid}-skillset`}>
                <h4 class="wk-skills-h label" id={`${hid}-skills`}>
                  Skills
                </h4>
                <ul class="wk-badges" aria-labelledby={`${hid}-skills ${hid}`}>
                  {d.skills.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        );
      })}
    </ol>

    {others.length > 0 && (
      <section class="wk-more" aria-labelledby="work-more-h">
        <h3 id="work-more-h" class="wk-more-h label" tabindex="-1">
          More client work
        </h3>
        <ul class="wk-more-list">
          {others.map((w) => {
            const d = w.data;
            return (
              <li class="wk-item">
                <p class="wk-meta">
                  <span class="label">{d.sector}</span>
                  <span class="wk-role">
                    <span class="visually-hidden">Role: </span>
                    {d.role}
                  </span>
                  {d.status === 'placeholder' && <Placeholder />}
                </p>
                <h4 class="wk-item-title">{d.title}</h4>
                <p class="wk-item-kicker">{d.kicker}</p>
                <details class="wk-disc">
                  <summary>
                    Details<span class="visually-hidden">: {d.title}</span>
                  </summary>
                  <div class="wk-disc-body">
                    <p>{d.summary}</p>
                    <ul class="wk-ul">
                      {d.contributions.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</section>

<script>
  import './work-paging';

  // The phone "Try the demo" toggle (WO-032). Opening shows the demo, so client:visible hydrates
  // it as it comes into view, and moves focus to the demo's own group (the only group: the
  // wrapper has no role or name) without scrolling. WO-040: then the page brings the demo's
  // screen flush under the header (the still and the caption make way), so the app opens on
  // screen. The button becomes "Hide demo", and a second "Hide demo" follows the demo. Hiding
  // only hides the demo (it stays mounted), returns focus to the toggle and brings the
  // engagement's title back into view. Which demos are open is kept in sessionStorage for this
  // page: Back from a case study (or a reload) opens them again, before the browser restores the
  // scroll position.
  const KEY = 'wk-open';
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-wk-try]')];
  const parts = (btn: HTMLButtonElement) => ({
    article: btn.closest('article'),
    demo: document.getElementById(btn.getAttribute('aria-controls') ?? ''),
  });
  const label = new Map(buttons.map((b) => [b, b.innerHTML]));

  const save = () => {
    try {
      const open = buttons
        .filter((b) => b.getAttribute('aria-expanded') === 'true')
        .map((b) => b.getAttribute('aria-controls'));
      sessionStorage.setItem(KEY, JSON.stringify(open));
    } catch {
      // storage unavailable: the toggles still work, they just aren't remembered
    }
  };

  const set = (btn: HTMLButtonElement, open: boolean) => {
    const { article } = parts(btn);
    const name = btn.dataset.wkName ?? '';
    article?.toggleAttribute('data-open', open);
    btn.setAttribute('aria-expanded', String(open));
    if (open) {
      btn.setAttribute('aria-label', `Hide demo: ${name}`);
      btn.textContent = 'Hide demo';
    } else {
      btn.setAttribute('aria-label', `Try the demo: ${name}`);
      btn.innerHTML = label.get(btn) ?? '';
    }
  };

  const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nav = () =>
    parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--ln-header'));

  const hide = (btn: HTMLButtonElement) => {
    const { article } = parts(btn);
    set(btn, false);
    save();
    btn.focus({ preventScroll: true });
    // The title back in view: the engagement's first line (sector and role) under the header.
    const meta = article?.querySelector<HTMLElement>('.wk-meta');
    const title = article?.querySelector('.wk-title')?.getBoundingClientRect();
    if (meta && title && (title.top < nav() || title.bottom > innerHeight)) {
      meta.scrollIntoView({ block: 'start', behavior: 'instant' });
    }
  };

  for (const btn of buttons) {
    const { article, demo } = parts(btn);
    if (!article || !demo) continue;
    btn.addEventListener('click', () => {
      if (btn.getAttribute('aria-expanded') === 'true') return hide(btn);
      set(btn, true);
      save();
      const group = demo.querySelector<HTMLElement>('.df-screen [role="group"]') ?? demo;
      group.tabIndex = -1;
      group.focus({ preventScroll: true });
      const screen = demo.querySelector<HTMLElement>('.df-screen') ?? demo;
      screen.scrollIntoView({ block: 'start', behavior: still() ? 'instant' : 'smooth' });
    });
    // The still is a larger target for the same button (pointer only; the button is the control).
    article.querySelector('[data-wk-shot]')?.addEventListener('click', () => btn.click());
    article.querySelector('[data-wk-hide]')?.addEventListener('click', () => hide(btn));
    // Details: the summary, what I did, outcomes and skills (phones only; open from 760px).
    const more = article.querySelector<HTMLButtonElement>('[data-wk-more]');
    more?.addEventListener('click', () => {
      const open = more.getAttribute('aria-expanded') !== 'true';
      more.setAttribute('aria-expanded', String(open));
      article.toggleAttribute('data-details', open);
    });
  }

  // Restore on Back or reload; a fresh visit starts with every demo closed.
  try {
    const entry = performance.getEntriesByType('navigation')[0] as
      PerformanceNavigationTiming | undefined;
    if (entry && (entry.type === 'back_forward' || entry.type === 'reload')) {
      const open = new Set(JSON.parse(sessionStorage.getItem(KEY) ?? '[]') as string[]);
      for (const btn of buttons)
        if (open.has(btn.getAttribute('aria-controls') ?? '')) set(btn, true);
    } else {
      sessionStorage.removeItem(KEY);
    }
  } catch {
    // storage unavailable or unreadable: start closed
  }

  // WO-040: on phones the airline and grocer apps grow to their content and the page scrolls
  // them (their CSS), so the app's own "back to the top" on a new tab would do nothing. When a
  // tab is selected while the app's top is above the header, bring the screen back under it.
  const phone = matchMedia('(max-width: 759.98px)');
  for (const btn of buttons) {
    const screen = parts(btn).demo?.querySelector<HTMLElement>('.df-phone .df-screen');
    if (!screen) continue;
    new MutationObserver((records) => {
      if (!phone.matches) return;
      const picked = records.some(
        (r) => (r.target as Element).getAttribute('aria-selected') === 'true',
      );
      if (picked && screen.getBoundingClientRect().top < nav()) {
        screen.scrollIntoView({ block: 'start', behavior: 'instant' });
      }
    }).observe(screen, { subtree: true, attributes: true, attributeFilter: ['aria-selected'] });
  }

  // WO-040: a tap inside a demo before it hydrates (a slow phone) is kept, not lost: the same
  // treatment as Billable's Play (WO-029, WO-033). The island is marked pending and busy, and once
  // Astro has hydrated it the last such tap is replayed on the same element.
  const pending = new Map<Element, HTMLElement>();
  document.addEventListener(
    'click',
    (e) => {
      if (!e.isTrusted) return;
      const target = e.target as Element | null;
      const island = target?.closest?.('#work .wk-demo astro-island[ssr]');
      const control = target?.closest<HTMLElement>('button, a, [role="tab"], summary, label');
      if (!island || !control || !island.contains(control)) return;
      const first = !pending.has(island);
      pending.set(island, control);
      if (!first) return;
      const screen = island.closest('.df-screen');
      island.setAttribute('data-pending', '');
      screen?.setAttribute('aria-busy', 'true');
      island.addEventListener(
        'astro:hydrate',
        () =>
          // The root commits in a transition: give it two frames before replaying.
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              const el = pending.get(island);
              pending.delete(island);
              island.removeAttribute('data-pending');
              screen?.removeAttribute('aria-busy');
              if (el?.isConnected) el.click();
            }),
          ),
        { once: true },
      );
    },
    true,
  );
</script>

<style>
  .wk-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .wk {
    border-bottom: var(--ln-hairline);
    /* A jump, a step or a wheel page (work-paging.ts) lands a pane's top flush under the header,
       like a section band (liner.css). There is no CSS scroll snap (WO-023, WO-034). */
    scroll-margin-top: var(--ln-flush);
  }
  .wk article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'try' 'demo' 'details' 'skills';
    padding-block: var(--space-7);
  }
  .wk-demo,
  .wk-details {
    margin-top: var(--space-5);
  }

  /* Sector (label) and role, one line above the title */
  .wk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-bottom: var(--space-2);
  }
  .wk-role {
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
  }
  .wk-meta :global(.ln-ph) {
    align-self: center;
  }

  /* Story */
  .wk-head {
    grid-area: head;
    max-width: var(--measure);
    /* "Try the demo" scrolls the head flush under the header (WO-025). */
    scroll-margin-top: var(--ln-flush);
  }
  /* Focus arrives here from the header's stepper; the pane coming into view is the cue. */
  body.ln :is(.wk-title, .wk-more-h):focus {
    outline: none;
  }
  body.ln .wk-title {
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .wk-kicker {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }
  .wk-summary {
    margin-top: var(--space-4);
  }
  .wk-details {
    grid-area: details;
    max-width: var(--measure);
  }
  body.ln .wk-h {
    margin: var(--space-5) 0 0;
  }
  body.ln .wk-h:first-child {
    margin-top: 0;
  }
  .wk-ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .wk-ul li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--ln-ink-2);
  }
  .wk-ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: var(--space-3);
    height: 1px;
    background: var(--ln-ink-3);
  }
  .wk-outcomes li {
    color: var(--ln-ink);
    font-weight: 600;
  }

  /* Demo, inline */
  .wk-demo {
    grid-area: demo;
    min-width: 0;
  }
  .wk:not(.wk-live) .wk-demo :global(.df) {
    justify-items: start;
  }
  /* Focus lands on a revealed demo; keyboard users see where. */
  .wk-demo:focus-visible {
    outline-offset: var(--space-2);
  }

  /* Try the demo (phones): a filled accent button in the demo's place, label centred, with its
     one line under it, until it is pressed. The one filled control in Work, so it reads as a
     button and the plain skill tags don't. Hover and focus shift the fill towards the ink
     (contrast rises in both schemes); press shifts it further and scales. */
  .wk-try {
    display: none;
    grid-area: try;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }
  .wk-try-b {
    display: block;
    width: 100%;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-2);
    background: var(--ln-accent);
    color: var(--ln-accent-ink);
    font: inherit;
    font-weight: 700;
    line-height: var(--leading-snug);
    text-align: center;
    text-wrap: balance;
    cursor: pointer;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  .wk-try-b:hover,
  .wk-try-b:focus-visible {
    background: color-mix(in oklch, var(--ln-accent) 85%, var(--ln-ink));
  }
  .wk-try-b:active {
    background: color-mix(in oklch, var(--ln-accent) 75%, var(--ln-ink));
    scale: var(--press-scale);
  }
  /* Open, it is "Hide demo": outlined in the ink, so the demo under it is the thing to look at.
     The second "Hide demo" under an open demo (WO-040) looks the same. */
  .wk-try-b:is([aria-expanded='true'], .wk-hide) {
    border-color: var(--ln-ink-2);
    background: transparent;
    color: var(--ln-ink);
  }
  .wk-try-b:is([aria-expanded='true'], .wk-hide):is(:hover, :focus-visible) {
    background: color-mix(in oklch, var(--ln-ink) 6%, transparent);
  }
  .wk-try-b:is([aria-expanded='true'], .wk-hide):active {
    background: color-mix(in oklch, var(--ln-ink) 12%, transparent);
  }
  body.ln .wk-try-d {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }
  /* WO-040: the phone-only parts (the still, the Details toggle, the second "Hide demo") are off
     unless the phone layout below turns them on. */
  .wk-shot,
  .wk-hide {
    display: none;
  }
  /* Phones: with every demo behind its button, an engagement is a story and a button, so it
     takes a step less padding (WO-028). */
  @media (max-width: 759.98px) {
    .wk article {
      padding-block: var(--space-6);
    }
  }
  /* WO-040: phones, scripting on. An engagement is its sector and role, title, intro line, a still
     of the app and one row: "Try the demo" and "Details". The story's parts become the
     article's own grid items, so the summary can wait behind Details with what I did, outcomes
     and skills; the demo comes last. */
