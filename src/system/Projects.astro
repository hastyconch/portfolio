---
// Projects: things I've built on my own time. Phones: a vertical list. Desktop: a horizontal
// rail of cards (scroll-snap; arrow buttons scroll it, and it scrolls natively too).
import type { Project } from '../lib/content';
import ProjectCard from './ProjectCard.astro';
import SideHead from './SideHead.astro';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---

<section id="projects" class="ln-sec projects" aria-labelledby="projects-h">
  <div class="ln-wrap">
    <SideHead
      title="Projects"
      id="projects-h"
      lead="Apps, games and tools I've built on my own time. Each one has a case study: the problem, what it does today and the stack."
    >
      <div class="rail-btns">
        <button type="button" class="rail-btn" data-rail="-1" aria-controls="rail">
          <span aria-hidden="true">←</span>
          <span class="visually-hidden">Scroll projects back</span>
        </button>
        <button type="button" class="rail-btn" data-rail="1" aria-controls="rail">
          <span aria-hidden="true">→</span>
          <span class="visually-hidden">Scroll projects forward</span>
        </button>
      </div>
    </SideHead>
  </div>
  <ol class="rail" id="rail" aria-label="Projects">
    {projects.map((p) => (
      <ProjectCard project={p} />
    ))}
  </ol>
</section>

<script>
  const rail = document.getElementById('rail');
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-rail]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  function sync() {
    if (!rail) return;
    const max = rail.scrollWidth - rail.clientWidth - 2;
    btns.forEach((b) => {
      const dir = Number(b.dataset.rail);
      b.disabled = dir < 0 ? rail.scrollLeft <= 2 : rail.scrollLeft >= max;
    });
  }
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      if (!rail) return;
      const step = Math.max(320, rail.clientWidth * 0.8) * Number(b.dataset.rail);
      rail.scrollBy({ left: step, behavior: reduce.matches ? 'auto' : 'smooth' });
    }),
  );
  rail?.addEventListener('scroll', sync, { passive: true });
  addEventListener('resize', sync);
  sync();
</script>

<style>
  .projects {
    padding-bottom: var(--space-8);
  }
  /* One section per screen (WO-021): on laptops Projects is one pane below the nav, heading and
     rail together, and the page settles on it like a Work pane (the root snaps only at 760px and
     up with motion allowed). Taller content grows the pane rather than clipping it. */
  @media (min-width: 1100px) and (min-height: 600px) {
    .projects {
      display: grid;
      /* minmax(0, …): the rail scrolls sideways inside its column instead of widening it */
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      min-height: calc(100svh - var(--ln-header));
      padding-block: clamp(var(--space-4), 4svh, var(--space-6));
      scroll-snap-align: start;
      scroll-margin-top: calc(var(--ln-header) - var(--ln-scroll-pad, var(--ln-header)));
    }
    /* Auto margins would size the rail to its cards (fit-content) in the grid; no margins let it
       stretch to the column and scroll inside it. */
    .projects .rail {
      margin-inline: 0;
    }
  }
  .rail-btns {
    display: none;
  }
  .rail {
    margin: 0 auto;
    padding: 0 var(--ln-gutter);
    max-width: var(--ln-max);
    list-style: none;
    border-top: var(--ln-hairline);
  }

  @media (min-width: 900px) {
    .rail-btns {
      display: flex;
      gap: var(--space-2);
    }
    .rail-btn {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: var(--radius-2);
      border: var(--ln-hairline);
      background: transparent;
      color: var(--ln-ink);
      font: inherit;
      font-size: var(--text-lg);
      cursor: pointer;
      transition:
        background-color var(--dur-quick) var(--ease-out),
        color var(--dur-quick) var(--ease-out),
        scale var(--dur-quick) var(--ease-out);
    }
    .rail-btn:hover:not(:disabled),
    .rail-btn:focus-visible:not(:disabled) {
      background: var(--ln-ink);
      color: var(--ln-bg);
    }
    .rail-btn:active:not(:disabled) {
      scale: var(--press-scale);
    }
    .rail-btn:disabled {
      color: var(--ln-ink-3);
      cursor: default;
    }
    .rail {
      display: flex;
      gap: var(--space-6);
      max-width: none;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(var(--ln-gutter), (100vw - var(--ln-max)) / 2 + var(--ln-gutter));
      padding: var(--space-3) max(var(--ln-gutter), (100vw - var(--ln-max)) / 2 + var(--ln-gutter))
        var(--space-6);
      border-top: 0;
      scrollbar-width: thin;
      scrollbar-color: var(--ln-rule) transparent;
    }
  }
</style>
