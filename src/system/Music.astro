---
// Music: the one section where the record theme lives. It opens with the music story (from
// src/content/music.json), then the songs as a tablist of sleeves; each song panel has art,
// credits, a link to the song's own page, click-to-load players and the lyrics annotator.
// SongArt, the players and Lyrics are shared with the /music/<id>/ pages.
import type { Music, Song } from '../lib/content';
import Placeholder from './Placeholder.astro';
import SongArt from './SongArt.astro';
import Lyrics from './Lyrics.astro';
import Players from './Players.astro';
import { Image } from 'astro:assets';
import { voice } from '../lib/music';

interface Props {
  songs: Song[];
  /** Songs by other artists that feature me: listen only, no page or lyrics. */
  features?: Song[];
  music: Music;
}
const { songs, features = [], music } = Astro.props;
const say = voice(music);

const pad = (n: number) => String(n).padStart(2, '0');
const first = songs[0]?.data.artColors ?? ['#3b1f5e', '#e07a5f'];
const placeholder =
  music.status === 'placeholder' || songs.some((s) => s.data.status === 'placeholder');
const [lead, ...story] = music.story.map(say);
---

<section
  id="music"
  class="ln-sec music ln-dark"
  aria-labelledby="music-h"
  style={`--mu-tint: ${first[0]}`}
>
  <div class="ln-wrap">
    <header class="mu-intro">
      <h2 id="music-h" class="mu-h2 label">
        Music
      </h2>
      <div class="mu-story" data-story>
        <p class="mu-story-lead">{lead}</p>
        {story.map((p) => (
          <p class="mu-story-p">{p}</p>
        ))}
        <ul class="mu-story-facts">
          <li>Released {music.releasedAs ? `as ${music.releasedAs}` : 'on streaming services'}</li>
          {music.links.map((l) => (
            <li>
              <a class="ln-link" href={l.href} rel="noopener">
                {l.label}
              </a>
            </li>
          ))}
          {placeholder && (
            <li>
              <Placeholder label="Story & lyrics to come" />
            </li>
          )}
        </ul>
      </div>
    </header>

    <div class="mu-tabs" role="tablist" aria-label="Songs">
      {songs.map((s, i) => (
        <button
          type="button"
          role="tab"
          class="mu-tab"
          id={`mu-tab-${s.id}`}
          aria-controls={`mu-panel-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-c1={s.data.artColors[0]}
          style={`--c1: ${s.data.artColors[0]}; --c2: ${s.data.artColors[1]}`}
        >
          <span class:list={['mu-tab-art', s.data.art && 'has-art']} aria-hidden="true">
            {s.data.art && (
              <Image
                class="mu-tab-img"
                src={s.data.art}
                alt=""
                widths={[96, 192]}
                sizes="96px"
                loading="lazy"
                decoding="async"
              />
            )}
            <span class="ln-num">{pad(i + 1)}</span>
          </span>
          <span class="mu-tab-text">
            <span class="mu-tab-t">{s.data.title}</span>
            <span class="mu-tab-y ln-num">{s.data.year}</span>
          </span>
        </button>
      ))}
    </div>

    {songs.map((s, i) => {
      const d = s.data;
      return (
        <div
          class="mu-panel"
          role="tabpanel"
          id={`mu-panel-${s.id}`}
          aria-labelledby={`mu-tab-${s.id}`}
          hidden={i !== 0}
          style={`--c1: ${d.artColors[0]}; --c2: ${d.artColors[1]}`}
        >
          <div class="mu-head">
            <SongArt song={s} index={i} />
            <div class="mu-info">
              <p class="mu-k">
                <span class="label">
                  Track {i + 1} · {d.year}
                </span>
                {d.status === 'placeholder' && <Placeholder />}
              </p>
              <h3 class="mu-title">{d.title}</h3>
              <p class="mu-credits">{say(d.credits)}</p>
              {d.release && <p class="mu-release">{d.release}</p>}
              <div class="mu-about">
                <h4 class="label">About this song</h4>
                <p>{say(d.meaning)}</p>
              </div>
              <p>
                <a class="mu-page ln-link" href={`/music/${s.id}/`} data-song-link>
                  Open the song page<span class="visually-hidden">: {d.title}</span>
                  <span aria-hidden="true">&nbsp;→</span>
                </a>
              </p>
              <Players song={s} />
            </div>
          </div>

          <Lyrics song={s} level={4} say={say} />
        </div>
      );
    })}

    {features.length > 0 && (
      <section class="mu-feat" aria-labelledby="mu-feat-h">
        <h3 id="mu-feat-h" class="label">
          Appears on
        </h3>
        <ul class="mu-feat-list">
          {features.map((f) => (
            <li
              class="mu-feat-item"
              style={`--c1: ${f.data.artColors[0]}; --c2: ${f.data.artColors[1]}`}
            >
              <span class="mu-feat-art" aria-hidden="true">
                {f.data.art && (
                  <Image
                    src={f.data.art}
                    alt=""
                    widths={[120, 240]}
                    sizes="120px"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
              <div class="mu-feat-text">
                <p class="mu-feat-t">{f.data.title}</p>
                <p class="mu-feat-c">{say(f.data.credits)}</p>
                {f.data.release && <p class="mu-feat-r">{f.data.release}</p>}
                <Players song={f} onlyAvailable />
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</section>

<script>
  // Tabs (automatic activation, roving tabindex). Lyrics and the players bring their own scripts.
  const root = document.getElementById('music');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      // The section's tint cross-fades to the song's colour (a registered custom property).
      if (tab.dataset.c1) root.style.setProperty('--mu-tint', tab.dataset.c1);
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let next = -1;
        if (k === 'ArrowRight' || k === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft' || k === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') next = 0;
        else if (k === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });
  }
</script>

<style>
  /* Registered so the tint interpolates: a real cross-fade between songs, not a snap. */
  @property --mu-tint {
    syntax: '<color>';
    inherits: true;
    initial-value: #3b1f5e;
  }
  .music {
    position: relative;
    overflow-x: clip;
    background-color: color-mix(in srgb, var(--mu-tint) 12%, var(--ln-bg));
    border-block: var(--ln-hairline);
    transition: --mu-tint var(--dur-slow) var(--ease-out);
  }

  /* Intro: the section opens with the story, not a big title. */
  .mu-intro {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .mu-story {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  .mu-story-lead {
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-title);
  }
  .mu-story-p {
    color: var(--ln-ink-2);
  }
  .mu-story-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
  }
  .mu-story-facts a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  /* Song tabs */
  .mu-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }
  .mu-tab {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-2);
    border: var(--ln-hairline);
    border-radius: var(--radius-3);
    background: transparent;
    color: var(--ln-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      border-color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  .mu-tab:hover,
  .mu-tab:focus-visible {
    background: var(--ln-hl);
  }
  .mu-tab:active {
    scale: var(--press-scale);
  }
  .mu-tab[aria-selected='true'] {
    border-color: var(--ln-ink-2);
    background: var(--ln-bg-3);
    box-shadow: inset 0 -2px 0 var(--ln-accent);
  }
  .mu-tab-art {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 1;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-1);
    background:
      repeating-linear-gradient(var(--c1) 0 12%, transparent 12% 26%) 0 52% / 100% 22% no-repeat,
      radial-gradient(circle at 64% 40%, var(--c2) 0 25%, transparent 25.4%),
      linear-gradient(
        172deg,
        color-mix(in oklab, var(--c1) 88%, #fff) 0%,
        var(--c1) 42%,
        color-mix(in oklab, var(--c1) 45%, #000) 100%
      );
    color: #fff;
    font-family: var(--ln-display);
    font-weight: 800;
    font-size: var(--text-md);
    line-height: var(--leading-tight);
  }
  .mu-tab-text {
    display: grid;
    min-width: 0;
  }
  .mu-tab-t {
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }
  .mu-tab-y {
    font-size: var(--text-xs);
    color: var(--ln-ink-3);
  }

  /* Song head */
  .mu-head {
    display: grid;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }
  .mu-info {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }
  .mu-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  body.ln .mu-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: var(--leading-tight);
  }
  .mu-credits {
    color: var(--ln-ink-2);
  }
  .mu-about {
    display: grid;
    gap: var(--space-1);
    max-width: 52ch;
    margin-top: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid var(--ln-rule);
  }
  .mu-about p {
    color: var(--ln-ink-2);
  }
  .mu-page {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (min-width: 900px) {
    .mu-intro {
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: clamp(2.5rem, 4vw, 4rem);
      align-items: baseline;
    }
    .mu-head {
      grid-template-columns: 360px minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
    .mu-tab {
      grid-template-columns: 64px minmax(0, 1fr);
      align-items: center;
      gap: var(--space-4);
    }
    .mu-tab-t {
      font-size: var(--text-md);
    }
  }
  .mu-release {
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  .mu-tab-art.has-art {
    position: relative;
    overflow: hidden;
  }
  .mu-tab-art :global(.mu-tab-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mu-tab-art.has-art .ln-num {
    position: relative;
    padding: 0 var(--space-1);
    border-radius: var(--radius-1);
    background: rgb(0 0 0 / 0.6);
  }

  /* Appears on: songs by other artists that feature me */
  .mu-feat {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--ln-hairline);
  }
  .mu-feat-list {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .mu-feat-item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-4) var(--space-5);
    align-items: start;
  }
  .mu-feat-art {
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius-1);
    overflow: hidden;
    background: linear-gradient(160deg, var(--c1), var(--c2));
  }
  .mu-feat-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mu-feat-t {
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-snug);
  }
  .mu-feat-c {
    margin-top: var(--space-1);
    color: var(--ln-ink-2);
  }
  .mu-feat-r {
    margin: var(--space-1) 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  @media (min-width: 760px) {
    .mu-feat-item {
      grid-template-columns: 140px minmax(0, 1fr);
    }
  }
</style>
