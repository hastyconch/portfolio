---
// Music: the one section where the record theme lives. It opens with a title and the music story
// (from src/content/music.json), then a stage: the selected song's panel and the songs as a
// tablist (a tracklist beside the panel on laptops, a strip of covers above it on phones). Each
// panel has the sleeve, one line of credits and release, a link to the song's page (full lyrics,
// notes on the lines and story; no lyric lines here) and click-to-load players. SongArt and
// Players are shared with the song pages. The selected song is kept in the URL (#song-<id>).
import type { Music, Song } from '../lib/content';
import Placeholder from './Placeholder.astro';
import SongArt from './SongArt.astro';
import Players from './Players.astro';
import { Image } from 'astro:assets';
import { voice } from '../lib/music';

interface Props {
  songs: Song[];
  /** Songs by other artists that feature me: listen only, no page or lyrics. */
  features?: Song[];
  music: Music;
}
const { songs, features = [], music } = Astro.props;
const say = voice(music);

const pad = (n: number) => String(n).padStart(2, '0');
const first = songs[0]?.data.artColors ?? ['#3b1f5e', '#e07a5f'];
const placeholder =
  music.status === 'placeholder' || songs.some((s) => s.data.status === 'placeholder');
// The section shows the songs itself, so a story sentence that only points at them
// ("Below are the songs…") is left out.
const notUi = (p: string) =>
  p
    .split(/(?<=[.!?])\s+/)
    .filter((s) => !/^Below\b/i.test(s))
    .join(' ');
const [lead, ...story] = music.story
  .map(say)
  .map(notUi)
  .filter((p) => p.trim());
---

<section
  id="music"
  class="ln-sec music ln-dark"
  aria-labelledby="music-h"
  style={`--mu-tint: ${first[0]}`}
>
  <div class="ln-wrap">
    <header class="mu-intro">
      <h2 id="music-h" class="mu-h2">
        Music
      </h2>
      <div class="mu-story" data-story>
        <p class="mu-story-lead">{lead}</p>
        {story.map((p) => (
          <p class="mu-story-p">{p}</p>
        ))}
        <ul class="mu-story-facts">
          <li>Released {music.releasedAs ? `as ${music.releasedAs}` : 'on streaming services'}</li>
          {music.links.map((l) => (
            <li>
              <a class="ln-link" href={l.href} rel="noopener">
                {l.label}
              </a>
            </li>
          ))}
          {placeholder && (
            <li>
              <Placeholder label="Story & lyrics to come" />
            </li>
          )}
        </ul>
      </div>
    </header>

    <div class="mu-stage">
      <div class="mu-tabs" role="tablist" aria-label="Songs" data-tabs>
        {songs.map((s, i) => (
          <button
            type="button"
            role="tab"
            class="mu-tab"
            id={`mu-tab-${s.id}`}
            aria-controls={`mu-panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-song={s.id}
            data-c1={s.data.artColors[0]}
            style={`--c1: ${s.data.artColors[0]}; --c2: ${s.data.artColors[1]}`}
          >
            <span class="mu-tab-n ln-num" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <span class:list={['mu-tab-art', s.data.art && 'has-art']} aria-hidden="true">
              {s.data.art && (
                <Image
                  class="mu-tab-img"
                  src={s.data.art}
                  alt=""
                  widths={[80, 160]}
                  sizes="(min-width: 900px) 40px, 80px"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </span>
            <span class="mu-tab-t">{s.data.title}</span>
            <span class="mu-tab-y ln-num">{s.data.year}</span>
          </button>
        ))}
      </div>

      {songs.map((s, i) => {
        const d = s.data;
        const notes = d.lyrics.filter((l) => l.note).length;
        // Promise the stories only once the song has notes on its lines (art. 7).
        const cta =
          notes > 0
            ? 'Read the lyrics and the stories behind the lines'
            : d.lyrics.length > 0
              ? 'Read the full lyrics'
              : 'Read about this song';
        const release = [say(d.credits), d.release].filter(Boolean).join(' · ');
        return (
          <div
            class="mu-panel"
            role="tabpanel"
            id={`mu-panel-${s.id}`}
            aria-labelledby={`mu-tab-${s.id}`}
            hidden={i !== 0}
            style={`--c1: ${d.artColors[0]}; --c2: ${d.artColors[1]}`}
          >
            <div class="mu-head">
              <SongArt song={s} index={i} />
              <div class="mu-info">
                <p class="mu-k">
                  <span class="label">
                    Track {i + 1} · {d.year}
                  </span>
                  {d.status === 'placeholder' && <Placeholder />}
                </p>
                <h3 class="mu-title">{d.title}</h3>
                <p class="mu-release">{release}</p>
                <div class="mu-about">
                  <h4 class="label">About this song</h4>
                  <p>{say(d.meaning)}</p>
                </div>
                <p class="mu-call">
                  <a class="mu-call-a" href={`/music/${s.id}/`} data-song-link>
                    {cta}
                    <span class="visually-hidden">: {d.title}</span>
                  </a>
                  <span class="mu-call-arrow" aria-hidden="true">
                    →
                  </span>
                </p>
                <Players song={s} onlyAvailable />
              </div>
            </div>
          </div>
        );
      })}
    </div>

    {features.length > 0 && (
      <section class="mu-feat" aria-labelledby="mu-feat-h">
        <h3 id="mu-feat-h" class="label">
          Appears on
        </h3>
        <ul class="mu-feat-list">
          {features.map((f) => (
            <li
              class="mu-feat-item"
              style={`--c1: ${f.data.artColors[0]}; --c2: ${f.data.artColors[1]}`}
            >
              <span class="mu-feat-art" aria-hidden="true">
                {f.data.art && (
                  <Image
                    src={f.data.art}
                    alt=""
                    widths={[120, 240]}
                    sizes="120px"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </span>
              <div class="mu-feat-text">
                <p class="mu-feat-t">{f.data.title}</p>
                <p class="mu-feat-c">{say(f.data.credits)}</p>
                {f.data.release && <p class="mu-feat-r">{f.data.release}</p>}
                <Players song={f} onlyAvailable />
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</section>

<script>
  // Tabs (automatic activation, roving tabindex). The selected song lives in the URL as
  // #song-<id> (replaced, not pushed), so a reload, a shared link, the song page's "All songs"
  // link and Back from a song page all come back to it. Lyrics and the players bring their own
  // scripts.
  const root = document.getElementById('music');
  const strip = root?.querySelector<HTMLElement>('[data-tabs]');
  if (root && strip) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    const panelOf = (t: HTMLButtonElement) =>
      document.getElementById(t.getAttribute('aria-controls') ?? '');
    const select = (tab: HTMLButtonElement, focus = false, remember = true) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = panelOf(t);
        if (!panel || panel.hidden === !on) return;
        panel.hidden = !on;
        // SongArt holds the cover and record back until the cover is ready (same task, so the
        // panel is never painted with a half-loaded sleeve).
        if (on) panel.dispatchEvent(new Event('sa:show', { bubbles: true }));
      });
      // The section's tint cross-fades to the song's colour (a registered custom property).
      if (tab.dataset.c1) root.style.setProperty('--mu-tint', tab.dataset.c1);
      if (remember && tab.dataset.song)
        history.replaceState(history.state, '', `#song-${tab.dataset.song}`);
      if (focus) tab.focus();
    };
    // Phones: the panel sits under the strip; if a tap leaves it mostly below the fold, bring it up
    // (otherwise the tap seems to do nothing).
    const reveal = (tab: HTMLButtonElement) => {
      const panel = panelOf(tab);
      if (!panel || panel.getBoundingClientRect().top < innerHeight * 0.6) return;
      panel.scrollIntoView({ block: 'nearest', behavior: motion.matches ? 'smooth' : 'auto' });
    };
    // Start fetching a song's cover on hover or focus, so it's usually ready by the click.
    const warm = (t: HTMLButtonElement) => {
      const img = panelOf(t)?.querySelector<HTMLImageElement>('[data-sa] img');
      if (img) img.loading = 'eager';
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => {
        select(t);
        reveal(t);
      });
      t.addEventListener('pointerenter', () => warm(t));
      t.addEventListener('focus', () => warm(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let next = -1;
        if (k === 'ArrowRight' || k === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft' || k === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') next = 0;
        else if (k === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });

    // Arriving on /#song-<id>: select that song and land on the section. On Back or Forward the
    // browser restores the scroll position itself.
    const fromHash = () => {
      const id = /^#song-(.+)$/.exec(location.hash)?.[1];
      const tab = id && tabs.find((t) => t.dataset.song === decodeURIComponent(id));
      if (!tab) return;
      if (tab.getAttribute('aria-selected') !== 'true') select(tab, false, false);
      // Keep the selected cover in view in the phone strip (without moving the page).
      strip.scrollLeft = Math.max(0, tab.offsetLeft - tab.offsetWidth / 2);
      return tab;
    };
    const nav = performance.getEntriesByType('navigation')[0] as
      PerformanceNavigationTiming | undefined;
    if (fromHash() && nav?.type !== 'back_forward') root.scrollIntoView();
    // Restored from the back/forward cache, or the hash edited by hand.
    addEventListener('hashchange', () => {
      if (fromHash()) root.scrollIntoView();
    });
  }
</script>

<style>
  /* Registered so the tint interpolates: a real cross-fade between songs, not a snap. */
  @property --mu-tint {
    syntax: '<color>';
    inherits: true;
    initial-value: #3b1f5e;
  }
  .music {
    position: relative;
    overflow-x: clip;
    /* The title sits close under the header after a jump to #music. */
    padding-top: var(--space-7);
    background-color: color-mix(in srgb, var(--mu-tint) 12%, var(--ln-bg));
    border-block: var(--ln-hairline);
    transition: --mu-tint var(--dur-slow) var(--ease-out);
  }

  /* Intro: the section title (the same as the other sections'), then the story. */
  .mu-intro {
    display: grid;
    gap: var(--space-3) var(--space-6);
    margin-bottom: var(--space-6);
  }
  body.ln .mu-h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
  }
  .mu-story {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }
  .mu-story-lead {
    font-family: var(--ln-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-title);
  }
  .mu-story-p {
    color: var(--ln-ink-2);
  }
  .mu-story-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
  }
  .mu-story-facts a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  /* Stage: the tablist directly above the panel (phones), or beside it (laptops). */
  .mu-stage {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  .mu-panel {
    container-type: inline-size;
    min-width: 0;
    scroll-margin-top: var(--ln-scroll-pad);
    scroll-margin-bottom: var(--space-4);
  }

  /* Song tabs. Phones: a strip of covers with titles, scrolled sideways. */
  .mu-tabs {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 88px;
    gap: var(--space-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--space-1);
    /* Room for the focus ring inside the scroller. */
    padding: var(--space-2);
    margin-inline: calc(var(--space-2) * -1);
  }
  .mu-tab {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-1);
    border: 0;
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--ln-ink-2);
    font: inherit;
    text-align: left;
    cursor: pointer;
    scroll-snap-align: start;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      color var(--dur-quick) var(--ease-out),
      box-shadow var(--dur-quick) var(--ease-out);
  }
  .mu-tab:hover,
  .mu-tab:focus-visible {
    background: var(--ln-hl);
    color: var(--ln-ink);
  }
  .mu-tab:active {
    background: var(--ln-hl-hover);
  }
  /* Selected: the highlight plus an accent edge (not colour alone). */
  .mu-tab[aria-selected='true'] {
    background: var(--ln-hl);
    color: var(--ln-ink);
    box-shadow: inset 0 -2px 0 var(--ln-accent);
  }
  .mu-tab-n,
  .mu-tab-y {
    display: none;
  }
  .mu-tab-art {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-1);
    background:
      repeating-linear-gradient(var(--c1) 0 12%, transparent 12% 26%) 0 52% / 100% 22% no-repeat,
      radial-gradient(circle at 64% 40%, var(--c2) 0 25%, transparent 25.4%),
      linear-gradient(
        172deg,
        color-mix(in oklab, var(--c1) 88%, #fff) 0%,
        var(--c1) 42%,
        color-mix(in oklab, var(--c1) 45%, #000) 100%
      );
  }
  .mu-tab-art :global(.mu-tab-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mu-tab-t {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: calc(2em * var(--leading-snug));
    font-weight: 600;
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  /* Song head */
  .mu-head {
    display: grid;
    gap: var(--space-6);
  }
  .mu-info {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }
  .mu-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  body.ln .mu-title {
    font-size: var(--text-2xl);
    font-weight: 800;
    line-height: var(--leading-tight);
  }
  .mu-release {
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
  }
  .mu-about {
    display: grid;
    gap: var(--space-1);
    max-width: 52ch;
    margin-top: var(--space-2);
  }
  .mu-about p {
    color: var(--ln-ink-2);
  }

  /* The way to the song page: one primary link, as wide as the players below it. The whole row
     is the link's target (stretched ::after); the focus ring sits on the row. */
  .mu-call {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-1);
    border-block: var(--ln-hairline);
    border-radius: var(--radius-1);
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  .mu-call-a {
    font-family: var(--ln-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-title);
    color: var(--ln-ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .mu-call-a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  /* The row carries the focus ring (below). */
  body.ln .mu-call-a:focus-visible {
    outline: none;
  }
  /* The arrow moves (translate), which paints it above the link's ::after: let clicks through. */
  .mu-call-arrow {
    pointer-events: none;
    color: var(--ln-accent);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1;
    transition: translate var(--dur-quick) var(--ease-out);
  }
  .mu-call:hover,
  .mu-call:focus-within {
    background: var(--ln-hl);
  }
  .mu-call:has(:focus-visible) {
    outline: var(--focus-width) solid var(--ln-accent);
    outline-offset: var(--focus-offset);
  }
  .mu-call:hover .mu-call-a,
  .mu-call:focus-within .mu-call-a {
    text-decoration-color: currentColor;
  }
  .mu-call:hover .mu-call-arrow,
  .mu-call:focus-within .mu-call-arrow {
    translate: var(--move-sm) 0;
  }
  .mu-call:active {
    background: var(--ln-hl-hover);
  }
  .mu-call:active .mu-call-arrow {
    translate: 0 0;
  }

  /* Phones: a smaller sleeve, so the song's title is close under the strip. */
  .mu-head :global(.sa) {
    width: min(100%, 15rem);
  }
  /* Sleeve beside the details once the panel has the room. */
  @container (min-width: 40rem) {
    .mu-head {
      grid-template-columns: 17.5rem minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }
    .mu-head :global(.sa) {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .mu-intro {
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: clamp(2.5rem, 4vw, 4rem);
      align-items: baseline;
    }
    .music {
      padding-top: var(--space-8);
    }
    .mu-story-lead {
      font-size: var(--text-xl);
    }
    /* Laptops: the selected song on the left, the tracklist on the right. */
    .mu-stage {
      grid-template-columns: minmax(0, 1fr) 20rem;
      column-gap: var(--space-6);
    }
    .mu-tabs {
      grid-column: 2;
      grid-row: 1;
      grid-auto-flow: row;
      grid-auto-columns: auto;
      gap: 0;
      overflow: visible;
      padding: 0;
      margin: 0;
      border-block: var(--ln-hairline);
    }
    .mu-panel {
      grid-column: 1;
      grid-row: 1;
    }
    /* One row per song: number, cover, title, year; hairlines between rows, no cards. */
    .mu-tab {
      grid-template-columns: 2ch 40px minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-3);
      padding: var(--space-2) var(--space-3);
      border-radius: 0;
    }
    .mu-tab + .mu-tab {
      border-top: var(--ln-hairline);
    }
    .mu-tab[aria-selected='true'] {
      box-shadow: inset 2px 0 0 var(--ln-accent);
    }
    .mu-tab-n,
    .mu-tab-y {
      display: block;
      font-size: var(--text-sm);
      color: var(--ln-ink-3);
    }
    .mu-tab-t {
      display: block;
      min-height: 0;
      overflow: visible;
      font-size: var(--text-md);
    }
  }
  @media (min-width: 1100px) {
    .mu-stage {
      column-gap: var(--space-8);
    }
  }

  /* Appears on: songs by other artists that feature me */
  .mu-feat {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: var(--ln-hairline);
  }
  .mu-feat-list {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .mu-feat-item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-4) var(--space-5);
    align-items: start;
  }
  .mu-feat-art {
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius-1);
    overflow: hidden;
    background: linear-gradient(160deg, var(--c1), var(--c2));
  }
  .mu-feat-art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mu-feat-t {
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-snug);
  }
  .mu-feat-c {
    margin-top: var(--space-1);
    color: var(--ln-ink-2);
  }
  .mu-feat-r {
    margin: var(--space-1) 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  .mu-feat-text :global(.pl) {
    max-width: 30rem;
  }
  @media (min-width: 760px) {
    .mu-feat-item {
      grid-template-columns: 140px minmax(0, 1fr);
    }
  }
</style>
