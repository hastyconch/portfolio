---
// Music slot — Bonus tracks, the showcase of this direction. It opens with the music story (from
// src/content/music.json), then the songs as a tablist of sleeves; each song panel has art,
// credits, a link to the song's own page, click-to-load players and the lyrics annotator.
// SongArt, the players and Lyrics are shared with the /music/<id>/ pages.
import type { Music, Song } from '../lib/content';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';
import SongArt from './SongArt.astro';
import Lyrics from './Lyrics.astro';
import Players from './Players.astro';
import { Image } from 'astro:assets';
import { voice } from '../lib/music';

interface Props {
  songs: Song[];
  music: Music;
}
const { songs, music } = Astro.props;
const say = voice(music);

const years = [...new Set(songs.map((s) => s.data.year))].sort();
const pad = (n: number) => String(n).padStart(2, '0');
const first = songs[0]?.data.artColors ?? ['#3b1f5e', '#e07a5f'];
const placeholder =
  music.status === 'placeholder' || songs.some((s) => s.data.status === 'placeholder');
const [lead, ...story] = music.story.map(say);
---

<section
  id="music"
  class="ln-side music ln-dark"
  data-np="Bonus tracks · Music"
  aria-labelledby="music-h"
  style={`--c1: ${first[0]}; --c2: ${first[1]}`}
>
  <div class="mu-glow" aria-hidden="true"></div>
  <div class="ln-wrap mu-wrap">
    <SideHead
      badge="+"
      kicker="Bonus tracks"
      title="Music"
      id="music-h"
      meta={`${songs.length} songs · ${years.length > 1 ? `${years[0]}–${years.at(-1)}` : years[0]}`}
    />

    <div class="mu-story" data-story>
      <p class="mu-story-lead">{lead}</p>
      {story.map((p) => (
        <p class="mu-story-p">{p}</p>
      ))}
      <ul class="mu-story-facts">
        <li>
          <span class="ln-eyebrow">Released</span>
          {music.releasedAs ? `as ${music.releasedAs}` : 'on streaming'}
        </li>
        {music.links.map((l) => (
          <li>
            <a href={l.href} rel="noopener">
              {l.label}
            </a>
          </li>
        ))}
        {placeholder && (
          <li>
            <Placeholder label="Story & lyrics to come" />
          </li>
        )}
      </ul>
    </div>

    <div class="mu-tabs" role="tablist" aria-label="Songs">
      {songs.map((s, i) => (
        <button
          type="button"
          role="tab"
          class="mu-tab"
          id={`mu-tab-${s.id}`}
          aria-controls={`mu-panel-${s.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-c1={s.data.artColors[0]}
          data-c2={s.data.artColors[1]}
          style={`--c1: ${s.data.artColors[0]}; --c2: ${s.data.artColors[1]}`}
        >
          <span class:list={['mu-tab-art', s.data.art && 'has-art']} aria-hidden="true">
            {s.data.art && (
              <Image
                class="mu-tab-img"
                src={s.data.art}
                alt=""
                widths={[96, 192]}
                sizes="96px"
                loading="lazy"
                decoding="async"
              />
            )}
            <span class="ln-num">{pad(i + 1)}</span>
          </span>
          <span class="mu-tab-text">
            <span class="mu-tab-k">Bonus {i + 1}</span>
            <span class="mu-tab-t">{s.data.title}</span>
            <span class="mu-tab-y ln-num">{s.data.year}</span>
          </span>
        </button>
      ))}
    </div>

    {songs.map((s, i) => {
      const d = s.data;
      return (
        <div
          class="mu-panel"
          role="tabpanel"
          id={`mu-panel-${s.id}`}
          aria-labelledby={`mu-tab-${s.id}`}
          hidden={i !== 0}
          style={`--c1: ${d.artColors[0]}; --c2: ${d.artColors[1]}`}
        >
          <div class="mu-head">
            <SongArt song={s} index={i} />
            <div class="mu-info">
              <p class="mu-k">
                <span class="ln-eyebrow">
                  Bonus track {i + 1} · {d.year}
                </span>
                {d.status === 'placeholder' && <Placeholder />}
              </p>
              <h3 class="mu-title">{d.title}</h3>
              <p class="mu-credits">{say(d.credits)}</p>
              {d.release && <p class="mu-release">{d.release}</p>}
              <div class="mu-about">
                <h4 class="mu-h">About this song</h4>
                <p>{say(d.meaning)}</p>
              </div>
              <p>
                <a class="mu-page" href={`/music/${s.id}/`} data-song-link>
                  Open the song page<span class="visually-hidden">: {d.title}</span>
                  <span aria-hidden="true">&nbsp;→</span>
                </a>
              </p>
              <Players song={s} />
            </div>
          </div>

          <Lyrics song={s} level={4} say={say} />
        </div>
      );
    })}
  </div>
</section>

<script>
  // Tabs (automatic activation, roving tabindex). Lyrics and the players bring their own scripts.
  const root = document.getElementById('music');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      root.style.setProperty('--c1', tab.dataset.c1 ?? '');
      root.style.setProperty('--c2', tab.dataset.c2 ?? '');
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let next = -1;
        if (k === 'ArrowRight' || k === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft' || k === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') next = 0;
        else if (k === 'End') next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        select(tabs[next], true);
      });
    });
  }
</script>

<style>
  .music {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background-color: #0a0908;
    border-block: 1px solid #2a2522;
  }
  .mu-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        42% 26% at 16% 40%,
        color-mix(in srgb, var(--c1) 80%, transparent),
        transparent 72%
      ),
      radial-gradient(
        26% 16% at 26% 36%,
        color-mix(in srgb, var(--c2) 22%, transparent),
        transparent 70%
      );
    filter: blur(20px);
    opacity: 0.8;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mu-glow {
      transition: background 0.6s ease;
    }
  }

  /* Story plate */
  .mu-story {
    display: grid;
    gap: 1.1rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 52rem;
  }
  .mu-story-lead {
    font-family: var(--ln-display);
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    font-weight: 600;
    font-stretch: 88%;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .mu-story-p {
    max-width: 40em;
    font-size: 1.0625rem;
    color: var(--ln-ink-2);
  }
  .mu-story-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.75rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--ln-ink-2);
  }
  .mu-story-facts .ln-eyebrow {
    margin-right: 0.35rem;
  }
  .mu-story-facts a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ln-ink);
  }

  /* Song tabs */
  .mu-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .mu-tab {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 0.5rem;
    border: 1px solid var(--ln-rule);
    border-radius: 10px;
    background: transparent;
    color: var(--ln-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .mu-tab:hover {
    background: var(--ln-hl);
  }
  .mu-tab[aria-selected='true'] {
    border-color: var(--ln-ink);
    background: var(--ln-bg-3);
    box-shadow: inset 0 -3px 0 var(--ln-accent);
  }
  .mu-tab-art {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 1;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    background:
      repeating-linear-gradient(var(--c1) 0 12%, transparent 12% 26%) 0 52% / 100% 22% no-repeat,
      radial-gradient(circle at 64% 40%, var(--c2) 0 25%, transparent 25.4%),
      linear-gradient(
        172deg,
        color-mix(in oklab, var(--c1) 88%, #fff) 0%,
        var(--c1) 42%,
        color-mix(in oklab, var(--c1) 45%, #000) 100%
      );
    color: #fff;
    font-family: var(--ln-display);
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1;
  }
  .mu-tab-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .mu-tab-k {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ln-accent);
  }
  .mu-tab-t {
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.15;
  }
  .mu-tab-y {
    font-size: 0.75rem;
    color: var(--ln-ink-3);
  }

  /* Song head */
  .mu-head {
    display: grid;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .mu-info {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    min-width: 0;
  }
  .mu-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
  }
  .mu-k .ln-eyebrow {
    color: var(--ln-accent);
  }
  body.ln .mu-title {
    font-size: clamp(2.6rem, 7vw, 5rem);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .mu-credits {
    font-size: 1.0625rem;
    color: var(--ln-ink-2);
  }
  body.ln .mu-h {
    font-family: var(--ln-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .mu-about {
    display: grid;
    gap: 0.4rem;
    max-width: 36em;
    margin-top: 0.4rem;
    padding: 1.1rem 1.2rem;
    border-left: 3px solid var(--ln-accent);
    background: rgb(255 255 255 / 0.04);
  }
  .mu-about p {
    color: var(--ln-ink-2);
  }
  .mu-page {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    color: var(--ln-accent);
    text-underline-offset: 0.2em;
  }
  .mu-page:hover {
    color: var(--ln-ink);
  }

  @media (min-width: 900px) {
    .mu-head {
      grid-template-columns: 360px minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
    .mu-tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .mu-tab {
      grid-template-columns: 76px minmax(0, 1fr);
      align-items: center;
      gap: 1rem;
      padding: 0.6rem;
    }
    .mu-tab-t {
      font-size: 1.15rem;
    }
  }
  .mu-release {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: var(--ln-ink-3);
  }
  .mu-tab-art.has-art {
    position: relative;
    overflow: hidden;
  }
  .mu-tab-art :global(.mu-tab-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mu-tab-art.has-art .ln-num {
    position: relative;
    padding: 0 0.25rem;
    border-radius: 3px;
    background: rgb(0 0 0 / 0.6);
  }
</style>
