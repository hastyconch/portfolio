---
// Résumé: a tinted header panel (summary, actions, key facts), then experience on a timeline
// rail beside capabilities and education. Print-friendly.
// WO-024: the download link serves /resume.pdf, generated from this section's print view by
// factory/stations/resume-pdf.mjs (npm run resume:pdf).
// WO-026: the actions have their own row (Download is the primary button, Print a quieter text
// button), and the print view fits on two Letter pages.
// WO-030: "Download résumé (PDF)", and in print the name is the level-1 heading (so the PDF's tag
// tree starts with H1, "Résumé" an H2 under it). It is a role, not an <h1>: the print head is
// display: none on screen, and the page keeps its one <h1> (the hero's).
// WO-038: the redesign. One idea, colour with a job: the accent marks time (the rail, its nodes
// and the dates; the current role's node is filled), and a warm tint derived from the accent
// marks the summary panel. Capabilities and education sit on the raised surface, with their
// group labels in the accent.
import { getSiteContent, type Resume } from '../lib/content';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  resume: Resume;
}
const { resume } = Astro.props;
const span = (a: string, b: string) => (a === b ? a : `${a} – ${b}`);
// The printed (and PDF) résumé opens with who it is, and only the contact links that are real.
const { profile } = await getSiteContent();
const real = profile.links.filter((l) => /^(https?|mailto):/.test(l.href));
const contacts = real.map((l) => l.href.replace(/^(https?:\/\/|mailto:)/, ''));
// The saved file is named for who it is (Nakul-Iyer-Resume.pdf), not "resume.pdf".
const file = `${profile.name.trim().replace(/\s+/g, '-')}-Resume.pdf`;
---

<section id="resume" class="ln-sec resume" aria-labelledby="resume-h">
  <div class="ln-wrap">
    <div class="cv-print-head">
      <p class="cv-print-name" role="heading" aria-level="1">
        {profile.name}
      </p>
      <p>{[profile.roleLine, profile.location, ...contacts].join(' · ')}</p>
      {resume.status === 'placeholder' && <p class="cv-print-draft">Draft: some details to come</p>}
    </div>
    <SideHead title="Résumé" id="resume-h" />

    <div class="cv-panel">
      <div class="cv-intro">
        {resume.status === 'placeholder' && (
          <p class="cv-status">
            <Placeholder label="Some details to come" />
          </p>
        )}
        <p class="cv-summary">{resume.summary}</p>
        <div class="cv-actions">
          <a class="cv-btn" href="/resume.pdf" download={file}>
            Download résumé (PDF)
          </a>
          <button type="button" class="cv-text-btn" data-print>
            Print résumé
          </button>
        </div>
      </div>
      <dl class="cv-facts">
        <div>
          <dt class="label">Now</dt>
          <dd>{profile.roleLine}</dd>
        </div>
        <div>
          <dt class="label">Based in</dt>
          <dd>{profile.location}</dd>
        </div>
        {real.map((l, i) => (
          <div>
            <dt class="label">{l.label}</dt>
            <dd>
              <a class="cv-link" href={l.href}>
                {contacts[i]}
              </a>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="cv-grid">
      <div class="cv-main">
        <h3 class="cv-h label">Experience</h3>
        <ol class="cv-list">
          {resume.experience.map((e) => (
            <li class:list={['cv-item', e.end === 'Present' && 'cv-now']}>
              <p class:list={['cv-when ln-num', e.start === 'Placeholder' && 'cv-tbd']}>
                {span(e.start, e.end)}
              </p>
              <h4 class="cv-org">{e.org}</h4>
              <p class="cv-title">{e.title}</p>
              <ul class="cv-bullets">
                {e.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>

      <div class="cv-side">
        <h3 class="cv-h label">Capabilities</h3>
        <dl class="cv-card cv-caps">
          {resume.capabilities.map((c) => (
            <div class="cv-group">
              <dt>{c.group}</dt>
              <dd>
                <ul class="cv-items">
                  {c.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
        <h3 class="cv-h label">Education</h3>
        <dl class="cv-card cv-edu">
          {resume.education.map((e) => (
            <div class="cv-group">
              <dt>{e.school}</dt>
              <dd>{e.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  // Print just the résumé (liner.css hides the rest while .ln-print-cv is set).
  const html = document.documentElement;
  document.querySelector('[data-print]')?.addEventListener('click', () => {
    html.classList.add('ln-print-cv');
    window.print();
  });
  addEventListener('afterprint', () => html.classList.remove('ln-print-cv'));
</script>

<style>
  /* Résumé tokens, derived from the Liner Notes colours, so they follow the scheme.
     --cv-tint: the summary panel, a warm wash of the accent on the page colour (stronger on the
     dark page, where a light wash reads as a grey card). --cv-tint-rule: the panel's dividers. --cv-rail: the timeline line (decorative; its nodes
     carry the accent at full strength). --cv-side: the side column's width, shared by the panel's
     facts column so the two line up. --cv-block / --cv-entry: the gaps between blocks and between
     entries. */
  .resume {
    --cv-tint: color-mix(in oklab, var(--ln-accent) 18%, var(--ln-bg));
    --cv-tint-rule: color-mix(in oklab, var(--ln-accent) 40%, var(--ln-bg));
    --cv-rail: color-mix(in oklab, var(--ln-accent) 45%, var(--ln-bg));
    --cv-side: 22rem;
    --cv-block: var(--space-7);
    --cv-entry: var(--space-6);
    --cv-node: 0.875rem;
  }
  @media (prefers-color-scheme: light) {
    .resume {
      --cv-tint: color-mix(in oklab, var(--ln-accent) 11%, var(--ln-bg));
      --cv-tint-rule: color-mix(in oklab, var(--ln-accent) 30%, var(--ln-bg));
    }
  }
  /* Landing (WO-034's one rule): on laptops and tablets the title's top lands 48px under the
     header, as Work's does (y = 108 at 1440 x 900). Phones keep the shared section padding, as
     Work does. Integrator: when WO-034's section-top token lands in liner.css, use it here. */
  @media (min-width: 760px) {
    .resume {
      padding-top: var(--space-7);
    }
  }

  /* The header panel: summary and actions, then the key facts. */
  .cv-panel {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--cv-block);
    padding: var(--space-5);
    border-radius: var(--radius-3);
    background: var(--cv-tint);
  }
  .cv-intro {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }
  .cv-summary {
    max-width: 56ch;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--ln-ink);
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-2);
  }
  .cv-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--ln-ink);
    border-radius: var(--radius-2);
    background: var(--ln-ink);
    color: var(--ln-bg);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      border-color var(--dur-quick) var(--ease-out),
      color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  .cv-btn:hover,
  .cv-btn:focus-visible {
    border-color: var(--ln-accent);
    background: var(--ln-accent);
    color: var(--ln-accent-ink);
  }
  .cv-btn:active {
    scale: var(--press-scale);
  }
  .cv-text-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-1);
    border: 0;
    background: transparent;
    color: var(--ln-ink-2);
    font: inherit;
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--cv-tint-rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    cursor: pointer;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cv-text-btn:hover,
  .cv-text-btn:focus-visible {
    color: var(--ln-ink);
    text-decoration-color: currentColor;
  }
  .cv-text-btn:active {
    color: var(--ln-ink-3);
  }

  .cv-facts {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--cv-tint-rule);
  }
  .cv-facts dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
    line-height: var(--leading-snug);
  }
  .cv-link {
    color: var(--ln-ink);
    text-decoration: underline;
    text-decoration-color: var(--cv-tint-rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cv-link:hover,
  .cv-link:focus-visible {
    color: var(--ln-accent);
    text-decoration-color: currentColor;
  }
  .cv-link:active {
    color: var(--ln-ink-2);
  }

  /* Experience and the side column. */
  .cv-grid {
    display: grid;
    gap: var(--cv-block);
  }
  body.ln .cv-h {
    margin-bottom: var(--space-4);
  }

  /* The timeline: a rail down the left, a node per role. The current role's node is filled and
     its stretch of the rail is at full strength, so "now" reads first.
     Nodes and markers are borders, not fills, so they survive printing without backgrounds. */
  .cv-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cv-item {
    position: relative;
    padding: 0 0 var(--cv-entry) var(--space-6);
  }
  .cv-item:last-child {
    padding-bottom: 0;
  }
  .cv-item:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--space-2) + var(--cv-node));
    bottom: calc(var(--space-2) * -1);
    left: calc(var(--cv-node) / 2 - 1px);
    border-left: 2px solid var(--cv-rail);
  }
  .cv-item::before {
    content: '';
    position: absolute;
    top: 0.2em;
    left: 0;
    box-sizing: border-box;
    width: var(--cv-node);
    height: var(--cv-node);
    border: 2px solid var(--ln-accent);
    border-radius: 50%;
  }
  .cv-now::before {
    border-width: calc(var(--cv-node) / 2);
  }
  .cv-now:not(:last-child)::after {
    border-left-color: var(--ln-accent);
  }
  /* The dates are the accent's column: the display face, at body size. */
  body.ln .cv-when {
    font-family: var(--ln-display);
    font-size: var(--text-md);
    font-weight: 700;
    line-height: var(--leading-snug);
    color: var(--ln-accent);
  }
  /* A date still to come stays visible (a placeholder marker) but quiet: the accent is for real
     time only. */
  body.ln .cv-tbd {
    font-family: var(--ln-body);
    font-weight: 500;
    color: var(--ln-ink-3);
  }
  body.ln .cv-org {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-snug);
  }
  .cv-title {
    margin-top: var(--space-1);
    font-weight: 600;
    color: var(--ln-ink-2);
  }
  .cv-bullets {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .cv-bullets li {
    position: relative;
    padding-left: var(--space-5);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }
  .cv-bullets li::before {
    content: '';
    position: absolute;
    left: var(--space-1);
    top: 0.62em;
    border: 3px solid var(--ln-ink-3);
    border-radius: 50%;
  }

  /* Capabilities and education: open groups parted by hairlines. The panel stays the one filled
     surface, and the accent keeps its one job (time). The first group's label shares a line
     with the first date. */
  .cv-card {
    display: grid;
    margin: 0;
  }
  .cv-caps {
    margin-bottom: var(--cv-block);
  }
  .cv-group {
    padding-block: var(--space-4);
  }
  .cv-group:first-child {
    padding-top: 0;
  }
  .cv-group:last-child {
    padding-bottom: 0;
  }
  .cv-group + .cv-group {
    border-top: var(--ln-hairline);
  }
  .cv-group dt {
    font-weight: 700;
    line-height: var(--leading-snug);
    color: var(--ln-ink);
  }
  .cv-group dd {
    margin: var(--space-2) 0 0;
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }
  .cv-items {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones: the panel runs edge to edge as a band, so the actions keep one row. The rail and
     bullet indents step in, for a wider line, and the capability groups pair up. */
  @media (max-width: 759.98px) {
    .cv-panel {
      margin-inline: calc(var(--ln-gutter) * -1);
      padding: var(--space-6) var(--ln-gutter);
      border-radius: 0;
    }
    .cv-item {
      padding-left: var(--space-5);
    }
    .cv-bullets li {
      padding-left: var(--space-4);
    }
    .cv-bullets li::before {
      left: 0;
    }
    .cv-caps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
    }
    .cv-caps .cv-group:nth-child(2) {
      padding-top: 0;
      border-top: 0;
    }
    .cv-caps .cv-group:nth-child(3) {
      padding-bottom: 0;
    }
    /* Paired columns are narrow: a smaller size, a hanging indent and a looser gap, so a
       wrapped item reads as one item. Education takes the same size, so the column is one. */
    .cv-card dd {
      font-size: var(--text-sm);
    }
    .cv-caps .cv-items {
      gap: var(--space-2);
    }
    .cv-caps .cv-items li {
      padding-left: var(--space-3);
      line-height: var(--leading-snug);
      text-indent: calc(var(--space-3) * -1);
    }
  }
  @media (min-width: 760px) {
    .cv-panel {
      padding: var(--space-6);
    }
  }
  @media (min-width: 1000px) {
    /* The panel's facts column lines up with the side column below it. */
    .cv-panel {
      grid-template-columns: minmax(0, 1fr) calc(var(--cv-side) - var(--space-6));
      gap: var(--space-8);
    }
    .cv-facts {
      align-content: start;
      gap: var(--space-5);
      padding-top: 0;
      border-top: 0;
    }
    .cv-grid {
      grid-template-columns: minmax(0, 1fr) var(--cv-side);
      gap: var(--space-8);
    }
  }
  .cv-print-head {
    display: none;
  }
  /* Paper (and the PDF): two Letter pages at the current content, nothing under 9pt. The name
     leads, so the "Résumé" title is small, and the spacing is tighter than on screen. The panel
     and cards print flat (no backgrounds), the facts are in the print head, and the rail prints
     as a grey line. */
  @media print {
    .cv-status,
    .cv-actions,
    .cv-facts {
      display: none;
    }
    .cv-item,
    .cv-group {
      break-inside: avoid;
    }
    .resume :global(.sh) {
      margin-bottom: var(--space-3);
    }
    body.ln .resume :global(.sh-title) {
      font-size: var(--text-xl);
    }
    .cv-panel,
    .cv-card {
      margin-inline: 0;
      padding: 0;
      border-radius: 0;
      background: none;
    }
    .cv-panel {
      margin-bottom: var(--space-5);
    }
    .cv-summary {
      font-size: var(--text-md);
    }
    .cv-grid {
      gap: var(--space-5);
    }
    body.ln .cv-h {
      margin-bottom: var(--space-3);
    }
    .cv-item {
      padding-bottom: var(--space-4);
    }
    body.ln .cv-org {
      margin-top: var(--space-1);
      font-size: var(--text-lg);
    }
    .cv-title {
      margin-top: 0;
    }
    .cv-bullets {
      gap: var(--space-1);
      margin-top: var(--space-2);
    }
    .cv-bullets li {
      font-size: var(--text-sm);
    }
    .cv-caps {
      margin-bottom: var(--space-5);
    }
    .cv-group {
      padding-block: var(--space-2);
    }
    .cv-group + .cv-group {
      border-top: 0;
    }
    /* Capabilities print as one comma-separated line per group. */
    .cv-items {
      display: block;
      color: var(--ln-ink-2);
    }
    .cv-items li {
      display: inline;
    }
    .cv-items li:not(:last-child)::after {
      content: ', ';
    }
    .cv-print-head {
      display: grid;
      gap: var(--space-1);
      margin-bottom: var(--space-5);
      font-size: var(--text-sm);
      color: var(--ln-ink-2);
    }
    /* The placeholder marker for paper: the on-screen one sits in the panel, which print hides. */
    .cv-print-draft {
      font-weight: 600;
      color: var(--ln-ink);
    }
    .cv-print-name {
      font-family: var(--ln-display);
      font-size: var(--text-3xl);
      font-weight: 800;
      line-height: var(--leading-tight);
      color: var(--ln-ink);
    }
  }
</style>
