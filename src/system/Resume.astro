---
// Résumé: experience beside capabilities and education. Print-friendly.
import type { Resume } from '../lib/content';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  resume: Resume;
}
const { resume } = Astro.props;
const span = (a: string, b: string) => (a === b ? a : `${a} – ${b}`);
---

<section id="resume" class="ln-sec resume" aria-labelledby="resume-h">
  <div class="ln-wrap">
    <SideHead title="Résumé" id="resume-h">
      <div class="cv-actions">
        {resume.status === 'placeholder' && <Placeholder label="Some details to come" />}
        <button type="button" class="cv-print" data-print>
          Print résumé
        </button>
      </div>
    </SideHead>

    <p class="cv-summary">{resume.summary}</p>

    <div class="cv-grid">
      <div class="cv-exp">
        <h3 class="cv-h label">Experience</h3>
        <ol class="cv-list">
          {resume.experience.map((e) => (
            <li class="cv-item">
              <p class="cv-when ln-num">{span(e.start, e.end)}</p>
              <div>
                <h4 class="cv-org">{e.org}</h4>
                <p class="cv-title">{e.title}</p>
                <ul class="cv-bullets">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="cv-side">
        <h3 class="cv-h label">Capabilities</h3>
        <dl class="cv-caps">
          {resume.capabilities.map((c) => (
            <div>
              <dt>{c.group}</dt>
              <dd>{c.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
        <h3 class="cv-h label">Education</h3>
        <dl class="cv-caps">
          {resume.education.map((e) => (
            <div>
              <dt>{e.school}</dt>
              <dd class="cv-edu">{e.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  // Print just the résumé (liner.css hides the rest while .ln-print-cv is set).
  const html = document.documentElement;
  document.querySelector('[data-print]')?.addEventListener('click', () => {
    html.classList.add('ln-print-cv');
    window.print();
  });
  addEventListener('afterprint', () => html.classList.remove('ln-print-cv'));
</script>

<style>
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .cv-print {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--ln-ink);
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--ln-ink);
    font: inherit;
    font-weight: 600;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  .cv-print:hover,
  .cv-print:focus-visible {
    background: var(--ln-ink);
    color: var(--ln-bg);
  }
  .cv-print:active {
    scale: var(--press-scale);
  }
  .cv-summary {
    max-width: 56ch;
    margin: calc(var(--space-4) * -1) 0 var(--space-7);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }
  .cv-grid {
    display: grid;
    gap: var(--space-7);
  }
  body.ln .cv-h {
    padding-bottom: var(--space-3);
    border-bottom: var(--ln-hairline);
  }
  .cv-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cv-item {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-bottom: var(--ln-hairline);
  }
  .cv-when {
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  body.ln .cv-org {
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .cv-title {
    margin-top: var(--space-1);
    color: var(--ln-ink-2);
  }
  .cv-bullets {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .cv-bullets li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }
  .cv-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: var(--space-3);
    height: 1px;
    background: var(--ln-ink-3);
  }

  .cv-caps {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 var(--space-7);
  }
  .cv-caps dt {
    font-weight: 700;
  }
  .cv-caps dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }

  @media (min-width: 760px) {
    .cv-item {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: var(--space-6);
    }
    .cv-when {
      padding-top: var(--space-1);
    }
  }
  @media (min-width: 1000px) {
    .cv-grid {
      grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
    .cv-side {
      position: sticky;
      top: calc(var(--ln-header) + var(--space-6));
      align-self: start;
    }
  }
  @media print {
    .cv-actions {
      display: none;
    }
  }
</style>
