---
// Résumé: experience beside capabilities and education. Print-friendly.
// WO-024: the download link serves /resume.pdf, generated from this section's print view by
// factory/stations/resume-pdf.mjs (npm run resume:pdf).
// WO-026: the actions have their own row under the heading (Download is the primary button,
// Print a quieter text button), and the print view fits on two Letter pages.
// WO-030: "Download résumé (PDF)", and in print the name is the level-1 heading (so the PDF's tag
// tree starts with H1, "Résumé" an H2 under it). It is a role, not an <h1>: the print head is
// display: none on screen, and the page keeps its one <h1> (the hero's).
import { getSiteContent, type Resume } from '../lib/content';
import SideHead from './SideHead.astro';
import Placeholder from './Placeholder.astro';

interface Props {
  resume: Resume;
}
const { resume } = Astro.props;
const span = (a: string, b: string) => (a === b ? a : `${a} – ${b}`);
// The printed (and PDF) résumé opens with who it is, and only the contact links that are real.
const { profile } = await getSiteContent();
const contacts = profile.links
  .filter((l) => /^(https?|mailto):/.test(l.href))
  .map((l) => l.href.replace(/^(https?:\/\/|mailto:)/, ''));
// The saved file is named for who it is (Nakul-Iyer-Resume.pdf), not "resume.pdf".
const file = `${profile.name.trim().replace(/\s+/g, '-')}-Resume.pdf`;
---

<section id="resume" class="ln-sec resume" aria-labelledby="resume-h">
  <div class="ln-wrap">
    <div class="cv-print-head">
      <p class="cv-print-name" role="heading" aria-level="1">
        {profile.name}
      </p>
      <p>{[profile.roleLine, profile.location, ...contacts].join(' · ')}</p>
      {resume.status === 'placeholder' && <p class="cv-print-draft">Draft: some details to come</p>}
    </div>
    <SideHead title="Résumé" id="resume-h" />
    <div class="cv-bar">
      {resume.status === 'placeholder' && (
        <p class="cv-status">
          <Placeholder label="Some details to come" />
        </p>
      )}
      <div class="cv-actions">
        <a class="cv-btn" href="/resume.pdf" download={file}>
          Download résumé (PDF)
        </a>
        <button type="button" class="cv-text-btn" data-print>
          Print résumé
        </button>
      </div>
    </div>

    <p class="cv-summary">{resume.summary}</p>

    <div class="cv-grid">
      <div class="cv-exp">
        <h3 class="cv-h label">Experience</h3>
        <ol class="cv-list">
          {resume.experience.map((e) => (
            <li class="cv-item">
              <p class="cv-when ln-num">{span(e.start, e.end)}</p>
              <div>
                <h4 class="cv-org">{e.org}</h4>
                <p class="cv-title">{e.title}</p>
                <ul class="cv-bullets">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="cv-side">
        <h3 class="cv-h label">Capabilities</h3>
        <dl class="cv-caps">
          {resume.capabilities.map((c) => (
            <div>
              <dt>{c.group}</dt>
              <dd>{c.items.join(', ')}</dd>
            </div>
          ))}
        </dl>
        <h3 class="cv-h label">Education</h3>
        <dl class="cv-caps">
          {resume.education.map((e) => (
            <div>
              <dt>{e.school}</dt>
              <dd class="cv-edu">{e.detail}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  // Print just the résumé (liner.css hides the rest while .ln-print-cv is set).
  const html = document.documentElement;
  document.querySelector('[data-print]')?.addEventListener('click', () => {
    html.classList.add('ln-print-cv');
    window.print();
  });
  addEventListener('afterprint', () => html.classList.remove('ln-print-cv'));
</script>

<style>
  /* Under the heading: the placeholder chip on its own line, then the actions' row (the download
     first, then the quieter print). */
  .cv-bar {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    margin: calc(var(--space-5) * -1) 0 var(--space-6);
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }
  .cv-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--ln-ink);
    border-radius: var(--radius-2);
    background: var(--ln-ink);
    color: var(--ln-bg);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      border-color var(--dur-quick) var(--ease-out),
      color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  .cv-btn:hover,
  .cv-btn:focus-visible {
    border-color: var(--ln-accent);
    background: var(--ln-accent);
    color: var(--ln-accent-ink);
  }
  .cv-btn:active {
    scale: var(--press-scale);
  }
  .cv-text-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-1);
    border: 0;
    background: transparent;
    color: var(--ln-ink-2);
    font: inherit;
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: var(--ln-rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    cursor: pointer;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cv-text-btn:hover,
  .cv-text-btn:focus-visible {
    color: var(--ln-ink);
    text-decoration-color: currentColor;
  }
  .cv-text-btn:active {
    color: var(--ln-ink-3);
  }
  .cv-summary {
    max-width: 56ch;
    margin: 0 0 var(--space-7);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }
  .cv-grid {
    display: grid;
    gap: var(--space-7);
  }
  body.ln .cv-h {
    padding-bottom: var(--space-3);
    border-bottom: var(--ln-hairline);
  }
  .cv-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cv-item {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-bottom: var(--ln-hairline);
  }
  .cv-when {
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  body.ln .cv-org {
    font-size: var(--text-xl);
    font-weight: 700;
  }
  .cv-title {
    margin-top: var(--space-1);
    color: var(--ln-ink-2);
  }
  .cv-bullets {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .cv-bullets li {
    position: relative;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }
  .cv-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: var(--space-3);
    height: 1px;
    background: var(--ln-ink-3);
  }

  .cv-caps {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 var(--space-7);
  }
  .cv-caps dt {
    font-weight: 700;
  }
  .cv-caps dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }

  @media (min-width: 760px) {
    .cv-item {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: var(--space-6);
    }
    .cv-when {
      padding-top: var(--space-1);
    }
  }
  @media (min-width: 1000px) {
    .cv-grid {
      grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
    .cv-side {
      position: sticky;
      top: calc(var(--ln-header) + var(--space-6));
      align-self: start;
    }
  }
  .cv-print-head {
    display: none;
  }
  /* Paper (and the PDF): two Letter pages at the current content, nothing under 9pt. The name
     leads, so the "Résumé" title is small, and the spacing is tighter than on screen. */
  @media print {
    .cv-bar {
      display: none;
    }
    .cv-item,
    .cv-caps > div {
      break-inside: avoid;
    }
    .resume :global(.sh) {
      margin-bottom: var(--space-3);
    }
    body.ln .resume :global(.sh-title) {
      font-size: var(--text-xl);
    }
    .cv-summary {
      margin-bottom: var(--space-5);
      font-size: var(--text-md);
    }
    .cv-grid {
      gap: var(--space-5);
    }
    .cv-item {
      gap: var(--space-1);
      padding: var(--space-3) 0;
    }
    body.ln .cv-org {
      font-size: var(--text-lg);
    }
    .cv-bullets {
      gap: var(--space-1);
      margin-top: var(--space-2);
    }
    /* Backgrounds don't print: the dash is a border on paper. */
    .cv-bullets li::before {
      height: 0;
      border-top: 1px solid var(--ln-ink-3);
      background: none;
    }
    .cv-caps {
      gap: var(--space-2);
      margin: var(--space-3) 0 var(--space-5);
    }
    .cv-print-head {
      display: grid;
      gap: var(--space-1);
      margin-bottom: var(--space-5);
      font-size: var(--text-sm);
      color: var(--ln-ink-2);
    }
    /* The placeholder marker for paper: the on-screen one sits in .cv-bar, which print hides. */
    .cv-print-draft {
      font-weight: 600;
      color: var(--ln-ink);
    }
    .cv-print-name {
      font-family: var(--ln-display);
      font-size: var(--text-3xl);
      font-weight: 800;
      line-height: var(--leading-tight);
      color: var(--ln-ink);
    }
  }
</style>
