---
// Page shell for the site's design system (Liner Notes, picked in Phase 1):
// Base layout + fonts/tokens + Nav + Footer.
import Base from '../layouts/Base.astro';
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '@fontsource-variable/dm-sans';
// Preload the main faces so text doesn't shift when web fonts swap in (CLS budget).
import bricolageFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wdth-normal.woff2?url';
import dmSansFont from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import './tokens.css';
import './liner.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { getSiteContent } from '../lib/content';

interface Props {
  /** page title; the owner's name is appended on every page except the home */
  title?: string;
  description?: string;
  /** true on the one-page home, so nav links are plain fragments */
  home?: boolean;
  noindex?: boolean;
  /** a case study's project id, for the header's crumb, stepper and jump list */
  project?: string;
}
const { title, description, home = false, noindex = false, project } = Astro.props;
const { profile, projects } = await getSiteContent();
// The section a deep page belongs to: its nav link is marked and its crumb shown.
const path = Astro.url.pathname;
const section = path.startsWith('/projects/')
  ? 'projects'
  : path.startsWith('/music/')
    ? 'music'
    : undefined;
// Cross-document view transitions (WO-019, CSS in liner.css). This runs before first render:
// between case studies it sets the direction (`fwd` or `back`, from the projects order), and
// between a project card and its case study it names that one art `art-<id>` so it morphs.
const order = projects.map((p) => p.id);
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.headline}`;
---

<Base
  title={fullTitle}
  description={description ?? profile.headline}
  noindex={noindex}
  bodyClass="ln"
>
  <link slot="head" rel="preload" href={bricolageFont} as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" href={dmSansFont} as="font" type="font/woff2" crossorigin />
  {project && <link slot="head" rel="expect" href="#cs-art" blocking="render" />}
  <script slot="head" is:inline define:vars={{ order }}>
    const at = (u) => new URL(u, location.href).pathname;
    const pid = (u) => at(u).match(/^\/projects\/([^/]+)\/$/)?.[1];
    const name = (k) =>
      document.querySelectorAll('[data-art]').forEach((el) => {
        el.style.viewTransitionName = el.dataset.art === k ? `art-${k}` : '';
      });
    addEventListener('pageswap', ({ viewTransition: vt, activation: a }) => {
      const to = a?.entry?.url;
      const here = location.href;
      if (vt && to) name(at(here) === '/' ? pid(to) : at(to) === '/' && pid(here));
    });
    addEventListener('pagereveal', ({ viewTransition: vt }) => {
      const from = window.navigation?.activation?.from?.url;
      if (!vt || !from) return;
      const f = pid(from);
      const t = pid(location.href);
      if (f && t) vt.types?.add('cs').add(order.indexOf(t) < order.indexOf(f) ? 'back' : 'fwd');
      else name(at(from) === '/' ? t : at(location.href) === '/' && f);
      vt.finished.finally(() => name());
    });
  </script>
  <Nav slot="header" profile={profile} home={home} section={section} project={project} />
  <slot />
  <Footer slot="footer" profile={profile} />
</Base>
