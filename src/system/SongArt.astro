---
// SongArt: a song's sleeve with the record peeking out (Music is where the record theme lives). Uses the song's `art` image when the
// owner has supplied it; otherwise the `artColors` gradient sleeve (number, title, year) stands in.
// Shared by the home Music section and the /music/<id>/ pages.
//
// Cover and record appear together, once. With scripting on, the sleeve stays unpainted until its
// cover image has loaded and decoded; then it shows and the record slides out. (Before WO-018 the
// drawn stand-in sleeve painted first, the record started sliding, and the real cover popped in on
// top of it mid-slide, because the image arrived after the panel or page was first painted.)
// The home tabs dispatch `sa:show` on a panel when they reveal it.
import type { Song } from '../lib/content';
import { Image } from 'astro:assets';

interface Props {
  song: Song;
  /** zero-based position in the tracklist */
  index: number;
  /** true when the sleeve is above the fold (song pages), so the image isn't lazy */
  eager?: boolean;
  /** the image's displayed size; the home panel shows a small sleeve on phones (WO-026) */
  sizes?: string;
}
const { song, index, eager = false, sizes = '(min-width: 900px) 296px, 280px' } = Astro.props;
const d = song.data;
const pad = (n: number) => String(n).padStart(2, '0');
// Without alt text the art is decorative: the title is always printed beside it.
const decorative = !d.art || !d.artAlt;
---

<div
  class="sa"
  data-sa
  aria-hidden={decorative ? 'true' : undefined}
  style={`--c1: ${d.artColors[0]}; --c2: ${d.artColors[1]}`}
>
  <span class="sa-vinyl ln-vinyl" aria-hidden="true"></span>
  {d.art ? (
    <div class="sa-art sa-art-img">
      <Image
        src={d.art}
        alt={d.artAlt ?? ''}
        widths={[300, 560]}
        sizes={sizes}
        quality={60}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    </div>
  ) : (
    <div class="sa-art">
      <span class="sa-n ln-num">{pad(index + 1)}</span>
      <span class="sa-t">{d.title}</span>
      <span class="sa-y ln-num">{d.year}</span>
    </div>
  )}
</div>

<script>
  const show = (sa: HTMLElement) => {
    // A newer show (a fast tab switch away and back) wins over a slower, older one.
    const run = String(Number(sa.dataset.run ?? 0) + 1);
    sa.dataset.run = run;
    const img = sa.querySelector('img');
    if (!img) {
      sa.dataset.state = 'in';
      return;
    }
    sa.dataset.state = 'wait';
    const reveal = () => {
      if (sa.dataset.run === run) sa.dataset.state = 'in';
    };
    // Lazy art in a panel that was hidden hasn't started loading yet.
    img.loading = 'eager';
    const loaded = img.complete
      ? Promise.resolve()
      : new Promise<void>((done) => {
          img.addEventListener('load', () => done(), { once: true });
          img.addEventListener('error', () => done(), { once: true });
        });
    // decode() rejects for a broken image: show the drawn sleeve then.
    loaded.then(() => img.decode()).then(reveal, reveal);
  };
  document.querySelectorAll<HTMLElement>('[data-sa]').forEach((sa) => {
    if (!sa.closest('[hidden]')) show(sa);
  });
  document.addEventListener('sa:show', (e) => {
    if (e.target instanceof Element)
      e.target.querySelectorAll<HTMLElement>('[data-sa]').forEach(show);
  });
</script>

<style>
  .sa {
    position: relative;
    width: min(100%, 340px);
    transition: opacity var(--dur-quick) var(--ease-out);
  }
  /* Waiting for the cover (see the note at the top). Before the script runs, only where scripting
     is on; if it never runs, the sleeve shows anyway after a few seconds. */
  .sa[data-state='wait'] {
    opacity: 0;
  }
  @media (scripting: enabled) {
    .sa:not([data-state]) {
      opacity: 0;
      animation: sa-show var(--dur-quick) var(--ease-out) calc(var(--dur-reveal) * 6) both;
    }
  }
  @keyframes sa-show {
    to {
      opacity: 1;
    }
  }
  .sa-vinyl {
    position: absolute;
    top: 5%;
    right: 0;
    width: 80%;
    --ln-label: var(--c2);
  }
  .sa-art {
    position: relative;
    width: 82%;
    aspect-ratio: 1;
    container-type: inline-size;
    border-radius: var(--radius-1);
    overflow: hidden;
    color: #fff;
    background:
      repeating-linear-gradient(var(--c1) 0 12%, transparent 12% 26%) 0 52% / 100% 22% no-repeat,
      radial-gradient(circle at 64% 40%, var(--c2) 0 25%, transparent 25.4%),
      radial-gradient(
        circle at 64% 40%,
        color-mix(in srgb, var(--c2) 45%, transparent) 0,
        transparent 48%
      ),
      linear-gradient(
        172deg,
        color-mix(in oklab, var(--c1) 88%, #fff) 0%,
        var(--c1) 42%,
        color-mix(in oklab, var(--c1) 45%, #000) 100%
      );
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.2) inset,
      var(--shadow-3);
  }
  .sa-art-img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Cover art type is sized to the cover. */
  .sa-n {
    position: absolute;
    top: 7cqi;
    left: 8cqi;
    font-family: var(--ln-display);
    font-weight: 800;
    font-size: 6cqi;
    line-height: var(--leading-tight);
  }
  .sa-t {
    position: absolute;
    left: 8cqi;
    right: 8cqi;
    bottom: 15cqi;
    font-family: var(--ln-display);
    font-weight: 800;
    font-stretch: var(--stretch-display);
    font-size: 15cqi;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }
  .sa-y {
    position: absolute;
    left: 8cqi;
    bottom: 7cqi;
    font-size: 6cqi;
    font-weight: 700;
  }
  /* The record slides out of the sleeve as the cover appears (data-state="in"); it replays
     whenever a hidden tab panel is shown. Without scripting it slides out on first paint. */
  @media (prefers-reduced-motion: no-preference) {
    .sa[data-state='in'] .sa-vinyl {
      animation: sa-out calc(var(--dur-reveal) * 2) var(--ease-out) both;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (scripting: none) {
    .sa-vinyl {
      animation: sa-out calc(var(--dur-reveal) * 2) var(--ease-out) both;
    }
  }
  @keyframes sa-out {
    from {
      transform: translateX(-18%) rotate(-60deg);
    }
  }
  @media (min-width: 900px) {
    .sa {
      width: 360px;
    }
  }
</style>
