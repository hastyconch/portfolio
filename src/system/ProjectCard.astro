---
// ProjectCard: a flat swatch of the project's accent, then the copy. The title comes first so
// titles line up across the rail whatever tags a card carries. The whole card links to the
// case study.
import type { Project } from '../lib/content';
import Placeholder from './Placeholder.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const d = project.data;
const stackHint = d.stack
  .slice(0, 3)
  .map((s) => s.tech.split(/\s[·(]/)[0].trim())
  .join(' · ');
---

<li class="pc" style={`--art: ${d.accent}`}>
  <div class="pc-art" aria-hidden="true"></div>
  <div class="pc-body">
    <h3 class="pc-title">
      <a class="pc-link" href={`/projects/${project.id}/`}>
        {d.title}
      </a>
    </h3>
    <p class="pc-k">
      <span class="pc-cat">{d.category}</span>
      <span class="ln-num">{d.year}</span>
      {d.featured && <span class="pc-feat">Featured</span>}
      {d.status === 'placeholder' && <Placeholder />}
    </p>
    <p class="pc-tag">{d.tagline}</p>
    <p class="pc-meta">{d.platforms.join(' · ')}</p>
    <p class="pc-stack">
      <span class="visually-hidden">Stack: </span>
      {stackHint}
    </p>
  </div>
</li>

<style>
  .pc {
    position: relative;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    /* rail cards stretch to the tallest; keep the extra space at the bottom so titles align */
    align-content: start;
    padding: var(--space-4) 0;
    border-bottom: var(--ln-hairline);
    border-radius: var(--radius-1);
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  .pc:has(.pc-link:focus-visible) {
    outline: var(--focus-width) solid var(--ln-accent);
    outline-offset: var(--focus-offset);
  }
  .pc-link {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .pc-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  body.ln .pc-link:focus-visible {
    outline: none;
  }
  .pc:is(:hover, :focus-within) .pc-link {
    text-decoration-color: currentColor;
  }
  .pc:active {
    background: var(--ln-hl);
  }

  /* Cover: a flat swatch of the project's accent */
  .pc-art {
    aspect-ratio: 1;
    border-radius: var(--radius-1);
    background: var(--art);
    outline: 1px solid color-mix(in srgb, var(--ln-ink) 10%, transparent);
    outline-offset: -1px;
  }

  /* Body */
  .pc-body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }
  body.ln .pc-title {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .pc-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
    color: var(--ln-ink-3);
  }
  .pc-cat {
    text-transform: capitalize;
  }
  .pc-feat {
    padding: 0 var(--space-2);
    border: var(--ln-hairline);
    border-radius: var(--radius-full);
    color: var(--ln-ink-2);
  }
  .pc-tag {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }
  .pc-meta,
  .pc-stack {
    font-size: var(--text-xs);
    color: var(--ln-ink-3);
  }
  .pc-stack {
    display: none;
  }

  /* Desktop: a card in the horizontal rail */
  @media (min-width: 900px) {
    .pc {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: 0;
      border-bottom: 0;
      width: 260px;
      flex: none;
      scroll-snap-align: start;
    }
    .pc:active {
      background: none;
    }
    .pc-art {
      aspect-ratio: 4 / 3;
      transition: translate var(--dur-base) var(--ease-out);
    }
    .pc:is(:hover, :focus-within) .pc-art {
      translate: 0 calc(var(--move-sm) * -1);
    }
    .pc:active .pc-art {
      translate: 0;
      transition-duration: var(--dur-quick);
    }
    body.ln .pc-title {
      font-size: var(--text-xl);
    }
    .pc-stack {
      display: block;
      padding-top: var(--space-2);
      margin-top: var(--space-1);
      border-top: var(--ln-hairline);
    }
  }
</style>
