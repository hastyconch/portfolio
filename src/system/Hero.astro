---
// Hero: the album cover carries the <h1> (the site's one display moment, and the one place the
// record theme and grain appear outside Music); the record slides out behind it once. Beside it,
// what I do in plain words.
import type { Profile } from '../lib/content';
import Placeholder from './Placeholder.astro';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
const [first, ...rest] = profile.name.split(' ');
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="ln-wrap hero-grid">
    <div class="hero-sleeve">
      <div class="hero-vinyl ln-vinyl" aria-hidden="true"></div>
      <div class="hero-cover">
        <span class="hero-sun" aria-hidden="true"></span>
        <h1 id="hero-title" class="hero-name">
          <span>{first}</span>
          {rest.length > 0 && <span>{rest.join(' ')}</span>}
        </h1>
      </div>
    </div>

    <div class="hero-notes">
      <p class="label hero-role">
        {profile.roleLine}
        {profile.status === 'placeholder' && <Placeholder />}
      </p>
      <p class="hero-headline">{profile.headline}</p>
      <p class="hero-intro">{profile.intro}</p>
      <dl class="hero-facts">
        {profile.pillars.map((p) => (
          <div>
            <dt>{p.title}</dt>
            <dd>{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    /* the record's rotated box can poke past the viewport while it slides in */
    overflow-x: clip;
    padding-block: var(--space-7) var(--space-8);
    scroll-margin-top: var(--ln-header);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  /* Sleeve and record */
  .hero-sleeve {
    position: relative;
    width: 100%;
    max-width: 600px;
  }
  .hero-cover {
    position: relative;
    z-index: 1;
    width: 84%;
    aspect-ratio: 1;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 6cqi;
    border-radius: var(--radius-1);
    color: #fff4e8;
    background: var(--ln-grain), var(--ln-cover);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      var(--shadow-3);
    overflow: hidden;
  }
  .hero-cover::after {
    /* sleeve wear: a soft ring where the record presses through */
    content: '';
    position: absolute;
    inset: 7% -38% 7% 26%;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    pointer-events: none;
  }
  .hero-sun {
    position: absolute;
    top: 9%;
    right: 9%;
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle,
      rgb(255 236 214 / 0.9) 0 1.5px,
      transparent 2px 8px
    );
    mix-blend-mode: soft-light;
  }
  body.ln .hero-name {
    position: relative;
    z-index: 1;
    display: grid;
    font-family: var(--ln-display);
    font-weight: 800;
    font-stretch: var(--stretch-display);
    /* Sized to the cover, not the viewport: the name always fills the sleeve the same way. */
    font-size: 29cqi;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: #fff4e8;
    text-shadow: 0 2px 30px rgb(28 19 64 / 0.35);
  }

  .hero-vinyl {
    position: absolute;
    top: 4%;
    right: 0;
    width: 76%;
    --ln-label: #ff9b66;
  }
  /* The signature moment: one slow slide, once, so it gets twice the reveal time. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-vinyl {
      animation: hero-slide calc(var(--dur-reveal) * 2) var(--ease-out) var(--dur-quick) both;
    }
  }
  @keyframes hero-slide {
    from {
      transform: translateX(-22%) rotate(-40deg);
    }
  }

  /* What I do */
  .hero-notes {
    display: grid;
    gap: var(--space-5);
    max-width: 38rem;
  }
  .hero-role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .hero-headline {
    font-family: var(--ln-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }
  .hero-intro {
    max-width: var(--measure);
    color: var(--ln-ink-2);
  }
  .hero-facts {
    margin: var(--space-2) 0 0;
    border-top: var(--ln-hairline);
  }
  .hero-facts div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: var(--ln-hairline);
  }
  .hero-facts dt {
    font-weight: 700;
    line-height: var(--leading-snug);
  }
  .hero-facts dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }

  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }
</style>
