---
// Hero: the album cover (the one place the record theme and grain appear outside Music; the
// record slides out once) beside the name, set as the site's one display moment: Bricolage's
// condensed width with tight tracking. Then what I do, in plain words.
// WO-024: on phones the cover is capped at about 60% of the width, so the name, headline and
// links all sit in the first screen. WO-026: the link row holds only links that work: Résumé,
// See the work, and Email and LinkedIn once they are real (http(s) or mailto). A contact that
// isn't real yet appears in the footer only.
// WO-028: the work shows above the fold on laptops. The three pillars leave the notes column and
// sit under the cover and the notes as one row of three, spanning both columns, with less
// padding; the hero's bottom padding is a step tighter. A row reads better than a shorter stack:
// the pillars are three parallel claims, so side by side they scan as a set at a glance, the
// notes column ends on its links, and the row costs one pillar's height instead of three. Copy,
// the cover's size and the one display moment (the name) are unchanged. Phones keep the stack.
// WO-032: the pillars are quiet. No rules and no bold column heads: each pillar is one run of
// small text, the title run in at weight 600 and ended with a full stop, then the body in the
// second ink. They join the notes column as one compact list under the links, at every width,
// rather than a row of three under the hero. Beside the cover the list sits in space the notes
// left empty (the cover is taller than them), so the hero ends sooner and Work's title shows on
// common laptops; and a list of sentences under the links reads as more about me, not as a
// landing page's feature grid. Tablets (760 to 999px, one column) cap the sleeve at 300px wide,
// so the name sits in the first half of the screen.
import type { Profile } from '../lib/content';
import Placeholder from './Placeholder.astro';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
const real = (href: string) => /^(https?|mailto):/.test(href);
const contacts = ['email', 'linkedin'].flatMap((k) =>
  profile.links.filter((l) => l.label.toLowerCase() === k && real(l.href)),
);
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="ln-wrap hero-grid">
    <div class="hero-sleeve" aria-hidden="true">
      <div class="hero-vinyl ln-vinyl"></div>
      <div class="hero-cover">
        <span class="hero-sun"></span>
        <span class="hero-cover-name">{profile.name}</span>
      </div>
    </div>

    <div class="hero-notes">
      <p class="label hero-role">
        {profile.roleLine}
        {profile.status === 'placeholder' && <Placeholder />}
      </p>
      <h1 id="hero-title" class="hero-name">
        {profile.name}
      </h1>
      <p class="hero-headline">{profile.headline}</p>
      <p class="hero-intro">{profile.intro}</p>
      <p class="hero-links">
        <a class="ln-link" href="#resume">
          Résumé
        </a>
        {contacts.map((l) => (
          <a class="ln-link" href={l.href}>
            {l.label}
          </a>
        ))}
        <a class="hero-quiet" href="#work">
          See the work <span aria-hidden="true">↓</span>
        </a>
      </p>
      <dl class="hero-facts">
        {profile.pillars.map((p) => (
          <div>
            <dt>{p.title}.</dt> <dd>{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    /* the record's rotated box can poke past the viewport while it slides in */
    overflow-x: clip;
    padding-block: var(--space-7) var(--space-8);
  }
  .hero-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  /* Sleeve and record */
  .hero-sleeve {
    position: relative;
    width: 100%;
    max-width: 560px;
  }
  .hero-cover {
    position: relative;
    z-index: 1;
    width: 84%;
    aspect-ratio: 1;
    container-type: inline-size;
    padding: 6cqi;
    border-radius: var(--radius-1);
    color: #fff4e8;
    background: var(--ln-grain), var(--ln-cover);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      var(--shadow-3);
    overflow: hidden;
  }
  .hero-cover::after {
    /* sleeve wear: a soft ring where the record presses through */
    content: '';
    position: absolute;
    inset: 7% -38% 7% 26%;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    pointer-events: none;
  }
  .hero-sun {
    position: absolute;
    top: 9%;
    right: 9%;
    width: 34%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle,
      rgb(255 236 214 / 0.9) 0 1.5px,
      transparent 2px 8px
    );
    mix-blend-mode: soft-light;
  }
  .hero-cover-name {
    position: relative;
    z-index: 1;
    color: #2a0f1c;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero-vinyl {
    position: absolute;
    top: 4%;
    right: 0;
    width: 76%;
    --ln-label: #ff9b66;
  }
  /* The signature moment: one slow slide, once, so it gets twice the reveal time. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-vinyl {
      animation: hero-slide calc(var(--dur-reveal) * 2) var(--ease-out) var(--dur-quick) both;
    }
  }
  @keyframes hero-slide {
    from {
      transform: translateX(-22%) rotate(-40deg);
    }
  }

  /* The name, then what I do */
  .hero-notes {
    display: grid;
    gap: var(--space-4);
    max-width: 38rem;
  }
  .hero-role {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  body.ln .hero-name {
    font-size: var(--text-4xl);
    font-weight: 800;
    font-stretch: var(--stretch-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }
  .hero-headline {
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-title);
    text-wrap: balance;
  }
  .hero-intro {
    max-width: 52ch;
    color: var(--ln-ink-2);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .hero-links > * {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
  }
  /* See the work: quieter than the accent links beside it. */
  .hero-quiet {
    font-weight: 600;
    color: var(--ln-ink-2);
    text-decoration: underline;
    text-decoration-color: var(--ln-rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .hero-quiet:hover,
  .hero-quiet:focus-visible {
    color: var(--ln-ink);
    text-decoration-color: currentColor;
  }
  .hero-quiet:active {
    color: var(--ln-ink-3);
  }
  /* The pillars: one quiet run each, title then body, at the same small size. */
  .hero-facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .hero-facts dt,
  .hero-facts dd {
    display: inline;
    margin: 0;
  }
  .hero-facts dt {
    font-weight: 600;
    color: var(--ln-ink);
  }
  .hero-facts dd {
    color: var(--ln-ink-2);
  }

  /* Phones: a smaller cover and tighter spacing, so who I am fits the first screen. */
  @media (max-width: 759.98px) {
    .hero {
      padding-block: var(--space-5) var(--space-7);
    }
    .hero-grid {
      gap: var(--space-5);
    }
    .hero-sleeve {
      /* the cover is 84% of the sleeve: about 60% of the width */
      max-width: 72%;
    }
  }
  @media (min-width: 760px) {
    .hero {
      padding-block: var(--space-6);
    }
  }
  /* Tablets: one column, so the sleeve is capped and the name comes sooner. */
  @media (min-width: 760px) and (max-width: 999.98px) {
    .hero-sleeve {
      max-width: 300px;
    }
  }
  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-6) var(--space-8);
    }
  }
</style>
