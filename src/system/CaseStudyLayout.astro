---
// CaseStudyLayout: one project's case study: an accent swatch, the problem, what it does today, the
// roadmap (clearly labelled as planned), the stack and why, and engineering notes.
import type { Project } from '../lib/content';
import Shell from './Shell.astro';
import Placeholder from './Placeholder.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BillableMini from '../demos/billable/BillableMini.tsx';

interface Props {
  project: Project;
  /** position in the projects list (kept for callers; not shown) */
  index: number;
  prev?: Project;
  next?: Project;
}
const { project, prev, next } = Astro.props;
const d = project.data;
// Owner drop-ins: src/assets/projects/<id>/<slot>.(png|jpg|webp), see the README there.
const dropins = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const fromSlot = (slot?: string) =>
  slot
    ? Object.entries(dropins).find(([k]) => k.includes(`/projects/${project.id}/${slot}.`))?.[1]
        .default
    : undefined;
const cover = d.cover;
const heroShot = cover?.image ?? fromSlot(cover?.slot);
const frame = cover?.frame ?? 'browser';
const isGame = frame === 'game';
const gallery = d.gallery?.items.map((g) => ({ ...g, src: g.image ?? fromSlot(g.slot) }));
const pending = gallery?.some((g) => !g.src);
const contents = [
  ...(d.demo === 'billable' ? [{ id: 'play', label: 'Play a room' }] : []),
  { id: 'problem', label: 'Problem' },
  { id: 'features', label: 'What it does' },
  ...(d.gallery ? [{ id: 'gallery', label: d.gallery.title }] : []),
  ...(d.planned.length ? [{ id: 'roadmap', label: 'Roadmap' }] : []),
  { id: 'stack', label: 'Stack' },
  { id: 'notes', label: 'Engineering notes' },
];
---

<Shell title={`${d.title} · case study`} description={d.tagline}>
  <article class="cs" style={`--art: ${d.accent}; --bd: ${cover?.backdrop ?? d.accent}`}>
    <header class="cs-head">
      <div class="ln-wrap cs-head-grid">
        <figure class="cs-hero">
          <div class:list={['cs-art', `pa-${frame}`]}>
            <div class="pa-dev">
              {heroShot && isGame ? (
                // Pixel art ships as its lossless 2x master (about 10 KB): re-encoding it lossy
                // makes it larger and blurrier.
                <img
                  src={heroShot.src}
                  width={heroShot.width}
                  height={heroShot.height}
                  alt={cover?.alt ?? ''}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              ) : heroShot ? (
                <Image
                  src={heroShot}
                  alt={cover?.alt ?? ''}
                  widths={frame === 'phone' ? [280, 480] : [720, 1280]}
                  sizes={
                    frame === 'phone'
                      ? '(min-width: 1000px) 210px, calc((100vw - 2rem) * 0.38)'
                      : '(min-width: 1000px) 580px, calc(100vw - 2rem)'
                  }
                  quality={60}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              ) : (
                <div class="pa-soon" role="img" aria-label={`${d.title}: screenshots coming`}>
                  <span class="pa-sk" />
                  <span class="pa-sk" />
                  <span class="pa-sk" />
                  <span class="pa-soon-t" aria-hidden="true">
                    Screenshots coming
                  </span>
                </div>
              )}
            </div>
          </div>
          {cover?.mockup && (
            <figcaption class="cs-hero-cap">Mock-up, with invented cards and prices.</figcaption>
          )}
        </figure>
        <div class="cs-intro">
          <p class="cs-back">
            <a href="/#projects">
              <span aria-hidden="true">←</span> All projects
            </a>
          </p>
          <p class="label cs-k">
            Case study
            {d.featured && <span class="cs-feat">Featured</span>}
            {d.status === 'placeholder' && <Placeholder />}
          </p>
          <h1 class="cs-title">{d.title}</h1>
          <p class="cs-tagline">{d.tagline}</p>
          <dl class="cs-facts">
            <div>
              <dt>Year</dt>
              <dd class="ln-num">{d.year}</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd class="cs-cap">{d.category}</dd>
            </div>
            <div>
              <dt>Platforms</dt>
              <dd>{d.platforms.join(' · ')}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <div class="ln-wrap cs-body">
      <nav class="cs-toc" aria-labelledby="cs-toc-h">
        <p class="label" id="cs-toc-h">
          On this page
        </p>
        <ol>
          {contents.map((c) => (
            <li>
              <a href={`#${c.id}`}>{c.label}</a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="cs-main">
        {d.demo === 'billable' && (
          <section id="play" class="cs-sec cs-play" aria-labelledby="play-h">
            <h2 id="play-h" class="cs-h">
              Play a room
            </h2>
            <p class="cs-sub">One room of the real game, in your browser.</p>
            <BillableMini client:visible />
          </section>
        )}

        <section id="problem" class="cs-sec reveal" aria-labelledby="problem-h">
          <h2 id="problem-h" class="cs-h">
            Problem
          </h2>
          <p class="cs-problem">{d.problem}</p>
        </section>

        <section id="features" class="cs-sec reveal" aria-labelledby="features-h">
          <h2 id="features-h" class="cs-h">
            What it does
          </h2>
          <ul class="cs-features">
            {d.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>

        {d.gallery && gallery && (
          <section id="gallery" class="cs-sec cs-gallery reveal" aria-labelledby="gallery-h">
            <h2 id="gallery-h" class="cs-h">
              {d.gallery.title}
            </h2>
            <p class="cs-gal-intro">{d.gallery.intro}</p>
            <ul
              class:list={['cs-gal', { 'cs-gal-game': isGame, 'cs-gal-waiting': pending }]}
              aria-labelledby="gallery-h"
              tabindex="0"
            >
              {gallery.map((g) => (
                <li class:list={['cs-gal-item', `cs-gal-${g.shape}`, { 'cs-gal-pending': !g.src }]}>
                  <figure>
                    {g.src && isGame ? (
                      <img
                        src={g.src.src}
                        width={g.src.width}
                        height={g.src.height}
                        alt={g.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : g.src ? (
                      <Image
                        src={g.src}
                        alt={g.alt}
                        widths={g.shape === 'tall' ? [360, 480] : [720, 1440]}
                        sizes={
                          g.shape === 'full'
                            ? '(min-width: 1000px) 760px, calc(100vw - 2rem)'
                            : g.shape === 'wide'
                              ? '(min-width: 760px) 380px, calc(100vw - 2rem)'
                              : '(min-width: 760px) 180px, calc(50vw - 1.5rem)'
                        }
                        quality={70}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="cs-gal-soon" aria-hidden="true">
                        <span class="pa-sk" />
                        <span class="pa-sk" />
                        <span class="pa-sk" />
                        <span class="cs-gal-soon-t">Screenshot coming</span>
                      </div>
                    )}
                    <figcaption>
                      {!g.src && <span class="visually-hidden">Screenshot coming: </span>}
                      {g.caption}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
            {pending && (
              <p class="cs-gal-note">
                Screenshots are on their way. This app runs on real accounts and personal data, so
                they will be taken on demo data.
              </p>
            )}
          </section>
        )}

        {d.planned.length > 0 && (
          <section id="roadmap" class="cs-sec cs-roadmap reveal" aria-labelledby="roadmap-h">
            <h2 id="roadmap-h" class="cs-h">
              Roadmap
            </h2>
            <p class="cs-sub">Planned, not shipped yet.</p>
            <ul class="cs-planned">
              {d.planned.map((p) => (
                <li>
                  <span class="cs-planned-tag">Planned</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section id="stack" class="cs-sec reveal" aria-labelledby="stack-h">
          <h2 id="stack-h" class="cs-h">
            Stack
          </h2>
          <table class="cs-stack">
            <thead>
              <tr>
                <th scope="col">Layer</th>
                <th scope="col">Tech</th>
                <th scope="col">Why</th>
              </tr>
            </thead>
            <tbody>
              {d.stack.map((s) => (
                <tr>
                  <th scope="row">{s.layer}</th>
                  <td class="cs-tech">{s.tech}</td>
                  <td class="cs-why">{s.why}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section id="notes" class="cs-sec reveal" aria-labelledby="notes-h">
          <h2 id="notes-h" class="cs-h">
            Engineering notes
          </h2>
          <div class="cs-notes">
            {d.engineering.map((e) => (
              <div class="cs-note">
                <h3>{e.title}</h3>
                <p>{e.body}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <nav class="ln-wrap cs-pager" aria-label="More projects">
      {prev ? (
        <a class="cs-pg" href={`/projects/${prev.id}/`} rel="prev">
          <span class="cs-pg-k">Previous project</span>
          <span class="cs-pg-t">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="cs-pg cs-pg-next" href={`/projects/${next.id}/`} rel="next">
          <span class="cs-pg-k">Next project</span>
          <span class="cs-pg-t">{next.data.title}</span>
        </a>
      ) : (
        <a class="cs-pg cs-pg-next" href="/#projects">
          <span class="cs-pg-k">Back to</span>
          <span class="cs-pg-t">All projects</span>
        </a>
      )}
    </nav>
  </article>
</Shell>

<style>
  .cs-head {
    padding-block: var(--space-7) var(--space-8);
    border-bottom: var(--ln-hairline);
  }
  .cs-head-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  /* Hero: the app's own screen in a device frame on a backdrop tinted from its palette (the
     same composition as the project card). On phones it follows the intro, so the title leads. */
  .cs-hero {
    order: 1;
    margin: 0;
    min-width: 0;
  }
  .cs-art {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-3);
    background: color-mix(in srgb, var(--bd) 24%, var(--ln-bg-2));
    outline: 1px solid color-mix(in srgb, var(--ln-ink) 10%, transparent);
    outline-offset: -1px;
  }
  .cs-hero-cap {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  .pa-dev {
    position: absolute;
    /* device material: the same near-black in both schemes, like real hardware */
    background: #18181b;
    box-shadow: var(--shadow-2);
  }
  .pa-dev :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  /* Phone: rises from the bottom edge. Concentric corners: 12 = 8 + 4. */
  .pa-phone .pa-dev {
    left: 50%;
    top: 10%;
    width: 38%;
    aspect-ratio: 390 / 844;
    translate: -50% 0;
    padding: var(--space-1);
    border-radius: var(--radius-3);
  }
  .pa-phone .pa-dev :global(img),
  .pa-phone .pa-soon {
    border-radius: var(--radius-2);
  }
  /* Browser: a window that runs off the right and bottom edges. */
  .pa-browser .pa-dev {
    left: 7%;
    top: 11%;
    width: 104%;
    aspect-ratio: 16 / 10;
    padding-top: 4cqi;
    border-radius: var(--radius-2) 0 0 0;
  }
  .pa-browser .pa-dev::before {
    content: '';
    position: absolute;
    top: 1.4cqi;
    left: 2cqi;
    width: 1.2cqi;
    height: 1.2cqi;
    border-radius: 50%;
    background: #52525b;
    box-shadow:
      2cqi 0 #52525b,
      4cqi 0 #52525b;
  }
  /* Game: a screen in a thick bezel, centred. Concentric corners: 12 = 4 + 8. */
  .pa-game .pa-dev {
    left: 50%;
    top: 50%;
    width: 84%;
    aspect-ratio: 16 / 9;
    translate: -50% -50%;
    padding: var(--space-2);
    border-radius: var(--radius-3);
  }
  .pa-game .pa-dev :global(img) {
    border-radius: var(--radius-1);
    image-rendering: pixelated;
  }
  /* Screenshots coming: a quiet sketch of a screen, not a broken image. */
  .pa-soon {
    display: grid;
    align-content: start;
    gap: 4cqi;
    height: 100%;
    padding: 5cqi 4cqi;
    background: color-mix(in srgb, var(--bd) 10%, var(--ln-bg-3));
  }
  .pa-sk {
    height: 3cqi;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bd) 28%, var(--ln-bg-3));
  }
  .pa-sk:first-child {
    width: 60%;
    height: 5cqi;
    background: color-mix(in srgb, var(--bd) 60%, var(--ln-bg-3));
  }
  .pa-soon-t {
    margin-top: 4cqi;
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }

  .cs-intro {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .cs-back a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cs-back a:hover,
  .cs-back a:focus-visible {
    color: var(--ln-ink);
    text-decoration-color: currentColor;
  }
  .cs-back a:active {
    color: var(--ln-ink-3);
  }
  .cs-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .cs-feat {
    padding: 0 var(--space-2);
    border: var(--ln-hairline);
    border-radius: var(--radius-full);
    color: var(--ln-ink-2);
  }
  body.ln .cs-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: var(--leading-tight);
  }
  .cs-tagline {
    max-width: 40ch;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }
  .cs-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-4);
    border-top: var(--ln-hairline);
  }
  .cs-facts dt {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .cs-facts dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
  }
  .cs-cap {
    text-transform: capitalize;
  }

  /* Body */
  .cs-body {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-8);
  }
  .cs-toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .cs-toc a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ln-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cs-toc a:hover,
  .cs-toc a:focus-visible {
    color: var(--ln-ink);
    text-decoration-color: currentColor;
  }
  .cs-toc a:active {
    color: var(--ln-ink-3);
  }
  .cs-main {
    display: grid;
    gap: var(--space-8);
    min-width: 0;
  }
  .cs-sec {
    scroll-margin-top: calc(var(--ln-header) + var(--space-4));
  }
  body.ln .cs-h {
    margin-bottom: var(--space-4);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
  }
  .cs-sub {
    margin: calc(var(--space-2) * -1) 0 var(--space-5);
    color: var(--ln-ink-2);
  }
  .cs-problem {
    max-width: var(--measure);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }
  .cs-features {
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .cs-features li {
    padding-block: var(--space-3);
    border-bottom: var(--ln-hairline);
  }
  .cs-planned {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cs-planned li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }
  .cs-planned-tag {
    padding: 0 var(--space-2);
    border: 1px dashed currentColor;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ln-ink-2);
  }

  /* Stack */
  .cs-stack {
    width: 100%;
    border-collapse: collapse;
  }
  .cs-stack thead th {
    padding: 0 0 var(--space-2);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: left;
    color: var(--ln-ink-3);
  }
  .cs-stack tbody th,
  .cs-stack td {
    padding: var(--space-4) var(--space-5) var(--space-4) 0;
    border-top: var(--ln-hairline);
    text-align: left;
    vertical-align: top;
  }
  .cs-stack tbody th {
    width: 9rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ln-ink-2);
  }
  .cs-tech {
    width: 32%;
    font-weight: 700;
    line-height: var(--leading-snug);
  }
  .cs-why {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }

  .cs-notes {
    display: grid;
    gap: var(--space-5) var(--space-6);
  }
  .cs-note {
    padding-top: var(--space-4);
    border-top: var(--ln-hairline);
  }
  body.ln .cs-note h3 {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .cs-note p {
    margin-top: var(--space-2);
    color: var(--ln-ink-2);
  }

  /* Pager */
  .cs-pager {
    display: grid;
    padding-bottom: var(--space-8);
  }
  .cs-pg {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-1);
    border-top: var(--ln-hairline);
    text-decoration: none;
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  .cs-pg-k {
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  .cs-pg-t {
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-title);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cs-pg:hover .cs-pg-t,
  .cs-pg:focus-visible .cs-pg-t {
    text-decoration-color: currentColor;
  }
  .cs-pg:active {
    background: var(--ln-hl);
  }
  .cs-pg:active .cs-pg-t {
    color: var(--ln-ink-2);
  }

  @media (max-width: 639px) {
    .cs-stack thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .cs-stack,
    .cs-stack tbody,
    .cs-stack tr,
    .cs-stack th,
    .cs-stack td {
      display: block;
      width: auto;
    }
    .cs-stack tr {
      padding: var(--space-4) 0;
      border-top: var(--ln-hairline);
    }
    .cs-stack tbody th,
    .cs-stack td {
      padding: 0;
      border: 0;
    }
    .cs-tech {
      margin-top: var(--space-1);
    }
    .cs-why {
      margin-top: var(--space-1);
    }
  }
  @media (min-width: 760px) {
    .cs-notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cs-pager {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-6);
    }
    .cs-pg-next {
      text-align: right;
      grid-column: 2;
    }
  }
  @media (min-width: 1000px) {
    .cs-head-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
    .cs-intro {
      grid-column: 1;
      grid-row: 1;
    }
    .cs-hero {
      grid-column: 2;
      grid-row: 1;
    }
    .cs-body {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-8);
    }
    .cs-toc {
      position: sticky;
