---
// CaseStudyLayout slot — a project's liner notes: sleeve front, the problem, features as a
// tracklist, the roadmap (clearly "On the roadmap"), the stack as credits, producer's notes.
import type { Project } from '../lib/content';
import Shell from './Shell.astro';
import Placeholder from './Placeholder.astro';
import { Image } from 'astro:assets';
import BillableMini from '../demos/billable/BillableMini.tsx';

interface Props {
  project: Project;
  index: number;
  prev?: Project;
  next?: Project;
}
const { project, index, prev, next } = Astro.props;
const d = project.data;
const n = `B${index + 1}`;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const contents = [
  ...(d.demo === 'billable' ? [{ id: 'play', label: 'Play a room' }] : []),
  { id: 'problem', label: 'The problem' },
  { id: 'features', label: 'Tracklist' },
  ...(d.gallery ? [{ id: 'gallery', label: d.gallery.title }] : []),
  ...(d.planned.length ? [{ id: 'roadmap', label: 'On the roadmap' }] : []),
  { id: 'stack', label: 'Credits · stack' },
  { id: 'notes', label: 'Producer’s notes' },
];
---

<Shell title={`${d.title} — case study`} description={d.tagline} nowPlaying={`${n} · ${d.title}`}>
  <article class="cs" style={`--art: ${d.accent}`}>
    <header class="cs-head" data-np={`${n} · ${d.title}`}>
      <div class="ln-wrap cs-head-grid">
        <div class="cs-sleeve" aria-hidden="true">
          <span class="cs-vinyl ln-vinyl"></span>
          <div class:list={['cs-art', `cs-art-${d.category}`]}>
            <span class="cs-art-n">{n}</span>
            <span class="cs-art-word">{d.title}</span>
          </div>
        </div>
        <div class="cs-intro">
          <p class="cs-back">
            <a href="/#projects">← Side B · Personal projects</a>
          </p>
          <p class="ln-eyebrow cs-k">
            Side B · Track {index + 1}
            {d.featured && <span class="cs-feat">Featured</span>}
            {d.status === 'placeholder' && <Placeholder />}
          </p>
          <h1 class="cs-title">{d.title}</h1>
          <p class="cs-tagline">{d.tagline}</p>
          <dl class="cs-facts">
            <div>
              <dt>Year</dt>
              <dd class="ln-num">{d.year}</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd class="cs-cap">{d.category}</dd>
            </div>
            <div>
              <dt>Platforms</dt>
              <dd>{d.platforms.join(' · ')}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <div class="ln-wrap cs-body">
      <nav class="cs-toc" aria-label="Liner notes contents">
        <p class="ln-eyebrow">Contents</p>
        <ol>
          {contents.map((c, i) => (
            <li>
              <a href={`#${c.id}`}>
                <span class="ln-num" aria-hidden="true">
                  {pad(i)}
                </span>
                {c.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="cs-main">
        {d.demo === 'billable' && (
          <section
            id="play"
            class="cs-sec cs-play"
            data-np={`${n} · Play a room`}
            aria-labelledby="play-h"
          >
            <h2 id="play-h" class="cs-h">
              Play a room <span>one room of the real game, in your browser</span>
            </h2>
            <BillableMini client:visible={{ rootMargin: '300px' }} />
          </section>
        )}

        <section
          id="problem"
          class="cs-sec"
          data-np={`${n} · The problem`}
          aria-labelledby="problem-h"
        >
          <h2 id="problem-h" class="cs-h">
            The problem
          </h2>
          <p class="cs-problem">{d.problem}</p>
        </section>

        <section
          id="features"
          class="cs-sec"
          data-np={`${n} · Tracklist`}
          aria-labelledby="features-h"
        >
          <h2 id="features-h" class="cs-h">
            Tracklist <span>what it does today</span>
          </h2>
          <ol class="cs-tracks">
            {d.features.map((f, i) => (
              <li>
                <span class="cs-tn ln-num" aria-hidden="true">
                  {pad(i)}
                </span>
                <span>{f}</span>
              </li>
            ))}
          </ol>
        </section>

        {d.gallery && (
          <section
            id="gallery"
            class="cs-sec cs-gallery"
            data-np={`${n} · ${d.gallery.title}`}
            aria-labelledby="gallery-h"
          >
            <h2 id="gallery-h" class="cs-h">
              {d.gallery.title}
            </h2>
            <p class="cs-gal-intro">{d.gallery.intro}</p>
            <ul class="cs-gal">
              {d.gallery.items.map((g) => (
                <li class:list={['cs-gal-item', `cs-gal-${g.shape}`]}>
                  <figure>
                    <Image
                      src={g.image}
                      alt={g.alt}
                      widths={g.shape === 'tall' ? [240, 480] : [720, 1440]}
                      sizes={
                        g.shape === 'full'
                          ? '(min-width: 1000px) 760px, 100vw'
                          : g.shape === 'wide'
                            ? '(min-width: 760px) 380px, 100vw'
                            : '(min-width: 760px) 180px, 45vw'
                      }
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>{g.caption}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </section>
        )}

        {d.planned.length > 0 && (
          <section
            id="roadmap"
            class="cs-sec cs-roadmap"
            data-np={`${n} · On the roadmap`}
            aria-labelledby="roadmap-h"
          >
            <h2 id="roadmap-h" class="cs-h">
              On the roadmap <span>planned — not shipped yet</span>
            </h2>
            <ul class="cs-planned">
              {d.planned.map((p) => (
                <li>
                  <span class="cs-planned-tag">Planned</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section id="stack" class="cs-sec" data-np={`${n} · Credits`} aria-labelledby="stack-h">
          <h2 id="stack-h" class="cs-h">
            Credits <span>the stack, and why</span>
          </h2>
          <table class="cs-stack">
            <thead>
              <tr>
                <th scope="col">Layer</th>
                <th scope="col">Tech</th>
                <th scope="col">Why</th>
              </tr>
            </thead>
            <tbody>
              {d.stack.map((s) => (
                <tr>
                  <th scope="row">{s.layer}</th>
                  <td class="cs-tech">{s.tech}</td>
                  <td class="cs-why">{s.why}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section
          id="notes"
          class="cs-sec"
          data-np={`${n} · Producer’s notes`}
          aria-labelledby="notes-h"
        >
          <h2 id="notes-h" class="cs-h">
            Producer’s notes <span>engineering</span>
          </h2>
          <div class="cs-notes">
            {d.engineering.map((e) => (
              <div class="cs-note">
                <h3>{e.title}</h3>
                <p>{e.body}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <nav class="ln-wrap cs-pager" aria-label="More projects">
      {prev ? (
        <a class="cs-pg" href={`/projects/${prev.id}/`} style={`--art: ${prev.data.accent}`}>
          <span class="cs-pg-k">← Previous track</span>
          <span class="cs-pg-t">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a
          class="cs-pg cs-pg-next"
          href={`/projects/${next.id}/`}
          style={`--art: ${next.data.accent}`}
        >
          <span class="cs-pg-k">Next track →</span>
          <span class="cs-pg-t">{next.data.title}</span>
        </a>
      ) : (
        <a class="cs-pg cs-pg-next" href="/#music">
          <span class="cs-pg-k">Flip to the bonus tracks →</span>
          <span class="cs-pg-t">Music</span>
        </a>
      )}
    </nav>
  </article>
</Shell>

<style>
  .cs-head {
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--ln-rule);
    background:
      radial-gradient(
        55% 70% at 10% 0%,
        color-mix(in srgb, var(--art) 22%, transparent),
        transparent 70%
      ),
      var(--ln-bg);
  }
  .cs-head-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .cs-sleeve {
    position: relative;
    width: min(100%, 520px);
  }
  .cs-vinyl {
    position: absolute;
    top: 5%;
    right: 0;
    width: 76%;
    --ln-label: color-mix(in oklab, var(--art) 55%, #fff);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cs-vinyl {
      animation: cs-out 1.2s cubic-bezier(0.2, 0.7, 0.1, 1) 0.1s both;
    }
  }
  @keyframes cs-out {
    from {
      transform: translateX(-22%) rotate(-50deg);
    }
  }
  .cs-art {
    position: relative;
    width: 82%;
    aspect-ratio: 1;
    container-type: inline-size;
    border-radius: 4px;
    overflow: hidden;
    color: #fff;
    background:
      var(--ln-grain),
      radial-gradient(
        90% 70% at 20% 10%,
        color-mix(in oklab, var(--art) 55%, #fff) 0,
        transparent 60%
      ),
      linear-gradient(160deg, var(--art), color-mix(in oklab, var(--art) 30%, #000));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.2) inset,
      0 30px 60px -24px rgb(0 0 0 / 0.6);
  }
  .cs-art::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.4;
    mix-blend-mode: soft-light;
  }
  .cs-art-app::before {
    background: repeating-radial-gradient(circle at 100% 100%, #fff 0 1px, transparent 1.5px 9cqi);
  }
  .cs-art-game::before {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.5) 1px, transparent 1px) 0 0 / 12.5cqi 12.5cqi,
      linear-gradient(rgb(255 255 255 / 0.5) 1px, transparent 1px) 0 0 / 12.5cqi 12.5cqi;
  }
  .cs-art-tool::before {
    background: repeating-linear-gradient(
      -45deg,
      rgb(255 255 255 / 0.55) 0 1px,
      transparent 1px 7cqi
    );
  }
  .cs-art-n {
    position: absolute;
    top: 7cqi;
    left: 8cqi;
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: 6cqi;
    letter-spacing: 0.08em;
  }
  .cs-art-word {
    position: absolute;
    left: 8cqi;
    right: 8cqi;
    bottom: 8cqi;
    font-family: var(--ln-display);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 17cqi;
    line-height: 0.85;
    letter-spacing: -0.03em;
    text-wrap: balance;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.25);
  }

  .cs-intro {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .cs-back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--ln-ink-2);
  }
  .cs-back a:hover {
    color: var(--ln-ink);
    text-decoration: underline;
  }
  .cs-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.8rem;
    color: var(--ln-accent);
  }
  .cs-feat {
    padding: 0.1em 0.6em;
    border-radius: 999px;
    background: var(--ln-accent);
    color: var(--ln-accent-ink);
    letter-spacing: 0.08em;
  }
  body.ln .cs-title {
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.86;
    letter-spacing: -0.035em;
  }
  .cs-tagline {
    font-family: var(--ln-display);
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ln-ink-2);
    max-width: 26em;
  }
  .cs-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0.75rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ln-rule);
  }
  .cs-facts dt {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .cs-facts dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }
  .cs-cap {
    text-transform: capitalize;
  }

  /* Body */
  .cs-body {
    display: grid;
    gap: 2rem;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  .cs-toc ol {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .cs-toc a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--ln-rule);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .cs-toc a:hover {
    background: var(--ln-hl);
  }
  .cs-toc .ln-num {
    font-size: 0.75rem;
    color: var(--ln-ink-3);
  }
  .cs-main {
    display: grid;
    gap: clamp(3.5rem, 7vw, 5.5rem);
    min-width: 0;
  }
  .cs-sec {
    scroll-margin-top: calc(var(--ln-header) + 1rem);
  }
  body.ln .cs-h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--ln-ink);
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    font-weight: 800;
    font-stretch: 82%;
    letter-spacing: -0.025em;
  }
  .cs-h span {
    font-family: var(--ln-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .cs-problem {
    font-family: var(--ln-display);
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.01em;
    max-width: 34em;
  }
  .cs-problem::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-size: 3.4em;
    font-weight: 800;
    line-height: 0.8;
    color: var(--ln-accent);
  }
  .cs-tracks {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: t;
  }
  .cs-tracks li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--ln-rule);
    font-size: 1.0625rem;
  }
  .cs-tn {
    padding-top: 0.15rem;
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ln-accent);
  }
  .cs-roadmap {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1.5px dashed var(--ln-rule);
    border-radius: 12px;
  }
  .cs-planned {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cs-planned li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
    font-size: 1.0625rem;
  }
  .cs-planned-tag {
    padding: 0.15em 0.65em;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ln-ink-2);
  }

  /* Stack as credits */
  .cs-stack {
    width: 100%;
    border-collapse: collapse;
  }
  .cs-stack thead th {
    padding: 0 0 0.6rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ln-ink-3);
  }
  .cs-stack tbody th,
  .cs-stack td {
    padding: 1.1rem 1.5rem 1.1rem 0;
    border-top: 1px solid var(--ln-rule);
    text-align: left;
    vertical-align: top;
  }
  .cs-stack tbody th {
    width: 9rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ln-accent);
    padding-top: 1.35rem;
  }
  .cs-tech {
    width: 32%;
    font-family: var(--ln-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .cs-why {
    color: var(--ln-ink-2);
    font-size: 0.98rem;
  }

  .cs-notes {
    display: grid;
    gap: 1.25rem;
  }
  .cs-note {
    padding: 1.4rem 1.5rem;
    border-radius: 12px;
    background: var(--ln-bg-2);
    border: 1px solid var(--ln-rule);
  }
  body.ln .cs-note h3 {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .cs-note p {
    margin-top: 0.5rem;
    color: var(--ln-ink-2);
  }

  /* Pager */
  .cs-pager {
    display: grid;
    gap: 1rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .cs-pg {
    display: grid;
    gap: 0.3rem;
    padding: 1.4rem 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--ln-rule);
    text-decoration: none;
    background: linear-gradient(
      120deg,
      color-mix(in srgb, var(--art, var(--ln-accent)) 18%, transparent),
      transparent 60%
    );
  }
  .cs-pg:hover {
    border-color: var(--ln-ink);
  }
  .cs-pg-k {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .cs-pg-t {
    font-family: var(--ln-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 800;
    font-stretch: 82%;
    letter-spacing: -0.02em;
  }

  @media (max-width: 639px) {
    .cs-stack thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .cs-stack,
    .cs-stack tbody,
    .cs-stack tr,
    .cs-stack th,
    .cs-stack td {
      display: block;
      width: auto;
    }
    .cs-stack tr {
      padding: 1.1rem 0;
      border-top: 1px solid var(--ln-rule);
    }
    .cs-stack tbody th,
    .cs-stack td {
      padding: 0;
      border: 0;
    }
    .cs-stack tbody th {
      padding-top: 0;
    }
    .cs-tech {
      margin-top: 0.3rem;
    }
    .cs-why {
      margin-top: 0.35rem;
    }
  }
  @media (min-width: 760px) {
    .cs-notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cs-pager {
      grid-template-columns: 1fr 1fr;
    }
    .cs-pg-next {
      text-align: right;
      grid-column: 2;
    }
  }
  @media (min-width: 1000px) {
    .cs-head-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 5rem;
    }
    .cs-body {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 5rem;
    }
    .cs-toc {
      position: sticky;
      top: calc(var(--ln-header) + 2rem);
      align-self: start;
    }
    .cs-toc ol {
      display: grid;
      gap: 0;
      border-top: 1px solid var(--ln-rule);
    }
    .cs-toc a {
      display: flex;
      width: 100%;
      padding: 0.7rem 0.25rem;
      border: 0;
      border-bottom: 1px solid var(--ln-rule);
      border-radius: 0;
    }
  }

  /* Process gallery */
  .cs-gal-intro {
    max-width: 38em;
    color: var(--ln-ink-2);
  }
  .cs-gal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .cs-gal-full,
  .cs-gal-wide {
    grid-column: 1 / -1;
  }
  .cs-gal figure {
    margin: 0;
  }
  .cs-gal :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--ln-rule);
    border-radius: 10px;
    background: var(--ln-bg-3);
  }
  .cs-gal-tall :global(img) {
    border-radius: 16px;
  }
  .cs-gal figcaption {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--ln-ink-3);
  }
  @media (min-width: 760px) {
    .cs-gal {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .cs-gal-wide {
      grid-column: span 2;
    }
  }

  /* Billable mini-room: give its Goal / Controls headings room inside the system's type. */
  body.ln .cs-play :global(.bm-h) {
    margin: 1.25rem 0 0.4rem;
    font-size: 0.75rem;
