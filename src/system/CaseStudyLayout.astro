---
// CaseStudyLayout: one project's case study: cover art, the problem, what it does today, the
// roadmap (clearly labelled as planned), the stack and why, and engineering notes.
import type { Project } from '../lib/content';
import Shell from './Shell.astro';
import Placeholder from './Placeholder.astro';
import { Image } from 'astro:assets';
import BillableMini from '../demos/billable/BillableMini.tsx';

interface Props {
  project: Project;
  /** position in the projects list (kept for callers; not shown) */
  index: number;
  prev?: Project;
  next?: Project;
}
const { project, prev, next } = Astro.props;
const d = project.data;
const contents = [
  ...(d.demo === 'billable' ? [{ id: 'play', label: 'Play a room' }] : []),
  { id: 'problem', label: 'Problem' },
  { id: 'features', label: 'What it does' },
  ...(d.gallery ? [{ id: 'gallery', label: d.gallery.title }] : []),
  ...(d.planned.length ? [{ id: 'roadmap', label: 'Roadmap' }] : []),
  { id: 'stack', label: 'Stack' },
  { id: 'notes', label: 'Engineering notes' },
];
---

<Shell title={`${d.title} · case study`} description={d.tagline}>
  <article class="cs" style={`--art: ${d.accent}`}>
    <header class="cs-head">
      <div class="ln-wrap cs-head-grid">
        <div class:list={['cs-art', `cs-art-${d.category}`]} aria-hidden="true">
          <span class="cs-art-word">{d.title}</span>
        </div>
        <div class="cs-intro">
          <p class="cs-back">
            <a href="/#projects">
              <span aria-hidden="true">←</span> All projects
            </a>
          </p>
          <p class="label cs-k">
            Case study
            {d.featured && <span class="cs-feat">Featured</span>}
            {d.status === 'placeholder' && <Placeholder />}
          </p>
          <h1 class="cs-title">{d.title}</h1>
          <p class="cs-tagline">{d.tagline}</p>
          <dl class="cs-facts">
            <div>
              <dt>Year</dt>
              <dd class="ln-num">{d.year}</dd>
            </div>
            <div>
              <dt>Format</dt>
              <dd class="cs-cap">{d.category}</dd>
            </div>
            <div>
              <dt>Platforms</dt>
              <dd>{d.platforms.join(' · ')}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <div class="ln-wrap cs-body">
      <nav class="cs-toc" aria-labelledby="cs-toc-h">
        <p class="label" id="cs-toc-h">
          On this page
        </p>
        <ol>
          {contents.map((c) => (
            <li>
              <a href={`#${c.id}`}>{c.label}</a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="cs-main">
        {d.demo === 'billable' && (
          <section id="play" class="cs-sec cs-play" aria-labelledby="play-h">
            <h2 id="play-h" class="cs-h">
              Play a room
            </h2>
            <p class="cs-sub">One room of the real game, in your browser.</p>
            <BillableMini client:visible />
          </section>
        )}

        <section id="problem" class="cs-sec reveal" aria-labelledby="problem-h">
          <h2 id="problem-h" class="cs-h">
            Problem
          </h2>
          <p class="cs-problem">{d.problem}</p>
        </section>

        <section id="features" class="cs-sec reveal" aria-labelledby="features-h">
          <h2 id="features-h" class="cs-h">
            What it does
          </h2>
          <ul class="cs-features">
            {d.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>

        {d.gallery && (
          <section id="gallery" class="cs-sec cs-gallery reveal" aria-labelledby="gallery-h">
            <h2 id="gallery-h" class="cs-h">
              {d.gallery.title}
            </h2>
            <p class="cs-gal-intro">{d.gallery.intro}</p>
            <ul class="cs-gal">
              {d.gallery.items.map((g) => (
                <li class:list={['cs-gal-item', `cs-gal-${g.shape}`]}>
                  <figure>
                    <Image
                      src={g.image}
                      alt={g.alt}
                      widths={g.shape === 'tall' ? [240, 480] : [720, 1440]}
                      sizes={
                        g.shape === 'full'
                          ? '(min-width: 1000px) 760px, 100vw'
                          : g.shape === 'wide'
                            ? '(min-width: 760px) 380px, 100vw'
                            : '(min-width: 760px) 180px, 45vw'
                      }
                      loading="lazy"
                      decoding="async"
                    />
                    <figcaption>{g.caption}</figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </section>
        )}

        {d.planned.length > 0 && (
          <section id="roadmap" class="cs-sec cs-roadmap reveal" aria-labelledby="roadmap-h">
            <h2 id="roadmap-h" class="cs-h">
              Roadmap
            </h2>
            <p class="cs-sub">Planned, not shipped yet.</p>
            <ul class="cs-planned">
              {d.planned.map((p) => (
                <li>
                  <span class="cs-planned-tag">Planned</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section id="stack" class="cs-sec reveal" aria-labelledby="stack-h">
          <h2 id="stack-h" class="cs-h">
            Stack
          </h2>
          <table class="cs-stack">
            <thead>
              <tr>
                <th scope="col">Layer</th>
                <th scope="col">Tech</th>
                <th scope="col">Why</th>
              </tr>
            </thead>
            <tbody>
              {d.stack.map((s) => (
                <tr>
                  <th scope="row">{s.layer}</th>
                  <td class="cs-tech">{s.tech}</td>
                  <td class="cs-why">{s.why}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section id="notes" class="cs-sec reveal" aria-labelledby="notes-h">
          <h2 id="notes-h" class="cs-h">
            Engineering notes
          </h2>
          <div class="cs-notes">
            {d.engineering.map((e) => (
              <div class="cs-note">
                <h3>{e.title}</h3>
                <p>{e.body}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </div>

    <nav class="ln-wrap cs-pager" aria-label="More projects">
      {prev ? (
        <a class="cs-pg" href={`/projects/${prev.id}/`} rel="prev">
          <span class="cs-pg-k">Previous project</span>
          <span class="cs-pg-t">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="cs-pg cs-pg-next" href={`/projects/${next.id}/`} rel="next">
          <span class="cs-pg-k">Next project</span>
          <span class="cs-pg-t">{next.data.title}</span>
        </a>
      ) : (
        <a class="cs-pg cs-pg-next" href="/#projects">
          <span class="cs-pg-k">Back to</span>
          <span class="cs-pg-t">All projects</span>
        </a>
      )}
    </nav>
  </article>
</Shell>

<style>
  .cs-head {
    padding-block: var(--space-7) var(--space-8);
    border-bottom: var(--ln-hairline);
  }
  .cs-head-grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .cs-art {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    container-type: inline-size;
    border-radius: var(--radius-1);
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(
        90% 70% at 20% 10%,
        color-mix(in oklab, var(--art) 55%, #fff) 0,
        transparent 60%
      ),
      linear-gradient(160deg, var(--art), color-mix(in oklab, var(--art) 30%, #000));
    box-shadow: var(--shadow-2);
  }
  .cs-art::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.4;
    mix-blend-mode: soft-light;
  }
  .cs-art-app::before {
    background: repeating-radial-gradient(circle at 100% 100%, #fff 0 1px, transparent 1.5px 9cqi);
  }
  .cs-art-game::before {
    background:
      linear-gradient(90deg, rgb(255 255 255 / 0.5) 1px, transparent 1px) 0 0 / 12.5cqi 12.5cqi,
      linear-gradient(rgb(255 255 255 / 0.5) 1px, transparent 1px) 0 0 / 12.5cqi 12.5cqi;
  }
  .cs-art-tool::before {
    background: repeating-linear-gradient(
      -45deg,
      rgb(255 255 255 / 0.55) 0 1px,
      transparent 1px 7cqi
    );
  }
  .cs-art-word {
    position: absolute;
    left: 8cqi;
    right: 8cqi;
    bottom: 8cqi;
    font-family: var(--ln-display);
    font-weight: 800;
    font-stretch: var(--stretch-display);
    /* cover art: sized to the cover */
    font-size: 15cqi;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.25);
  }

  .cs-intro {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .cs-back a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cs-back a:hover,
  .cs-back a:focus-visible {
    color: var(--ln-ink);
    text-decoration-color: currentColor;
  }
  .cs-back a:active {
    color: var(--ln-ink-3);
  }
  .cs-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .cs-feat {
    padding: 0 var(--space-2);
    border: var(--ln-hairline);
    border-radius: var(--radius-full);
    color: var(--ln-ink-2);
  }
  body.ln .cs-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: var(--leading-tight);
  }
  .cs-tagline {
    max-width: 40ch;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ln-ink-2);
  }
  .cs-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-4);
    border-top: var(--ln-hairline);
  }
  .cs-facts dt {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .cs-facts dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
  }
  .cs-cap {
    text-transform: capitalize;
  }

  /* Body */
  .cs-body {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-8);
  }
  .cs-toc ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .cs-toc a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ln-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cs-toc a:hover,
  .cs-toc a:focus-visible {
    color: var(--ln-ink);
    text-decoration-color: currentColor;
  }
  .cs-toc a:active {
    color: var(--ln-ink-3);
  }
  .cs-main {
    display: grid;
    gap: var(--space-8);
    min-width: 0;
  }
  .cs-sec {
    scroll-margin-top: calc(var(--ln-header) + var(--space-4));
  }
  body.ln .cs-h {
    margin-bottom: var(--space-4);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
  }
  .cs-sub {
    margin: calc(var(--space-2) * -1) 0 var(--space-5);
    color: var(--ln-ink-2);
  }
  .cs-problem {
    max-width: var(--measure);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }
  .cs-features {
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .cs-features li {
    padding-block: var(--space-3);
    border-bottom: var(--ln-hairline);
  }
  .cs-planned {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cs-planned li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }
  .cs-planned-tag {
    padding: 0 var(--space-2);
    border: 1px dashed currentColor;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ln-ink-2);
  }

  /* Stack */
  .cs-stack {
    width: 100%;
    border-collapse: collapse;
  }
  .cs-stack thead th {
    padding: 0 0 var(--space-2);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: left;
    color: var(--ln-ink-3);
  }
  .cs-stack tbody th,
  .cs-stack td {
    padding: var(--space-4) var(--space-5) var(--space-4) 0;
    border-top: var(--ln-hairline);
    text-align: left;
    vertical-align: top;
  }
  .cs-stack tbody th {
    width: 9rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ln-ink-2);
  }
  .cs-tech {
    width: 32%;
    font-weight: 700;
    line-height: var(--leading-snug);
  }
  .cs-why {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }

  .cs-notes {
    display: grid;
    gap: var(--space-5) var(--space-6);
  }
  .cs-note {
    padding-top: var(--space-4);
    border-top: var(--ln-hairline);
  }
  body.ln .cs-note h3 {
    font-size: var(--text-lg);
    font-weight: 700;
  }
  .cs-note p {
    margin-top: var(--space-2);
    color: var(--ln-ink-2);
  }

  /* Pager */
  .cs-pager {
    display: grid;
    padding-bottom: var(--space-8);
  }
  .cs-pg {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-1);
    border-top: var(--ln-hairline);
    text-decoration: none;
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  .cs-pg-k {
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  .cs-pg-t {
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-title);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .cs-pg:hover .cs-pg-t,
  .cs-pg:focus-visible .cs-pg-t {
    text-decoration-color: currentColor;
  }
  .cs-pg:active {
    background: var(--ln-hl);
  }
  .cs-pg:active .cs-pg-t {
    color: var(--ln-ink-2);
  }

  @media (max-width: 639px) {
    .cs-stack thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .cs-stack,
    .cs-stack tbody,
    .cs-stack tr,
    .cs-stack th,
    .cs-stack td {
      display: block;
      width: auto;
    }
    .cs-stack tr {
      padding: var(--space-4) 0;
      border-top: var(--ln-hairline);
    }
    .cs-stack tbody th,
    .cs-stack td {
      padding: 0;
      border: 0;
    }
    .cs-tech {
      margin-top: var(--space-1);
    }
    .cs-why {
      margin-top: var(--space-1);
    }
  }
  @media (min-width: 760px) {
    .cs-notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cs-pager {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-6);
    }
    .cs-pg-next {
      text-align: right;
      grid-column: 2;
    }
  }
  @media (min-width: 1000px) {
    .cs-head-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-8);
    }
    .cs-body {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-8);
    }
    .cs-toc {
      position: sticky;
      top: calc(var(--ln-header) + var(--space-6));
      align-self: start;
    }
    .cs-toc ol {
      display: grid;
      gap: 0;
    }
  }

  /* Process gallery */
  .cs-gal-intro {
    max-width: var(--measure);
    color: var(--ln-ink-2);
  }
  .cs-gal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .cs-gal-full,
  .cs-gal-wide {
    grid-column: 1 / -1;
  }
  .cs-gal figure {
    margin: 0;
  }
  .cs-gal :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: var(--ln-hairline);
    border-radius: var(--radius-2);
    background: var(--ln-bg-3);
  }
  .cs-gal figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  @media (min-width: 760px) {
    .cs-gal {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .cs-gal-wide {
      grid-column: span 2;
    }
  }

  /* Billable mini-room: its Goal / Controls headings take the site's label style. */
  body.ln .cs-play :global(.bm-h) {
    margin: var(--space-5) 0 var(--space-2);
    font-family: var(--ln-body);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  body.ln .cs-play :global(.bm-h:first-child) {
    margin-top: 0;
  }
</style>
