---
// Section header: a plain title and, optionally, a lead sentence and actions (slot).
// Two shapes, one title size (WO-033: the layout varies from section to section, the hierarchy
// does not):
//   "aside": the title sits in a narrow left column beside the lead (Work, aligned to its
//            sector / company / role column). Actions, if any, end the lead's row.
//   "stack": the title over the lead in one column, actions on the right of that block
//            (Projects' rail arrows, Résumé).
// Phones stack both shapes.
interface Props {
  title: string;
  id: string;
  lead?: string;
  layout?: 'aside' | 'stack';
}
const { title, id, lead, layout = 'stack' } = Astro.props;
const acts = Astro.slots.has('default');
---

<header class:list={['sh', `sh-${layout}`, acts && 'sh-acts']}>
  <h2 id={id} class="sh-title">
    {title}
  </h2>
  {lead && <p class="sh-lead">{lead}</p>}
  <slot />
</header>

<style>
  .sh {
    display: grid;
    gap: var(--space-3) var(--space-6);
    margin-bottom: var(--space-7);
  }
  body.ln .sh-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
  }
  .sh-lead {
    max-width: 52ch;
    color: var(--ln-ink-2);
  }

  @media (min-width: 760px) {
    .sh-aside {
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: 2.5rem;
      align-items: baseline;
    }
    .sh-aside.sh-acts {
      grid-template-columns: 11rem minmax(0, 1fr) auto;
    }
    .sh-aside > :global(:not(.sh-title, .sh-lead)) {
      grid-column: 3;
      grid-row: 1;
      align-self: center;
    }
    .sh-stack {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
    .sh-stack .sh-title,
    .sh-stack .sh-lead {
      grid-column: 1;
    }
    .sh-stack > :global(:not(.sh-title, .sh-lead)) {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: end;
    }
  }
  @media (min-width: 1100px) {
    .sh-aside {
      column-gap: clamp(2.5rem, 4vw, 4rem);
    }
  }
</style>
