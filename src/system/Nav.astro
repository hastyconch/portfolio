---
// Site header: the name with a small disc mark, a breadcrumb that says where you are, plain
// section links and a reading-progress bar. Phones get a menu (details/summary, works without JS).
// WO-019 wayfinding: the crumb follows the section in view (`Name / Work / Grocer loyalty`), the
// nav link for that section is marked, and a stepper plus a jump list move between siblings:
// Work's demo engagements on the home page, every project on a case study. One small script
// below drives the crumb, the stepper, the jump list and a case study's "On this page" list.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getSiteContent, type Profile } from '../lib/content';

interface Props {
  profile: Profile;
  home: boolean;
  /** the section a page belongs to (case studies, songs); the home page follows the scroll */
  section?: string;
  /** a case study's project id: the crumb's item, the stepper and the jump list */
  project?: string;
}
const { profile, home, section, project } = Astro.props;
const base = home ? '' : '/';
const links = [
  { id: 'work', label: 'Work' },
  { id: 'projects', label: 'Projects' },
  { id: 'music', label: 'Music' },
  { id: 'resume', label: 'Résumé' },
  { id: 'contact', label: 'Contact' },
].map((l) => ({ ...l, href: `${base}#${l.id}` }));
const here = links.find((l) => l.id === section);

const { work, projects, songs, features } = await getSiteContent();
// A song page stays dark in both schemes, tinted by the song (music/[id].astro). The header takes
// the same band, so there is no cream strip over it (WO-029).
const songId = Astro.url.pathname.match(/^\/music\/([^/]+)\/?$/)?.[1];
const song = [...songs, ...features].find((s) => s.id === songId);
// Home: Work's demo engagements, then the compact list. Labels are the crumb's short names.
const featured = work.filter((w) => w.data.demo !== 'none');
const stops = home
  ? [
      ...featured.map((w) => ({ target: `work-${w.id}`, label: w.data.short ?? w.data.title })),
      ...(featured.length < work.length
        ? [{ target: 'work-more-h', label: 'More client work' }]
        : []),
    ]
  : [];
// Case study: its place in the projects order.
const pi = project ? projects.findIndex((p) => p.id === project) : -1;
const cur = projects[pi];
const prev = projects[pi - 1];
const next = projects[pi + 1];
const jump = stops.length > 0 || !!cur;
// The jump list shows each project's card art at 40px: its screen on its backdrop. Built here
// rather than from ProjectCard, so the card's stylesheet stays off pages that show no cards
// (render-blocking CSS, LCP budget). Owner drop-ins resolve as they do on the card.
const dropins = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const thumbs = cur
  ? await Promise.all(
      projects.map(async (p) => {
        const c = p.data.cover;
        const slot = c?.slot
          ? Object.entries(dropins).find(([k]) => k.includes(`/projects/${p.id}/${c.slot}.`))?.[1]
              .default
          : undefined;
        const src = c?.image ?? slot;
        return {
          bd: c?.backdrop ?? p.data.accent,
          img: src ? await getImage({ src, width: 80, format: 'webp' }) : undefined,
        };
      }),
    )
  : [];
---

<header
  class:list={['np', { 'ln-dark': song }]}
  data-home={home ? '' : undefined}
  data-deep={cur ? '' : undefined}
  data-band={song ? '' : undefined}
  style={song ? `--c1: ${song.data.artColors[0]}` : undefined}
>
  <div class="np-bar">
    <nav class="np-crumbs" aria-label="Breadcrumb">
      <ol>
        <li class="np-c-home">
          <a class="np-brand" href={`${base}#hero`}>
            <span class="np-disc" aria-hidden="true"></span>
            <span class="np-name">{profile.name}</span>
          </a>
        </li>
        <li class="np-c np-c-sec" hidden={!here}>
          <span class="np-sep" aria-hidden="true">
            /
          </span>
          <a class="np-sec" href={here?.href ?? '#work'}>
            {here?.label}
          </a>
        </li>
        {jump && (
          <li class="np-c np-c-item" hidden={!cur}>
            <span class="np-sep" aria-hidden="true">
              /
            </span>
            {/* The item is the current place (aria-current on its text); the button over it opens
                the jump list and its name says so (WO-027). */}
            <span class="np-here">
              <button
                type="button"
                class="np-trigger"
                popovertarget="np-jump"
                aria-label={cur ? `${cur.data.title}, switch project` : 'Switch engagement'}
              />
              <span class="np-item" aria-current="location">
                {cur?.data.title}
              </span>
              <span class="np-caret" aria-hidden="true" />
            </span>
            {cur ? (
              <span class="np-step">
                {prev ? (
                  <a
                    class="np-arrow np-prev"
                    href={`/projects/${prev.id}/`}
                    rel="prev"
                    aria-label={`Previous project: ${prev.data.title}`}
                  />
                ) : (
                  <span class="np-arrow np-prev" aria-hidden="true" data-off />
                )}
                <span class="np-count ln-num" aria-hidden="true">
                  {pi + 1} / {projects.length}
                </span>
                {next ? (
                  <a
                    class="np-arrow np-next"
                    href={`/projects/${next.id}/`}
                    rel="next"
                    aria-label={`Next project: ${next.data.title}`}
                  />
                ) : (
                  <span class="np-arrow np-next" aria-hidden="true" data-off />
                )}
              </span>
            ) : (
              <span class="np-step">
                <button
                  type="button"
                  class="np-arrow np-prev"
                  data-step="-1"
                  aria-label="Previous engagement"
                />
                <span class="np-count ln-num" aria-hidden="true" />
                <button
                  type="button"
                  class="np-arrow np-next"
                  data-step="1"
                  aria-label="Next engagement"
                />
              </span>
            )}
          </li>
        )}
      </ol>
    </nav>

    {jump && (
      <div class="np-jump" id="np-jump" popover>
        <p class="label np-jump-h" id="np-jump-h">
          {cur ? 'Projects' : 'Work'}
        </p>
        <ul aria-labelledby="np-jump-h">
          {cur
            ? projects.map((p, i) => (
                <li>
                  <a
                    href={`/projects/${p.id}/`}
                    aria-current={p.id === cur.id ? 'page' : undefined}
                  >
                    <span class="np-thumb" style={`--bd: ${thumbs[i].bd}`} aria-hidden="true">
                      {thumbs[i].img && (
                        <img
                          src={thumbs[i].img.src}
                          width="40"
                          height="30"
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </span>
                    <span class="np-jump-t">
                      <span>{p.data.title}</span>
                      <span class="np-jump-f">{p.data.category}</span>
                    </span>
                  </a>
                </li>
              ))
            : stops.map((s) => (
                <li>
                  <a href={`#${s.target}`} data-target={s.target}>
                    {s.label}
                  </a>
                </li>
              ))}
        </ul>
      </div>
    )}

    <nav class="np-nav" aria-label="Sections">
      <ul class="np-links">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.id === section ? 'true' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <details class="np-menu">
        <summary>
          <span class="np-burger" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          Menu
        </summary>
        <ul class="np-menu-list">
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.id === section ? 'true' : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
  <div class="np-progress" aria-hidden="true">
    <span></span>
  </div>
</header>

<script>
  // The phone menu closes after a jump, when focus leaves it, and on Escape from anywhere
  // (focus then returns to its toggle), so it never stays open over the page you tabbed into.
  const menu = document.querySelector<HTMLDetailsElement>('.np-menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menu.open = false;
  });
  menu?.addEventListener('focusout', (e) => {
    const to = e.relatedTarget as Node | null;
    if (menu.open && to && !menu.contains(to)) menu.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  // It also closes once the page scrolls under it (more than a few pixels) or a finger drags
  // outside it (WO-033). Focus moves only if it was in the menu: back to the toggle. Opened while
  // a jump is still gliding, it measures from where the page comes to rest.
  let y0 = NaN;
  let t: ReturnType<typeof setTimeout> | undefined;
  let still = true;
  const shut = () => {
    if (!menu?.open) return;
    const back = menu.contains(document.activeElement);
    menu.open = false;
    if (back) menu.querySelector('summary')?.focus({ preventScroll: true });
  };
  menu?.addEventListener('toggle', () => (y0 = menu.open && still ? scrollY : NaN));
  addEventListener(
    'scroll',
    () => {
      still = false;
      clearTimeout(t);
      t = setTimeout(() => {
        still = true;
        if (menu?.open && isNaN(y0)) y0 = scrollY;
      }, 150);
      if (Math.abs(scrollY - y0) > 8) shut();
    },
    { passive: true },
  );
  addEventListener('touchmove', (e) => menu?.contains(e.target as Node) || shut(), {
    passive: true,
  });

  // In-page links to a section (the header's #work, #projects, ..., the hero's, a case study's
  // "On this page") replace the current history entry instead of adding one, so Back leaves the
  // page rather than scrolling back through it (WO-027, WO-033). location.replace keeps the
  // browser's own fragment jump: the same scroll, landing and :target as a plain link. The jump
  // list's links (data-target) are handled by the wayfinding script.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href^="#"]');
    const me = e as MouseEvent;
    if (!a || a.dataset.target || me.defaultPrevented) return;
    if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
    if (!a.closest('.np') && !document.getElementById(a.hash.slice(1))?.matches('section')) return;
    e.preventDefault();
    location.replace(a.hash);
  });
</script>

<script>
  // Two scripts, so each stays small enough to be inlined in the page (no extra request).
  // Wayfinding (WO-019). One observer for the section, the Work pane and a case study's
  // "On this page" list: the current target is the last one whose top has crossed a line a
  // quarter of the way down the view, under the header.
  const header = document.querySelector<HTMLElement>('.np')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  function spy(targets: HTMLElement[], onChange: (i: number) => void) {
    let cur = -2;
    let io: IntersectionObserver | undefined;
    const line = () => {
      const h = header.offsetHeight;
      return Math.round(h + (innerHeight - h) / 4);
    };
    const update = () => {
      const y = line();
      let i = -1;
      targets.forEach((t, k) => {
        if (t.getBoundingClientRect().top <= y) i = k;
      });
      // At the very bottom the last target counts, even if it is too short to reach the line.
      const doc = document.documentElement;
      const last = targets[targets.length - 1].getBoundingClientRect();
      if (i >= 0 && innerHeight + scrollY >= doc.scrollHeight - 4 && last.top < innerHeight) {
        i = targets.length - 1;
      }
      if (i !== cur) onChange((cur = i));
    };
    const observe = () => {
      io?.disconnect();
      const y = line();
      io = new IntersectionObserver(update, {
        rootMargin: `-${y}px 0px -${Math.max(0, innerHeight - y - 1)}px 0px`,
      });
      targets.forEach((t) => io!.observe(t));
    };
    observe();
    addEventListener('resize', observe, { passive: true });
    // Current as soon as scrolling stops, and once the page has loaded (a deep link's jump).
    addEventListener('scrollend', update, { passive: true });
    addEventListener('load', update);
  }

  // New crumb text arrives as one short slide and fade (an instant swap under reduced motion).
  function swap(el: HTMLElement, text: string) {
    if (el.textContent === text) return;
    el.textContent = text;
    el.classList.remove('np-swap');
    void el.offsetWidth;
    el.classList.add('np-swap');
  }
  function mark(els: Element[], on: (el: Element) => boolean, value = 'true') {
    els.forEach((el) =>
      on(el) ? el.setAttribute('aria-current', value) : el.removeAttribute('aria-current'),
    );
  }

  const secLi = header.querySelector<HTMLElement>('.np-c-sec');
  const secA = secLi?.querySelector<HTMLAnchorElement>('a');
  const itemLi = header.querySelector<HTMLElement>('.np-c-item');
  const itemT = header.querySelector<HTMLElement>('.np-item');
  const trigger = header.querySelector<HTMLButtonElement>('.np-trigger');
  const jump = document.getElementById('np-jump');
  const jumpLinks = [...(jump?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];

  // Home: the section in view marks its nav link and names the crumb; inside Work, the pane.
  const navLinks = [...header.querySelectorAll<HTMLAnchorElement>('.np-links a, .np-menu-list a')];
  const sections = header.hasAttribute('data-home')
    ? [...header.querySelectorAll<HTMLAnchorElement>('.np-links a')].flatMap((a) => {
        const el = document.getElementById(a.hash.slice(1));
        return el ? [{ id: el.id, label: a.textContent!.trim(), el }] : [];
      })
    : [];
  const stops = jumpLinks.flatMap((a) => {
    const h = a.dataset.target ? document.getElementById(a.dataset.target) : null;
    const pane = h?.closest<HTMLElement>('.wk, .wk-more');
    return h && pane ? [{ a, h, pane, label: a.textContent!.trim() }] : [];
  });
  const panes = stops.filter((s) => s.pane.matches('.wk')).length;
  const prevB = header.querySelector<HTMLButtonElement>('button.np-prev');
  const nextB = header.querySelector<HTMLButtonElement>('button.np-next');
  const count = header.querySelector<HTMLElement>('.np-count');
  let section = '';
  let item = -1;
  let pending: number | null = null;

  // An end-of-list step says so with aria-disabled, and the item stays shown while it holds
  // focus, so focus never falls to the page (WO-023). It hides once focus moves on.
  const off = (b: HTMLButtonElement) => b.getAttribute('aria-disabled') === 'true';
  function able(b: HTMLButtonElement, on: boolean) {
    if (on) b.removeAttribute('aria-disabled');
    else b.setAttribute('aria-disabled', 'true');
  }
  function renderItem() {
    if (!itemLi || !itemT || !stops.length) return;
    const show = section === 'work' && item >= 0;
    if (!show && itemLi.contains(document.activeElement)) return;
    itemLi.hidden = !show;
    mark(
      stops.map((s) => s.a),
      (a) => show && a === stops[item].a,
    );
    if (!show) return;
    swap(itemT, stops[item].label);
    trigger?.setAttribute('aria-label', `${stops[item].label}, switch engagement`);
    if (count) count.textContent = item < panes ? `${item + 1} / ${panes}` : '';
    const p = stops[item - 1];
    const n = stops[item + 1];
    if (prevB) {
      able(prevB, !!p);
      prevB.setAttribute(
        'aria-label',
        p ? `Previous engagement: ${p.label}` : 'Previous engagement',
      );
    }
    if (nextB) {
      able(nextB, !!n);
      const kind = item + 1 < panes ? 'Next engagement' : 'Next';
      nextB.setAttribute('aria-label', n ? `${kind}: ${n.label}` : 'Next engagement');
    }
  }

  if (sections.length) {
    spy(
      sections.map((s) => s.el),
      (i) => {
        const s = sections[i];
        section = s?.id ?? '';
        mark(navLinks, (a) => !!s && (a as HTMLAnchorElement).hash === `#${s.id}`);
        if (secLi && secA) {
          secLi.hidden = !s;
          if (s) {
            secA.href = `#${s.id}`;
            swap(secA, s.label);
          }
        }
        renderItem();
      },
    );
  }

  // Previous and next scroll the pane into view, flush under the header, and put focus on its
  // heading, so keyboard users land in the right place.
  function go(i: number) {
    const s = stops[i];
    if (!s) return;
    if (jump?.matches(':popover-open')) jump.hidePopover();
    pending = i;
    s.pane.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
    s.h.focus({ preventScroll: true });
  }
  if (stops.length) {
    spy(
      stops.map((s) => s.pane),
      (i) => {
        item = i;
        if (pending === i) pending = null;
        renderItem();
      },
    );
    addEventListener('scrollend', () => (pending = null));
    for (const b of [prevB, nextB]) {
      b?.addEventListener('click', () => {
        if (!off(b)) go((pending ?? item) + Number(b.dataset.step));
      });
    }
    itemLi?.addEventListener('focusout', (e) => {
      if (!itemLi.contains(e.relatedTarget as Node | null)) renderItem();
    });
    stops.forEach((s, i) =>
      s.a.addEventListener('click', (e) => {
        e.preventDefault();
        go(i);
      }),
    );
  }

  // The jump list opens under its trigger with focus on the current entry. Arrow keys move
  // through it; Escape closes it and the browser returns focus to the trigger. It also closes
  // when focus moves to anything outside it and its trigger (WO-027).
  if (jump && trigger) {
    const leave = (e: FocusEvent) => {
      const to = e.relatedTarget as Node | null;
      if (to && to !== trigger && !jump.contains(to) && jump.matches(':popover-open')) {
        jump.hidePopover();
      }
    };
    jump.addEventListener('focusout', leave);
    trigger.addEventListener('focusout', leave);
    jump.addEventListener('beforetoggle', (e) => {
      if ((e as ToggleEvent).newState !== 'open') return;
      jump.style.setProperty('--jx', `${Math.round(trigger.getBoundingClientRect().left)}px`);
    });
    jump.addEventListener('toggle', (e) => {
      if ((e as ToggleEvent).newState !== 'open') return;
      (jumpLinks.find((a) => a.hasAttribute('aria-current')) ?? jumpLinks[0])?.focus();
    });
    jump.addEventListener('keydown', (e) => {
      const i = jumpLinks.indexOf(document.activeElement as HTMLAnchorElement);
      const keys: Record<string, number> = {
        ArrowDown: i + 1,
        ArrowUp: i - 1,
        Home: 0,
        End: jumpLinks.length - 1,
      };
      if (!(e.key in keys)) return;
      e.preventDefault();
      jumpLinks[(keys[e.key] + jumpLinks.length) % jumpLinks.length]?.focus();
    });
  }

  // A case study's "On this page" list marks the section in view.
  const toc = [...document.querySelectorAll<HTMLAnchorElement>('.cs-toc a[href^="#"]')];
  const tocTargets = toc.flatMap((a) => document.getElementById(a.hash.slice(1)) ?? []);
  if (toc.length && tocTargets.length === toc.length) {
    spy(tocTargets, (i) => mark(toc, (a) => a === toc[i]));
  }
</script>

<style>
  .np {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Solid, so nothing scrolling under it reads through (WO-023). */
    background: var(--ln-bg);
    border-bottom: var(--ln-hairline);
    /* It holds still while a page changes underneath it (cross-document view transitions). */
    view-transition-name: site-header;
  }
  /* A song page: the song's band, in the dark palette (.ln-dark), whatever the scheme. */
  .np[data-band] {
    background: color-mix(in srgb, var(--c1) 12%, var(--ln-bg));
    /* --ln-hairline resolves its colour on :root (cream in light mode); re-resolve it here, so
       the header's edge, the Menu button and the menu's rules take the band's own. */
    --ln-hairline: 1px solid var(--ln-rule);
  }
  /* The header holds still: its scroll margin cancels the root's scroll padding (liner.css), so
     focusing or clicking anything in it never scrolls the page to "reveal" it. */
  .np,
  .np :global(*) {
    scroll-margin-top: calc(var(--ln-scroll-pad) * -1);
  }
  /* The jump list scrolls on its own (a fixed popover): its entries scroll fully into its view. */
  .np-jump,
  .np-jump :global(*) {
    scroll-margin-top: 0;
  }
  .np-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--ln-max);
    min-height: var(--ln-header);
    margin-inline: auto;
    padding-inline: var(--ln-gutter);
  }
  .np-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    text-decoration: none;
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-title);
    white-space: nowrap;
  }
  .np-disc {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex: none;
    background:
      radial-gradient(circle, #0b0a09 0 7%, transparent 8%),
      radial-gradient(circle, #ff7a45 0 30%, transparent 31%),
      repeating-radial-gradient(circle, #151312 0 1px, #24211f 1.5px 2.5px), #151312;
    box-shadow: 0 0 0 1px var(--ln-rule);
    transition: scale var(--dur-quick) var(--ease-out);
  }
  /* The disc turns once when the name is hovered or focused (a full turn, so there is no
     visible return on leave). */
  @media (prefers-reduced-motion: no-preference) {
    .np-brand:hover .np-disc,
    .np-brand:focus-visible .np-disc {
      animation: np-turn var(--dur-reveal) var(--ease-out);
    }
  }
  @keyframes np-turn {
    to {
      rotate: 1turn;
    }
  }
  .np-brand:active .np-disc {
    scale: var(--press-scale);
  }

  /* Breadcrumb: it takes the space between the name and the links, so a change of crumb never
     moves the links; long names truncate. */
  .np-crumbs {
    flex: 1 1 auto;
    min-width: 0;
  }
  .np-crumbs ol {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }
  .np-c-home {
    flex: none;
  }
  .np-c {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .np-c[hidden] {
    display: none;
  }
  .np-c-sec {
    flex: none;
  }
  .np-sep {
    color: var(--ln-ink-3);
    font-size: var(--text-sm);
  }
  .np-sec,
  .np-here {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .np-sec {
    color: var(--ln-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .np-sec:hover,
  .np-sec:focus-visible {
    color: var(--ln-ink);
