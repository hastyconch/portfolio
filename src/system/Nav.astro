---
// Site header: the name with a small disc mark, plain section links and a reading-progress bar.
// Phones get a menu (details/summary, works without JS).
import type { Profile } from '../lib/content';

interface Props {
  profile: Profile;
  home: boolean;
}
const { profile, home } = Astro.props;
const base = home ? '' : '/';
const links = [
  { href: `${base}#work`, label: 'Work' },
  { href: `${base}#projects`, label: 'Projects' },
  { href: `${base}#music`, label: 'Music' },
  { href: `${base}#resume`, label: 'Résumé' },
  { href: `${base}#contact`, label: 'Contact' },
];
---

<header class="np">
  <div class="np-bar">
    <a class="np-brand" href={`${base}#hero`}>
      <span class="np-disc" aria-hidden="true"></span>
      <span>{profile.name}</span>
    </a>

    <nav class="np-nav" aria-label="Sections">
      <ul class="np-links">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
      <details class="np-menu">
        <summary>
          <span class="np-burger" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          Menu
        </summary>
        <ul class="np-menu-list">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
  <div class="np-progress" aria-hidden="true">
    <span></span>
  </div>
</header>

<script>
  // The menu closes after a jump, and on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('.np-menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) menu.open = false;
  });
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .np {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ln-bg) 94%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: var(--ln-hairline);
  }
  .np-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--ln-max);
    min-height: var(--ln-header);
    margin-inline: auto;
    padding-inline: var(--ln-gutter);
  }
  .np-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    text-decoration: none;
    font-family: var(--ln-display);
    font-weight: 700;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-title);
  }
  .np-disc {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex: none;
    background:
      radial-gradient(circle, #0b0a09 0 7%, transparent 8%),
      radial-gradient(circle, #ff7a45 0 30%, transparent 31%),
      repeating-radial-gradient(circle, #151312 0 1px, #24211f 1.5px 2.5px), #151312;
    box-shadow: 0 0 0 1px var(--ln-rule);
    transition: scale var(--dur-quick) var(--ease-out);
  }
  /* The disc turns once when the name is hovered or focused (a full turn, so there is no
     visible return on leave). */
  @media (prefers-reduced-motion: no-preference) {
    .np-brand:hover .np-disc,
    .np-brand:focus-visible .np-disc {
      animation: np-turn var(--dur-reveal) var(--ease-out);
    }
  }
  @keyframes np-turn {
    to {
      rotate: 1turn;
    }
  }
  .np-brand:active .np-disc {
    scale: var(--press-scale);
  }

  /* Phone menu */
  .np-links {
    display: none;
  }
  .np-menu summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border: var(--ln-hairline);
    border-radius: var(--radius-2);
    font-weight: 600;
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  .np-menu summary::-webkit-details-marker {
    display: none;
  }
  .np-menu summary:hover,
  .np-menu summary:focus-visible {
    background: var(--ln-hl);
  }
  .np-menu summary:active {
    scale: var(--press-scale);
  }
  .np-burger {
    display: grid;
    gap: 4px;
    width: 16px;
  }
  .np-burger span {
    height: 2px;
    border-radius: var(--radius-1);
    background: currentColor;
  }
  .np-menu[open] summary {
    background: var(--ln-ink);
    color: var(--ln-bg);
  }
  .np-menu-list {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin: 0;
    padding: var(--space-2) var(--ln-gutter) var(--space-5);
    list-style: none;
    background: var(--ln-bg);
    border-bottom: var(--ln-hairline);
    box-shadow: var(--shadow-2);
  }
  .np-menu-list a {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: var(--ln-hairline);
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    text-decoration: none;
    transition: color var(--dur-quick) var(--ease-out);
  }
  .np-menu-list li:last-child a {
    border-bottom: 0;
  }
  .np-menu-list a:hover,
  .np-menu-list a:focus-visible {
    color: var(--ln-accent);
  }
  .np-menu-list a:active {
    background: var(--ln-hl);
  }

  /* Reading progress */
  .np-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    overflow: hidden;
  }
  .np-progress span {
    display: block;
    height: 100%;
    background: var(--ln-accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .np-progress span {
        animation: np-grow linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes np-grow {
    to {
      transform: scaleX(1);
    }
  }

  @media (min-width: 900px) {
    .np-menu {
      display: none;
    }
    .np-links {
      display: flex;
      gap: var(--space-1);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .np-links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: var(--space-3);
      border-radius: var(--radius-2);
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--ln-ink-2);
      text-decoration: underline;
      text-decoration-color: transparent;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.45em;
      transition:
        color var(--dur-quick) var(--ease-out),
        text-decoration-color var(--dur-quick) var(--ease-out);
    }
    .np-links a:hover,
    .np-links a:focus-visible {
      color: var(--ln-ink);
      text-decoration-color: currentColor;
    }
    .np-links a:active {
      background: var(--ln-hl);
    }
  }
</style>
