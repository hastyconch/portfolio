---
// DemoFrame slot: chrome around demos — phone, desktop window or diagram plate.
// With `coming`, renders a "still in the studio" state instead of slotted content.
interface Props {
  frame: 'phone' | 'desktop' | 'diagram' | 'none';
  caption?: string;
  coming?: boolean;
  size?: 'lg' | 'sm';
}
const { frame, caption, coming = false, size = 'lg' } = Astro.props;
const kind = frame === 'none' ? 'diagram' : frame;
const label = { phone: 'Phone demo', desktop: 'Desktop demo', diagram: 'Diagram' }[kind];
---

<figure class:list={['df', `df-${kind}`, `df-${size}`, coming && 'df-coming']}>
  <div class="df-device">
    {kind === 'desktop' && (
      <div class="df-titlebar" aria-hidden="true">
        <span />
        <span />
        <span />
      </div>
    )}
    {kind === 'phone' && <span class="df-island" aria-hidden="true" />}
    <div class="df-screen">
      {coming ? (
        <div class="df-soon">
          <span class="df-soon-disc ln-vinyl" aria-hidden="true" />
          <span class="df-soon-k">{label}</span>
          <span class="df-soon-t">In the studio — coming soon</span>
        </div>
      ) : (
        <slot />
      )}
    </div>
  </div>
  {caption && <figcaption class="df-cap">{caption}</figcaption>}
</figure>

<style>
  .df {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
  }
  .df-device {
    position: relative;
    width: 100%;
  }
  .df-screen {
    position: relative;
    overflow: hidden;
    background: var(--ln-bg-2);
  }

  /* Phone */
  .df-phone .df-device {
    max-width: 360px;
    padding: 12px;
    border-radius: 48px;
    background: linear-gradient(145deg, #2b2724, #0c0b0a 60%);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14),
      0 0 0 1px #000,
      0 40px 80px -30px rgb(0 0 0 / 0.7),
      0 0 0 10px color-mix(in srgb, var(--ln-accent) 10%, transparent);
  }
  .df-phone.df-lg .df-screen {
    height: 630px;
    border-radius: 37px;
    padding-top: 36px;
    /* status-bar strip in the demo's own (invented) header colour */
    background: linear-gradient(#3d2c5e 0 40px, #f6f3fb 40px);
  }
  .df-phone.df-lg .df-screen > :global(*) {
    height: 100%;
  }
  .df-island {
    position: absolute;
    z-index: 2;
    top: 22px;
    left: 50%;
    width: 96px;
    height: 26px;
    border-radius: 20px;
    background: #000;
    transform: translateX(-50%);
  }
  .df-phone.df-sm .df-device {
    max-width: 170px;
    padding: 7px;
    border-radius: 28px;
  }
  .df-phone.df-sm .df-screen {
    aspect-ratio: 9 / 18;
    border-radius: 22px;
  }
  .df-phone.df-sm .df-island {
    top: 12px;
    width: 44px;
    height: 12px;
  }

  /* Desktop window */
  .df-desktop .df-device {
    max-width: 920px;
    border-radius: 12px;
    border: 1px solid var(--ln-rule);
    background: var(--ln-bg-3);
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5);
  }
  .df-titlebar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--ln-rule);
  }
  .df-titlebar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ln-rule);
  }
  .df-desktop.df-sm .df-device {
    max-width: 280px;
  }
  .df-desktop .df-screen {
    aspect-ratio: 16 / 10;
  }

  /* Diagram plate */
  .df-diagram .df-device {
    max-width: 920px;
    border: 1px solid var(--ln-rule);
    border-radius: 4px;
    background:
      radial-gradient(circle, var(--ln-rule) 1px, transparent 1.5px) 0 0 / 18px 18px,
      var(--ln-bg-2);
  }
  .df-diagram.df-sm .df-device {
    max-width: 280px;
  }
  .df-diagram .df-screen {
    aspect-ratio: 16 / 10;
    background: transparent;
  }

  /* Coming soon state */
  .df-soon {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.35rem;
    padding: 1rem;
    text-align: center;
  }
  .df-soon-disc {
    width: 56px;
    margin-bottom: 0.5rem;
    --ln-label: var(--ln-accent);
  }
  .df-soon-k {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
  }
  .df-soon-t {
    font-family: var(--ln-display);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
    color: var(--ln-ink);
  }
  .df-cap {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ln-ink-3);
    text-align: center;
  }
</style>
