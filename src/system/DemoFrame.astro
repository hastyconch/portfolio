---
// DemoFrame slot: chrome around demos: phone, desktop window or diagram plate.
// With `coming`, renders a "coming soon" state instead of slotted content.
// Height budget (WO-015): a layout may set `--df-h` (the device's maximum height). Phones scale
// down to it, keeping their proportions. Live desktop and diagram frames also honour any
// definite height their container gives them: the screen scrolls inside the frame instead of
// the frame growing past it.
// WO-040: under 760px a phone frame has no height of its own (the app grows and the page scrolls
// it); under 480px it drops the bezel, island and status strip; under 600px a window drops its dots.
interface Props {
  frame: 'phone' | 'desktop' | 'diagram' | 'none';
  caption?: string;
  coming?: boolean;
  size?: 'lg' | 'sm';
  /** phone status-bar colour and screen colour behind the demo's own header, e.g. ['#3d2c5e', '#f6f3fb'] */
  tint?: [string, string];
}
const { frame, caption, coming = false, size = 'lg', tint } = Astro.props;
const tintStyle = tint ? `--df-top: ${tint[0]}; --df-screen: ${tint[1]}` : undefined;
const kind = frame === 'none' ? 'diagram' : frame;
const label = { phone: 'Phone demo', desktop: 'Desktop demo', diagram: 'Diagram' }[kind];
---

<figure class:list={['df', `df-${kind}`, `df-${size}`, coming && 'df-coming']} style={tintStyle}>
  <div class="df-device">
    {kind === 'desktop' && (
      <div class="df-titlebar" aria-hidden="true">
        <span />
        <span />
        <span />
      </div>
    )}
    {kind === 'phone' && <span class="df-island" aria-hidden="true" />}
    <div class="df-screen" data-df-screen={!coming && kind !== 'phone' ? '' : undefined}>
      {coming ? (
        <div class="df-soon">
          <span class="df-soon-k label">{label}</span>
          <span class="df-soon-t">Coming soon</span>
        </div>
      ) : (
        <slot />
      )}
    </div>
  </div>
  {caption && <figcaption class="df-cap">{caption}</figcaption>}
</figure>

<script>
  // WO-025: a live desktop or diagram screen that its content fits does not scroll. Sub-pixel
  // rounding (1219.3px of content in a 1219px box) or a demo's last few pixels of bottom padding
  // would otherwise leave a 1 to 3px scroll range, and Chrome latches a whole wheel or swipe
  // gesture to that box: the page stops under the pointer. Content that is really taller than its
  // frame (short laptop windows) still scrolls inside it, then hands the gesture back to the page.
  const SLACK = 4; // px of overflow treated as fitting
  const fit = (screen: HTMLElement) => {
    // Measure as a scroller: under `overflow: clip` the box is not one.
    delete screen.dataset.fits;
    if (screen.scrollHeight - screen.clientHeight <= SLACK) {
      screen.scrollTop = 0;
      screen.dataset.fits = '';
    }
  };
  const screens = [...document.querySelectorAll<HTMLElement>('[data-df-screen]')];
  if (screens.length && 'ResizeObserver' in window) {
    const ro = new ResizeObserver((entries) => {
      const seen = new Set<HTMLElement>();
      for (const e of entries) {
        const screen = e.target.closest<HTMLElement>('[data-df-screen]');
        if (screen && !seen.has(screen)) {
          seen.add(screen);
          fit(screen);
        }
      }
    });
    for (const screen of screens) {
      ro.observe(screen);
      // The demo's own root (an astro-island is display: contents, so look one level in).
      for (const el of screen.querySelectorAll(':scope > *, :scope > astro-island > *')) {
        ro.observe(el);
      }
    }
  }
</script>

<style>
  .df {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }
  /* Both shrink with their column (WO-024): a demo's own minimum never widens the page. */
  .df-device {
    position: relative;
    width: 100%;
    min-width: 0;
  }
  .df-screen {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--ln-bg-2);
  }

  /* Phone. The large phone is 360 × 654 (screen + 12px bezel); under a height budget it keeps
     that ratio (0.55). The floor keeps it usable in very short windows. */
  .df-phone {
    --df-ph: clamp(440px, var(--df-h, 654px), 654px);
  }
  .df-phone .df-device {
    max-width: min(360px, calc(var(--df-ph) * 0.55));
    padding: 12px;
    /* device chrome: outer radius = screen radius + bezel */
    border-radius: calc(var(--df-r) + 12px);
    background: linear-gradient(145deg, #2b2724, #0c0b0a 60%);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14),
      0 0 0 1px #000,
      var(--shadow-2);
  }
  .df-phone {
    --df-r: 36px;
  }
  .df-phone.df-lg .df-screen {
    height: calc(var(--df-ph) - 24px);
    border-radius: var(--df-r);
    padding-top: 36px;
    /* status-bar strip in the demo's own (invented) header colour */
    background: linear-gradient(var(--df-top, #3d2c5e) 0 40px, var(--df-screen, #f6f3fb) 40px);
  }
  /* The frame owns the screen's height: the island and the demo inside it fill it exactly (a
     demo's own minimum would push its tab bar out of a scaled-down phone; its body scrolls). */
  .df-phone.df-lg .df-screen > :global(*),
  .df-phone.df-lg .df-screen > :global(*) > :global(*) {
    height: 100%;
    min-height: 0;
  }
  /* Narrow phones (under 360px): the bezel goes, so the screen keeps the column's full width. */
  @media (max-width: 359.98px) {
    .df-phone.df-lg .df-device {
      padding: 0;
      border-radius: var(--df-r);
      box-shadow:
        0 0 0 1px #000,
        var(--shadow-2);
    }
    .df-phone.df-lg .df-screen {
      height: var(--df-ph);
    }
  }
  @media (max-width: 359.98px) {
    .df-phone.df-lg .df-island {
      top: 10px;
    }
  }
  .df-island {
    position: absolute;
    z-index: 2;
    top: 22px;
    left: 50%;
    width: 96px;
    height: 26px;
    border-radius: var(--radius-full);
    background: #000;
    transform: translateX(-50%);
  }
  .df-phone.df-sm {
    --df-r: 20px;
  }
  .df-phone.df-sm .df-device {
    max-width: 170px;
    padding: 7px;
    border-radius: calc(var(--df-r) + 7px);
  }
  .df-phone.df-sm .df-screen {
    aspect-ratio: 9 / 18;
    border-radius: var(--df-r);
  }
  .df-phone.df-sm .df-island {
    top: 12px;
    width: 44px;
    height: 12px;
  }

  /* Desktop window */
  .df-desktop .df-device {
    max-width: 920px;
    border-radius: var(--radius-3);
    border: var(--ln-hairline);
    background: var(--ln-bg-3);
    overflow: hidden;
    box-shadow: var(--shadow-1);
  }
  .df-titlebar {
    display: flex;
    gap: 6px;
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--ln-hairline);
  }
  .df-titlebar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ln-rule);
  }
  .df-desktop.df-sm .df-device {
    max-width: 280px;
  }
  .df-desktop .df-screen {
    aspect-ratio: 16 / 10;
  }

  /* Diagram plate */
  .df-diagram .df-device {
    max-width: 920px;
    border: var(--ln-hairline);
    border-radius: var(--radius-1);
    background:
      radial-gradient(circle, var(--ln-rule) 1px, transparent 1.5px) 0 0 / 18px 18px,
      var(--ln-bg-2);
  }
  .df-diagram.df-sm .df-device {
    max-width: 280px;
  }
  .df-diagram .df-screen {
    aspect-ratio: 16 / 10;
    background: transparent;
  }
  /* Live desktop and diagram demos size to their content; only the "coming" plate keeps 16:10.
     They fill their container's width, and when the container has a definite height the frame
     stops there and the screen scrolls inside it. No overscroll containment (WO-025): at the end
     of the demo the wheel or swipe goes on to the page. A screen whose content fits (to within a
     few pixels of rounding or the demo's own bottom padding) is marked `data-fits` by the script
     below and clips instead of scrolling, so a gesture over it never latches onto the frame. */
  .df-desktop:not(.df-coming),
  .df-diagram:not(.df-coming) {
    display: flex;
    flex-direction: column;
    max-height: 100%;
    min-height: 0;
  }
  .df-desktop:not(.df-coming) .df-device,
  .df-diagram:not(.df-coming) .df-device {
    display: flex;
    flex-direction: column;
    flex: 0 1 auto;
    min-height: 0;
    max-width: none;
  }
  .df-desktop:not(.df-coming) .df-screen,
  .df-diagram:not(.df-coming) .df-screen {
    flex: 0 1 auto;
    min-height: 0;
    aspect-ratio: auto;
    overflow: auto;
  }
  .df-desktop:not(.df-coming) .df-screen[data-fits],
  .df-diagram:not(.df-coming) .df-screen[data-fits] {
    overflow: clip;
  }
  .df-titlebar,
  .df-cap {
    flex: none;
  }

  /* WO-040: phones (under 760px). The phone grows to its app's content, and the page scrolls it:
     no screen height, nothing scrolls inside (the app's own phone rules make its tab bar stick to
     the bottom of the viewport). The screen clips without becoming a scroller, so that sticky
     bar sticks to the page. */
  @media (max-width: 759.98px) {
    .df-phone.df-lg .df-screen {
      height: auto;
      overflow: clip;
    }
    .df-phone.df-lg .df-screen > :global(*),
    .df-phone.df-lg .df-screen > :global(*) > :global(*) {
      height: auto;
    }
  }
  /* Below 480px a phone drawn inside a phone only costs room: no bezel, island or status strip.
     The screen keeps its corners and a 1px outline. */
  @media (max-width: 479.98px) {
    .df-phone.df-lg .df-device {
      padding: 0;
      border-radius: var(--df-r);
      background: none;
      box-shadow: 0 0 0 1px var(--ln-rule);
    }
    .df-phone.df-lg .df-screen {
      padding-top: 0;
      background: var(--df-screen, #f6f3fb);
    }
    .df-phone.df-lg .df-island {
      display: none;
    }
  }
  /* Below 600px the window dots read as decoration: the window is just its edge. */
  @media (max-width: 599.98px) {
    .df-titlebar {
      display: none;
    }
  }

  /* Coming soon state */
  .df-soon {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-4);
    text-align: center;
  }
  .df-soon-t {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ln-ink);
  }
  .df-cap {
    font-size: var(--text-xs);
    color: var(--ln-ink-3);
    text-align: center;
  }
</style>
