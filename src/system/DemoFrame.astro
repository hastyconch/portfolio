---
// DemoFrame slot: chrome around demos: phone, desktop window or diagram plate.
// With `coming`, renders a "coming soon" state instead of slotted content.
// Height budget (WO-015): a layout may set `--df-h` (the device's maximum height). Phones scale
// down to it, keeping their proportions. Live desktop and diagram frames also honour any
// definite height their container gives them: the screen scrolls inside the frame instead of
// the frame growing past it.
interface Props {
  frame: 'phone' | 'desktop' | 'diagram' | 'none';
  caption?: string;
  coming?: boolean;
  size?: 'lg' | 'sm';
  /** phone status-bar colour and screen colour behind the demo's own header, e.g. ['#3d2c5e', '#f6f3fb'] */
  tint?: [string, string];
}
const { frame, caption, coming = false, size = 'lg', tint } = Astro.props;
const tintStyle = tint ? `--df-top: ${tint[0]}; --df-screen: ${tint[1]}` : undefined;
const kind = frame === 'none' ? 'diagram' : frame;
const label = { phone: 'Phone demo', desktop: 'Desktop demo', diagram: 'Diagram' }[kind];
---

<figure class:list={['df', `df-${kind}`, `df-${size}`, coming && 'df-coming']} style={tintStyle}>
  <div class="df-device">
    {kind === 'desktop' && (
      <div class="df-titlebar" aria-hidden="true">
        <span />
        <span />
        <span />
      </div>
    )}
    {kind === 'phone' && <span class="df-island" aria-hidden="true" />}
    <div class="df-screen">
      {coming ? (
        <div class="df-soon">
          <span class="df-soon-k label">{label}</span>
          <span class="df-soon-t">Coming soon</span>
        </div>
      ) : (
        <slot />
      )}
    </div>
  </div>
  {caption && <figcaption class="df-cap">{caption}</figcaption>}
</figure>

<style>
  .df {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }
  .df-device {
    position: relative;
    width: 100%;
  }
  .df-screen {
    position: relative;
    overflow: hidden;
    background: var(--ln-bg-2);
  }

  /* Phone. The large phone is 360 × 654 (screen + 12px bezel); under a height budget it keeps
     that ratio (0.55). The floor keeps it usable in very short windows. */
  .df-phone {
    --df-ph: clamp(440px, var(--df-h, 654px), 654px);
  }
  .df-phone .df-device {
    max-width: min(360px, calc(var(--df-ph) * 0.55));
    padding: 12px;
    /* device chrome: outer radius = screen radius + bezel */
    border-radius: calc(var(--df-r) + 12px);
    background: linear-gradient(145deg, #2b2724, #0c0b0a 60%);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14),
      0 0 0 1px #000,
      var(--shadow-2);
  }
  .df-phone {
    --df-r: 36px;
  }
  .df-phone.df-lg .df-screen {
    height: calc(var(--df-ph) - 24px);
    border-radius: var(--df-r);
    padding-top: 36px;
    /* status-bar strip in the demo's own (invented) header colour */
    background: linear-gradient(var(--df-top, #3d2c5e) 0 40px, var(--df-screen, #f6f3fb) 40px);
  }
  /* The frame owns the screen's height: the island and the demo inside it fill it exactly (a
     demo's own minimum would push its tab bar out of a scaled-down phone; its body scrolls). */
  .df-phone.df-lg .df-screen > :global(*),
  .df-phone.df-lg .df-screen > :global(*) > :global(*) {
    height: 100%;
    min-height: 0;
  }
  .df-island {
    position: absolute;
    z-index: 2;
    top: 22px;
    left: 50%;
    width: 96px;
    height: 26px;
    border-radius: var(--radius-full);
    background: #000;
    transform: translateX(-50%);
  }
  .df-phone.df-sm {
    --df-r: 20px;
  }
  .df-phone.df-sm .df-device {
    max-width: 170px;
    padding: 7px;
    border-radius: calc(var(--df-r) + 7px);
  }
  .df-phone.df-sm .df-screen {
    aspect-ratio: 9 / 18;
    border-radius: var(--df-r);
  }
  .df-phone.df-sm .df-island {
    top: 12px;
    width: 44px;
    height: 12px;
  }

  /* Desktop window */
  .df-desktop .df-device {
    max-width: 920px;
    border-radius: var(--radius-3);
    border: var(--ln-hairline);
    background: var(--ln-bg-3);
    overflow: hidden;
    box-shadow: var(--shadow-1);
  }
  .df-titlebar {
    display: flex;
    gap: 6px;
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--ln-hairline);
  }
  .df-titlebar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ln-rule);
  }
  .df-desktop.df-sm .df-device {
    max-width: 280px;
  }
  .df-desktop .df-screen {
    aspect-ratio: 16 / 10;
  }

  /* Diagram plate */
  .df-diagram .df-device {
    max-width: 920px;
    border: var(--ln-hairline);
    border-radius: var(--radius-1);
    background:
      radial-gradient(circle, var(--ln-rule) 1px, transparent 1.5px) 0 0 / 18px 18px,
      var(--ln-bg-2);
  }
  .df-diagram.df-sm .df-device {
    max-width: 280px;
  }
  .df-diagram .df-screen {
    aspect-ratio: 16 / 10;
    background: transparent;
  }
  /* Live desktop and diagram demos size to their content; only the "coming" plate keeps 16:10.
     They fill their container's width, and when the container has a definite height the frame
     stops there and the screen scrolls inside it (contained, so the page doesn't take over). */
  .df-desktop:not(.df-coming),
  .df-diagram:not(.df-coming) {
    display: flex;
    flex-direction: column;
    max-height: 100%;
    min-height: 0;
  }
  .df-desktop:not(.df-coming) .df-device,
  .df-diagram:not(.df-coming) .df-device {
    display: flex;
    flex-direction: column;
    flex: 0 1 auto;
    min-height: 0;
    max-width: none;
  }
  .df-desktop:not(.df-coming) .df-screen,
  .df-diagram:not(.df-coming) .df-screen {
    flex: 0 1 auto;
    min-height: 0;
    aspect-ratio: auto;
    overflow: auto;
    overscroll-behavior: contain;
  }
  .df-titlebar,
  .df-cap {
    flex: none;
  }

  /* Coming soon state */
  .df-soon {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-4);
    text-align: center;
  }
  .df-soon-t {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ln-ink);
  }
  .df-cap {
    font-size: var(--text-xs);
    color: var(--ln-ink-3);
    text-align: center;
  }
</style>
