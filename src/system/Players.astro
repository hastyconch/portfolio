---
// Click-to-load Spotify/YouTube players for one song (constitution art. 5 and 6): nothing
// third-party is requested until the visitor presses a player button. Each service has one
// control: the "Play on …" button with scripting, or, without it, a plain "Open … on …" link to the
// service in its place (the no-JS fallback). Shared by the home Music section and song pages.
import type { Song } from '../lib/content';
import { spotifyEmbed, youtubeEmbed } from '../lib/music';

interface Props {
  song: Song;
  /** Hide services that have no link yet instead of showing their "Link coming" state. */
  onlyAvailable?: boolean;
}
const { song, onlyAvailable = false } = Astro.props;
const d = song.data;
const players = [
  { key: 'spotify', name: 'Spotify', url: d.spotify, embed: spotifyEmbed(d.spotify) },
  { key: 'youtube', name: 'YouTube', url: d.youtube, embed: youtubeEmbed(d.youtube) },
].filter((p) => !onlyAvailable || (p.url && p.embed));
---

{players.length > 0 && (
  <ul class="pl" aria-label="Listen">
    {players.map((p) => (
      <li class="pl-player">
        {p.url && p.embed ? (
          <>
            <button
              type="button"
              class="pl-play"
              data-src={p.embed}
              data-kind={p.key}
              data-title={`${d.title} on ${p.name}`}
              aria-label={`Play on ${p.name}: ${d.title}`}
              aria-describedby={`pl-${song.id}-${p.key}`}
            >
              <span class="pl-ico" aria-hidden="true" />
              <span class="pl-text">
                <strong>Play on {p.name}</strong>
              </span>
            </button>
            <span id={`pl-${song.id}-${p.key}`} hidden>
              Loads the {p.name} player
            </span>
            <a class="pl-play pl-link" href={p.url} rel="noopener">
              <span class="pl-ico" aria-hidden="true" />
              <span class="pl-text">
                <strong>
                  Open {d.title} on {p.name}
                </strong>
              </span>
            </a>
          </>
        ) : (
          <p class="pl-play is-soon">
            <span class="pl-ico" aria-hidden="true" />
            <span class="pl-text">
              <strong>{p.name}</strong>
              <small>Link coming. Player loads on click.</small>
            </span>
          </p>
        )}
      </li>
    ))}
  </ul>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('button.pl-play[data-src]').forEach((b) => {
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = b.dataset.src ?? '';
      f.title = b.dataset.title ?? 'Music player';
      f.className = `pl-frame pl-frame-${b.dataset.kind}`;
      f.allow = 'encrypted-media; picture-in-picture; fullscreen';
      f.loading = 'lazy';
      b.replaceWith(f);
      f.focus();
    });
  });
</script>

<style>
  .pl {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .pl-player {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }
  .pl-play {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 60px;
    padding: var(--space-2) var(--space-4) var(--space-2) var(--space-2);
    border: var(--ln-hairline);
    border-radius: var(--radius-3);
    background: var(--ln-bg-2);
    color: var(--ln-ink);
    font: inherit;
    text-align: left;
  }
  button.pl-play {
    cursor: pointer;
    transition:
      border-color var(--dur-quick) var(--ease-out),
      background-color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  button.pl-play:hover,
  button.pl-play:focus-visible {
    border-color: var(--ln-ink-2);
    background: var(--ln-bg-3);
  }
  button.pl-play:active {
    scale: var(--press-scale);
  }
  .pl-play.is-soon {
    border-style: dashed;
    background: transparent;
  }
  .pl-ico {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ln-ink);
  }
  .pl-ico::after {
    content: '';
    position: absolute;
    left: 15px;
    top: 12px;
    border-left: 13px solid var(--ln-bg);
    border-block: 8px solid transparent;
  }
  .is-soon .pl-ico {
    background: var(--ln-bg-3);
    box-shadow: inset 0 0 0 1px var(--ln-rule);
  }
  .is-soon .pl-ico::after {
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    border: 0;
    border-radius: 50%;
    background: var(--ln-ink-3);
    box-shadow:
      -8px 0 0 var(--ln-ink-3),
      8px 0 0 var(--ln-ink-3);
    transform: translate(-50%, -50%);
  }
  .pl-text {
    display: grid;
    line-height: var(--leading-snug);
  }
  .pl-text strong {
    font-weight: 700;
  }
  .pl-text small {
    font-size: var(--text-xs);
    color: var(--ln-ink-3);
  }
  /* One control per service: the click-to-load button with scripting, the plain link to the
     service (the same row) without it. */
  .pl-link {
    text-decoration: none;
    transition:
      border-color var(--dur-quick) var(--ease-out),
      background-color var(--dur-quick) var(--ease-out);
  }
  .pl-link:hover,
  .pl-link:focus-visible {
    border-color: var(--ln-ink-2);
    background: var(--ln-bg-3);
  }
  .pl-link:active {
    background: var(--ln-bg-2);
  }
  @media (scripting: enabled) {
    .pl-link {
      display: none;
    }
  }
  @media (scripting: none) {
    button.pl-play {
      display: none;
    }
  }
  .pl-player :global(.pl-frame) {
    width: 100%;
    border: 0;
    border-radius: var(--radius-3);
  }
  .pl-player :global(.pl-frame-spotify) {
    height: 152px;
  }
  .pl-player :global(.pl-frame-youtube) {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  /* Side by side when there is room; a lone player takes the whole row. */
  @media (min-width: 900px) {
    .pl {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    }
  }
</style>
