---
// Footer: contact links and the fine print.
// WO-024: a link that isn't real yet (not http(s) or mailto) is plain text, marked "to come".
// The arrow marks external http(s) links only; mailto gets none.
import type { Profile } from '../lib/content';
import Placeholder from './Placeholder.astro';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;
const external = (href: string) => /^https?:/.test(href);
const real = (href: string) => external(href) || href.startsWith('mailto:');
---

<footer id="contact" class="ft ln-dark" aria-labelledby="contact-h">
  <div class="ln-wrap ft-grid">
    <div class="ft-intro">
      <h2 id="contact-h" class="ft-title">
        Get in touch
      </h2>
      {profile.status === 'placeholder' && <Placeholder label="Some links to come" />}
    </div>
    <ul class="ft-links">
      {profile.links.map((l) => (
        <li>
          {real(l.href) ? (
            <a class="ft-row" href={l.href} rel={external(l.href) ? 'noopener' : undefined}>
              <span class="ft-label">{l.label}</span>
              {external(l.href) && (
                <span class="ft-arrow" aria-hidden="true">
                  ↗
                </span>
              )}
            </a>
          ) : (
            <span class="ft-row ft-soon">
              <span class="ft-label">{l.label}</span>
              <span class="ft-soon-k">To come</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>

  <div class="ln-wrap">
    <div class="ft-fine">
      <p>
        <span>{profile.name}</span>
        <span>{profile.location}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .ft {
    /* The same boundary as between sections (WO-034): Résumé's end and this top. */
    padding-block: var(--rhythm-top) var(--space-6);
    border-top: var(--ln-hairline);
  }
  .ft-grid {
    display: grid;
    gap: var(--space-6);
  }
  .ft-intro {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    align-content: start;
  }
  body.ln .ft-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
  }
  .ft-links {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--ln-hairline);
  }
  .ft-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    /* Flush: labels start where "Get in touch" and the hairlines start (WO-027). */
    padding-inline: 0;
    border-bottom: var(--ln-hairline);
  }
  .ft-links a {
    text-decoration: none;
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  /* Not a link yet: the label in a quieter ink, with a note where the arrow would be. */
  .ft-soon .ft-label {
    color: var(--ln-ink-2);
  }
  .ft-soon-k {
    font-size: var(--text-xs);
    color: var(--ln-ink-3);
  }
  .ft-label {
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-title);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .ft-arrow {
    color: var(--ln-accent);
    transition: translate var(--dur-quick) var(--ease-out);
  }
  .ft-links a:focus-visible .ft-label {
    text-decoration-color: currentColor;
  }
  @media (hover: hover) {
    .ft-links a:hover .ft-label {
      text-decoration-color: currentColor;
    }
  }
  .ft-links a:focus-visible .ft-arrow {
    translate: var(--move-sm) calc(var(--move-sm) * -1);
  }
  @media (hover: hover) {
    .ft-links a:hover .ft-arrow {
      translate: var(--move-sm) calc(var(--move-sm) * -1);
    }
  }
  /* The press tint bleeds a little past the flush text on both sides (shadows, so the hairlines
     keep their length). */
  .ft-links a:active {
    background: var(--ln-hl);
    box-shadow:
      calc(var(--space-2) * -1) 0 var(--ln-hl),
      var(--space-2) 0 var(--ln-hl);
  }
  .ft-fine {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: var(--rhythm-end);
    padding-top: var(--space-4);
    border-top: var(--ln-hairline);
    font-size: var(--text-xs);
    color: var(--ln-ink-3);
  }
  .ft-fine p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
  }
  @media (min-width: 900px) {
    .ft-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-8);
    }
  }
</style>
