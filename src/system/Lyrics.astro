---
// Lyrics: a Genius-style annotator for the song pages. One column: a note opens inline under its
// line. Annotated lines are <details>/<summary>: native keyboard support, and they still open with
// no JS. The script adds focus management (the note receives focus; Esc or Close returns it to
// the line).
import type { Song } from '../lib/content';

interface Props {
  song: Song;
  /** heading level for "Lyrics" (2 on a song page) */
  level?: 2 | 3 | 4;
  headingId?: string;
  /** rewrites displayed copy, e.g. to keep an unnamed collaborator anonymous */
  say?: (text: string) => string;
}
const { song, level = 4, headingId, say = (t: string) => t } = Astro.props;
const d = song.data;
const H = `h${level}` as 'h2' | 'h3' | 'h4';

type Line = Song['data']['lyrics'][number];
function stanzas(lines: Line[]) {
  const out: { section?: string; lines: Line[] }[] = [];
  for (const l of lines) {
    if (l.section || l.stanza || out.length === 0) out.push({ section: l.section, lines: [] });
    out[out.length - 1].lines.push(l);
  }
  return out;
}
const notes = d.lyrics.filter((l) => l.note).length;
let lineNo = 0;
---

<div class="ly" style={`--c1: ${d.artColors[0]}; --c2: ${d.artColors[1]}`}>
  <div class="ly-head">
    <H class="ly-h label" id={headingId}>
      Lyrics
    </H>
    {notes > 0 && (
      <p class="ly-legend">
        <span class="ly-swatch" aria-hidden="true" />
        {notes} annotated {notes === 1 ? 'line' : 'lines'}. Select one to read the note.
      </p>
    )}
  </div>
  {d.lyrics.length === 0 && (
    <p class="ly-empty">Lyrics and the stories behind the lines are on their way.</p>
  )}
  <div class="ly-grid" data-lyrics hidden={d.lyrics.length === 0}>
    <div class="ly-col">
      {stanzas(d.lyrics).map((st) => (
        <div class="ly-stanza">
          {st.section && <p class="ly-sec">[{st.section}]</p>}
          {st.lines.map((l) => {
            lineNo += 1;
            return l.note ? (
              <details class="ly-d" name={`notes-${song.id}`}>
                <summary class="ly-s">
                  <span class="ly-hl">{l.line}</span>
                  <span class="visually-hidden"> (annotated line)</span>
                </summary>
                <div
                  class="ly-note"
                  role="group"
                  tabindex="-1"
                  aria-label={`Annotation: ${l.line}`}
                  id={`note-${song.id}-${lineNo}`}
                >
                  <p class="ly-note-k">
                    <span class="ly-note-disc" aria-hidden="true" />
                    Liner note
                  </p>
                  <p class="ly-note-q">“{l.line}”</p>
                  <p class="ly-note-t">{say(l.note)}</p>
                  <button type="button" class="ly-close" data-close>
                    Close note <kbd>Esc</kbd>
                  </button>
                </div>
              </details>
            ) : (
              <p class="ly-line">{l.line}</p>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-lyrics] details.ly-d').forEach((d) => {
    const summary = d.querySelector<HTMLElement>('summary');
    const note = d.querySelector<HTMLElement>('.ly-note');
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      note?.focus({ preventScroll: true });
      note?.scrollIntoView({ block: 'nearest' });
    });
    const close = () => {
      d.open = false;
      summary?.focus();
    };
    d.querySelector('[data-close]')?.addEventListener('click', close);
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) {
        e.preventDefault();
        close();
      }
    });
  });
</script>

<style>
  .ly-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
    border-bottom: var(--ln-hairline);
  }
  .ly-legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
  }
  .ly-swatch {
    flex: none;
    width: 1.6rem;
    height: 0.9rem;
    border-radius: var(--radius-1);
    background: var(--ln-hl);
    box-shadow: inset 0 -2px 0 var(--ln-accent);
  }
  .ly-grid {
    position: relative;
  }
  .ly-stanza {
    margin-bottom: var(--space-6);
  }
  .ly-sec {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--ln-ink-3);
  }
  .ly-line,
  .ly-s {
    font-family: var(--ln-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-normal);
    padding-block: 0.12rem;
    /* A hanging indent, so a line that wraps reads as a continuation, not a new line (WO-030).
       An annotated line's highlight (.ly-hl) is inline, so its summary carries the indent. */
    padding-left: 1em;
    text-indent: -1em;
  }
  .ly-s {
    display: block;
    width: fit-content;
    max-width: 100%;
    list-style: none;
    cursor: pointer;
    border-radius: var(--radius-1);
  }
  .ly-s::-webkit-details-marker {
    display: none;
  }
  .ly-hl {
    padding: 0.05em 0.3em;
    margin-inline: -0.3em;
    border-radius: var(--radius-1);
    background: var(--ln-hl);
    box-shadow: inset 0 -2px 0 color-mix(in srgb, var(--ln-accent) 70%, transparent);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  .ly-s:hover .ly-hl,
  .ly-s:focus-visible .ly-hl {
    background: var(--ln-hl-hover);
  }
  .ly-s:active .ly-hl {
    background: var(--ln-accent);
    color: var(--ln-accent-ink);
  }
  .ly-d[open] .ly-hl {
    background: var(--ln-accent);
    color: var(--ln-accent-ink);
    box-shadow: none;
  }

  /* Annotation card: an inline sheet on mobile, a side panel on desktop */
  .ly-note {
    position: relative;
    margin: var(--space-3) 0 var(--space-5);
    padding: var(--space-4) var(--space-4) var(--space-4);
    border-radius: var(--radius-3);
    background: #f4ece1;
    color: #1a1411;
    box-shadow: var(--shadow-3);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ly-d[open] .ly-note {
      animation: ly-in var(--dur-base) var(--ease-out);
    }
  }
  @keyframes ly-in {
    from {
      opacity: 0;
      translate: 0 var(--move-sm);
    }
  }
  .ly-note:focus-visible {
    outline: var(--focus-width) solid var(--ln-accent);
    outline-offset: var(--focus-offset);
  }
  .ly-note::before {
    content: '';
    position: absolute;
    top: -7px;
    left: var(--space-5);
    width: 14px;
    height: 14px;
    background: inherit;
    transform: rotate(45deg);
  }
  .ly-note-k {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #5c4f44;
  }
  .ly-note-disc {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background:
      radial-gradient(circle, #1a1411 0 12%, transparent 13%),
      radial-gradient(circle, var(--c2) 0 40%, transparent 41%), #1a1411;
  }
  .ly-note-q {
    margin-top: var(--space-3);
    font-family: var(--ln-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: #5c4f44;
  }
  .ly-note-t {
    margin-top: var(--space-2);
    line-height: var(--leading-normal);
  }
  .ly-close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 36px;
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    border: 1px solid #c9bba5;
    border-radius: var(--radius-2);
    background: transparent;
    color: #1a1411;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-quick) var(--ease-out),
      color var(--dur-quick) var(--ease-out),
      scale var(--dur-quick) var(--ease-out);
  }
  .ly-close:hover,
  .ly-close:focus-visible {
    background: #1a1411;
    color: #f4ece1;
  }
  .ly-close:active {
    scale: var(--press-scale);
  }
  .ly-close:focus-visible {
    outline: var(--focus-width) solid #a63d17;
    outline-offset: 2px;
  }
  .ly-close kbd {
    padding: 0 var(--space-1);
    border: 1px solid currentColor;
    border-radius: var(--radius-1);
    font: inherit;
    font-size: var(--text-2xs);
    opacity: 0.8;
  }

  @media (min-width: 900px) {
    .ly-note {
      max-width: 34rem;
    }
  }
  .ly-grid[hidden] {
    display: none;
  }
  .ly-empty {
    margin-top: var(--space-4);
    color: var(--ln-ink-2);
  }
</style>
