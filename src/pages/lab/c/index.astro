---
// Direction C — Product Spec: the one-page home.
import { getSiteContent } from '../../../lib/content';
import Shell from '../../../directions/c/Shell.astro';
import Hero from '../../../directions/c/Hero.astro';
import Work from '../../../directions/c/Work.astro';
import Projects from '../../../directions/c/Projects.astro';
import Music from '../../../directions/c/Music.astro';
import Resume from '../../../directions/c/Resume.astro';

const content = await getSiteContent();
---

<Shell
  title={`${content.profile.name} — Product Spec (direction C)`}
  description={content.profile.headline}
  content={content}
  home
>
  <Hero content={content} />
  <Work content={content} />
  <Projects content={content} />
  <Music content={content} />
  <Resume content={content} />
</Shell>
