---
// Phase 1 comparison gallery (constitution art. 1). Shows one slot at a time across directions
// A–D at phone or desktop width, and builds factory/picks.yaml from the owner's choices.
// Removed at launch (Phase 6).
import Base from '../../layouts/Base.astro';
import '@fontsource-variable/inter';

const directions = [
  {
    id: 'a',
    name: 'Editorial',
    idea: 'Long-scroll magazine, big serif type, demos as full-bleed spreads.',
  },
  {
    id: 'b',
    name: 'Desktop OS',
    idea: 'Projects open as app windows; a home screen of icons on mobile.',
  },
  {
    id: 'c',
    name: 'Product Spec',
    idea: 'PM-native: work as tickets with status, metrics and spec drawers.',
  },
  {
    id: 'd',
    name: 'Liner Notes',
    idea: 'Dark record sleeve: Side A professional, Side B personal, bonus tracks.',
  },
];

const slots = [
  { id: 'overall', label: 'Overall feel', path: '' },
  { id: 'hero', label: 'Hero & nav', path: '#hero' },
  { id: 'work', label: 'Professional work', path: '#work' },
  { id: 'demo', label: 'Phone demo frame', path: '#work' },
  { id: 'projects', label: 'Project cards', path: '#projects' },
  { id: 'casestudy', label: 'Case-study page', path: 'billable/' },
  { id: 'music', label: 'Music & lyrics', path: '#music' },
  { id: 'resume', label: 'Résumé', path: '#resume' },
];
---

<Base title="Design lab — pick your directions" noindex bodyClass="lab">
  <Fragment slot="header">
    <header class="lab-head">
      <p class="lab-eyebrow">Phase 1 · design lab</p>
      <h1>Pick what you like from four directions</h1>
      <p class="lab-lede">
        Choose a slot, compare A–D side by side at phone or desktop width, open any direction full
        screen, then record a pick for each slot. The pick sheet at the bottom builds the
        <code>picks.yaml</code> I build the real site from.
      </p>
    </header>
  </Fragment>

  <section aria-labelledby="dirs-h" class="lab-dirs">
    <h2 id="dirs-h">The directions</h2>
    <ul>
      {directions.map((d) => (
        <li>
          <a href={`/lab/${d.id}/`}>
            <strong>
              {d.id.toUpperCase()} · {d.name}
            </strong>
            <span>{d.idea}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="cmp-h" class="lab-compare">
    <h2 id="cmp-h">Compare a slot</h2>
    <form class="lab-controls" id="controls">
      <fieldset>
        <legend>Slot</legend>
        <div class="lab-chips">
          {slots.map((s, i) => (
            <label>
              <input type="radio" name="slot" value={s.id} data-path={s.path} checked={i === 0} />
              <span>{s.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend>Viewport</legend>
        <div class="lab-chips">
          <label>
            <input type="radio" name="vp" value="375" checked />
            <span>Phone 375</span>
          </label>
          <label>
            <input type="radio" name="vp" value="1440" />
            <span>Desktop 1440</span>
          </label>
        </div>
      </fieldset>
    </form>
    <div class="lab-frames" id="frames" data-vp="375">
      {directions.map((d) => (
        <figure class="lab-frame">
          <figcaption>
            <strong>{d.id.toUpperCase()}</strong> {d.name}
            <a href={`/lab/${d.id}/`} class="lab-open">
              Open full screen<span class="visually-hidden"> — direction {d.id.toUpperCase()}</span>
            </a>
          </figcaption>
          <div class="lab-viewport">
            <iframe
              title={`Direction ${d.id.toUpperCase()}, ${d.name}`}
              data-dir={d.id}
              loading="lazy"
              src="about:blank"
            />
          </div>
        </figure>
      ))}
    </div>
  </section>

  <section aria-labelledby="pick-h" class="lab-picks">
    <h2 id="pick-h">Pick sheet</h2>
    <p>Your choices are saved in this browser as you go.</p>
    <form id="picks">
      {slots.map((s) => (
        <fieldset class="lab-pick">
          <legend>{s.label}</legend>
          <div class="lab-chips">
            {['a', 'b', 'c', 'd'].map((d) => (
              <label>
                <input type="radio" name={s.id} value={d} />
                <span>{d.toUpperCase()}</span>
              </label>
            ))}
          </div>
          <label class="lab-note">
            <span>Notes for {s.label.toLowerCase()}</span>
            <input type="text" name={`${s.id}-note`} autocomplete="off" />
          </label>
        </fieldset>
      ))}
      <fieldset class="lab-pick">
        <legend>Motion level</legend>
        <div class="lab-chips">
          {['calm', 'some', 'lively'].map((m) => (
            <label>
              <input type="radio" name="motion" value={m} />
              <span>{m}</span>
            </label>
          ))}
        </div>
      </fieldset>
    </form>
    <label for="yaml" class="lab-yaml-label">
      picks.yaml
    </label>
    <textarea id="yaml" rows="14" readonly></textarea>
    <button type="button" id="copy">
      Copy picks.yaml
    </button>
    <p id="copied" aria-live="polite" class="lab-status"></p>
  </section>
</Base>

<script>
  const frames = document.getElementById('frames')!;
  const controls = document.getElementById('controls') as HTMLFormElement;
  const picks = document.getElementById('picks') as HTMLFormElement;
  const yaml = document.getElementById('yaml') as HTMLTextAreaElement;
  const KEY = 'lab-picks-v1';

  function showSlot() {
    const slot = controls.querySelector<HTMLInputElement>('input[name=slot]:checked')!;
    const vp = controls.querySelector<HTMLInputElement>('input[name=vp]:checked')!.value;
    frames.dataset.vp = vp;
    frames.querySelectorAll<HTMLIFrameElement>('iframe').forEach((f) => {
      const url = `/lab/${f.dataset.dir}/${slot.dataset.path}`;
      if (f.getAttribute('src') !== url) f.setAttribute('src', url);
    });
  }

  function toYaml() {
    const data = new FormData(picks);
    const lines = [
      '# Phase 1 picks — paste into factory/picks.yaml',
      `date: ${new Date().toISOString().slice(0, 10)}`,
      'slots:',
    ];
    picks.querySelectorAll('fieldset.lab-pick').forEach((fs) => {
      const radio = fs.querySelector<HTMLInputElement>('input[type=radio]');
      if (!radio) return;
      const name = radio.name;
      if (name === 'motion') return;
      const note = String(data.get(`${name}-note`) ?? '').replace(/"/g, '\\"');
      lines.push(`  ${name}: { pick: ${data.get(name) ?? 'null'}, note: "${note}" }`);
    });
    lines.push(`motion: ${data.get('motion') ?? 'null'}`);
    yaml.value = lines.join('\n');
  }

  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify(Object.fromEntries(new FormData(picks))));
    } catch {
      /* storage unavailable: picks still work for this visit */
    }
    toYaml();
  }

  function restore() {
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) ?? '{}') as Record<string, string>;
      for (const [k, v] of Object.entries(saved)) {
        const el = picks.elements.namedItem(k);
        if (el instanceof RadioNodeList) el.value = v;
        else if (el instanceof HTMLInputElement) el.value = v;
      }
    } catch {
      /* ignore */
    }
    toYaml();
  }

  controls.addEventListener('change', showSlot);
  picks.addEventListener('input', save);
  picks.addEventListener('change', save);
  document.getElementById('copy')!.addEventListener('click', async () => {
    const status = document.getElementById('copied')!;
    try {
      await navigator.clipboard.writeText(yaml.value);
      status.textContent = 'Copied picks.yaml to the clipboard.';
    } catch {
      yaml.select();
      status.textContent = 'Select-all done — press Cmd+C to copy.';
    }
  });
  restore();
  showSlot();
</script>

<style is:global>
  body.lab {
    --ink: #16141d;
    --muted: #57536a;
    --line: #dcd8e6;
    --paper: #faf9fc;
    --accent: #4338ca;
    font-family: 'Inter Variable', system-ui, sans-serif;
    color: var(--ink);
    background: var(--paper);
  }
  @media (prefers-color-scheme: dark) {
    body.lab {
      --ink: #f1eff7;
      --muted: #b9b4c9;
      --line: #36324a;
      --paper: #121019;
      --accent: #a5b4fc;
    }
  }
  .lab main,
  .lab-head {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .lab-head {
    padding-top: 40px;
  }
  .lab-eyebrow {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lab h1 {
    margin: 0.3rem 0 0.5rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
  }
  .lab h2 {
    margin: 2.5rem 0 1rem;
    font-size: 1.35rem;
  }
  .lab-lede {
    max-width: 70ch;
    color: var(--muted);
  }
  .lab a {
    color: var(--accent);
  }
  .lab-dirs ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    padding: 0;
    list-style: none;
  }
  .lab-dirs a {
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .lab-dirs a:hover {
    border-color: var(--accent);
  }
  .lab-dirs span {
    color: var(--muted);
  }
  .lab fieldset {
    margin: 0 0 12px;
    padding: 0;
    border: 0;
  }
  .lab legend {
    margin-bottom: 6px;
    font-weight: 600;
  }
  .lab-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .lab-chips label {
    position: relative;
  }
  .lab-chips input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .lab-chips span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-transform: capitalize;
  }
  .lab-chips input:checked + span {
    color: var(--paper);
    background: var(--ink);
    border-color: var(--ink);
  }
  .lab-chips input:focus-visible + span {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .lab-frames {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  }
  .lab-frames[data-vp='1440'] {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 640px), 1fr));
  }
  .lab-frame {
    margin: 0;
  }
  .lab-frame figcaption {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin-bottom: 8px;
  }
  .lab-open {
    margin-left: auto;
    font-size: 0.9rem;
  }
  .lab-viewport {
    --w: 375;
    --h: 740;
    position: relative;
    width: 100%;
    aspect-ratio: var(--w) / var(--h);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
    container-type: inline-size;
  }
  .lab-frames[data-vp='1440'] .lab-viewport {
    --w: 1440;
    --h: 900;
    border-radius: 10px;
  }
  .lab-viewport iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--w) * 1px);
    height: calc(var(--h) * 1px);
    border: 0;
    transform-origin: 0 0;
    transform: scale(calc(100cqw / (var(--w) * 1px)));
  }
  .lab-picks {
    padding-bottom: 64px;
  }
  .lab-pick {
    padding: 12px 0 !important;
    border-top: 1px solid var(--line) !important;
  }
  .lab-note {
    display: grid;
    gap: 4px;
    margin-top: 8px;
    max-width: 560px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .lab-note input,
  .lab textarea {
    width: 100%;
    min-height: 40px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font: inherit;
    color: var(--ink);
    background: transparent;
  }
  .lab textarea {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-size: 0.85rem;
  }
  .lab-yaml-label {
    display: block;
    margin: 16px 0 6px;
    font-weight: 600;
  }
  #copy {
    min-height: 44px;
    margin-top: 10px;
    padding: 0 18px;
    border: 0;
    border-radius: 10px;
    font: inherit;
    font-weight: 600;
    color: var(--paper);
    background: var(--ink);
    cursor: pointer;
  }
  .lab-status {
    min-height: 1.5em;
    color: var(--muted);
  }
</style>
