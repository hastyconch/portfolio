---
// Direction D — Liner Notes: the one-page home (WO-006).
import '@fontsource-variable/inter'; // the airline demo's own typeface
import Shell from '../../../directions/d/Shell.astro';
import Hero from '../../../directions/d/Hero.astro';
import Work from '../../../directions/d/Work.astro';
import Projects from '../../../directions/d/Projects.astro';
import Music from '../../../directions/d/Music.astro';
import Resume from '../../../directions/d/Resume.astro';
import { getSiteContent } from '../../../lib/content';

const { profile, resume, work, projects, songs } = await getSiteContent();
---

<Shell
  title={`${profile.name} — Liner Notes · Direction D`}
  description={profile.headline}
  home
  nowPlaying="Intro"
>
  <Hero
    profile={profile}
    counts={{ work: work.length, projects: projects.length, songs: songs.length }}
  />
  <Work work={work} />
  <Projects projects={projects} />
  <Music songs={songs} />
  <Resume resume={resume} />
</Shell>
