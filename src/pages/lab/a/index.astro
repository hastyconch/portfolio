---
// Direction A — Editorial: the full one-page home (WO-003).
import { getSiteContent } from '../../../lib/content';
import Shell from '../../../directions/a/Shell.astro';
import Hero from '../../../directions/a/Hero.astro';
import Work from '../../../directions/a/Work.astro';
import Projects from '../../../directions/a/Projects.astro';
import Music from '../../../directions/a/Music.astro';
import Resume from '../../../directions/a/Resume.astro';

const { profile, resume, work, projects, songs } = await getSiteContent();
---

<Shell title={`${profile.name} — Editorial (direction A)`} profile={profile}>
  <Hero profile={profile} />
  <Work work={work} />
  <Projects projects={projects} />
  <Music songs={songs} />
  <Resume resume={resume} />
</Shell>
