---
// Direction B case study: the project opened as an app window.
import type { GetStaticPaths } from 'astro';
import { getSiteContent, type Project } from '../../../lib/content';
import Shell from '../../../directions/b/Shell.astro';
import CaseStudyLayout from '../../../directions/b/CaseStudyLayout.astro';
import { LAB_BASE } from '../../../directions/b/apps';

export const getStaticPaths = (async () => {
  const { projects } = await getSiteContent();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev?: Project;
  next?: Project;
}
const { project, prev, next } = Astro.props;
const { profile } = await getSiteContent();
---

<Shell
  title={`${project.data.title} — case study (lab B)`}
  description={project.data.tagline}
  profile={profile}
  base={LAB_BASE}
  bodyClass="dos-cs"
>
  <CaseStudyLayout project={project} prev={prev} next={next} />
</Shell>
