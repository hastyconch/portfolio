---
// Test harness for the nurse scheduler demo (WO-012, WO-016): first in a laptop pane
// (1160 × 540, the size the Work section gives it at 1440 × 900), then in a 360px column.
import Base from '../../layouts/Base.astro';
import SchedulerDemo from '../../demos/scheduler/SchedulerDemo.tsx';
import '../../system/tokens.css';
---

<Base
  title="Nurse scheduler demo · harness"
  description="Test harness for the nurse scheduler demo."
  noindex
>
  <div class="harness">
    <h1>Nurse scheduler demo</h1>
    <p>Test harness. Mock data only: the unit, staff and rules are invented.</p>

    <section aria-labelledby="full-width">
      <h2 id="full-width">Laptop pane, 1160 × 540</h2>
      <h3 class="visually-hidden">Roster</h3>
      <div class="frame pane" data-pane="1160x540">
        <SchedulerDemo client:visible />
      </div>
    </section>

    <section aria-labelledby="narrow">
      <h2 id="narrow">360px column</h2>
      <h3 class="visually-hidden">Roster (narrow)</h3>
      <div class="frame narrow">
        <SchedulerDemo client:visible />
      </div>
    </section>
  </div>
</Base>

<style>
  .harness {
    max-width: 1192px;
    margin: 0 auto;
    padding: 1rem;
  }
  section {
    margin-top: 2rem;
  }
  .frame {
    border: 1px solid GrayText;
  }
  .pane {
    width: 1160px;
    max-width: 100%;
  }
  /* The pane only has a fixed height where it is full size; narrower, it grows with its content. */
  @media (min-width: 1192px) {
    .pane {
      height: 540px;
      overflow: auto;
    }
  }
  .narrow {
    width: 100%;
    max-width: 360px;
  }
</style>
