---
// Review harness for the pipeline demo (WO-010, WO-016): first in a laptop pane (1160 × 500, the
// frame the Work section gives it at 1440 × 900), then in a 360px side column.
import Base from '../../layouts/Base.astro';
import PipelineDemo from '../../demos/pipeline/PipelineDemo.tsx';
import '../../system/tokens.css';
import '../../system/liner.css';
---

<Base title="Pipeline demo harness" noindex>
  <div class="h-wrap">
    <h1>Pipeline demo harness</h1>
    <p>AI-assisted program management, step by step. Mock data only.</p>

    <section aria-labelledby="h-full">
      <h2 id="h-full">Laptop pane, 1160 × 500</h2>
      <div class="h-full" data-pane="1160x500">
        <PipelineDemo client:visible />
      </div>
    </section>

    <section aria-labelledby="h-side">
      <h2 id="h-side">360px side column</h2>
      <div class="h-side">
        <PipelineDemo client:visible />
      </div>
    </section>
  </div>
</Base>

<style is:global>
  body {
    color: var(--ln-ink);
    background: var(--ln-bg);
  }
</style>

<style>
  .h-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    max-width: 1192px;
    margin-inline: auto;
    padding: 2rem 1rem 4rem;
  }
  h1 {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }
  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-md);
    color: var(--ln-ink-2);
  }
  p {
    margin: 0;
  }
  .h-full {
    width: 1160px;
    max-width: 100%;
  }
  /* The pane only has a fixed height where it is full size; narrower, it grows with its content. */
  @media (min-width: 1192px) {
    .h-full {
      height: 500px;
      overflow: auto;
    }
  }
  .h-side {
    max-width: 360px;
  }
</style>
