---
// Harness for the grocer loyalty demo (WO-009): the demo alone in a 336×630 phone screen, so it
// can be reviewed and tested before integration places it on the home page. Not indexed.
import Base from '../../layouts/Base.astro';
import GrocerDemo from '../../demos/grocer/GrocerDemo.tsx';
---

<Base title="Grocer loyalty demo" description="Grocer loyalty phone demo (mock data)." noindex>
  <div class="harness">
    <h1>Grocer loyalty demo</h1>
    <p>Invented brand, mock data. Every control works by keyboard.</p>
    <div class="screen">
      <GrocerDemo client:visible />
    </div>
    <p>
      <a href="/">Back to the portfolio</a>
    </p>
  </div>
</Base>

<style>
  :global(body) {
    --h-bg: #f4f4f2;
    --h-fg: #1b1b1b;
    --h-link: #0b4f8a;
    color: var(--h-fg);
    background: var(--h-bg);
  }
  @media (prefers-color-scheme: dark) {
    :global(body) {
      --h-bg: #141414;
      --h-fg: #ededed;
      --h-link: #8cc4ff;
    }
  }
  .harness {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 1.5rem 1rem 3rem;
  }
  h1 {
    margin: 0;
    font-size: 1.5rem;
  }
  p {
    margin: 0;
  }
  a {
    color: var(--h-link);
  }
  .screen {
    width: 336px;
    max-width: 100%;
    height: 630px;
    border-radius: 28px;
    overflow: hidden;
    box-shadow:
      0 0 0 10px #0d0d0d,
      0 24px 48px -24px rgb(0 0 0 / 0.6);
  }
  .screen > :global(*) {
    height: 100%;
  }
</style>
