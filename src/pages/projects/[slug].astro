---
// A case-study page for every project except Billable, which has its own route
// (projects/billable.astro) so the game's island and stylesheet load on that page only.
import CaseStudyLayout from '../../system/CaseStudyLayout.astro';
import { getSiteContent, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const { projects } = await getSiteContent();
  return projects
    .map((project, index) => ({
      params: { slug: project.id },
      props: { project, index, prev: projects[index - 1], next: projects[index + 1] },
    }))
    .filter(({ props }) => props.project.data.demo !== 'billable');
}

interface Props {
  project: Project;
  index: number;
  prev?: Project;
  next?: Project;
}
const { project, index, prev, next } = Astro.props;
---

<CaseStudyLayout project={project} index={index} prev={prev} next={next} />
