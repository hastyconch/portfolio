---
// Click-to-load Spotify/YouTube players for one song (constitution art. 5 and 6): nothing
// third-party is requested until the visitor presses a player button, and every player keeps a
// plain "Open on …" link as its no-JS fallback. Shared by the home Music section and song pages;
// the leading underscore keeps this file out of the router.
import type { Song } from '../../lib/content';
import { spotifyEmbed, youtubeEmbed } from './_music';

interface Props {
  song: Song;
}
const d = Astro.props.song.data;
const players = [
  { key: 'spotify', name: 'Spotify', url: d.spotify, embed: spotifyEmbed(d.spotify) },
  { key: 'youtube', name: 'YouTube', url: d.youtube, embed: youtubeEmbed(d.youtube) },
];
---

<ul class="pl" aria-label="Listen">
  {players.map((p) => (
    <li class="pl-player">
      {p.url && p.embed ? (
        <>
          <button
            type="button"
            class="pl-play"
            data-src={p.embed}
            data-kind={p.key}
            data-title={`${d.title} on ${p.name}`}
          >
            <span class="pl-ico" aria-hidden="true" />
            <span class="pl-text">
              <strong>Play on {p.name}</strong>
              <small>Loads the {p.name} player</small>
            </span>
          </button>
          <a class="pl-link" href={p.url} rel="noopener">
            Open on {p.name}
          </a>
        </>
      ) : (
        <p class="pl-play is-soon">
          <span class="pl-ico" aria-hidden="true" />
          <span class="pl-text">
            <strong>{p.name}</strong>
            <small>Link coming — player loads on click</small>
          </span>
        </p>
      )}
    </li>
  ))}
</ul>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.pl-play[data-src]').forEach((b) => {
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = b.dataset.src ?? '';
      f.title = b.dataset.title ?? 'Music player';
      f.className = `pl-frame pl-frame-${b.dataset.kind}`;
      f.allow = 'encrypted-media; picture-in-picture; fullscreen';
      f.loading = 'lazy';
      b.replaceWith(f);
      f.focus();
    });
  });
</script>

<style>
  .pl {
    display: grid;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .pl-player {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .pl-play {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    min-height: 60px;
    padding: 0.6rem 1rem 0.6rem 0.6rem;
    border: 1px solid var(--ln-rule);
    border-radius: 999px;
    background: var(--ln-bg-2);
    color: var(--ln-ink);
    font: inherit;
    text-align: left;
  }
  button.pl-play {
    cursor: pointer;
  }
  button.pl-play:hover {
    border-color: var(--ln-ink);
  }
  .pl-play.is-soon {
    border-style: dashed;
    background: transparent;
  }
  .pl-ico {
    position: relative;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--ln-ink);
  }
  .pl-ico::after {
    content: '';
    position: absolute;
    left: 16px;
    top: 13px;
    border-left: 13px solid var(--ln-bg);
    border-block: 8px solid transparent;
  }
  .is-soon .pl-ico {
    background: var(--ln-bg-3);
    box-shadow: inset 0 0 0 1px var(--ln-rule);
  }
  .is-soon .pl-ico::after {
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    border: 0;
    border-radius: 50%;
    background: var(--ln-ink-3);
    box-shadow:
      -8px 0 0 var(--ln-ink-3),
      8px 0 0 var(--ln-ink-3);
    transform: translate(-50%, -50%);
  }
  .pl-text {
    display: grid;
    line-height: 1.25;
  }
  .pl-text strong {
    font-weight: 700;
  }
  .pl-text small {
    font-size: 0.8125rem;
    color: var(--ln-ink-3);
  }
  .pl-link {
    justify-self: start;
    padding: 0.25rem 1rem;
    font-size: 0.875rem;
    color: var(--ln-ink-2);
  }
  .pl-player :global(.pl-frame) {
    width: 100%;
    border: 0;
    border-radius: 12px;
  }
  .pl-player :global(.pl-frame-spotify) {
    height: 152px;
  }
  .pl-player :global(.pl-frame-youtube) {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  @media (min-width: 900px) {
    .pl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
