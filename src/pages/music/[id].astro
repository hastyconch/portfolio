---
// A page for every song: the sleeve, credits, click-to-load players, what the song is about, the
// full lyrics annotator and the neighbouring tracks. Like the Music section on the home page (the
// one place the record theme lives), it stays dark in both colour schemes, tinted by the song.
import Shell from '../../system/Shell.astro';
import SongArt from '../../system/SongArt.astro';
import Lyrics from '../../system/Lyrics.astro';
import Placeholder from '../../system/Placeholder.astro';
import Players from '../../system/Players.astro';
import { voice } from '../../lib/music';
import { getSiteContent, type Music, type Song } from '../../lib/content';

export async function getStaticPaths() {
  const { songs, music } = await getSiteContent();
  return songs.map((song, index) => ({
    params: { id: song.id },
    props: { song, index, music, prev: songs[index - 1], next: songs[index + 1] },
  }));
}

interface Props {
  song: Song;
  index: number;
  music: Music;
  prev?: Song;
  next?: Song;
}
const { song, index, music, prev, next } = Astro.props;
const d = song.data;
const say = voice(music);
const colors = (s: Song) => `--c1: ${s.data.artColors[0]}; --c2: ${s.data.artColors[1]}`;
// Credits and release on one line, as in the home panel.
const release = [say(d.credits), d.release].filter(Boolean).join(' · ');
// Back to the Music section with this song selected (the home tabs read #song-<id>).
const allSongs = `/#song-${song.id}`;
---

<Shell title={`${d.title} · lyrics and liner notes`} description={say(d.meaning)}>
  <article class="sg ln-dark" style={colors(song)}>
    <div class="ln-wrap sg-layout">
      <header class="sg-intro">
        <p class="sg-back">
          <a href={allSongs}>
            <span aria-hidden="true">←</span> All songs
          </a>
        </p>
        <p class="sg-k">
          <span class="label">
            Track {index + 1} · {d.year}
          </span>
          {d.status === 'placeholder' && <Placeholder />}
        </p>
        <h1 class="sg-title">{d.title}</h1>
        <p class="sg-release">{release}</p>
      </header>

      <!-- Cover and players: beside the lyrics (and sticky) on wide screens. -->
      <div class="sg-side">
        <SongArt song={song} index={index} eager />
        <div class="sg-players">
          <Players song={song} />
        </div>
      </div>

      <section id="about" class="sg-sec sg-about" aria-labelledby="about-h">
        <h2 id="about-h" class="sg-h label">
          About this song
        </h2>
        <p>{say(d.meaning)}</p>
      </section>

      <section id="lyrics" class="sg-sec" aria-labelledby="lyrics-h">
        <Lyrics song={song} level={2} headingId="lyrics-h" say={say} />
      </section>
    </div>

    <nav class="ln-wrap sg-pager" aria-label="More songs">
      {prev ? (
        <a class="sg-pg" href={`/music/${prev.id}/`} style={colors(prev)} rel="prev">
          <span class="sg-pg-k">Previous track</span>
          <span class="sg-pg-t">{prev.data.title}</span>
        </a>
      ) : (
        <a class="sg-pg" href={allSongs}>
          <span class="sg-pg-k">All songs</span>
          <span class="sg-pg-t">Music</span>
        </a>
      )}
      {next ? (
        <a class="sg-pg sg-pg-next" href={`/music/${next.id}/`} style={colors(next)} rel="next">
          <span class="sg-pg-k">Next track</span>
          <span class="sg-pg-t">{next.data.title}</span>
        </a>
      ) : (
        <a class="sg-pg sg-pg-next" href={allSongs}>
          <span class="sg-pg-k">All songs</span>
          <span class="sg-pg-t">Music</span>
        </a>
      )}
    </nav>
  </article>
</Shell>

<style>
  .sg {
    overflow-x: clip;
    color: var(--ln-ink);
    background-color: color-mix(in srgb, var(--c1) 12%, var(--ln-bg));
  }

  /* Phones: one column (title, cover and players, about, lyrics). Wide screens: the lyrics in
     one column with the cover and players sticky beside them. */
  .sg-layout {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-8);
  }
  .sg-side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    min-width: 0;
  }
  .sg-intro {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }
  .sg-back a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ln-ink-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--dur-quick) var(--ease-out),
      text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .sg-back a:hover,
  .sg-back a:focus-visible {
    color: var(--ln-ink);
    text-decoration-color: currentColor;
  }
  .sg-back a:active {
    color: var(--ln-ink-3);
  }
  .sg-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  body.ln .sg-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: var(--leading-tight);
    overflow-wrap: anywhere;
  }

  .sg-sec {
    scroll-margin-top: calc(var(--ln-header) + var(--space-4));
    min-width: 0;
  }
  .sg-about {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
    padding-left: var(--space-4);
    border-left: 2px solid var(--ln-rule);
  }
  .sg-about p {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--ln-ink-2);
  }

  .sg-pager {
    display: grid;
    padding-bottom: var(--space-8);
  }
  .sg-pg {
    display: grid;
    gap: var(--space-1);
    /* Flush with the rule (WO-030); the press tint bleeds past the text instead (below). */
    padding: var(--space-5) 0;
    border-top: var(--ln-hairline);
    color: var(--ln-ink);
    text-decoration: none;
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  .sg-pg-k {
    font-size: var(--text-sm);
    color: var(--ln-ink-3);
  }
  .sg-pg-t {
    font-family: var(--ln-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-title);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-quick) var(--ease-out);
  }
  .sg-pg:hover .sg-pg-t,
  .sg-pg:focus-visible .sg-pg-t {
    text-decoration-color: currentColor;
  }
  /* As in the footer: shadows bleed the tint past the flush text, so the rule keeps its length. */
  .sg-pg:active {
    background: var(--ln-hl);
    box-shadow:
      calc(var(--space-2) * -1) 0 var(--ln-hl),
      var(--space-2) 0 var(--ln-hl);
  }
  .sg-pg:active .sg-pg-t {
    color: var(--ln-ink-2);
  }

  @media (min-width: 760px) {
    .sg-pager {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-6);
    }
    .sg-pg-next {
      text-align: right;
    }
  }
  @media (min-width: 900px) {
    .sg-layout {
      grid-template-columns: minmax(0, 1fr) 320px;
      column-gap: var(--space-8);
      row-gap: var(--space-7);
      align-items: start;
    }
    .sg-intro,
    .sg-sec {
      grid-column: 1;
    }
    .sg-side {
      grid-column: 2;
      grid-row: 1 / span 3;
      position: sticky;
      top: calc(var(--ln-header) + var(--space-6));
    }
    .sg-side :global(.sa) {
      width: 100%;
    }
    .sg-side :global(.pl) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .sg-release {
    color: var(--ln-ink-2);
  }
</style>
