---
// The one-page home, built from the Phase 1 picks (factory/picks.yaml).
import Shell from '../system/Shell.astro';
import Hero from '../system/Hero.astro';
import Work from '../system/Work.astro';
import Projects from '../system/Projects.astro';
import Music from '../system/Music.astro';
import Resume from '../system/Resume.astro';
import { getSiteContent } from '../lib/content';

const { profile, music, resume, work, projects, songs, features } = await getSiteContent();
---

<Shell home description={profile.headline}>
  <Hero profile={profile} />
  <Work work={work} />
  <Projects projects={projects} />
  <Music songs={songs} features={features} music={music} />
  <Resume resume={resume} />
</Shell>
