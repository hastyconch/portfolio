---
import Shell from '../system/Shell.astro';
---

<Shell title="Page not found" noindex>
  <section class="nf ln-wrap">
    <p class="label">404</p>
    <h1>Page not found</h1>
    <p class="nf-body">
      There's nothing at this address. The link may be mistyped, or the page may have moved.
    </p>
    <p>
      <a class="ln-link" href="/">
        Go to the home page
      </a>
    </p>
  </section>
</Shell>

<style>
  .nf {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-block: var(--space-9);
  }
  body :global(.nf h1) {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
  }
  .nf-body {
    max-width: 52ch;
    color: var(--ln-ink-2);
  }
</style>
